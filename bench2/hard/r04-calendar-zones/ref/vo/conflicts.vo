# Which meetings clash with a time slot.
import std.option;
import model;
import timefmt;

export record Order {
    start: int;
    meeting_id: str;
}

export fn order(m: model.Meeting) -> Order {
    return new Order { start: m.start, meeting_id: m.meeting_id };
}

export fn overlaps(start: int, end: int, other_start: int, other_end: int) -> bool {
    return start < other_end and other_start < end;
}

# The meeting that starts first (ties: the smaller ID), if any.
export fn first(meetings: list[model.Meeting]) -> option.Option[model.Meeting] {
    if len(meetings) == 0 {
        return option.Option.none;
    }
    var best = meetings[0];
    for m in meetings {
        if order(m) < order(best) {
            set best = m;
        }
    }
    return option.Option.some(best);
}

export fn room_clash(cal: model.Calendar, room: str, start: int, end: int, skip: str) -> option.Option[model.Meeting] {
    let found = new list[model.Meeting];
    for _, m in cal.meetings {
        if m.room == room and m.meeting_id != skip and overlaps(start, end, m.start, m.end) {
            push(found, m);
        }
    }
    return first(found);
}

export fn person_clash(cal: model.Calendar, name: str, start: int, end: int, skip: str) -> option.Option[model.Meeting] {
    let found = new list[model.Meeting];
    for _, m in cal.meetings {
        if model.contains(model.people(m), name) and m.meeting_id != skip and overlaps(start, end, m.start, m.end) {
            push(found, m);
        }
    }
    return first(found);
}

export fn clash_text(who: str, m: model.Meeting, offset: int) -> str {
    return "error: " + who + " busy: " + m.meeting_id + " " + timefmt.span(m.start + offset, m.end + offset);
}

# Whether a meeting from start to end (UTC) lies within the user's working hours of one local day.
export fn hours_error(u: model.User, start: int, end: int) -> str {
    if not u.has_hours {
        return "";
    }
    let local_start = start + u.offset;
    let base = timefmt.day_of(local_start) * model.minutes_per_day;
    if local_start < base + u.hours_start or end + u.offset > base + u.hours_end {
        return "error: " + u.name + " works " + timefmt.clock(u.hours_start) + "-" + timefmt.clock(u.hours_end);
    }
    return "";
}

export fn person_error(cal: model.Calendar, name: str, start: int, end: int, skip: str, offset: int) -> str {
    match person_clash(cal, name, start, end, skip) {
        case some(m) {
            return clash_text(name, m, offset);
        }
        case none {
        }
    }
    return hours_error(cal.users[name], start, end);
}

export fn capacity_error(room: model.Room, people_count: int) -> str {
    if people_count > room.capacity {
        return "error: room " + room.name + " holds " + str(room.capacity) + ", meeting has " + str(people_count);
    }
    return "";
}

# The first clash for a meeting of `people` in `room` from start to end, or "".
# Times in messages are shown with `offset` (the organizer's zone).
export fn placement_error(cal: model.Calendar, room: str, people: list[str], start: int, end: int, skip: str, offset: int) -> str {
    match room_clash(cal, room, start, end, skip) {
        case some(m) {
            return clash_text("room " + room, m, offset);
        }
        case none {
        }
    }
    for name in people {
        let e = person_error(cal, name, start, end, skip, offset);
        if e != "" {
            return e;
        }
    }
    return "";
}
