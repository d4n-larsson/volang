import model;

fn spaces(n: int) -> str {
    var out = "";
    for _ in 0..n {
        set out = out + " ";
    }
    return out;
}

export fn pad_right(s: str, width: int) -> str {
    return s + spaces(width - len(s));
}

export fn pad_left(s: str, width: int) -> str {
    return spaces(width - len(s)) + s;
}

# Columns separated by two spaces; the first column left-aligned, the others right-aligned.
export fn table(header: list[str], rows: list[list[str]]) -> list[str] {
    let widths = map(header, fn(h) => len(h));
    for row in rows {
        for i, cell in row {
            set widths[i] = max(widths[i], len(cell));
        }
    }
    let all_rows = [header];
    for row in rows {
        push(all_rows, row);
    }
    let out = new list[str];
    for row in all_rows {
        let cells = [pad_right(row[0], widths[0])];
        for i in 1..len(row) {
            push(cells, pad_left(row[i], widths[i]));
        }
        push(out, join(cells, "  "));
    }
    return out;
}

export fn dep_text(dep: model.Dep) -> str {
    if dep.lag > 0 {
        return dep.pred + "+" + str(dep.lag);
    }
    return dep.pred;
}

export fn id_list(ids: list[str]) -> str {
    if len(ids) == 0 {
        return "-";
    }
    return join(ids, ", ");
}

# part * 100 / whole rounded down, as text; `-` when whole is 0.
export fn percent(part: int, whole: int) -> str {
    if whole == 0 {
        return "-";
    }
    return str(part * 100 / whole) + "%";
}
