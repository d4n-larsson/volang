# Fibonacci numbers and a small table
func fib(n)
    if n < 2
        return n
    end
    return fib(n - 1) + fib(n - 2)
end

func describe(n)
    if n % 15 == 0
        return "fizzbuzz"
    elif n % 5 == 0
        return "buzz"
    elif n % 3 == 0
        return "fizz"
    else
        return str(n)
    end
end

let i = 1
while i <= 12
    print i, fib(i), describe(i)
    set i = i + 1
end
print "done", i > 12, i * -2
