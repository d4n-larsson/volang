# The cells of the sheet. A cell holds a number or a formula; a cell that holds nothing is empty.
import cells;
import formula;

export variant Content {
    number(int);
    formula(formula.Node);
}

export record Sheet {
    cells: map[cells.Pos, Content];
}

export fn new_sheet() -> Sheet {
    return new Sheet { cells: new map[cells.Pos, Content] };
}

export fn is_empty(s: Sheet, p: cells.Pos) -> bool {
    return not has(s.cells, p);
}

# The content of a cell that is not empty.
export fn content(s: Sheet, p: cells.Pos) -> Content {
    return s.cells[p];
}

export fn put(s: Sheet, p: cells.Pos, c: Content) {
    set s.cells[p] = c;
}

export fn clear(s: Sheet, p: cells.Pos) {
    remove(s.cells, p);
}

# The non-empty cells, sorted.
export fn filled(s: Sheet) -> list[cells.Pos] {
    return cells.sorted_cells(keys(s.cells));
}

export fn is_formula(c: Content) -> bool {
    match c {
        case number(_) {
            return false;
        }
        case formula(_) {
            return true;
        }
    }
}

export fn formula_cells(s: Sheet) -> list[cells.Pos] {
    return filter(filled(s), fn(p) => is_formula(s.cells[p]));
}
