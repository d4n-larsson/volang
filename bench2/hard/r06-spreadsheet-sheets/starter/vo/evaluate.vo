# Values of cells and formulas. A value has an error ("" or #DIV0, #CYCLE or #REF) or a number.
#
# A formula's value is the first error met when evaluating it left to right (a function's range row by
# row, left to right), else its number. An empty cell counts as 0; SUM adds the range's cells, MIN and
# MAX skip its empty cells (0 when all are empty). Division truncates toward zero.
import cells;
import formula;
import sheet;

export record Value {
    error: str;
    number: int;
}

fn number(n: int) -> Value {
    return new Value { error: "", number: n };
}

fn failure(e: str) -> Value {
    return new Value { error: e, number: 0 };
}

export fn value_text(v: Value) -> str {
    if v.error != "" {
        return v.error;
    }
    return str(v.number);
}

fn divide(a: int, b: int) -> int {
    let q = abs(a) / abs(b);
    if (a < 0) != (b < 0) {
        return -q;
    }
    return q;
}

# The value of a cell. `active` holds the cells being evaluated: meeting one again is a cycle.
fn cell_value(s: sheet.Sheet, p: cells.Pos, active: map[cells.Pos, bool]) -> Value {
    if sheet.is_empty(s, p) {
        return number(0);
    }
    match sheet.content(s, p) {
        case number(n) {
            return number(n);
        }
        case formula(node) {
            if has(active, p) {
                return failure("#CYCLE");
            }
            set active[p] = true;
            let v = node_value(s, node, active);
            remove(active, p);
            return v;
        }
    }
}

fn func_value(s: sheet.Sheet, name: str, area: cells.Area, active: map[cells.Pos, bool]) -> Value {
    var total = 0;
    var best = 0;
    var seen = false;
    for p in cells.range_cells(area) {
        if sheet.is_empty(s, p) {
            continue;
        }
        let v = cell_value(s, p, active);
        if v.error != "" {
            return v;
        }
        set total = total + v.number;
        if not seen or (name == "MIN" and v.number < best) or (name == "MAX" and v.number > best) {
            set best = v.number;
        }
        set seen = true;
    }
    if name == "SUM" {
        return number(total);
    }
    return number(best);
}

fn bin_value(op: str, a: int, b: int) -> Value {
    if op == "+" {
        return number(a + b);
    }
    if op == "-" {
        return number(a - b);
    }
    if op == "*" {
        return number(a * b);
    }
    if b == 0 {
        return failure("#DIV0");
    }
    return number(divide(a, b));
}

fn node_value(s: sheet.Sheet, node: formula.Node, active: map[cells.Pos, bool]) -> Value {
    match node {
        case num(n) {
            return number(n);
        }
        case cell_ref(r) {
            return cell_value(s, new cells.Pos { col: r.col, row: r.row }, active);
        }
        case func(f) {
            return func_value(s, f.name, formula.range_of(f.first, f.last), active);
        }
        case lost_func(_) {
            return failure("#REF");
        }
        case bin(b) {
            let left = node_value(s, b.left, active);
            if left.error != "" {
                return left;
            }
            let right = node_value(s, b.right, active);
            if right.error != "" {
                return right;
            }
            return bin_value(b.op, left.number, right.number);
        }
        case neg(inner) {
            let v = node_value(s, inner, active);
            if v.error != "" {
                return v;
            }
            return number(-v.number);
        }
        case paren(inner) {
            return node_value(s, inner, active);
        }
        case bad_ref {
            return failure("#REF");
        }
    }
}

export fn value_of(s: sheet.Sheet, p: cells.Pos) -> Value {
    return cell_value(s, p, new map[cells.Pos, bool]);
}

export fn formula_value(s: sheet.Sheet, node: formula.Node) -> Value {
    return node_value(s, node, new map[cells.Pos, bool]);
}
