import ledger;
import parsing;
import reports;

fn main() uses console, input {
    let led = ledger.new_ledger();
    let out = new list[str];
    for n, line in split(read_all(), "\n") {
        match parsing.parse(line) {
            case blank {
            }
            case invalid {
                push(out, "line " + str(n + 1) + ": invalid");
            }
            case command(c) {
                if c.name == "statement" {
                    reports.statement(led, c.id, out);
                } else if c.name == "aging" {
                    reports.aging(led, out);
                } else {
                    ledger.run(led, c, out);
                }
            }
        }
    }
    reports.final_list(led, out);
    for s in out {
        print(s);
    }
}
