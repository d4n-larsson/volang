# Opening, closing and renaming accounts, and their balances.
import model;
import parse;
import rates;
import std.text;

export fn native_balance(account: model.Account) -> int {
    var total = 0;
    for p in account.postings {
        set total = total + p.amount;
    }
    return total;
}

# The accounts named `name` or below it (`name:...`), in byte order of their names.
export fn covered(ledger: model.Ledger, name: str) -> list[model.Account] {
    let names = keys(ledger.accounts);
    sort(names);
    let picked = filter(names, fn(n) => n == name or text.starts_with(n, name + ":"));
    return map(picked, fn(n) => ledger.accounts[n]);
}

# The account's base value at the rates of its postings.
export fn book_balance(account: model.Account) -> int {
    var total = 0;
    for p in account.postings {
        set total = total + p.base;
    }
    return total;
}

# The account's balance in base cents at the latest rate of its currency.
export fn current_value(ledger: model.Ledger, account: model.Account) -> int {
    let bal = native_balance(account);
    if account.currency == model.base_currency {
        return bal;
    }
    return rates.to_base(bal, rates.latest_rate(ledger, account.currency));
}

export fn subtree_total(ledger: model.Ledger, name: str) -> int {
    var total = 0;
    for a in covered(ledger, name) {
        set total = total + current_value(ledger, a);
    }
    return total;
}

# The native totals of the foreign currencies below name: non-zero ones, by code.
export fn subtree_currencies(ledger: model.Ledger, name: str) -> map[str, int] {
    let totals = new ordered_map[str, int];
    for a in covered(ledger, name) {
        if a.currency != model.base_currency {
            set totals[a.currency] = get_or(totals, a.currency, 0) + native_balance(a);
        }
    }
    let out = new map[str, int];
    for c, t in totals {
        if t != 0 {
            set out[c] = t;
        }
    }
    return out;
}

export fn open_account(ledger: model.Ledger, name: str, kind: str, currency: str) -> str {
    if not parse.valid_account_name(name) {
        return "error: bad account name " + name;
    }
    if not parse.valid_type(kind) {
        return "error: bad type " + kind;
    }
    if not parse.valid_currency(currency) {
        return "error: bad currency " + currency;
    }
    if has(ledger.accounts, name) {
        return "error: account " + name + " exists";
    }
    set ledger.accounts[name] = model.new_account(name, kind, currency);
    if currency == model.base_currency {
        return "opened " + name + " (" + kind + ")";
    }
    return "opened " + name + " (" + kind + ", " + currency + ")";
}

export fn close_account(ledger: model.Ledger, name: str) -> str {
    if not has(ledger.accounts, name) {
        return "error: unknown account " + name;
    }
    let a = ledger.accounts[name];
    if a.closed {
        return "error: account " + name + " is closed";
    }
    let bal = native_balance(a);
    if bal != 0 {
        return "error: account " + name + " has balance " + rates.native_text(bal, a.currency);
    }
    set a.closed = true;
    return "closed " + name;
}

export fn rename_account(ledger: model.Ledger, old: str, new_name: str) -> str {
    if not has(ledger.accounts, old) {
        return "error: unknown account " + old;
    }
    if not parse.valid_account_name(new_name) {
        return "error: bad account name " + new_name;
    }
    if has(ledger.accounts, new_name) {
        return "error: account " + new_name + " exists";
    }
    let a = ledger.accounts[old];
    remove(ledger.accounts, old);
    set a.name = new_name;
    set ledger.accounts[new_name] = a;
    return "renamed " + old + " to " + new_name;
}
