import accounts;
import journal;
import model;
import parse;
import rates;
import reports;

fn bad() -> list[str] {
    return ["error: bad command"];
}

fn two_days(a: list[str]) -> bool {
    return len(a) == 2 and parse.is_number(a[0]) and parse.is_number(a[1]);
}

fn run_accounts(ledger: model.Ledger, cmd: str, a: list[str]) -> list[str] {
    if cmd == "open" {
        if len(a) != 2 and len(a) != 3 {
            return bad();
        }
        var currency = model.base_currency;
        if len(a) == 3 {
            set currency = a[2];
        }
        return [accounts.open_account(ledger, a[0], a[1], currency)];
    }
    if cmd == "close" {
        if len(a) != 1 {
            return bad();
        }
        return [accounts.close_account(ledger, a[0])];
    }
    if len(a) != 2 {
        return bad();
    }
    return [accounts.rename_account(ledger, a[0], a[1])];
}

fn run_journal(ledger: model.Ledger, cmd: str, a: list[str]) -> list[str] {
    if cmd == "post" {
        if len(a) < 5 or not parse.is_number(a[1]) {
            return bad();
        }
        return [journal.post(ledger, a[0], parse.digits_value(a[1]), a[2], slice(a, 3, len(a)))];
    }
    if cmd == "void" {
        if len(a) != 2 or not parse.is_number(a[1]) {
            return bad();
        }
        return [journal.void_txn(ledger, a[0], parse.digits_value(a[1]))];
    }
    if cmd == "show" {
        if len(a) != 1 {
            return bad();
        }
        return journal.show(ledger, a[0]);
    }
    if len(a) != 1 or not parse.is_number(a[0]) {
        return bad();
    }
    return [journal.lock(ledger, parse.digits_value(a[0]))];
}

fn run_reports(ledger: model.Ledger, cmd: str, a: list[str]) -> list[str] {
    if cmd == "balance" or cmd == "statement" {
        if len(a) != 1 {
            return bad();
        }
        if cmd == "balance" {
            return reports.balance_lines(ledger, a[0]);
        }
        return reports.statement_lines(ledger, a[0]);
    }
    if cmd == "income" or cmd == "journal" {
        if not two_days(a) {
            return bad();
        }
        if cmd == "income" {
            return reports.income_lines(ledger, parse.digits_value(a[0]), parse.digits_value(a[1]));
        }
        return reports.journal_lines(ledger, parse.digits_value(a[0]), parse.digits_value(a[1]));
    }
    if len(a) != 0 {
        return bad();
    }
    if cmd == "trial" {
        return reports.trial_lines(ledger);
    }
    if cmd == "accounts" {
        return reports.account_lines(ledger);
    }
    return reports.tree_lines(ledger);
}

fn run_rates(ledger: model.Ledger, cmd: str, a: list[str]) -> list[str] {
    if cmd == "revalue" {
        if len(a) != 1 or not parse.is_number(a[0]) {
            return bad();
        }
        return reports.revalue_lines(ledger, parse.digits_value(a[0]));
    }
    if len(a) != 3 or not parse.is_number(a[1]) {
        return bad();
    }
    match parse.parse_rate(a[2]) {
        case ok(rate) {
            if rate == 0 {
                return bad();
            }
            if not parse.valid_currency(a[0]) {
                return ["error: bad currency " + a[0]];
            }
            return [rates.set_rate(ledger, a[0], parse.digits_value(a[1]), rate)];
        }
        case err(_) {
            return bad();
        }
    }
}

fn run(ledger: model.Ledger, words: list[str]) -> list[str] {
    let cmd = words[0];
    let a = slice(words, 1, len(words));
    if cmd == "open" or cmd == "close" or cmd == "rename" {
        return run_accounts(ledger, cmd, a);
    }
    if cmd == "post" or cmd == "void" or cmd == "show" or cmd == "lock" {
        return run_journal(ledger, cmd, a);
    }
    if cmd == "balance" or cmd == "statement" or cmd == "trial" or cmd == "income" or cmd == "journal" or cmd == "accounts" or cmd == "tree" {
        return run_reports(ledger, cmd, a);
    }
    if cmd == "rate" or cmd == "revalue" {
        return run_rates(ledger, cmd, a);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let ledger = model.new_ledger();
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w) => w != "");
        if len(words) == 0 {
            continue;
        }
        for out in run(ledger, words) {
            print(out);
        }
    }
}
