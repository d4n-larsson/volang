# Cents as X.YY (amounts are never negative).
export fn money(cents: int) -> str {
    var frac = str(cents % 100);
    if len(frac) < 2 {
        set frac = "0" + frac;
    }
    return str(cents / 100) + "." + frac;
}

export fn pad_right(text: str, width: int) -> str {
    var out = text;
    while len(out) < width {
        set out = out + " ";
    }
    return out;
}

export fn pad_left(text: str, width: int) -> str {
    var out = text;
    while len(out) < width {
        set out = " " + out;
    }
    return out;
}

# A movement quantity with its sign: +5, -3.
export fn signed(n: int) -> str {
    if n >= 0 {
        return "+" + str(n);
    }
    return str(n);
}

export fn plural(n: int, word: str) -> str {
    if n == 1 {
        return str(n) + " " + word;
    }
    return str(n) + " " + word + "s";
}
