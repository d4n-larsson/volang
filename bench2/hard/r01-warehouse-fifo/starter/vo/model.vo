# The records shared by every module.
export record Item {
    sku: str;
    name: str;
    # standard unit cost in cents
    cost: int;
    # reorder point; 0 means none
    reorder: int;
}

export record OrderLine {
    sku: str;
    qty: int;
}

export record Order {
    order_id: str;
    wh: str;
    lines: list[OrderLine];
    # open, fulfilled or cancelled
    status: str;
}

# One stock movement: delta is positive for stock coming in.
export record Move {
    seq: int;
    kind: str;
    wh: str;
    sku: str;
    delta: int;
    note: str;
}

export record State {
    items: map[str, Item];
    # warehouse code -> sku -> quantity
    stock: map[str, map[str, int]];
    # in creation order
    orders: map[str, Order];
    # in sequence order
    moves: list[Move];
    next_seq: int;
    shipments: int;
    shipped_units: int;
}

export fn new_state() -> State {
    return new State {
        items: new map[str, Item],
        stock: new map[str, map[str, int]],
        orders: new map[str, Order],
        moves: new list[Move],
        next_seq: 1,
        shipments: 0,
        shipped_units: 0
    };
}
