# Stock movements: receipts, shipments, transfers and adjustments, and their history.
import catalog;
import fmt;
import model;
import parse;
import stock;

export fn record_move(state: model.State, kind: str, wh: str, sku: str, delta: int, note: str, lot: int, amount: int) {
    push(state.moves, new model.Move { seq: state.next_seq, kind: kind, wh: wh, sku: sku, delta: delta, note: note, lot: lot, amount: amount });
    set state.next_seq = state.next_seq + 1;
}

fn lot_text(lot: int, cost: int) -> str {
    return "lot " + str(lot) + " at " + fmt.money(cost);
}

fn cost_text(cost: int) -> str {
    return "cost " + fmt.money(cost);
}

# The error for an unknown warehouse or item, or "".
fn check_place(state: model.State, wh: str, sku: str) -> str {
    if not has(state.stock, wh) {
        return catalog.unknown_warehouse(wh);
    }
    if not has(state.items, sku) {
        return catalog.unknown_item(sku);
    }
    return "";
}

# cost -1: the item's standard cost.
export fn receive(state: model.State, wh: str, sku: str, qty: int, cost: int) -> str {
    let problem = check_place(state, wh, sku);
    if problem != "" {
        return problem;
    }
    var unit = cost;
    if unit < 0 {
        set unit = state.items[sku].cost;
    }
    let lot = stock.new_lot(state, wh, sku, qty, unit);
    record_move(state, "receive", wh, sku, qty, "", lot, unit);
    return "received " + str(qty) + " " + sku + " into " + wh + ", now " + str(stock.on_hand(state, wh, sku)) + ", " + lot_text(lot, unit);
}

export fn ship(state: model.State, wh: str, sku: str, qty: int) -> str {
    let problem = check_place(state, wh, sku);
    if problem != "" {
        return problem;
    }
    if stock.on_hand(state, wh, sku) < qty {
        return stock.short_message(state, wh, sku);
    }
    let cost = stock.cost_of(stock.take(state, wh, sku, qty));
    record_move(state, "ship", wh, sku, -qty, "", 0, cost);
    set state.shipments = state.shipments + 1;
    set state.shipped_units = state.shipped_units + qty;
    set state.shipped_cost = state.shipped_cost + cost;
    return "shipped " + str(qty) + " " + sku + " from " + wh + ", now " + str(stock.on_hand(state, wh, sku)) + ", " + cost_text(cost);
}

export fn transfer(state: model.State, src: str, dst: str, sku: str, qty: int) -> str {
    if not has(state.stock, src) {
        return catalog.unknown_warehouse(src);
    }
    if not has(state.stock, dst) {
        return catalog.unknown_warehouse(dst);
    }
    if src == dst {
        return "error: same warehouse " + src;
    }
    if not has(state.items, sku) {
        return catalog.unknown_item(sku);
    }
    if stock.on_hand(state, src, sku) < qty {
        return stock.short_message(state, src, sku);
    }
    let pieces = stock.take(state, src, sku, qty);
    for p in pieces {
        stock.place(state, dst, sku, p.receipt, p.qty, p.cost);
    }
    let cost = stock.cost_of(pieces);
    record_move(state, "transfer-out", src, sku, -qty, "to " + dst, 0, cost);
    record_move(state, "transfer-in", dst, sku, qty, "from " + src, 0, cost);
    return "transferred " + str(qty) + " " + sku + " from " + src + " to " + dst + ", " + cost_text(cost);
}

# Applies a checked adjustment of delta units (not 0); returns what it adds to the message.
fn change(state: model.State, wh: str, sku: str, delta: int, reason: str) -> str {
    if delta > 0 {
        let unit = state.items[sku].cost;
        let lot = stock.new_lot(state, wh, sku, delta, unit);
        record_move(state, "adjust", wh, sku, delta, reason, lot, unit);
        return lot_text(lot, unit);
    }
    let cost = stock.cost_of(stock.take(state, wh, sku, -delta));
    record_move(state, "adjust", wh, sku, delta, reason, 0, cost);
    return cost_text(cost);
}

export fn adjust(state: model.State, wh: str, sku: str, delta: int, reason: str) -> str {
    let problem = check_place(state, wh, sku);
    if problem != "" {
        return problem;
    }
    if not parse.is_reason(reason) {
        return "error: unknown reason " + reason;
    }
    if delta < 0 and stock.on_hand(state, wh, sku) < -delta {
        return stock.short_message(state, wh, sku);
    }
    let extra = change(state, wh, sku, delta, reason);
    return "adjusted " + sku + " in " + wh + " by " + fmt.signed(delta) + " (" + reason + "), now " + str(stock.on_hand(state, wh, sku)) + ", " + extra;
}

# A stock-take: the shelf holds qty units, adjusted with reason `count`.
export fn count(state: model.State, wh: str, sku: str, qty: int) -> str {
    let problem = check_place(state, wh, sku);
    if problem != "" {
        return problem;
    }
    let was = stock.on_hand(state, wh, sku);
    if was == qty {
        return "counted " + sku + " in " + wh + ": no change";
    }
    let extra = change(state, wh, sku, qty - was, "count");
    return "counted " + sku + " in " + wh + ": was " + str(was) + ", now " + str(qty) + ", " + extra;
}

fn history_line(m: model.Move) -> str {
    var line = "#" + str(m.seq) + " " + m.kind + " " + m.wh + " " + fmt.signed(m.delta);
    if m.note != "" {
        set line = line + " (" + m.note + ")";
    }
    if m.lot > 0 {
        return line + " " + lot_text(m.lot, m.amount);
    }
    return line + " " + cost_text(m.amount);
}

export fn history(state: model.State, sku: str) -> list[str] {
    if not has(state.items, sku) {
        return [catalog.unknown_item(sku)];
    }
    let out = map(filter(state.moves, fn(m) => m.sku == sku), history_line);
    if len(out) == 0 {
        return ["no movements for " + sku];
    }
    return out;
}

export fn lot_lines(state: model.State, wh: str, sku: str) -> list[str] {
    let problem = check_place(state, wh, sku);
    if problem != "" {
        return [problem];
    }
    let row = stock.lots(state, wh, sku);
    if len(row) == 0 {
        return ["no lots of " + sku + " in " + wh];
    }
    let out = map(row, fn(lot) => "lot " + str(lot.receipt) + ": " + str(lot.qty) + " x " + fmt.money(lot.cost) + " = " + fmt.money(lot.qty * lot.cost));
    push(out, "total " + fmt.plural(stock.on_hand(state, wh, sku), "unit") + " = " + fmt.money(stock.cost_of(row)));
    return out;
}
