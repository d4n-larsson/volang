# Reports about teams and matches: form, head to head, goals, streaks, records, summary.
import fmt;
import model;
import results;
import standings;
import teams;

export fn form_line(league: model.League, name: str) -> list[str] {
    let e = teams.playable_error(league, name);
    if e != "" {
        return [e];
    }
    let all_games = results.matches_of(league, name);
    let recent = slice(all_games, max(0, len(all_games) - 5), len(all_games));
    var letters = join(map(recent, fn(m) => results.outcome(m, name)), "");
    if letters == "" {
        set letters = "-";
    }
    return ["form " + name + ": " + letters];
}

export fn h2h_lines(league: model.League, a: str, b: str) -> list[str] {
    for name in [a, b] {
        let e = teams.known_error(league, name);
        if e != "" {
            return [e];
        }
    }
    if a == b {
        return ["error: team cannot play itself"];
    }
    let games = filter(results.active_matches(league), fn(m) => results.involves(m, a) and results.involves(m, b));
    if len(games) == 0 {
        return ["no matches between " + a + " and " + b];
    }
    let out = map(games, fmt.match_line);
    let a_wins = len(filter(games, fn(m) => results.outcome(m, a) == "W"));
    let b_wins = len(filter(games, fn(m) => results.outcome(m, b) == "W"));
    let draws = len(games) - a_wins - b_wins;
    push(out, a + " " + str(a_wins) + " wins, " + b + " " + str(b_wins) + " wins, " + str(draws) + " draws");
    return out;
}

# The row with the highest (or lowest) value; the first name in byte order on a tie.
fn best_team(rows: list[model.Row], value: fn(model.Row) -> int, lowest: bool) -> model.Row {
    let by_name = slice(rows, 0, len(rows));
    sort_by(by_name, fn(r) => r.name);
    var best = by_name[0];
    for r in by_name {
        if (lowest and value(r) < value(best)) or (not lowest and value(r) > value(best)) {
            set best = r;
        }
    }
    return best;
}

export fn goal_lines(league: model.League) -> list[str] {
    let games = results.active_matches(league);
    if len(games) == 0 {
        return ["no matches"];
    }
    let rows = standings.build_rows(teams.active_names(league), games);
    let top = best_team(rows, fn(r) => r.gf, false);
    let tight = best_team(rows, fn(r) => r.ga, true);
    var biggest = games[0];
    var total = 0;
    for m in games {
        set total = total + m.hg + m.ag;
        if m.hg + m.ag > biggest.hg + biggest.ag {
            set biggest = m;
        }
    }
    return [
        "most scored: " + top.name + " " + str(top.gf),
        "fewest conceded: " + tight.name + " " + str(tight.ga),
        "highest scoring match: " + fmt.match_line(biggest) + " (" + str(biggest.hg + biggest.ag) + " goals)",
        "total: " + str(total) + " goals in " + str(len(games)) + " matches"
    ];
}

fn longest_run(league: model.League, name: str) -> int {
    var best = 0;
    var run = 0;
    for m in results.matches_of(league, name) {
        if results.outcome(m, name) == "W" {
            set run = run + 1;
            set best = max(best, run);
        } else {
            set run = 0;
        }
    }
    return best;
}

export fn streak_line(league: model.League) -> list[str] {
    let names = teams.active_names(league);
    sort(names);
    var best = 0;
    for name in names {
        set best = max(best, longest_run(league, name));
    }
    if best == 0 {
        return ["no wins yet"];
    }
    let top = best;
    let leaders = filter(names, fn(name) => longest_run(league, name) == top);
    return ["longest winning streak " + str(best) + ": " + fmt.name_list(leaders)];
}

fn split_record(league: model.League, name: str, at_home: bool) -> str {
    var w = 0;
    var d = 0;
    var l = 0;
    for m in results.matches_of(league, name) {
        if (m.home == name) != at_home {
            continue;
        }
        let o = results.outcome(m, name);
        if o == "W" {
            set w = w + 1;
        } else if o == "D" {
            set d = d + 1;
        } else {
            set l = l + 1;
        }
    }
    return str(w) + "-" + str(d) + "-" + str(l);
}

export fn record_lines(league: model.League, name: str) -> list[str] {
    let e = teams.playable_error(league, name);
    if e != "" {
        return [e];
    }
    let rows = standings.standings(league);
    let r = rows[standings.find_row(rows, name)];
    return [
        name + ": P " + str(r.played) + ", W " + str(r.won) + ", D " + str(r.drawn) + ", L " + str(r.lost) + ", GF " + str(r.gf) + ", GA " + str(r.ga) + ", GD " + fmt.signed(model.gd(r)) + ", Pts " + str(model.points(r)),
        "home " + split_record(league, name, true) + ", away " + split_record(league, name, false),
        "position " + str(r.rank) + " of " + str(len(rows))
    ];
}

export fn summary_lines(league: model.League) -> list[str] {
    let games = results.active_matches(league);
    let withdrawn = len(league.teams) - len(teams.active_teams(league));
    let goals = fold(games, 0, fn(acc, m) => acc + m.hg + m.ag);
    let home = len(filter(games, fn(m) => m.hg > m.ag));
    let away = len(filter(games, fn(m) => m.hg < m.ag));
    return [
        "teams " + str(len(league.teams)) + " (" + str(withdrawn) + " withdrawn), matches " + str(len(games)) + ", goals " + str(goals),
        "home wins " + str(home) + ", draws " + str(len(games) - home - away) + ", away wins " + str(away)
    ];
}
