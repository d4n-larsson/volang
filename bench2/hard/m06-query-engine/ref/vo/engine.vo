import syntax;

export record Table {
    name: str;
    cols: list[syntax.ColDef];
    rows: list[list[syntax.Value]];
}

record Src {
    table: str;
    name: str;
    ty: str;
}

record Scope {
    source: list[Src];
    grouped: bool;
    group_idx: map[int, bool];
}

# The rows an expression is evaluated on: one combined row, or a group of them.
record Ctx {
    rows: list[list[syntax.Value]];
}

export record Result {
    headers: list[str];
    types: list[str];
    rows: list[list[syntax.Value]];
}

fn col_text(c: syntax.Col) -> str {
    if c.table == "" {
        return c.name;
    }
    return c.table + "." + c.name;
}

export fn item_text(o: syntax.Operand) -> str {
    match o {
        case col(c) {
            return col_text(c);
        }
        case agg(a) {
            if a.star {
                return a.func + "(*)";
            }
            return a.func + "(" + col_text(a.arg) + ")";
        }
        case lit(_) {
            return "";
        }
    }
}

fn lit_type(v: syntax.Value) -> str {
    match v {
        case null {
            return "";
        }
        case num(_) {
            return "int";
        }
        case txt(_) {
            return "text";
        }
    }
}

fn scope(tables: list[Table], grouped: bool) -> Scope {
    let source = new list[Src];
    for t in tables {
        for c in t.cols {
            push(source, new Src { table: t.name, name: c.name, ty: c.ty });
        }
    }
    return new Scope { source: source, grouped: grouped, group_idx: new map[int, bool] };
}

fn find_col(sc: Scope, c: syntax.Col) -> result[int] {
    var hit = -1;
    var hits = 0;
    for i, s in sc.source {
        if s.name == c.name and (c.table == "" or c.table == s.table) {
            if hit < 0 {
                set hit = i;
            }
            set hits = hits + 1;
        }
    }
    if hits > 1 {
        return err("ambiguous column " + c.name);
    }
    if hits == 0 {
        return err("unknown column " + col_text(c));
    }
    return ok(hit);
}

fn resolve(sc: Scope, c: syntax.Col) -> result[str] {
    set c.index = try find_col(sc, c);
    return ok(sc.source[c.index].ty);
}

fn check_operand(sc: Scope, o: syntax.Operand, part: str) -> result[str] {
    match o {
        case lit(v) {
            return ok(lit_type(v));
        }
        case col(c) {
            let ty = try resolve(sc, c);
            if sc.grouped and (part == "select" or part == "having" or part == "order") and not has(sc.group_idx, c.index) {
                return err("column " + col_text(c) + " must be grouped");
            }
            return ok(ty);
        }
        case agg(a) {
            if part == "where" {
                return err("aggregate in where");
            }
            if a.star {
                return ok("int");
            }
            let ty = try resolve(sc, a.arg);
            if a.func == "sum" and ty != "int" {
                return err("sum needs an int column");
            }
            if a.func == "count" or a.func == "sum" {
                return ok("int");
            }
            return ok(ty);
        }
    }
}

fn check_expr(sc: Scope, e: syntax.Expr, part: str) -> result[void] {
    match e {
        case always {
        }
        case cmp(c) {
            let ta = try check_operand(sc, c.a, part);
            let tb = try check_operand(sc, c.b, part);
            if ta != "" and tb != "" and ta != tb {
                return err("type mismatch in comparison");
            }
        }
        case isnull(n) {
            let _ = try check_operand(sc, n.a, part);
        }
        case negate(x) {
            try check_expr(sc, x, part);
        }
        case both(x) {
            try check_expr(sc, x.a, part);
            try check_expr(sc, x.b, part);
        }
        case either(x) {
            try check_expr(sc, x.a, part);
            try check_expr(sc, x.b, part);
        }
    }
    return ok();
}

fn is_agg(o: syntax.Operand) -> bool {
    match o {
        case agg(_) {
            return true;
        }
        case col(_) {
            return false;
        }
        case lit(_) {
            return false;
        }
    }
}

fn has_agg(e: syntax.Expr) -> bool {
    match e {
        case always {
            return false;
        }
        case cmp(c) {
            return is_agg(c.a) or is_agg(c.b);
        }
        case isnull(n) {
            return is_agg(n.a);
        }
        case negate(x) {
            return has_agg(x);
        }
        case both(x) {
            return has_agg(x.a) or has_agg(x.b);
        }
        case either(x) {
            return has_agg(x.a) or has_agg(x.b);
        }
    }
}

export fn table(db: map[str, Table], name: str) -> result[Table] {
    if not has(db, name) {
        return err("unknown table " + name);
    }
    return ok(db[name]);
}

fn check_select(db: map[str, Table], s: syntax.Stmt) -> result[Scope] {
    let tables = [try table(db, s.table)];
    if s.join != "" {
        push(tables, try table(db, s.join));
        if s.join == s.table {
            return err("duplicate table " + s.join);
        }
    }
    let grouped = s.has_group or any(s.items, is_agg) or has_agg(s.having) or any(s.order, fn(k) => is_agg(k.op));
    let sc = scope(tables, grouped);
    for c in s.group {
        match find_col(sc, c) {
            case ok(i) {
                set sc.group_idx[i] = true;
            }
            case err(_) {
            }
        }
    }
    if s.star and grouped {
        return err("* with grouping");
    }
    for it in s.items {
        let _ = try check_operand(sc, it, "select");
    }
    try check_expr(sc, s.on, "on");
    try check_expr(sc, s.where, "where");
    for c in s.group {
        let _ = try resolve(sc, c);
    }
    if s.has_having {
        if not grouped {
            return err("having without grouping");
        }
        try check_expr(sc, s.having, "having");
    }
    for k in s.order {
        let _ = try check_operand(sc, k.op, "order");
    }
    return ok(sc);
}

# ---- evaluation ----

# -1, 0 or 1; NULL is smallest.
export fn compare(a: syntax.Value, b: syntax.Value) -> int {
    match a {
        case null {
            if b == syntax.Value.null {
                return 0;
            }
            return -1;
        }
        case num(x) {
            match b {
                case null {
                    return 1;
                }
                case num(y) {
                    return sign_of(x, y);
                }
                case txt(_) {
                    return -1;
                }
            }
        }
        case txt(x) {
            match b {
                case null {
                    return 1;
                }
                case num(_) {
                    return 1;
                }
                case txt(y) {
                    if x < y {
                        return -1;
                    }
                    if x > y {
                        return 1;
                    }
                    return 0;
                }
            }
        }
    }
}

fn sign_of(x: int, y: int) -> int {
    if x < y {
        return -1;
    }
    if x > y {
        return 1;
    }
    return 0;
}

fn aggregate(a: syntax.Agg, rows: list[list[syntax.Value]]) -> syntax.Value {
    if a.star {
        return syntax.Value.num(len(rows));
    }
    let vals = filter(map(rows, fn(r) => r[a.arg.index]), fn(v) => v != syntax.Value.null);
    if a.func == "count" {
        return syntax.Value.num(len(vals));
    }
    if len(vals) == 0 {
        return syntax.Value.null;
    }
    var acc = vals[0];
    for v in slice(vals, 1, len(vals)) {
        if a.func == "sum" {
            set acc = syntax.Value.num(num_of(acc) + num_of(v));
        } else if a.func == "min" and compare(v, acc) < 0 {
            set acc = v;
        } else if a.func == "max" and compare(v, acc) > 0 {
            set acc = v;
        }
    }
    return acc;
}

fn num_of(v: syntax.Value) -> int {
    match v {
        case num(x) {
            return x;
        }
        case null {
            return 0;
        }
        case txt(_) {
            return 0;
        }
    }
}

fn value(o: syntax.Operand, ctx: Ctx) -> syntax.Value {
    match o {
        case lit(v) {
            return v;
        }
        case agg(a) {
            return aggregate(a, ctx.rows);
        }
        case col(c) {
            return ctx.rows[0][c.index];
        }
    }
}

# 1 true, 0 false, -1 unknown.
fn truth(e: syntax.Expr, ctx: Ctx) -> int {
    match e {
        case always {
            return 1;
        }
        case both(x) {
            let a = truth(x.a, ctx);
            let b = truth(x.b, ctx);
            if a == 0 or b == 0 {
                return 0;
            }
            if a < 0 or b < 0 {
                return -1;
            }
            return 1;
        }
        case either(x) {
            let a = truth(x.a, ctx);
            let b = truth(x.b, ctx);
            if a == 1 or b == 1 {
                return 1;
            }
            if a < 0 or b < 0 {
                return -1;
            }
            return 0;
        }
        case negate(x) {
            let a = truth(x, ctx);
            if a < 0 {
                return -1;
            }
            return 1 - a;
        }
        case isnull(n) {
            let is_null = value(n.a, ctx) == syntax.Value.null;
            if is_null != n.negated {
                return 1;
            }
            return 0;
        }
        case cmp(c) {
            let a = value(c.a, ctx);
            let b = value(c.b, ctx);
            if a == syntax.Value.null or b == syntax.Value.null {
                return -1;
            }
            let r = compare(a, b);
            var holds = false;
            if c.op == "=" {
                set holds = r == 0;
            } else if c.op == "!=" {
                set holds = r != 0;
            } else if c.op == "<" {
                set holds = r < 0;
            } else if c.op == "<=" {
                set holds = r <= 0;
            } else if c.op == ">" {
                set holds = r > 0;
            } else {
                set holds = r >= 0;
            }
            if holds {
                return 1;
            }
            return 0;
        }
    }
}

fn row_ctx(r: list[syntax.Value]) -> Ctx {
    return new Ctx { rows: [r] };
}

fn joined(a: list[syntax.Value], b: list[syntax.Value]) -> list[syntax.Value] {
    let out = slice(a, 0, len(a));
    for v in b {
        push(out, v);
    }
    return out;
}

fn source_rows(db: map[str, Table], s: syntax.Stmt) -> list[list[syntax.Value]] {
    let left = db[s.table].rows;
    if s.join == "" {
        return map(left, fn(r) => slice(r, 0, len(r)));
    }
    let right = db[s.join];
    let nulls = map(right.cols, fn(c) => syntax.Value.null);
    let out = new list[list[syntax.Value]];
    for lr in left {
        var kept = 0;
        for rr in right.rows {
            let row = joined(lr, rr);
            if truth(s.on, row_ctx(row)) == 1 {
                push(out, row);
                set kept = kept + 1;
            }
        }
        if kept == 0 and s.left {
            push(out, joined(lr, nulls));
        }
    }
    return out;
}

fn before(order_keys: list[syntax.Key], x: Ctx, y: Ctx) -> bool {
    for k in order_keys {
        var c = compare(value(k.op, x), value(k.op, y));
        if k.desc {
            set c = -c;
        }
        if c != 0 {
            return c < 0;
        }
    }
    return false;
}

# Stable insertion sort.
fn sorted_ctx(xs: list[Ctx], order_keys: list[syntax.Key]) -> list[Ctx] {
    let out = new list[Ctx];
    for x in xs {
        push(out, x);
        var j = len(out) - 1;
        while j > 0 and before(order_keys, x, out[j - 1]) {
            set out[j] = out[j - 1];
            set j = j - 1;
        }
        set out[j] = x;
    }
    return out;
}

fn groups(s: syntax.Stmt, rows: list[list[syntax.Value]]) -> list[Ctx] {
    if not s.has_group {
        return [new Ctx { rows: rows }];
    }
    let gkeys = new list[list[syntax.Value]];
    let out = new list[Ctx];
    for r in rows {
        let k = map(s.group, fn(c) => r[c.index]);
        var found = -1;
        for i, g in gkeys {
            if g == k {
                set found = i;
                break;
            }
        }
        if found < 0 {
            push(gkeys, k);
            push(out, new Ctx { rows: [r] });
        } else {
            push(out[found].rows, r);
        }
    }
    return out;
}

fn item_type(sc: Scope, o: syntax.Operand) -> str {
    match o {
        case col(c) {
            return sc.source[c.index].ty;
        }
        case agg(a) {
            if a.func == "count" or a.func == "sum" {
                return "int";
            }
            return sc.source[a.arg.index].ty;
        }
        case lit(_) {
            return "";
        }
    }
}

export fn run_select(db: map[str, Table], s: syntax.Stmt) -> result[Result] {
    let sc = try check_select(db, s);
    var ctxs = map(filter(source_rows(db, s), fn(r) => truth(s.where, row_ctx(r)) == 1), row_ctx);
    if sc.grouped {
        let rows = map(ctxs, fn(c) => c.rows[0]);
        set ctxs = filter(groups(s, rows), fn(g) => truth(s.having, g) == 1);
    }
    set ctxs = sorted_ctx(ctxs, s.order);
    var end = len(ctxs);
    if s.has_limit {
        set end = min(end, s.offset + s.limit);
    }
    let start = min(s.offset, len(ctxs));
    set ctxs = slice(ctxs, start, max(start, end));
    let items = slice(s.items, 0, len(s.items));
    if s.star {
        for i, src in sc.source {
            push(items, syntax.Operand.col(new syntax.Col { table: "", name: src.name, index: i }));
        }
    }
    let headers = map(items, item_text);
    let types = map(items, fn(it) => item_type(sc, it));
    let rows = map(ctxs, fn(c) => map(items, fn(it) => value(it, c)));
    return ok(new Result { headers: headers, types: types, rows: rows });
}

export fn run_create(db: map[str, Table], s: syntax.Stmt) -> result[str] {
    if has(db, s.table) {
        return err("table " + s.table + " already exists");
    }
    let seen = new map[str, bool];
    for c in s.cols {
        if has(seen, c.name) {
            return err("duplicate column " + c.name);
        }
        set seen[c.name] = true;
    }
    set db[s.table] = new Table { name: s.table, cols: s.cols, rows: [] };
    return ok("created " + s.table);
}

fn fits(ty: str, v: syntax.Value) -> bool {
    let t = lit_type(v);
    return t == "" or t == ty;
}

export fn run_insert(db: map[str, Table], s: syntax.Stmt) -> result[str] {
    let t = try table(db, s.table);
    for tup in s.tuples {
        if len(tup) != len(t.cols) {
            return err("wrong number of values");
        }
        for i, c in t.cols {
            if not fits(c.ty, tup[i]) {
                return err("type mismatch for column " + c.name);
            }
        }
    }
    for tup in s.tuples {
        push(t.rows, tup);
    }
    return ok("inserted " + str(len(s.tuples)));
}

fn matching(t: Table, s: syntax.Stmt) -> result[list[bool]] {
    let sc = scope([t], false);
    try check_expr(sc, s.where, "where");
    return ok(map(t.rows, fn(r) => truth(s.where, row_ctx(r)) == 1));
}

fn count_true(xs: list[bool]) -> int {
    return len(filter(xs, fn(x) => x));
}

export fn run_delete(db: map[str, Table], s: syntax.Stmt) -> result[str] {
    let t = try table(db, s.table);
    let hits = try matching(t, s);
    let keep = new list[list[syntax.Value]];
    for i, r in t.rows {
        if not hits[i] {
            push(keep, r);
        }
    }
    set t.rows = keep;
    return ok("deleted " + str(count_true(hits)));
}

fn col_index(t: Table, name: str) -> int {
    for i, c in t.cols {
        if c.name == name {
            return i;
        }
    }
    return -1;
}

export fn run_update(db: map[str, Table], s: syntax.Stmt) -> result[str] {
    let t = try table(db, s.table);
    let done = new map[str, bool];
    for a in s.sets {
        let i = col_index(t, a.name);
        if i < 0 {
            return err("unknown column " + a.name);
        }
        if has(done, a.name) {
            return err("duplicate column " + a.name);
        }
        set done[a.name] = true;
        if not fits(t.cols[i].ty, a.value) {
            return err("type mismatch for column " + a.name);
        }
    }
    let hits = try matching(t, s);
    for i, r in t.rows {
        if hits[i] {
            for a in s.sets {
                set r[col_index(t, a.name)] = a.value;
            }
        }
    }
    return ok("updated " + str(count_true(hits)));
}
