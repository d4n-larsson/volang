create table emp (id int, name text, boss int)
create table proj (pid int, owner int, title text)
insert into emp values (1, 'ivy', null), (2, 'jon', 1), (3, 'kai', 1), (4, 'lux', 2)
insert into proj values (10, 3, 'alpha'), (11, 3, 'beta'), (12, 1, 'gamma'), (13, null, 'delta'), (14, 8, 'eps')
select name, title from emp left join proj on id = owner
select name from emp left join proj on id = owner where pid is null
select title, name from proj left join emp on owner = id order by name desc, title
select title, name from proj left join emp on owner = id order by name, title desc limit 3 offset 1
select name, pid from emp left join proj on emp.id = proj.pid
select * from proj left join emp on owner = id where boss = 1 or name is null
