record Row {
    cat: str;
    amount: int;
}

fn main() -> result[void] uses console, input {
    let rows = new list[Row];
    let seen = new map[str, bool];
    let cats = new list[str];
    while true {
        match read_line() {
            case ok(line) {
                let p = split(line, " ");
                push(rows, new Row { cat: p[0], amount: try parse_int(p[1]) });
                if not has(seen, p[0]) {
                    set seen[p[0]] = true;
                    push(cats, p[0]);
                }
            }
            case err(_) {
                break;
            }
        }
    }
    for c in cats {
        let group = filter(rows, fn(r) => r.cat == c);
        let total = fold(group, 0, fn(acc, r) => acc + r.amount);
        let top = fold(group, group[0].amount, fn(acc, r) => max(acc, r.amount));
        print(c + " count=" + str(len(group)) + " total=" + str(total) + " max=" + str(top));
    }
    print("grand " + str(fold(rows, 0, fn(acc, r) => acc + r.amount)));
    return ok();
}
