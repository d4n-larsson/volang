import shop.Shop;
import shop.new_shop;
import money.is_number;
import money.num;
import money.parse_amount;
import cart.add_product;
import cart.set_price;
import cart.add_to_cart;
import cart.remove_from_cart;
import cart.show_cart;
import pricing.set_promo;
import pricing.set_bulk;
import pricing.define_coupon;
import pricing.use_coupon;
import checkout.checkout;
import checkout.report;

fn positive(s: str) -> bool {
    return is_number(s) and num(s) >= 1;
}

fn percent(s: str) -> bool {
    return positive(s) and num(s) <= 100;
}

fn run(words: list[str], shop: Shop) -> list[str] {
    let cmd = words[0];
    let args = slice(words, 1, len(words));
    let bad = ["error: bad command"];
    if cmd == "product" {
        if len(args) != 3 {
            return bad;
        }
        match parse_amount(args[2]) {
            case ok(price) {
                return [add_product(shop, args[0], args[1], price)];
            }
            case err(_) {
                return bad;
            }
        }
    }
    if cmd == "price" {
        if len(args) != 2 {
            return bad;
        }
        match parse_amount(args[1]) {
            case ok(price) {
                return [set_price(shop, args[0], price)];
            }
            case err(_) {
                return bad;
            }
        }
    }
    if cmd == "add" {
        if len(args) != 2 or not positive(args[1]) {
            return bad;
        }
        return [add_to_cart(shop, args[0], num(args[1]))];
    }
    if cmd == "remove" {
        if len(args) != 2 or not positive(args[1]) {
            return bad;
        }
        return [remove_from_cart(shop, args[0], num(args[1]))];
    }
    if cmd == "promo" {
        if len(args) != 2 or not positive(args[1]) {
            return bad;
        }
        return [set_promo(shop, args[0], num(args[1]))];
    }
    if cmd == "bulk" {
        if len(args) != 3 or not positive(args[1]) or not percent(args[2]) {
            return bad;
        }
        return [set_bulk(shop, args[0], num(args[1]), num(args[2]))];
    }
    if cmd == "coupon" {
        if len(args) != 2 or not percent(args[1]) {
            return bad;
        }
        return [define_coupon(shop, args[0], num(args[1]))];
    }
    if cmd == "use" {
        if len(args) != 1 {
            return bad;
        }
        return [use_coupon(shop, args[0])];
    }
    if cmd == "cart" {
        if len(args) != 0 {
            return bad;
        }
        return show_cart(shop);
    }
    if cmd == "checkout" {
        if len(args) != 0 {
            return bad;
        }
        return checkout(shop);
    }
    if cmd == "report" {
        if len(args) != 0 {
            return bad;
        }
        return report(shop);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let shop = new_shop();
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, shop) {
            print(out);
        }
    }
}
