import money;
import shop;

export fn add_product(shop_value: shop.Shop, sku: str, name: str, price: int) -> str {
    if has(shop_value.catalog, sku) {
        return "error: product " + sku + " exists";
    }
    set shop_value.catalog[sku] = new shop.Product { sku: sku, name: name, price: price, sold: 0, net: 0 };
    return "product " + sku + " added";
}

export fn set_price(shop_value: shop.Shop, sku: str, price: int) -> str {
    if not has(shop_value.catalog, sku) {
        return shop.unknown_product(sku);
    }
    let product = shop_value.catalog[sku];
    set product.price = price;
    return "product " + sku + " price " + money.money(price);
}

export fn add_to_cart(shop_value: shop.Shop, sku: str, qty: int) -> str {
    if not has(shop_value.catalog, sku) {
        return shop.unknown_product(sku);
    }
    if not shop.has_line(shop_value, sku) {
        push(shop_value.cart, new shop.Line { sku: sku, qty: 0 });
    }
    let line = shop.find_line(shop_value, sku);
    set line.qty = line.qty + qty;
    return "cart " + sku + " x" + str(line.qty);
}

export fn remove_from_cart(shop_value: shop.Shop, sku: str, qty: int) -> str {
    if not shop.has_line(shop_value, sku) {
        return "error: " + sku + " not in cart";
    }
    let line = shop.find_line(shop_value, sku);
    if qty > line.qty {
        return "error: only " + str(line.qty) + " " + sku + " in cart";
    }
    set line.qty = line.qty - qty;
    if line.qty == 0 {
        set shop_value.cart = filter(shop_value.cart, fn(x: shop.Line) -> bool {
            return x.sku != sku;
        });
        return "cart " + sku + " removed";
    }
    return "cart " + sku + " x" + str(line.qty);
}

export fn show_cart(shop_value: shop.Shop) -> list[str] {
    if len(shop_value.cart) == 0 {
        return ["cart empty"];
    }
    let out = new list[str];
    var units = 0;
    var gross = 0;
    for line in shop_value.cart {
        let price = shop_value.catalog[line.sku].price;
        push(out, line.sku + " x" + str(line.qty) + " @ " + money.money(price) + " = " + money.money(line.qty * price));
        set units = units + line.qty;
        set gross = gross + line.qty * price;
    }
    push(out, "items " + str(units) + ", gross " + money.money(gross));
    return out;
}
