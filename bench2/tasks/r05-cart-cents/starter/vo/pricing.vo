import shop;

# One cart line with its discounts worked out.
export record Priced {
    sku: str;
    qty: int;
    price: int;
    gross: int;
    free_qty: int;
    free_amount: int;
    bulk_pct: int;
    bulk_amount: int;
    net: int;
}

export fn set_promo(shop_value: shop.Shop, sku: str, buy: int) -> str {
    if not has(shop_value.catalog, sku) {
        return shop.unknown_product(sku);
    }
    set shop_value.promos[sku] = buy;
    return "promo " + sku + ": buy " + str(buy) + " get 1 free";
}

export fn set_bulk(shop_value: shop.Shop, sku: str, min_qty: int, pct: int) -> str {
    if not has(shop_value.catalog, sku) {
        return shop.unknown_product(sku);
    }
    set shop_value.bulks[sku] = new shop.Bulk { min_qty: min_qty, pct: pct };
    return "bulk " + sku + ": " + str(min_qty) + " or more " + str(pct) + "% off";
}

export fn define_coupon(shop_value: shop.Shop, code: str, pct: int) -> str {
    set shop_value.coupons[code] = pct;
    return "coupon " + code + ": " + str(pct) + "% off";
}

export fn use_coupon(shop_value: shop.Shop, code: str) -> str {
    if not has(shop_value.coupons, code) {
        return "error: unknown coupon " + code;
    }
    set shop_value.active = code;
    return "coupon " + code + " active";
}

export fn price_line(shop_value: shop.Shop, line: shop.Line) -> Priced {
    let price = shop_value.catalog[line.sku].price;
    let p = new Priced { sku: line.sku, qty: line.qty, price: price, gross: line.qty * price, free_qty: 0, free_amount: 0, bulk_pct: 0, bulk_amount: 0, net: 0 };
    if has(shop_value.promos, line.sku) {
        set p.free_qty = line.qty / (shop_value.promos[line.sku] + 1);
        set p.free_amount = p.free_qty * p.price;
    }
    let base = p.gross - p.free_amount;
    if has(shop_value.bulks, line.sku) and line.qty >= shop_value.bulks[line.sku].min_qty {
        set p.bulk_pct = shop_value.bulks[line.sku].pct;
        set p.bulk_amount = base * p.bulk_pct / 100;
    }
    set p.net = base - p.bulk_amount;
    return p;
}

# The active coupon's discount on subtotal (0 without a coupon).
export fn coupon_discount(shop_value: shop.Shop, subtotal: int) -> int {
    if shop_value.active == "" {
        return 0;
    }
    return subtotal * shop_value.coupons[shop_value.active] / 100;
}
