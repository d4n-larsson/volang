import shop.Shop;
import shop.new_shop;
import cart.add_product;
import cart.set_price;
import cart.add_to_cart;
import cart.remove_from_cart;
import cart.show_cart;
import pricing.set_promo;
import pricing.set_bulk;
import pricing.define_coupon;
import pricing.use_coupon;
import checkout.checkout;
import checkout.report;

fn is_number(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    return all(chars(s), fn(c: str) -> bool {
        return c >= "0" and c <= "9";
    });
}

# Only called on strings that passed is_number.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

fn positive(s: str) -> bool {
    return is_number(s) and num(s) >= 1;
}

fn percent(s: str) -> bool {
    return positive(s) and num(s) <= 100;
}

fn run(words: list[str], shop: Shop) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    let bad = ["error: bad command"];
    if cmd == "product" {
        if len(args_value) != 3 or not is_number(args_value[2]) {
            return bad;
        }
        return [add_product(shop, args_value[0], args_value[1], num(args_value[2]))];
    }
    if cmd == "price" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return bad;
        }
        return [set_price(shop, args_value[0], num(args_value[1]))];
    }
    if cmd == "add" {
        if len(args_value) != 2 or not positive(args_value[1]) {
            return bad;
        }
        return [add_to_cart(shop, args_value[0], num(args_value[1]))];
    }
    if cmd == "remove" {
        if len(args_value) != 2 or not positive(args_value[1]) {
            return bad;
        }
        return [remove_from_cart(shop, args_value[0], num(args_value[1]))];
    }
    if cmd == "promo" {
        if len(args_value) != 2 or not positive(args_value[1]) {
            return bad;
        }
        return [set_promo(shop, args_value[0], num(args_value[1]))];
    }
    if cmd == "bulk" {
        if len(args_value) != 3 or not positive(args_value[1]) or not percent(args_value[2]) {
            return bad;
        }
        return [set_bulk(shop, args_value[0], num(args_value[1]), num(args_value[2]))];
    }
    if cmd == "coupon" {
        if len(args_value) != 2 or not percent(args_value[1]) {
            return bad;
        }
        return [define_coupon(shop, args_value[0], num(args_value[1]))];
    }
    if cmd == "use" {
        if len(args_value) != 1 {
            return bad;
        }
        return [use_coupon(shop, args_value[0])];
    }
    if cmd == "cart" {
        if len(args_value) != 0 {
            return bad;
        }
        return show_cart(shop);
    }
    if cmd == "checkout" {
        if len(args_value) != 0 {
            return bad;
        }
        return checkout(shop);
    }
    if cmd == "report" {
        if len(args_value) != 0 {
            return bad;
        }
        return report(shop);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let shop = new_shop();
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, shop) {
            print(out);
        }
    }
}
