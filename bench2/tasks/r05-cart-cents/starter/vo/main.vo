import cart;
import checkout;
import pricing;
import shop;

fn is_number(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    return all(chars(s), fn(c) => c >= "0" and c <= "9");
}

# Only called on strings that passed is_number.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

fn positive(s: str) -> bool {
    return is_number(s) and num(s) >= 1;
}

fn percent(s: str) -> bool {
    return positive(s) and num(s) <= 100;
}

fn run(words: list[str], shop_value: shop.Shop) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    let bad = ["error: bad command"];
    if cmd == "product" {
        if len(args_value) != 3 or not is_number(args_value[2]) {
            return bad;
        }
        return [cart.add_product(shop_value, args_value[0], args_value[1], num(args_value[2]))];
    }
    if cmd == "price" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return bad;
        }
        return [cart.set_price(shop_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "add" {
        if len(args_value) != 2 or not positive(args_value[1]) {
            return bad;
        }
        return [cart.add_to_cart(shop_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "remove" {
        if len(args_value) != 2 or not positive(args_value[1]) {
            return bad;
        }
        return [cart.remove_from_cart(shop_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "promo" {
        if len(args_value) != 2 or not positive(args_value[1]) {
            return bad;
        }
        return [pricing.set_promo(shop_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "bulk" {
        if len(args_value) != 3 or not positive(args_value[1]) or not percent(args_value[2]) {
            return bad;
        }
        return [pricing.set_bulk(shop_value, args_value[0], num(args_value[1]), num(args_value[2]))];
    }
    if cmd == "coupon" {
        if len(args_value) != 2 or not percent(args_value[1]) {
            return bad;
        }
        return [pricing.define_coupon(shop_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "use" {
        if len(args_value) != 1 {
            return bad;
        }
        return [pricing.use_coupon(shop_value, args_value[0])];
    }
    if cmd == "cart" {
        if len(args_value) != 0 {
            return bad;
        }
        return cart.show_cart(shop_value);
    }
    if cmd == "checkout" {
        if len(args_value) != 0 {
            return bad;
        }
        return checkout.checkout(shop_value);
    }
    if cmd == "report" {
        if len(args_value) != 0 {
            return bad;
        }
        return checkout.report(shop_value);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let shop_value = shop.new_shop();
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w) => w != "");
        if len(words) == 0 {
            continue;
        }
        for out in run(words, shop_value) {
            print(out);
        }
    }
}
