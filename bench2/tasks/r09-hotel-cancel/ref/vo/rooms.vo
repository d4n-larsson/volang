import model;

export fn add_type(types: map[str, model.RoomType], name: str, rate: int, count: int) -> str {
    if has(types, name) {
        return "error: type " + name + " exists";
    }
    set types[name] = new model.RoomType { name: name, rate: rate, count: count };
    return "type " + name + " added";
}

export fn set_rate(types: map[str, model.RoomType], name: str, rate: int, money: fn(int) -> str) -> str {
    if not has(types, name) {
        return "error: unknown type " + name;
    }
    let t = types[name];
    set t.rate = rate;
    return "type " + name + " rate " + money(rate);
}

export fn sorted_types(types: map[str, model.RoomType]) -> list[model.RoomType] {
    let names = keys(types);
    sort(names);
    return map(names, fn(name: str) -> model.RoomType {
        return types[name];
    });
}

# How many rooms of the type are taken on the night of `day`.
export fn occupied(bookings: map[str, model.Booking], type_name: str, day: int) -> int {
    var n = 0;
    for k in keys(bookings) {
        let b = bookings[k];
        if b.type_name == type_name and b.start <= day and day < b.held_until {
            set n = n + 1;
        }
    }
    return n;
}

# The first night in [start, end) with no free room of the type, or -1.
export fn first_full_day(types: map[str, model.RoomType], bookings: map[str, model.Booking], type_name: str, start: int, end: int) -> int {
    let count = types[type_name].count;
    for day in start..end {
        if occupied(bookings, type_name, day) >= count {
            return day;
        }
    }
    return -1;
}

export fn min_free(types: map[str, model.RoomType], bookings: map[str, model.Booking], type_name: str, start: int, end: int) -> int {
    let t = types[type_name];
    var best = t.count;
    for day in start..end {
        set best = min(best, t.count - occupied(bookings, type_name, day));
    }
    return best;
}
