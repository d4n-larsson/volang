import model.RoomType;
import model.Booking;
import rooms.add_type;
import rooms.set_rate;
import bookings.book;
import billing.money;
import billing.invoice_lines;
import report.avail_line;
import report.occupancy_lines;
import report.report_lines;

fn is_number(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    return all(chars(s), fn(c: str) -> bool {
        return c >= "0" and c <= "9";
    });
}

# Only called on strings that passed is_number.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

fn run(words: list[str], types: map[str, RoomType], bookings: map[str, Booking]) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    if cmd == "type" {
        if len(args_value) != 3 or not is_number(args_value[1]) or not is_number(args_value[2]) {
            return ["error: bad command"];
        }
        return [add_type(types, args_value[0], num(args_value[1]), num(args_value[2]))];
    }
    if cmd == "rate" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return ["error: bad command"];
        }
        return [set_rate(types, args_value[0], num(args_value[1]), money)];
    }
    if cmd == "book" {
        if len(args_value) != 5 or not is_number(args_value[3]) or not is_number(args_value[4]) {
            return ["error: bad command"];
        }
        return [book(types, bookings, args_value[0], args_value[1], args_value[2], num(args_value[3]), num(args_value[4]))];
    }
    if cmd == "avail" {
        if len(args_value) != 3 or not is_number(args_value[1]) or not is_number(args_value[2]) {
            return ["error: bad command"];
        }
        if not has(types, args_value[0]) {
            return ["error: unknown type " + args_value[0]];
        }
        if num(args_value[1]) >= num(args_value[2]) {
            return ["error: bad dates"];
        }
        return [avail_line(types, bookings, args_value[0], num(args_value[1]), num(args_value[2]))];
    }
    if cmd == "occupancy" {
        if len(args_value) != 1 or not is_number(args_value[0]) {
            return ["error: bad command"];
        }
        return occupancy_lines(types, bookings, num(args_value[0]));
    }
    if cmd == "invoice" {
        if len(args_value) != 1 {
            return ["error: bad command"];
        }
        if not has(bookings, args_value[0]) {
            return ["error: unknown booking " + args_value[0]];
        }
        return invoice_lines(bookings[args_value[0]]);
    }
    if cmd == "report" {
        if len(args_value) != 0 {
            return ["error: bad command"];
        }
        return report_lines(types, bookings);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let types = new map[str, RoomType];
    let bookings = new map[str, Booking];
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, types, bookings) {
            print(out);
        }
    }
}
