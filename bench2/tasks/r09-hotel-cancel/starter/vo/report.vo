import billing;
import bookings;
import model;
import rooms;

export fn avail_line(types: map[str, model.RoomType], bookings_value: map[str, model.Booking], type_name: str, start: int, end: int) -> str {
    let free = rooms.min_free(types, bookings_value, type_name, start, end);
    return "avail " + type_name + " " + str(start) + "-" + str(end) + ": " + str(free) + " of " + str(types[type_name].count) + " free";
}

export fn occupancy_lines(types: map[str, model.RoomType], bookings_value: map[str, model.Booking], day: int) -> list[str] {
    var used = 0;
    var total = 0;
    let rows = new list[str];
    for t in rooms.sorted_types(types) {
        let n = rooms.occupied(bookings_value, t.name, day);
        set used = used + n;
        set total = total + t.count;
        push(rows, "  " + t.name + " " + str(n) + "/" + str(t.count));
    }
    let out = ["day " + str(day) + ": " + str(used) + " of " + str(total) + " rooms occupied"];
    for r in rows {
        push(out, r);
    }
    return out;
}

export fn report_lines(types: map[str, model.RoomType], bookings_value: map[str, model.Booking]) -> list[str] {
    let out = new list[str];
    var revenue = 0;
    for t in rooms.sorted_types(types) {
        var count = 0;
        var held = 0;
        var earned = 0;
        for k in keys(bookings_value) {
            let b = bookings_value[k];
            if b.type_name == t.name {
                set count = count + 1;
                set held = held + bookings.nights(b);
                set earned = earned + b.total;
            }
        }
        set revenue = revenue + earned;
        push(out, t.name + ": " + str(count) + " bookings, " + str(held) + " nights, revenue " + billing.money(earned));
    }
    push(out, "total revenue " + billing.money(revenue));
    return out;
}
