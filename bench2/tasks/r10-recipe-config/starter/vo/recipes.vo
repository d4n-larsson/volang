import units;

export record Ingredient {
    item: str;
    qty: int;
    unit: str;
}

export record Recipe {
    name: str;
    servings: int;
    ingredients: list[Ingredient];
}

export fn add_recipe(recipes: map[str, Recipe], name: str, servings: int, ingredients: list[Ingredient]) -> str {
    for ing in ingredients {
        if not units.is_unit(ing.unit) {
            return "error: bad unit " + ing.unit;
        }
    }
    if has(recipes, name) {
        return "error: recipe " + name + " exists";
    }
    let seen = new map[str, bool];
    for ing in ingredients {
        if has(seen, ing.item) {
            return "error: duplicate " + ing.item;
        }
        set seen[ing.item] = true;
    }
    set recipes[name] = new Recipe { name: name, servings: servings, ingredients: ingredients };
    return "recipe " + name + " added (" + str(len(ingredients)) + " ingredients)";
}

export fn ingredient_line(item: str, qty: int, unit: str) -> str {
    return "  " + item + " " + units.format_qty(qty, unit);
}

export fn show_lines(recipe: Recipe) -> list[str] {
    let out = [recipe.name + " (" + str(recipe.servings) + " servings)"];
    for ing in recipe.ingredients {
        push(out, ingredient_line(ing.item, ing.qty, ing.unit));
    }
    return out;
}

export fn list_lines(recipes: map[str, Recipe]) -> list[str] {
    if len(recipes) == 0 {
        return ["no recipes"];
    }
    let names = keys(recipes);
    sort(names);
    return map(names, fn(name) {
        let r = recipes[name];
        return name + ": " + str(r.servings) + " servings, " + str(len(r.ingredients)) + " ingredients";
    });
}
