import recipes;
import scaling;

# Only called on strings of digits.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

# A number of at least 1.
fn is_count(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    if not all(chars(s), fn(c) => c >= "0" and c <= "9") {
        return false;
    }
    return num(s) > 0;
}

fn run(words: list[str], recipes_value: map[str, recipes.Recipe]) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    if cmd == "recipe" {
        if len(args_value) < 5 or (len(args_value) - 2) % 3 != 0 or not is_count(args_value[1]) {
            return ["error: bad command"];
        }
        let ingredients = new list[recipes.Ingredient];
        var i = 2;
        while i < len(args_value) {
            if not is_count(args_value[i + 1]) {
                return ["error: bad command"];
            }
            push(ingredients, new recipes.Ingredient { item: args_value[i], qty: num(args_value[i + 1]), unit: args_value[i + 2] });
            set i = i + 3;
        }
        return [recipes.add_recipe(recipes_value, args_value[0], num(args_value[1]), ingredients)];
    }
    if cmd == "show" {
        if len(args_value) != 1 {
            return ["error: bad command"];
        }
        if not has(recipes_value, args_value[0]) {
            return ["error: unknown recipe " + args_value[0]];
        }
        return recipes.show_lines(recipes_value[args_value[0]]);
    }
    if cmd == "scale" {
        if len(args_value) != 2 or not is_count(args_value[1]) {
            return ["error: bad command"];
        }
        if not has(recipes_value, args_value[0]) {
            return ["error: unknown recipe " + args_value[0]];
        }
        return scaling.scale_lines(recipes_value[args_value[0]], num(args_value[1]));
    }
    if cmd == "shop" {
        if len(args_value) < 2 or len(args_value) % 2 != 0 {
            return ["error: bad command"];
        }
        let orders = new list[scaling.Order];
        var i = 0;
        while i < len(args_value) {
            if not is_count(args_value[i + 1]) {
                return ["error: bad command"];
            }
            push(orders, new scaling.Order { name: args_value[i], wanted: num(args_value[i + 1]) });
            set i = i + 2;
        }
        for o in orders {
            if not has(recipes_value, o.name) {
                return ["error: unknown recipe " + o.name];
            }
        }
        return scaling.shopping_list(recipes_value, orders);
    }
    if cmd == "list" {
        if len(args_value) != 0 {
            return ["error: bad command"];
        }
        return recipes.list_lines(recipes_value);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let recipes_value = new map[str, recipes.Recipe];
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w) => w != "");
        if len(words) == 0 {
            continue;
        }
        for out in run(words, recipes_value) {
            print(out);
        }
    }
}
