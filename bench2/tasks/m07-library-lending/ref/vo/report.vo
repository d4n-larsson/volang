import commands;
import library;

fn listed(xs: list[str]) -> str {
    if len(xs) == 0 {
        return "-";
    }
    return join(xs, ",");
}

export fn report(lib: library.Library) -> list[str] {
    let out = ["members:"];
    let ms = keys(lib.limit);
    sort(ms);
    for m in ms {
        let isbns = map(lib.loans[m], fn(l: library.Loan) -> str {
            return l.isbn;
        });
        sort(isbns);
        push(out, m + " loans " + listed(isbns) + " owes " + commands.money(lib.owes[m]));
    }
    push(out, "books:");
    let bs = keys(lib.copies);
    sort(bs);
    for b in bs {
        push(out, b + " " + str(lib.shelf[b]) + "/" + str(lib.copies[b]) + " queue " + listed(lib.queue[b]));
    }
    return out;
}
