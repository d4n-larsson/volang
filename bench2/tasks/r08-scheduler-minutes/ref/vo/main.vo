import clock.is_digits;
import clock.num;
import clock.parse_time;
import schedule.Event;
import schedule.add_event;
import schedule.remove_event;
import report.agenda_lines;
import report.who_line;
import report.free_lines;
import report.summary_lines;

# The first word that is not a valid time, or "" when all are valid.
fn bad_time(words: list[str]) -> str {
    for w in words {
        if parse_time(w) < 0 {
            return w;
        }
    }
    return "";
}

fn run(words: list[str], events: map[str, Event]) -> list[str] {
    let cmd = words[0];
    let args = slice(words, 1, len(words));
    if cmd == "add" {
        if len(args) != 4 {
            return ["error: bad command"];
        }
        let bad = bad_time(slice(args, 2, 4));
        if bad != "" {
            return ["error: bad time " + bad];
        }
        return [add_event(events, args[0], args[1], parse_time(args[2]), parse_time(args[3]))];
    }
    if cmd == "remove" {
        if len(args) != 1 {
            return ["error: bad command"];
        }
        return [remove_event(events, args[0])];
    }
    if cmd == "agenda" {
        if len(args) != 1 {
            return ["error: bad command"];
        }
        return agenda_lines(events, args[0]);
    }
    if cmd == "who" {
        if len(args) != 2 {
            return ["error: bad command"];
        }
        let t = parse_time(args[1]);
        if t < 0 {
            return ["error: bad time " + args[1]];
        }
        return [who_line(events, args[0], t)];
    }
    if cmd == "free" {
        if len(args) != 4 or not is_digits(args[3]) or num(args[3]) == 0 {
            return ["error: bad command"];
        }
        let bad = bad_time(slice(args, 1, 3));
        if bad != "" {
            return ["error: bad time " + bad];
        }
        let lo = parse_time(args[1]);
        let hi = parse_time(args[2]);
        if lo >= hi {
            return ["error: empty interval"];
        }
        return free_lines(events, args[0], lo, hi, num(args[3]));
    }
    if cmd == "summary" {
        if len(args) != 0 {
            return ["error: bad command"];
        }
        return summary_lines(events);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let events = new map[str, Event];
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, events) {
            print(out);
        }
    }
}
