import clock;
import report;
import schedule;

# The first word that is not a valid time, or "" when all are valid.
fn bad_time(words: list[str]) -> str {
    for w in words {
        if clock.parse_time(w) < 0 {
            return w;
        }
    }
    return "";
}

fn run(words: list[str], events: map[str, schedule.Event]) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    if cmd == "add" {
        if len(args_value) != 4 {
            return ["error: bad command"];
        }
        let bad = bad_time(slice(args_value, 2, 4));
        if bad != "" {
            return ["error: bad time " + bad];
        }
        return [schedule.add_event(events, args_value[0], args_value[1], clock.parse_time(args_value[2]), clock.parse_time(args_value[3]))];
    }
    if cmd == "remove" {
        if len(args_value) != 1 {
            return ["error: bad command"];
        }
        return [schedule.remove_event(events, args_value[0])];
    }
    if cmd == "agenda" {
        if len(args_value) != 1 {
            return ["error: bad command"];
        }
        return report.agenda_lines(events, args_value[0]);
    }
    if cmd == "who" {
        if len(args_value) != 2 {
            return ["error: bad command"];
        }
        let t = clock.parse_time(args_value[1]);
        if t < 0 {
            return ["error: bad time " + args_value[1]];
        }
        return [report.who_line(events, args_value[0], t)];
    }
    if cmd == "free" {
        if len(args_value) != 4 or not clock.is_digits(args_value[3]) or clock.num(args_value[3]) == 0 {
            return ["error: bad command"];
        }
        let bad = bad_time(slice(args_value, 1, 3));
        if bad != "" {
            return ["error: bad time " + bad];
        }
        let lo = clock.parse_time(args_value[1]);
        let hi = clock.parse_time(args_value[2]);
        if lo >= hi {
            return ["error: empty interval"];
        }
        return report.free_lines(events, args_value[0], lo, hi, clock.num(args_value[3]));
    }
    if cmd == "summary" {
        if len(args_value) != 0 {
            return ["error: bad command"];
        }
        return report.summary_lines(events);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let events = new map[str, schedule.Event];
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, events) {
            print(out);
        }
    }
}
