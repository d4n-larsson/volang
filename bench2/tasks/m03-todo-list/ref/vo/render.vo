import store;

fn task_line(t: store.Task, mark_done: bool) -> str {
    let tags = slice(t.tags, 0, len(t.tags));
    sort(tags);
    var s = "#" + str(t.id) + " P" + str(t.prio) + " " + t.text;
    for g in tags {
        set s = s + " +" + g;
    }
    if mark_done and t.done {
        set s = s + " (done)";
    }
    return s;
}

export fn listing(s: store.Store, which: str) -> list[str] {
    let out = new list[str];
    var ts = store.all_tasks(s);
    if which == "" {
        set ts = filter(ts, fn(t) => not t.done);
        sort_by(ts, fn(t) => t.prio);
    } else if which == "done" {
        set ts = filter(ts, fn(t) => t.done);
        sort_by(ts, fn(t) => t.done_seq);
    } else {
        let tag = slice(which, 1, len(which));
        set ts = filter(ts, fn(t) => any(t.tags, fn(g) => g == tag));
    }
    for t in ts {
        push(out, task_line(t, which != "" and which != "done"));
    }
    if len(out) == 0 {
        push(out, "no tasks");
    }
    return out;
}

export fn stats(s: store.Store) -> str {
    let ts = store.all_tasks(s);
    let done = len(filter(ts, fn(t) => t.done));
    return "open " + str(len(ts) - done) + " done " + str(done);
}
