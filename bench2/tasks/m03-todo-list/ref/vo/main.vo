import commands.Command;
import commands.parse;
import render.listing;
import render.stats;
import store.Store;
import store.add;
import store.add_tag;
import store.delete;
import store.exists;
import store.new_store;
import store.set_done;

fn digit_value(p: str) -> int {
    return ord(p) - ord("0");
}

fn handle(s: Store, c: Command) -> list[str] {
    let a = c.args;
    if c.name == "" {
        return new list[str];
    }
    if c.name == "add" {
        return ["added #" + str(add(s, digit_value(a[0]), a[1]))];
    }
    if c.name == "list" {
        if len(a) == 0 {
            return listing(s, "");
        }
        return listing(s, a[0]);
    }
    if c.name == "stats" {
        return [stats(s)];
    }
    if not exists(s, a[0]) {
        return ["error: no task " + a[0]];
    }
    let t = s.tasks[a[0]];
    let id = "#" + str(t.id);
    if c.name == "done" {
        if set_done(s, t, true) {
            return ["done " + id];
        }
        return [id + " is already done"];
    }
    if c.name == "reopen" {
        if set_done(s, t, false) {
            return ["reopened " + id];
        }
        return [id + " is already open"];
    }
    if c.name == "delete" {
        delete(t);
        return ["deleted " + id];
    }
    if c.name == "tag" {
        if add_tag(t, a[1]) {
            return ["tagged " + id + " +" + a[1]];
        }
        return [id + " already has +" + a[1]];
    }
    set t.prio = digit_value(a[1]);
    return [id + " is now P" + a[1]];
}

fn main() uses console, input {
    let s = new_store();
    let out = new list[str];
    for line in split(read_all(), "\n") {
        match parse(line) {
            case ok(c) {
                for r in handle(s, c) {
                    push(out, r);
                }
            }
            case err(e) {
                push(out, "error: " + e);
            }
        }
    }
    for r in out {
        print(r);
    }
}
