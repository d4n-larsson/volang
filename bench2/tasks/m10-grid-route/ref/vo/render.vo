import grid;

export fn draw(g: grid.Grid, cells: list[int]) -> list[str] {
    let rows = map(g.rows, fn(r) => slice(r, 0, len(r)));
    for cell in cells {
        let r = cell / g.width;
        let c = cell % g.width;
        if not grid.is_stop(rows[r][c]) {
            set rows[r][c] = "*";
        }
    }
    return map(rows, fn(r) => join(r, ""));
}
