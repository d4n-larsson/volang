import gradebook;
import parsing;
import report;

fn main() uses console, input {
    let g = gradebook.new_book();
    let lines = split(read_all(), "\n");
    for i in 0..len(lines) {
        match parsing.parse(lines[i]) {
            case ok(l) {
                if l.kind != "blank" and not gradebook.apply(g, l) {
                    print("invalid line " + str(i + 1));
                }
            }
            case err(_) {
                print("invalid line " + str(i + 1));
            }
        }
    }
    for s in report.report(g) {
        print(s);
    }
}
