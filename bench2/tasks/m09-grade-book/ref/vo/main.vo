import gradebook.apply;
import gradebook.new_book;
import parsing.parse;
import report.report;

fn main() uses console, input {
    let g = new_book();
    let lines = split(read_all(), "\n");
    for i in 0..len(lines) {
        match parse(lines[i]) {
            case ok(l) {
                if l.kind != "blank" and not apply(g, l) {
                    print("invalid line " + str(i + 1));
                }
            }
            case err(_) {
                print("invalid line " + str(i + 1));
            }
        }
    }
    for s in report(g) {
        print(s);
    }
}
