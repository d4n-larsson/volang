export record Line {
    kind: str;
    a: str;
    b: str;
    x: int;
    y: int;
}

fn digits(s: str, lo: int, hi: int) -> bool {
    return len(s) >= lo and len(s) <= hi and all(chars(s), fn(c) => c >= "0" and c <= "9");
}

fn to_int(s: str) -> int {
    match parse_int(s) {
        case ok(v) {
            return v;
        }
        case err(_) {
            return -1;
        }
    }
}

export fn parse(line: str) -> result[Line] {
    let f = filter(split(line, " "), fn(x) => x != "");
    if len(f) == 0 {
        return ok(new Line { kind: "blank", a: "", b: "", x: 0, y: 0 });
    }
    let n = len(f);
    if f[0] == "assignment" and n == 4 and digits(f[2], 1, 3) and digits(f[3], 1, 4) {
        if to_int(f[2]) >= 1 and to_int(f[3]) >= 1 {
            return ok(new Line { kind: "assignment", a: f[1], b: "", x: to_int(f[2]), y: to_int(f[3]) });
        }
    }
    if f[0] == "student" and n == 2 {
        return ok(new Line { kind: "student", a: f[1], b: "", x: 0, y: 0 });
    }
    if f[0] == "score" and n == 4 and digits(f[3], 1, 4) {
        return ok(new Line { kind: "score", a: f[1], b: f[2], x: to_int(f[3]), y: 0 });
    }
    if f[0] == "drop" and n == 2 and digits(f[1], 1, 1) {
        return ok(new Line { kind: "drop", a: "", b: "", x: to_int(f[1]), y: 0 });
    }
    return err("invalid");
}

export fn pct(bp: int) -> str {
    let r = bp % 100;
    if r < 10 {
        return str(bp / 100) + ".0" + str(r);
    }
    return str(bp / 100) + "." + str(r);
}
