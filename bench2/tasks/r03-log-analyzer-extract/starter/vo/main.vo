import counts;
import search;
import timeline;

fn run(words: list[str], logs: list[str]) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    if cmd == "stats" and len(args_value) == 0 {
        return counts.stats(logs);
    }
    if cmd == "levels" and len(args_value) == 0 {
        return counts.levels(logs);
    }
    if cmd == "errors" and len(args_value) == 0 {
        return counts.errors(logs);
    }
    if cmd == "busiest" and len(args_value) == 0 {
        return timeline.busiest(logs);
    }
    if cmd == "range" and len(args_value) == 4 {
        return timeline.in_range(logs, args_value);
    }
    if cmd == "span" and len(args_value) == 0 {
        return timeline.span(logs);
    }
    if cmd == "grep" and len(args_value) == 1 {
        return search.grep(logs, args_value[0]);
    }
    let known = ["stats", "levels", "errors", "busiest", "range", "span", "grep"];
    if any(known, fn(k: str) -> bool {
        return k == cmd;
    }) {
        return ["error: bad command"];
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let logs = new list[str];
    let commands = new list[str];
    var in_commands = false;
    for line in split(read_all(), "\n") {
        if line == "---" and not in_commands {
            set in_commands = true;
        } else if trim(line) == "" {
            continue;
        } else if in_commands {
            push(commands, line);
        } else {
            push(logs, line);
        }
    }
    for line in commands {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        for out in run(words, logs) {
            print(out);
        }
    }
}
