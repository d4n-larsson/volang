import bank.apply;
import bank.new_bank;
import parsing.Entry;
import parsing.show;

export fn replay(entries: list[Entry]) -> list[str] {
    let b = new_bank();
    let out = new list[str];
    let order = slice(entries, 0, len(entries));
    sort_by(order, fn(e: Entry) -> int {
        return e.time;
    });
    for e in order {
        match apply(b, e) {
            case ok {
            }
            case err(reason) {
                push(out, "t=" + str(e.time) + " line " + str(e.line) + ": " + reason);
            }
        }
    }
    let names = keys(b.balance);
    sort(names);
    for a in names {
        var s = a + " " + show(b.balance[a]);
        if has(b.closed, a) {
            set s = s + " closed";
        }
        push(out, s);
    }
    push(out, "fees " + show(b.fees) + " interest " + show(b.interest));
    return out;
}
