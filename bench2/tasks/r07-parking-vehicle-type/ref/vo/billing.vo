import fees;
import garage;

# The parked vehicle, or the error for `time`.
fn find_parked(garage_value: garage.Garage, plate: str, time: int) -> result[garage.Vehicle] {
    if not has(garage_value.vehicles, plate) {
        return err("error: " + plate + " not parked");
    }
    let vehicle = garage_value.vehicles[plate];
    if time < vehicle.since {
        return err("error: time before entry");
    }
    return ok(vehicle);
}

export fn exit_vehicle(garage_value: garage.Garage, plate: str, time: int) -> str {
    match find_parked(garage_value, plate, time) {
        case ok(vehicle) {
            let minutes = time - vehicle.since;
            let amount = fees.fee(vehicle.kind, minutes);
            let level = garage_value.levels[vehicle.level];
            set level.exits = level.exits + 1;
            set level.revenue = level.revenue + amount;
            garage.unpark(garage_value, vehicle);
            return plate + " left " + garage.spot_name(vehicle) + " after " + str(minutes) + " min, fee " + fees.money(amount);
        }
        case err(e) {
            return e;
        }
    }
}

export fn quote(garage_value: garage.Garage, plate: str, time: int) -> str {
    match find_parked(garage_value, plate, time) {
        case ok(vehicle) {
            let minutes = time - vehicle.since;
            return plate + " owes " + fees.money(fees.fee(vehicle.kind, minutes)) + " after " + str(minutes) + " min";
        }
        case err(e) {
            return e;
        }
    }
}

# What the vehicles on level `number` would owe if they all left at `time`.
fn pending(garage_value: garage.Garage, number: int, time: int) -> int {
    var total = 0;
    for plate in keys(garage_value.vehicles) {
        let vehicle = garage_value.vehicles[plate];
        if vehicle.level == number and vehicle.since <= time {
            set total = total + fees.fee(vehicle.kind, time - vehicle.since);
        }
    }
    return total;
}

export fn report(garage_value: garage.Garage, time: int) -> list[str] {
    let out = new list[str];
    var exits = 0;
    var revenue = 0;
    var owed = 0;
    for number in garage.level_numbers(garage_value) {
        let level = garage_value.levels[number];
        let p = pending(garage_value, number, time);
        push(out, "level " + str(number) + ": exits " + str(level.exits) + " revenue " + fees.money(level.revenue) + " pending " + fees.money(p));
        set exits = exits + level.exits;
        set revenue = revenue + level.revenue;
        set owed = owed + p;
    }
    push(out, "total exits " + str(exits) + " revenue " + fees.money(revenue) + " pending " + fees.money(owed));
    return out;
}
