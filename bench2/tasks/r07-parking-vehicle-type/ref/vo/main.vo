import billing;
import fees;
import garage;

fn is_number(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    return all(chars(s), fn(c: str) -> bool {
        return c >= "0" and c <= "9";
    });
}

# Only called on strings that passed is_number.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

# The TYPE word of `enter PLATE TIME [TYPE]`, "car" when it is left out.
fn vehicle_type(args_value: list[str]) -> str {
    if len(args_value) == 3 {
        return args_value[2];
    }
    return "car";
}

fn run(words: list[str], garage_value: garage.Garage) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    let bad = ["error: bad command"];
    if cmd == "level" {
        if len(args_value) != 2 or not is_number(args_value[0]) or not is_number(args_value[1]) {
            return bad;
        }
        let number = num(args_value[0]);
        let spots = num(args_value[1]);
        if number < 1 or spots < 1 or spots > 99 {
            return bad;
        }
        return [garage.open_level(garage_value, number, spots)];
    }
    if cmd == "enter" {
        if (len(args_value) != 2 and len(args_value) != 3) or not is_number(args_value[1]) {
            return bad;
        }
        let kind = vehicle_type(args_value);
        if not any(fees.vehicle_types(), fn(t: str) -> bool {
            return t == kind;
        }) {
            return ["error: unknown vehicle type " + kind];
        }
        return [garage.park(garage_value, args_value[0], num(args_value[1]), kind)];
    }
    if cmd == "exit" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return bad;
        }
        return [billing.exit_vehicle(garage_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "quote" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return bad;
        }
        return [billing.quote(garage_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "occupancy" {
        if len(args_value) != 0 {
            return bad;
        }
        return garage.occupancy(garage_value);
    }
    if cmd == "parked" {
        if len(args_value) != 0 {
            return bad;
        }
        return garage.parked(garage_value);
    }
    if cmd == "report" {
        if len(args_value) != 1 or not is_number(args_value[0]) {
            return bad;
        }
        return billing.report(garage_value, num(args_value[0]));
    }
    if cmd == "rates" {
        if len(args_value) != 0 {
            return bad;
        }
        return fees.rates();
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let garage_value = garage.new_garage();
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, garage_value) {
            print(out);
        }
    }
}
