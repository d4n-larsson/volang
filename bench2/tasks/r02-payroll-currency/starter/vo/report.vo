import money.format_money;
import pay.compute_pay;
import staff.Employee;
import staff.sorted_staff;

export fn payslip(emp: Employee) -> list[str] {
    let p = compute_pay(emp);
    let out = ["payslip " + emp.emp_id + " " + emp.name + " (" + emp.kind + ")"];
    if emp.kind == "hourly" {
        push(out, "  regular " + str(p.regular_hours) + "h " + format_money(p.regular));
        if p.overtime_hours > 0 {
            push(out, "  overtime " + str(p.overtime_hours) + "h " + format_money(p.overtime));
        }
    } else {
        push(out, "  salary " + format_money(p.regular));
    }
    push(out, "  gross " + format_money(p.gross));
    push(out, "  tax " + format_money(p.tax));
    for d in emp.deductions {
        push(out, "  deduction " + d.label + " " + format_money(d.amount));
    }
    push(out, "  net " + format_money(p.net));
    return out;
}

fn total_line(gross: int, tax: int, deductions: int, net: int) -> str {
    return "total gross " + format_money(gross) + " tax " + format_money(tax) + " deductions " + format_money(deductions) + " net " + format_money(net);
}

export fn summary(staff: map[str, Employee]) -> list[str] {
    let emps = sorted_staff(staff);
    if len(emps) == 0 {
        return ["summary: no employees"];
    }
    let out = ["summary: " + str(len(emps)) + " employees"];
    var gross = 0;
    var tax = 0;
    var deductions = 0;
    var net = 0;
    for emp in emps {
        let p = compute_pay(emp);
        push(out, "  " + emp.emp_id + " " + emp.name + " gross " + format_money(p.gross) + " net " + format_money(p.net));
        set gross = gross + p.gross;
        set tax = tax + p.tax;
        set deductions = deductions + p.deductions;
        set net = net + p.net;
    }
    push(out, total_line(gross, tax, deductions, net));
    return out;
}
