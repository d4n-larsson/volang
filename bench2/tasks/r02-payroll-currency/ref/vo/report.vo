import money.currencies;
import money.format_money;
import pay.compute_pay;
import staff.Employee;
import staff.sorted_staff;

export fn payslip(emp: Employee) -> list[str] {
    let p = compute_pay(emp);
    let out = ["payslip " + emp.emp_id + " " + emp.name + " (" + emp.kind + ")"];
    if emp.kind == "hourly" {
        push(out, "  regular " + str(p.regular_hours) + "h " + format_money(p.regular, emp.currency));
        if p.overtime_hours > 0 {
            push(out, "  overtime " + str(p.overtime_hours) + "h " + format_money(p.overtime, emp.currency));
        }
    } else {
        push(out, "  salary " + format_money(p.regular, emp.currency));
    }
    push(out, "  gross " + format_money(p.gross, emp.currency));
    push(out, "  tax " + format_money(p.tax, emp.currency));
    for d in emp.deductions {
        push(out, "  deduction " + d.label + " " + format_money(d.amount, emp.currency));
    }
    push(out, "  net " + format_money(p.net, emp.currency));
    return out;
}

record Totals {
    gross: int;
    tax: int;
    deductions: int;
    net: int;
}

fn total_line(t: Totals, currency: str) -> str {
    return "total gross " + format_money(t.gross, currency) + " tax " + format_money(t.tax, currency) + " deductions " + format_money(t.deductions, currency) + " net " + format_money(t.net, currency);
}

export fn summary(staff: map[str, Employee]) -> list[str] {
    let emps = sorted_staff(staff);
    if len(emps) == 0 {
        return ["summary: no employees"];
    }
    let out = ["summary: " + str(len(emps)) + " employees"];
    let totals = new map[str, Totals];
    for emp in emps {
        let p = compute_pay(emp);
        push(out, "  " + emp.emp_id + " " + emp.name + " gross " + format_money(p.gross, emp.currency) + " net " + format_money(p.net, emp.currency));
        if not has(totals, emp.currency) {
            set totals[emp.currency] = new Totals { gross: 0, tax: 0, deductions: 0, net: 0 };
        }
        let t = totals[emp.currency];
        set t.gross = t.gross + p.gross;
        set t.tax = t.tax + p.tax;
        set t.deductions = t.deductions + p.deductions;
        set t.net = t.net + p.net;
    }
    for currency in currencies() {
        if has(totals, currency) {
            push(out, total_line(totals[currency], currency));
        }
    }
    return out;
}
