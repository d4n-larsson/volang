import money;
import report;
import staff;

fn is_number(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    return all(chars(s), fn(c) => c >= "0" and c <= "9");
}

# Only called on strings that passed is_number.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

fn run(words: list[str], staff_value: map[str, staff.Employee]) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    if cmd == "employee" {
        if len(args_value) != 4 and len(args_value) != 5 {
            return ["error: bad command"];
        }
        if args_value[2] != "hourly" and args_value[2] != "salaried" or not is_number(args_value[3]) {
            return ["error: bad command"];
        }
        var currency = "USD";
        if len(args_value) == 5 {
            set currency = args_value[4];
        }
        if not money.is_currency(currency) {
            return ["error: unknown currency " + currency];
        }
        return [staff.add_employee(staff_value, args_value[0], args_value[1], args_value[2], num(args_value[3]), currency)];
    }
    if cmd == "hours" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return ["error: bad command"];
        }
        return [staff.log_hours(staff_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "rate" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return ["error: bad command"];
        }
        return [staff.set_rate(staff_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "deduct" {
        if len(args_value) != 3 or not is_number(args_value[1]) {
            return ["error: bad command"];
        }
        return [staff.add_deduction(staff_value, args_value[0], num(args_value[1]), args_value[2])];
    }
    if cmd == "payslip" {
        if len(args_value) != 1 {
            return ["error: bad command"];
        }
        if not has(staff_value, args_value[0]) {
            return ["error: unknown employee " + args_value[0]];
        }
        return report.payslip(staff_value[args_value[0]]);
    }
    if cmd == "summary" {
        if len(args_value) != 0 {
            return ["error: bad command"];
        }
        return report.summary(staff_value);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let staff_value = new map[str, staff.Employee];
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w) => w != "");
        if len(words) == 0 {
            continue;
        }
        for out in run(words, staff_value) {
            print(out);
        }
    }
}
