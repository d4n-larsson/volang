import staff.Employee;
import staff.add_employee;
import staff.log_hours;
import staff.set_rate;
import staff.add_deduction;
import report.payslip;
import report.summary;
import money.is_currency;

fn is_number(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    return all(chars(s), fn(c: str) -> bool {
        return c >= "0" and c <= "9";
    });
}

# Only called on strings that passed is_number.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

fn run(words: list[str], staff: map[str, Employee]) -> list[str] {
    let cmd = words[0];
    let args = slice(words, 1, len(words));
    if cmd == "employee" {
        if len(args) != 4 and len(args) != 5 {
            return ["error: bad command"];
        }
        if args[2] != "hourly" and args[2] != "salaried" or not is_number(args[3]) {
            return ["error: bad command"];
        }
        var currency = "USD";
        if len(args) == 5 {
            set currency = args[4];
        }
        if not is_currency(currency) {
            return ["error: unknown currency " + currency];
        }
        return [add_employee(staff, args[0], args[1], args[2], num(args[3]), currency)];
    }
    if cmd == "hours" {
        if len(args) != 2 or not is_number(args[1]) {
            return ["error: bad command"];
        }
        return [log_hours(staff, args[0], num(args[1]))];
    }
    if cmd == "rate" {
        if len(args) != 2 or not is_number(args[1]) {
            return ["error: bad command"];
        }
        return [set_rate(staff, args[0], num(args[1]))];
    }
    if cmd == "deduct" {
        if len(args) != 3 or not is_number(args[1]) {
            return ["error: bad command"];
        }
        return [add_deduction(staff, args[0], num(args[1]), args[2])];
    }
    if cmd == "payslip" {
        if len(args) != 1 {
            return ["error: bad command"];
        }
        if not has(staff, args[0]) {
            return ["error: unknown employee " + args[0]];
        }
        return payslip(staff[args[0]]);
    }
    if cmd == "summary" {
        if len(args) != 0 {
            return ["error: bad command"];
        }
        return summary(staff);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let staff = new map[str, Employee];
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, staff) {
            print(out);
        }
    }
}
