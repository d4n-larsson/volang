import evaluator;
import exprparser;
import lexer;
import printer;

fn main() uses console, input {
    let env_value = new map[str, int];
    for line in split(read_all(), "\n") {
        if len(join(split(line, " "), "")) == 0 {
            continue;
        }
        match lexer.tokenize(line) {
            case ok(toks) {
                match exprparser.parse_line(toks) {
                    case ok(st) {
                        var text = printer.show(st.expr);
                        if st.name != "" {
                            set text = st.name + " = " + text;
                        }
                        match evaluator.evaluate(st.expr, env_value) {
                            case ok(v) {
                                if st.name != "" {
                                    set env_value[st.name] = v;
                                }
                                print(text + " => " + str(v));
                            }
                            case err(e) {
                                print(text + " => error: " + e);
                            }
                        }
                    }
                    case err(_) {
                        print("error: syntax");
                    }
                }
            }
            case err(_) {
                print("error: syntax");
            }
        }
    }
}
