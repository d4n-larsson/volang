import exprparser;
import printer;

fn max_int() -> int {
    return 9223372036854775807;
}

fn min_int() -> int {
    return -9223372036854775807 - 1;
}

fn literal(d: str) -> result[int] {
    let s = printer.strip_zeros(d);
    if len(s) > 19 {
        return err("overflow");
    }
    match parse_int(s) {
        case ok(v) {
            return ok(v);
        }
        case err(_) {
            return err("overflow");
        }
    }
}

fn add(a: int, b: int) -> result[int] {
    if b > 0 and a > max_int() - b or b < 0 and a < min_int() - b {
        return err("overflow");
    }
    return ok(a + b);
}

fn sub(a: int, b: int) -> result[int] {
    if b < 0 and a > max_int() + b or b > 0 and a < min_int() + b {
        return err("overflow");
    }
    return ok(a - b);
}

fn mul(a: int, b: int) -> result[int] {
    if a == 0 or b == 0 {
        return ok(0);
    }
    var bad = false;
    if a > 0 and b > 0 {
        set bad = a > max_int() / b;
    } else if a > 0 and b < 0 {
        set bad = b < min_int() / a;
    } else if a < 0 and b > 0 {
        set bad = a < min_int() / b;
    } else {
        set bad = a < max_int() / b;
    }
    if bad {
        return err("overflow");
    }
    return ok(a * b);
}

fn power(a: int, b: int) -> result[int] {
    if b < 0 {
        return err("negative exponent");
    }
    if b == 0 {
        return ok(1);
    }
    if a == 0 or a == 1 {
        return ok(a);
    }
    if a == -1 {
        if b % 2 == 0 {
            return ok(1);
        }
        return ok(-1);
    }
    var r = 1;
    for _ in 0..b {
        set r = try mul(r, a);
    }
    return ok(r);
}

export fn evaluate(e: exprparser.Expr, env_value: map[str, int]) -> result[int] {
    match e {
        case num(d) {
            return literal(d);
        }
        case name(n) {
            if not has(env_value, n) {
                return err("undefined " + n);
            }
            return ok(env_value[n]);
        }
        case neg(x) {
            return sub(0, try evaluate(x, env_value));
        }
        case bin(op) {
            let a = try evaluate(op.left, env_value);
            let b = try evaluate(op.right, env_value);
            if op.op == "+" {
                return add(a, b);
            }
            if op.op == "-" {
                return sub(a, b);
            }
            if op.op == "*" {
                return mul(a, b);
            }
            if op.op == "^" {
                return power(a, b);
            }
            if b == 0 {
                return err("division by zero");
            }
            if a == min_int() and b == -1 {
                if op.op == "/" {
                    return err("overflow");
                }
                return ok(0);
            }
            if op.op == "/" {
                return ok(a / b);
            }
            return ok(a % b);
        }
    }
}
