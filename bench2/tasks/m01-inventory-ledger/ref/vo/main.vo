import ledger;
import parsing;
import report;

fn emit(out: list[str], lines: list[str]) {
    for s in lines {
        push(out, s);
    }
}

fn main() uses console, input {
    let led = ledger.new_ledger();
    let out = new list[str];
    let lines = split(read_all(), "\n");
    var count = len(lines);
    if lines[count - 1] == "" {
        set count = count - 1;
    }
    for i in 0..count {
        let n = i + 1;
        let c = parsing.parse(lines[i]);
        if c.kind == "INVALID" {
            push(out, "line " + str(n) + ": invalid");
        } else if c.kind == "REPORT" {
            emit(out, report.report(led));
        } else if c.kind == "RECEIVE" {
            ledger.receive(led, c.sku, c.qty, c.price);
        } else if c.kind == "SHIP" or c.kind == "SCRAP" {
            let have = ledger.stock(led, c.sku);
            if have < c.qty {
                push(out, "line " + str(n) + ": cannot take " + str(c.qty) + " of " + c.sku + ", only " + str(have) + " in stock");
            } else if c.kind == "SHIP" {
                ledger.ship(led, c.sku, c.qty, c.price);
            } else {
                ledger.scrap(led, c.sku, c.qty);
            }
        }
    }
    emit(out, report.report(led));
    for s in out {
        print(s);
    }
}
