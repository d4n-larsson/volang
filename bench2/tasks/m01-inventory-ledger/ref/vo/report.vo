import ledger;

fn money(c: int) -> str {
    var sign = "";
    if c < 0 {
        set sign = "-";
    }
    let a = abs(c);
    var cents = str(a % 100);
    if len(cents) == 1 {
        set cents = "0" + cents;
    }
    return sign + str(a / 100) + "." + cents;
}

export fn report(l: ledger.Ledger) -> list[str] {
    let out = ["REPORT"];
    let skus = keys(l.lots);
    sort(skus);
    var total = 0;
    for sku in skus {
        let v = ledger.value(l, sku);
        set total = total + v;
        push(out, sku + " " + str(ledger.stock(l, sku)) + " " + money(v));
    }
    let profit = l.revenue - l.cogs - l.loss;
    push(out, "revenue " + money(l.revenue) + " cogs " + money(l.cogs) + " loss " + money(l.loss) + " profit " + money(profit) + " stock " + money(total));
    return out;
}
