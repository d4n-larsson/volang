import parse.Meeting;
import parse.Query;
import schedule.shares;

export fn earliest(ms: list[Meeting], q: Query) -> int {
    let busy = filter(ms, fn(m: Meeting) -> bool {
        return m.day == q.day and len(shares(m.people, q.people)) > 0;
    });
    let starts = [480];
    for m in busy {
        push(starts, m.end);
    }
    sort(starts);
    for t in starts {
        let e = t + q.minutes;
        if t >= 480 and e <= 1080 and not any(busy, fn(m: Meeting) -> bool {
            return m.start < e and t < m.end;
        }) {
            return t;
        }
    }
    return -1;
}
