import parse;
import schedule;

export fn earliest(ms: list[parse.Meeting], q: parse.Query) -> int {
    let busy = filter(ms, fn(m) => m.day == q.day and len(schedule.shares(m.people, q.people)) > 0);
    let starts = [480];
    for m in busy {
        push(starts, m.end);
    }
    sort(starts);
    for t in starts {
        let e = t + q.minutes;
        if t >= 480 and e <= 1080 and not any(busy, fn(m) => m.start < e and t < m.end) {
            return t;
        }
    }
    return -1;
}
