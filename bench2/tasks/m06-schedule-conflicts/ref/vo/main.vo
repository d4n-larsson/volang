import freeslot.earliest;
import parse.Meeting;
import parse.Query;
import parse.clock;
import parse.parse;
import schedule.conflicts;
import schedule.room_minutes;

fn main() uses console, input {
    let lines = split(read_all(), "\n");
    let meetings = new list[Meeting];
    let queries = new list[Query];
    let ids = new map[str, bool];
    for i in 0..len(lines) {
        match parse(lines[i], i + 1) {
            case ok(l) {
                if l.kind == "meeting" {
                    if has(ids, l.meeting.id) {
                        print("invalid line " + str(i + 1));
                    } else {
                        set ids[l.meeting.id] = true;
                        push(meetings, l.meeting);
                    }
                } else if l.kind == "free" {
                    push(queries, l.query);
                }
            }
            case err(_) {
                print("invalid line " + str(i + 1));
            }
        }
    }
    let c = conflicts(meetings);
    print("conflicts: " + str(len(c)));
    for s in c {
        print(s);
    }
    print("rooms:");
    for s in room_minutes(meetings) {
        print(s);
    }
    for q in queries {
        let t = earliest(meetings, q);
        if t < 0 {
            print("free line " + str(q.line) + ": none");
        } else {
            print("free line " + str(q.line) + ": " + clock(t));
        }
    }
}
