import book;
import reports;
import stats;

fn is_number(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    return all(chars(s), fn(c) => c >= "0" and c <= "9");
}

# Only called on strings that passed is_number.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

fn run(words: list[str], book_value: book.Book) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    let bad = ["error: bad command"];
    if cmd == "assignment" {
        if len(args_value) != 3 or not is_number(args_value[1]) or not is_number(args_value[2]) {
            return bad;
        }
        let weight = num(args_value[1]);
        let max_points = num(args_value[2]);
        if weight < 1 or weight > 100 or max_points < 1 {
            return bad;
        }
        return [book.add_assignment(book_value, args_value[0], weight, max_points)];
    }
    if cmd == "enroll" {
        if len(args_value) != 1 {
            return bad;
        }
        return [book.enroll(book_value, args_value[0])];
    }
    if cmd == "score" {
        if len(args_value) != 3 or not is_number(args_value[2]) {
            return bad;
        }
        return [book.set_score(book_value, args_value[0], args_value[1], num(args_value[2]))];
    }
    if cmd == "card" {
        if len(args_value) != 1 {
            return bad;
        }
        return reports.card(book_value, args_value[0]);
    }
    if cmd == "stats" {
        if len(args_value) != 1 {
            return bad;
        }
        return stats.assignment_stats(book_value, args_value[0]);
    }
    if cmd == "distribution" {
        if len(args_value) != 0 {
            return bad;
        }
        return reports.distribution(book_value);
    }
    if cmd == "report" {
        if len(args_value) != 0 {
            return bad;
        }
        return reports.class_report(book_value);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let book_value = book.new_book();
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w) => w != "");
        if len(words) == 0 {
            continue;
        }
        for out in run(words, book_value) {
            print(out);
        }
    }
}
