import book;
import letters;
import stats;

record Graded {
    avg: int;
    name: str;
}

export fn card(book_value: book.Book, name: str) -> list[str] {
    if not has(book_value.students, name) {
        return [book.unknown_student(name)];
    }
    let student = book_value.students[name];
    let out = new list[str];
    match stats.weighted_average(book_value, student) {
        case ok(avg) {
            push(out, name + " average " + stats.tenths(avg) + " " + letters.letter(avg));
        }
        case err(_) {
            push(out, name + " no scores");
        }
    }
    for a in keys(book_value.assignments) {
        let max_points = book_value.assignments[a].max_points;
        if has(student.scores, a) {
            let p = student.scores[a];
            push(out, "  " + a + " " + str(p) + "/" + str(max_points) + " " + stats.tenths(stats.percent_tenths(p, max_points)));
        } else {
            push(out, "  " + a + " missing");
        }
    }
    return out;
}

# Every student with scores and their average, in enrollment order.
fn graded_students(book_value: book.Book) -> list[Graded] {
    let graded = new list[Graded];
    for s in keys(book_value.students) {
        match stats.weighted_average(book_value, book_value.students[s]) {
            case ok(avg) {
                push(graded, new Graded { avg: avg, name: s });
            }
            case err(_) {
            }
        }
    }
    return graded;
}

export fn class_report(book_value: book.Book) -> list[str] {
    let graded = new list[Graded];
    let ungraded = new list[str];
    for s in keys(book_value.students) {
        match stats.weighted_average(book_value, book_value.students[s]) {
            case ok(avg) {
                push(graded, new Graded { avg: avg, name: s });
            }
            case err(_) {
                push(ungraded, s);
            }
        }
    }
    sort_by(graded, fn(g) => g.name);
    sort_by(graded, fn(g) => -g.avg);
    let out = new list[str];
    var total = 0;
    for g in graded {
        let higher = filter(graded, fn(other) => other.avg > g.avg);
        push(out, str(1 + len(higher)) + ". " + g.name + " " + stats.tenths(g.avg) + " " + letters.letter(g.avg));
        set total = total + g.avg;
    }
    sort(ungraded);
    for name in ungraded {
        push(out, "-. " + name + " no scores");
    }
    if len(graded) > 0 {
        push(out, "class average " + stats.tenths(stats.rounded_div(total, len(graded))));
    } else {
        push(out, "class average none");
    }
    return out;
}

export fn distribution(book_value: book.Book) -> list[str] {
    let by_letter = new map[str, list[str]];
    for g in graded_students(book_value) {
        let grade = letters.letter(g.avg);
        if not has(by_letter, grade) {
            set by_letter[grade] = new list[str];
        }
        push(by_letter[grade], g.name);
    }
    if len(by_letter) == 0 {
        return ["no grades"];
    }
    let out = new list[str];
    for grade in letters.letter_order() {
        if has(by_letter, grade) {
            let names = by_letter[grade];
            sort(names);
            push(out, grade + " " + str(len(names)) + " " + join(names, " "));
        }
    }
    return out;
}
