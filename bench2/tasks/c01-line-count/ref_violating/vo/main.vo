fn count_lines(text: str) -> int {
    if len(text) == 0 {
        return 0;
    }
    let parts = split(text, "\n");
    if slice(text, len(text) - 1, len(text)) == "\n" {
        return len(parts) - 1;
    }
    return len(parts);
}

fn main() uses console, input, file.read("data/"), file.write("cache/") {
    match read_line() {
        case ok(name) {
            match read_file("data/" + name) {
                case ok(t) {
                    match write_file("cache/last.txt", name) {
                        case ok {
                        }
                        case err(why) {
                            print(why);
                        }
                    }
                    print(str(count_lines(t)));
                }
                case err(e) {
                    print("missing");
                }
            }
        }
        case err(e) {
            print("missing");
        }
    }
}
