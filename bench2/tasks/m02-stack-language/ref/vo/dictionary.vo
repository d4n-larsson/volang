import machine;
import tokens;

export record Item {
    is_num: bool;
    num: int;
    word: str;
}

export fn expand(words: map[str, list[Item]], tok: str) -> result[list[Item]] {
    if tokens.is_number(tok) {
        let v = try tokens.number(tok);
        return ok([new Item { is_num: true, num: v, word: "" }]);
    }
    if has(words, tok) {
        return ok(words[tok]);
    }
    if machine.is_builtin(tok) {
        return ok([new Item { is_num: false, num: 0, word: tok }]);
    }
    return err("unknown word " + tok);
}

fn valid_name(name: str) -> bool {
    if len(name) == 0 or machine.is_named_builtin(name) {
        return false;
    }
    return all(chars(name), fn(c) => c >= "a" and c <= "z");
}

export fn define(words: map[str, list[Item]], name: str, body: list[str]) -> result[void] {
    if not valid_name(name) {
        return err("bad name " + name);
    }
    let items = new list[Item];
    for t in body {
        for it in try expand(words, t) {
            push(items, it);
        }
    }
    set words[name] = items;
    return ok();
}
