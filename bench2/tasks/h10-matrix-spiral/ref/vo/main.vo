fn words(s: str) -> list[str] {
    return filter(split(s, " "), fn(w) => len(w) > 0);
}

fn spiral(m: list[list[str]]) -> list[str] {
    let out = new list[str];
    var top = 0;
    var bottom = len(m) - 1;
    var left = 0;
    var right = len(m[0]) - 1;
    while top <= bottom and left <= right {
        for j in left..right + 1 {
            push(out, m[top][j]);
        }
        for i in top + 1..bottom + 1 {
            push(out, m[i][right]);
        }
        if top < bottom {
            var j = right - 1;
            while j >= left {
                push(out, m[bottom][j]);
                set j = j - 1;
            }
        }
        if left < right {
            var i = bottom - 1;
            while i > top {
                push(out, m[i][left]);
                set i = i - 1;
            }
        }
        set top = top + 1;
        set bottom = bottom - 1;
        set left = left + 1;
        set right = right - 1;
    }
    return out;
}

fn main() -> result[void] uses console, input {
    let head = words(try read_line());
    let r = try parse_int(head[0]);
    let c = try parse_int(head[1]);
    if r == 0 or c == 0 {
        print("empty");
        return ok();
    }
    var m = new list[list[str]];
    for _ in 0..r {
        push(m, words(try read_line()));
    }
    if head[2] == "ccw" {
        let t = new list[list[str]];
        for j in 0..c {
            let col = new list[str];
            for i in 0..r {
                push(col, m[i][j]);
            }
            push(t, col);
        }
        set m = t;
    }
    print(join(spiral(m), " "));
    return ok();
}
