fn adler(text: str) -> int {
    var a = 1;
    var b = 0;
    for c in chars(text) {
        set a = (a + ord(c)) % 65521;
        set b = (b + a) % 65521;
    }
    return b * 65536 + a;
}

# Checksums are slow for big files: remember them in cache/ between runs.
fn checksum(name: str, text: str) -> int uses file.read("cache/"), file.write("cache/") {
    let path = "cache/" + join(split(name, "/"), "_") + "." + str(len(text));
    match read_file(path) {
        case ok(cached) {
            match parse_int(cached) {
                case ok(v) {
                    return v;
                }
                case err(_) {
                }
            }
        }
        case err(_) {
        }
    }
    let v = adler(text);
    match write_file(path, str(v)) {
        case ok {
        }
        case err(_) {
        }
    }
    return v;
}

fn main() uses console, input, file.read("cache/", "data/"), file.write("cache/") {
    var found = 0;
    var total = 0;
    while true {
        match read_line() {
            case ok(name) {
                if name == "" {
                    continue;
                }
                match read_file("data/" + name) {
                    case ok(text) {
                        let lines = len(split(text, "\n")) - 1;
                        print(name + " " + str(checksum(name, text)) + " " + str(len(text)) + " " + str(lines));
                        set found = found + 1;
                        set total = total + len(text);
                    }
                    case err(_) {
                        print(name + " missing");
                    }
                }
            }
            case err(_) {
                break;
            }
        }
    }
    print("total " + str(found) + " " + str(total));
}
