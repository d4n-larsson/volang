import world;

export record Player {
    room: str;
    inventory: list[str];
    score: int;
    moves: int;
    visited: map[str, bool];
    # every item ever picked up (points are only earned the first time)
    taken: map[str, bool];
}

export fn not_here() -> int {
    return -1;
}

export fn too_heavy() -> int {
    return -2;
}

export fn new_player() -> Player {
    let visited = new map[str, bool];
    set visited[world.start_room()] = true;
    return new Player { room: world.start_room(), inventory: new list[str], score: 0, moves: 0, visited: visited, taken: new map[str, bool] };
}

# Moves through an exit of the current room; false if there is none.
export fn move(player: Player, world_value: map[str, world.Room], direction: str) -> bool {
    let room = world_value[player.room];
    if not has(room.exits, direction) {
        return false;
    }
    set player.room = room.exits[direction];
    set player.moves = player.moves + 1;
    if not has(player.visited, player.room) {
        set player.visited[player.room] = true;
        set player.score = player.score + world.visit_points();
    }
    return true;
}

fn contains(xs: list[str], x: str) -> bool {
    return any(xs, fn(y) => y == x);
}

# Moves an item from the current room to the inventory; returns the points earned, not_here() or too_heavy().
export fn pick_up(player: Player, world_value: map[str, world.Room], item: str) -> int {
    let room = world_value[player.room];
    if not contains(room.items, item) {
        return not_here();
    }
    if carried_weight(player) + world.item_weight(item) > world.carry_limit() {
        return too_heavy();
    }
    set room.items = without(room.items, item);
    push(player.inventory, item);
    if has(player.taken, item) {
        return 0;
    }
    set player.taken[item] = true;
    let points = world.item_value(item);
    set player.score = player.score + points;
    return points;
}

fn without(xs: list[str], item: str) -> list[str] {
    return filter(xs, fn(x) => x != item);
}

fn carried_weight(player: Player) -> int {
    return fold(player.inventory, 0, fn(total, i) => total + world.item_weight(i));
}

# Moves an item from the inventory to the current room; false if it is not carried.
export fn put_down(player: Player, world_value: map[str, world.Room], item: str) -> bool {
    if not contains(player.inventory, item) {
        return false;
    }
    set player.inventory = without(player.inventory, item);
    push(world_value[player.room].items, item);
    return true;
}
