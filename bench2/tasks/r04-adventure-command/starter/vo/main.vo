import commands;
import player;
import world;

# Number of words after the verb that each command takes.
fn arity() -> map[str, int] {
    let a = new map[str, int];
    set a["look"] = 0;
    set a["go"] = 1;
    set a["take"] = 1;
    set a["inventory"] = 0;
    set a["score"] = 0;
    set a["quit"] = 0;
    return a;
}

fn run(words: list[str], player_value: player.Player, world_value: map[str, world.Room]) -> list[str] {
    let verb = words[0];
    let args_value = slice(words, 1, len(words));
    let counts = arity();
    if not has(counts, verb) {
        return ["unknown command " + verb];
    }
    if len(args_value) != counts[verb] {
        return ["what?"];
    }
    if verb == "look" {
        return commands.do_look(player_value, world_value);
    }
    if verb == "go" {
        return commands.do_go(player_value, world_value, args_value[0]);
    }
    if verb == "take" {
        return commands.do_take(player_value, world_value, args_value[0]);
    }
    if verb == "inventory" {
        return commands.do_inventory(player_value);
    }
    if verb == "score" {
        return commands.do_score(player_value);
    }
    return commands.do_quit(player_value);
}

fn main() uses console, input {
    let world_value = world.make_world();
    let player_value = player.new_player();
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, player_value, world_value) {
            print(out);
        }
        if words[0] == "quit" and len(words) == 1 {
            break;
        }
    }
}
