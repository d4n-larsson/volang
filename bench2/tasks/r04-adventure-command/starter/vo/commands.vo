import player;
import world;

fn describe(world_value: map[str, world.Room], room_id: str) -> list[str] {
    let room = world_value[room_id];
    let exits = keys(room.exits);
    sort(exits);
    var items = "none";
    if len(room.items) > 0 {
        set items = join(room.items, ", ");
    }
    return ["== " + room.title + " ==", "exits: " + join(exits, " "), "items: " + items];
}

export fn do_look(player_value: player.Player, world_value: map[str, world.Room]) -> list[str] {
    return describe(world_value, player_value.room);
}

export fn do_go(player_value: player.Player, world_value: map[str, world.Room], direction: str) -> list[str] {
    if not player.move(player_value, world_value, direction) {
        return ["you can't go " + direction];
    }
    return describe(world_value, player_value.room);
}

export fn do_take(player_value: player.Player, world_value: map[str, world.Room], item: str) -> list[str] {
    let points = player.pick_up(player_value, world_value, item);
    if points < 0 {
        return ["no " + item + " here"];
    }
    if points > 0 {
        return ["taken " + item + " (+" + str(points) + ")"];
    }
    return ["taken " + item];
}

export fn do_inventory(player_value: player.Player) -> list[str] {
    if len(player_value.inventory) == 0 {
        return ["you carry nothing"];
    }
    return ["you carry: " + join(player_value.inventory, ", ")];
}

fn score_text(player_value: player.Player) -> str {
    return "score " + str(player_value.score) + " in " + str(player_value.moves) + " moves";
}

export fn do_score(player_value: player.Player) -> list[str] {
    return [score_text(player_value)];
}

export fn do_quit(player_value: player.Player) -> list[str] {
    return ["final " + score_text(player_value)];
}
