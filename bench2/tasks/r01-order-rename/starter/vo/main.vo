import catalog;
import orders;
import report;

fn is_number(s: str) -> bool {
    if len(s) == 0 {
        return false;
    }
    return all(chars(s), fn(c: str) -> bool {
        return c >= "0" and c <= "9";
    });
}

# Only called on strings that passed is_number.
fn num(s: str) -> int {
    match parse_int(s) {
        case ok(n) {
            return n;
        }
        case err(_) {
            return 0;
        }
    }
}

fn run(words: list[str], catalog_value: map[str, catalog.Item], orders_value: map[str, orders.Order]) -> list[str] {
    let cmd = words[0];
    let args_value = slice(words, 1, len(words));
    if cmd == "add-item" {
        if len(args_value) != 4 or not is_number(args_value[2]) or not is_number(args_value[3]) {
            return ["error: bad command"];
        }
        return [catalog.add_item(catalog_value, args_value[0], args_value[1], num(args_value[2]), num(args_value[3]))];
    }
    if cmd == "restock" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return ["error: bad command"];
        }
        return [catalog.restock_item(catalog_value, args_value[0], num(args_value[1]))];
    }
    if cmd == "price" {
        if len(args_value) != 2 or not is_number(args_value[1]) {
            return ["error: bad command"];
        }
        return [catalog.set_item_price(catalog_value, args_value[0], num(args_value[1]), report.money)];
    }
    if cmd == "order" {
        if len(args_value) < 3 or len(args_value) % 2 != 1 {
            return ["error: bad command"];
        }
        let pairs = new list[orders.Line];
        var i = 1;
        while i < len(args_value) {
            if not is_number(args_value[i + 1]) or num(args_value[i + 1]) == 0 {
                return ["error: bad command"];
            }
            push(pairs, new orders.Line { sku: args_value[i], qty: num(args_value[i + 1]), price: 0 });
            set i = i + 2;
        }
        match orders.place_order(catalog_value, orders_value, args_value[0], pairs) {
            case ok(order) {
                return [report.placed_line(order)];
            }
            case err(e) {
                return [e];
            }
        }
    }
    if cmd == "cancel" {
        if len(args_value) != 1 {
            return ["error: bad command"];
        }
        return [orders.cancel_order(catalog_value, orders_value, args_value[0])];
    }
    if cmd == "show" {
        if len(args_value) != 1 {
            return ["error: bad command"];
        }
        if not has(orders_value, args_value[0]) {
            return ["error: unknown order " + args_value[0]];
        }
        return report.show_order(orders_value[args_value[0]]);
    }
    if cmd == "report" {
        if len(args_value) != 0 {
            return ["error: bad command"];
        }
        return report.full_report(catalog_value, orders_value);
    }
    return ["error: unknown command " + cmd];
}

fn main() uses console, input {
    let catalog_value = new map[str, catalog.Item];
    let orders_value = new map[str, orders.Order];
    for line in split(read_all(), "\n") {
        let words = filter(split(line, " "), fn(w: str) -> bool {
            return w != "";
        });
        if len(words) == 0 {
            continue;
        }
        for out in run(words, catalog_value, orders_value) {
            print(out);
        }
    }
}
