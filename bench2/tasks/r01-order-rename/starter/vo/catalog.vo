export record Item {
    sku: str;
    name: str;
    price: int;
    stock: int;
    sold: int;
}

export fn add_item(catalog: map[str, Item], sku: str, name: str, price: int, stock: int) -> str {
    if has(catalog, sku) {
        return "error: item " + sku + " exists";
    }
    set catalog[sku] = new Item { sku: sku, name: name, price: price, stock: stock, sold: 0 };
    return "item " + sku + " added";
}

export fn restock_item(catalog: map[str, Item], sku: str, n: int) -> str {
    if not has(catalog, sku) {
        return "error: unknown item " + sku;
    }
    let item = catalog[sku];
    set item.stock = item.stock + n;
    return "item " + sku + " stock " + str(item.stock);
}

export fn set_item_price(catalog: map[str, Item], sku: str, price: int, money: fn(int) -> str) -> str {
    if not has(catalog, sku) {
        return "error: unknown item " + sku;
    }
    let item = catalog[sku];
    set item.price = price;
    return "item " + sku + " price " + money(price);
}

export fn sorted_items(catalog: map[str, Item]) -> list[Item] {
    let skus = keys(catalog);
    sort(skus);
    return map(skus, fn(sku) => catalog[sku]);
}
