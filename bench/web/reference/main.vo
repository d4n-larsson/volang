# Reference solution of bench/web (std.web): validates the acceptance suite.
import std.http;
import std.sqlite;
import std.web;

# The inventory database in data/, read and written by every operation.
effects Storage = file.read("data/"), file.write("data/");

record Store {
    db: sqlite.Database[uses Storage];
}

record Item {
    id: int;
    sku: str;
    name: str;
    quantity: int;
}

record Fields {
    @size(3, 12)
    @pattern("[A-Z0-9]+")
    sku: str;
    @size(1, 50)
    name: str;
    @range(0, 10000)
    quantity: int;
}

record NewItem {
    body: Fields;
}

record ItemId {
    id: int;
}

record Change {
    id: int;
    body: Fields;
}

record BySku {
    sku: str;
}

record Delta {
    @range(-10000, 10000)
    delta: int;
}

record Adjust {
    id: int;
    body: Delta;
}

record NewName {
    @size(1, 50)
    name: str;
}

record Rename {
    id: int;
    body: NewName;
}

record Ids {
    @size(1, 100)
    ids: list[int];
}

record BulkDelete {
    body: Ids;
}

record Count {
    count: int;
}

record Filter {
    @default(-1)
    min_quantity: int;
}

fn open_store() -> result[Store] uses Storage {
    let db = try sqlite.open("data/inventory.db");
    let _ = try sqlite.exec(
        db,
        sqlite.sql(
            "create table if not exists items (id integer primary key, sku text not null unique, name text not null, quantity integer not null)"
        ),
        new list[sqlite.Value]
    );
    return ok(new Store { db: db });
}

fn item_of(row: sqlite.Row) -> result[Item] {
    return ok(new Item {
        id: try sqlite.int_column(row, "id"),
        sku: try sqlite.text_column(row, "sku"),
        name: try sqlite.text_column(row, "name"),
        quantity: try sqlite.int_column(row, "quantity")
    });
}

fn find_item(s: Store, id: int) -> result[Item] uses Storage {
    let rows = try sqlite.query(s.db, sqlite.sql("select id, sku, name, quantity from items where id = ?"), [
        sqlite.Value.integer(id)
    ]);
    if len(rows) == 0 {
        return err("not_found: no item " + str(id));
    }
    return item_of(rows[0]);
}

fn unique(e: str) -> str {
    if find(e, "UNIQUE") >= 0 {
        return "conflict: the sku is taken";
    }
    return e;
}

fn list_items(s: Store, input: Filter) -> result[http.Response] uses Storage {
    let out = new list[Item];
    for row in try sqlite.query(
        s.db,
        sqlite.sql("select id, sku, name, quantity from items where quantity >= ? order by id"),
        [sqlite.Value.integer(input.min_quantity)]
    ) {
        push(out, try item_of(row));
    }
    return ok(web.json_reply(200, out));
}

fn add(s: Store, input: NewItem) -> result[http.Response] uses Storage {
    let f = input.body;
    match sqlite.exec(s.db, sqlite.sql("insert into items (sku, name, quantity) values (?, ?, ?)"), [
        sqlite.Value.text(f.sku),
        sqlite.Value.text(f.name),
        sqlite.Value.integer(f.quantity)
    ]) {
        case ok(c) {
            return ok(web.created("/items/" + str(c.last_id), new Item {
                id: c.last_id,
                sku: f.sku,
                name: f.name,
                quantity: f.quantity
            }));
        }
        case err(e) {
            return err(unique(e));
        }
    }
}

fn show(s: Store, input: ItemId) -> result[http.Response] uses Storage {
    return ok(web.json_reply(200, try find_item(s, input.id)));
}

fn change(s: Store, input: Change) -> result[http.Response] uses Storage {
    let _ = try find_item(s, input.id);
    let f = input.body;
    match sqlite.exec(s.db, sqlite.sql("update items set sku = ?, name = ?, quantity = ? where id = ?"), [
        sqlite.Value.text(f.sku),
        sqlite.Value.text(f.name),
        sqlite.Value.integer(f.quantity),
        sqlite.Value.integer(input.id)
    ]) {
        case ok(_) {
            return ok(web.json_reply(200, new Item {
                id: input.id,
                sku: f.sku,
                name: f.name,
                quantity: f.quantity
            }));
        }
        case err(e) {
            return err(unique(e));
        }
    }
}

fn remove_item(s: Store, input: ItemId) -> result[http.Response] uses Storage {
    let _ = try find_item(s, input.id);
    let _ = try sqlite.exec(s.db, sqlite.sql("delete from items where id = ?"), [sqlite.Value.integer(input.id)]);
    return ok(web.no_content());
}

fn by_sku(s: Store, input: BySku) -> result[http.Response] uses Storage {
    let rows = try sqlite.query(s.db, sqlite.sql("select id, sku, name, quantity from items where sku = ?"), [
        sqlite.Value.text(input.sku)
    ]);
    if len(rows) == 0 {
        return err("not_found: no item with sku " + input.sku);
    }
    return ok(web.json_reply(200, try item_of(rows[0])));
}

fn adjust(s: Store, input: Adjust) -> result[http.Response] uses Storage {
    let item = try find_item(s, input.id);
    let quantity = item.quantity + input.body.delta;
    if quantity < 0 or quantity > 10000 {
        return err("unprocessable: the quantity would be " + str(quantity));
    }
    let _ = try sqlite.exec(s.db, sqlite.sql("update items set quantity = ? where id = ?"), [
        sqlite.Value.integer(quantity),
        sqlite.Value.integer(input.id)
    ]);
    return ok(web.json_reply(200, new Item {
        id: item.id,
        sku: item.sku,
        name: item.name,
        quantity: quantity
    }));
}

fn count(s: Store, input: web.NoInput) -> result[http.Response] uses Storage {
    let rows = try sqlite.query(s.db, sqlite.sql("select count(*) as n from items"), new list[sqlite.Value]);
    return ok(web.json_reply(200, new Count { count: try sqlite.int_column(rows[0], "n") }));
}

fn rename_item(s: Store, input: Rename) -> result[http.Response] uses Storage {
    let item = try find_item(s, input.id);
    let _ = try sqlite.exec(s.db, sqlite.sql("update items set name = ? where id = ?"), [
        sqlite.Value.text(input.body.name),
        sqlite.Value.integer(input.id)
    ]);
    return ok(web.json_reply(200, new Item {
        id: item.id,
        sku: item.sku,
        name: input.body.name,
        quantity: item.quantity
    }));
}

fn delete_many(s: Store, input: BulkDelete) -> result[http.Response] uses Storage {
    for id in input.body.ids {
        let _ = try sqlite.exec(s.db, sqlite.sql("delete from items where id = ?"), [sqlite.Value.integer(id)]);
    }
    return ok(web.no_content());
}

fn routes() -> list[web.Route[Store, uses Storage]] {
    return [
        web.on_get("/items", list_items),
        web.on_post("/items", add),
        web.on_get("/items/{id}", show),
        web.on_put("/items/{id}", change),
        web.on_delete("/items/{id}", remove_item),
        web.on_get("/skus/{sku}", by_sku),
        web.on_post("/items/{id}/adjust", adjust),
        web.on_get("/stats/count", count),
        web.on_post("/items/{id}/rename", rename_item),
        web.on_post("/bulk/delete", delete_many)
    ];
}

fn main() -> result[void] uses serve("8765"), Storage {
    return web.serve_app("8765", 2, open_store, new web.App {
        routes: routes(),
        steps: new list[web.Step[Store, uses Storage]],
        errors: new list[web.ErrorStatus]
    });
}
