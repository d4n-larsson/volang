{
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh /home/dan/dev/priv/sesi/scripts/sesi hook",
            "timeout": 60,
            "statusMessage": "Checking with SESI packs"
          },
          {
            "type": "command",
            "command": "sh /home/dan/dev/priv/volang/tools/cc_check.sh",
            "timeout": 120,
            "statusMessage": "Checking C with the strict warning set"
          }
        ]
      }
    ]
  }
}
