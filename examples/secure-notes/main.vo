# Secure notes: a JSON service whose access rules are one table (std.security on std.web).
#   vo run main.vo        serve on http://localhost:8080 until Ctrl-C
#   vo test main.vo       every route for every kind of caller, without a network
# Notes are kept in memory by one worker, to keep the example about access control. The key that signs
# the tokens is made at start, so a restart signs everybody out.
import notes;
import std.crypto;
import std.security;
import std.web;
import store;

fn main() -> result[void] uses console, clock, serve("8080"), entropy {
    let key = crypto.random_bytes(32);
    let no_more = new list[security.Way[store.Store, uses clock, entropy]];
    print("secure notes on http://localhost:8080 (Ctrl-C stops)");
    try web.serve_app("8080", 1, fn() -> result[store.Store] {
        return ok(store.new_store());
    }, notes.notes_app(key, no_more, fn() -> int {
        return now_ms();
    }, crypto.random_bytes));
    print("stopped");
    return ok();
}
