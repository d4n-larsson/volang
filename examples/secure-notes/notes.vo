# The secure notes service: who may call what is the one table in rules(); the operations get the
# signed-in user from the identity the policy step passes on. Programs sign in with a token, browsers
# with a session cookie: two ways, one table.
import std.bytes;
import std.http;
import std.json;
import std.option;
import std.security;
import std.web;
import store;

# Who may call what. A route no rule mentions is refused.
export fn rules() -> list[security.Rule] {
    return [
        security.rule("/health", security.Access.anyone),
        security.rule_for(["POST"], "/token", security.Access.anyone),
        security.rule_for(["POST"], "/sign-in", security.Access.anyone),
        security.rule_for(["POST"], "/sign-out", security.Access.anyone),
        security.rule("/admin", security.Access.any_role(["admin"])),
        security.rule("/notes", security.Access.signed_in)
    ];
}

record Caller {
    @header("X-Identity")
    @default("")
    identity: str;
}

record NewNote {
    @size(1, 200)
    text: str;
}

record Add {
    body: NewNote;
    @header("X-Identity")
    @default("")
    identity: str;
}

record ById {
    id: int;
    @header("X-Identity")
    @default("")
    identity: str;
}

fn alive(store_value: store.Store, input: web.NoInput) -> result[http.Response] {
    return ok(web.json_reply(200, "up"));
}

fn my_notes(store_value: store.Store, input: Caller) -> result[http.Response] {
    let user = try security.require_user(input.identity);
    let mine = new list[store.Note];
    for n in store_value.notes {
        if n.owner == user.name {
            push(mine, n);
        }
    }
    return ok(web.json_reply(200, mine));
}

fn add(store_value: store.Store, input: Add) -> result[http.Response] {
    let user = try security.require_user(input.identity);
    let note = new store.Note { id: store_value.next_id, owner: user.name, text: input.body.text };
    set store_value.next_id = store_value.next_id + 1;
    push(store_value.notes, note);
    return ok(web.created("/notes/" + str(note.id), note));
}

fn erase(store_value: store.Store, input: ById) -> result[http.Response] {
    let user = try security.require_user(input.identity);
    let kept = new list[store.Note];
    var found = false;
    for n in store_value.notes {
        if n.id != input.id {
            push(kept, n);
        } else if n.owner == user.name or security.has_role(user, "admin") {
            set found = true;
        } else {
            return err("forbidden: not your note");
        }
    }
    if not found {
        return err("not_found: no note " + str(input.id));
    }
    set store_value.notes = kept;
    return ok(web.no_content());
}

fn users(store_value: store.Store, input: web.NoInput) -> result[http.Response] {
    let names = new list[str];
    for a in store_value.accounts {
        push(names, a.name);
    }
    return ok(web.json_reply(200, names));
}

# The policy: the rules, tokens signed with key (32 bytes or more) for programs and session cookies for
# browsers. more_ways is empty when serving and [test_users()] in tests; now is the clock.
export fn notes_policy[E: effects](
    key: bytes,
    more_ways: list[security.Way[store.Store, uses E]],
    now: fn() -> int uses E,
    random: fn(int) -> bytes uses E
) -> security.Policy[store.Store, uses E] {
    let ways: list[security.Way[store.Store, uses E]] = [
        security.tokens([key]),
        security.browser(store.browsers(random))
    ];
    for w in more_ways {
        push(ways, w);
    }
    return security.policy(rules(), ways, now);
}

# The application: its routes, and the policy step in front of all of them.
export fn notes_app[E: effects](
    key: bytes,
    more_ways: list[security.Way[store.Store, uses E]],
    now: fn() -> int uses E,
    random: fn(int) -> bytes uses E
) -> web.App[store.Store, uses E] {
    let p = notes_policy(key, more_ways, now, random);
    let routes: list[web.Route[store.Store, uses E]] = [
        web.on_get("/health", alive),
        security.sign_in_route("/token", p, store.find_account, key, 3600)
    ];
    for rt in security.browser_routes(store.browsers(random), p) {
        push(routes, rt);
    }
    push(routes, web.on_get("/notes", my_notes));
    push(routes, web.on_post("/notes", add));
    push(routes, web.on_delete("/notes/{id}", erase));
    push(routes, web.on_get("/admin/users", users));
    return new web.App {
        routes: routes,
        steps: [security.safe_headers(0), security.secure(p)],
        errors: new list[web.ErrorStatus]
    };
}

# ---- tests: every request goes through the application, without a network ----

fn test_app() -> web.App[store.Store] {
    let more: list[security.Way[store.Store]] = [security.test_users()];
    return notes_app(bytes.from_text("a test key of thirty-two bytes!!"), more, fn() -> int {
        return 0;
    }, fixed_random);
}

fn fixed_random(n: int) -> bytes {
    return bytes.from_text("0123456789abcdef");
}

fn ada() -> security.User {
    return new security.User { name: "ada", roles: ["admin"] };
}

fn bo() -> security.User {
    return new security.User { name: "bo", roles: new list[str] };
}

fn call(
    store_value: store.Store,
    user: security.User,
    method: str,
    path: str,
    body: str
) -> http.Response {
    return web.handle_request(test_app(), store_value, security.as_user(
        web.request(method, path, body),
        user
    ));
}

test "the review of the policy that is served finds nothing" {
    let none = new list[security.Way[store.Store]];
    let served = notes_app(bytes.from_text("a test key of thirty-two bytes!!"), none, fn() -> int {
        return 0;
    }, fixed_random);
    let p = notes_policy(bytes.from_text("a test key of thirty-two bytes!!"), none, fn() -> int {
        return 0;
    }, fixed_random);
    expect_eq(security.review(served, p), [
        "browsers sign in: browser (sign-in /sign-in, sign-out /sign-out, 28800 s, origin from Host)"
    ]);
}

test "who may call what" {
    let none = new list[security.Way[store.Store]];
    let served = notes_app(bytes.from_text("a test key of thirty-two bytes!!"), none, fn() -> int {
        return 0;
    }, fixed_random);
    expect_eq(security.describe(served, rules()), join(
        [
            "GET /health: anyone",
            "POST /token: anyone",
            "POST /sign-in: anyone",
            "POST /sign-out: anyone",
            "GET /notes: signed in",
            "POST /notes: signed in",
            "DELETE /notes/{id}: signed in",
            "GET /admin/users: roles admin"
        ],
        "\n"
    ));
}

test "every route answers each caller as the rules decide" {
    let requests = [
        web.request("GET", "/health", ""),
        web.request("POST", "/token", `{"name": "x", "password": "y"}`),
        web.request("GET", "/notes", ""),
        web.request("POST", "/notes", `{"text": "a"}`),
        web.request("DELETE", "/notes/1", ""),
        web.request("GET", "/admin/users", ""),
        web.request("GET", "/nothing/here", "")
    ];
    for r in requests {
        let wrong = web.handle_request(test_app(), store.new_store(), web.with_header(
            r,
            "Authorization",
            "Bearer not.a.token"
        ));
        expect_eq(wrong.status, 401);
        let callers: list[option.Option[security.User]] = [
            option.Option.none,
            option.Option.some(bo()),
            option.Option.some(ada())
        ];
        for c in callers {
            var sent = r;
            match c {
                case some(user) {
                    set sent = security.as_user(r, user);
                }
                case none {
                }
            }
            let status = web.handle_request(test_app(), store.new_store(), sent).status;
            match security.decide(rules(), r.method, r.path, c) {
                case allowed {
                    # The operation ran: its own answer (the sign-in refuses x, there is no note 1).
                    expect(
                        status == 200 or status == 201 or status == 404 or (r.path == "/token" and status == 401)
                    );
                }
                case sign_in_needed {
                    expect_eq(status, 401);
                }
                case forbidden {
                    expect_eq(status, 403);
                }
            }
        }
    }
}

test "a user sees and deletes only their own notes; an admin deletes any" {
    let store_value = store.new_store();
    expect_eq(call(store_value, bo(), "POST", "/notes", `{"text": "buy bread"}`).status, 201);
    expect_eq(
        call(store_value, ada(), "POST", "/notes", `{"text": "review the policy"}`).status,
        201
    );
    expect_eq(
        call(store_value, bo(), "GET", "/notes", "").body,
        `[{"id":1,"owner":"bo","text":"buy bread"}]`
    );
    expect_eq(call(store_value, bo(), "DELETE", "/notes/2", "").status, 403);
    expect_eq(call(store_value, ada(), "DELETE", "/notes/1", "").status, 204);
    expect_eq(call(store_value, bo(), "GET", "/notes", "").body, "[]");
    expect_eq(call(store_value, ada(), "DELETE", "/notes/9", "").status, 404);
}

test "a password is exchanged for a token, and the token signs in" {
    let store_value = store.new_store();
    let wrong = web.handle_request(test_app(), store_value, web.request(
        "POST",
        "/token",
        `{"name": "bo", "password": "guess"}`
    ));
    expect_eq(wrong.status, 401);
    let answer = web.handle_request(test_app(), store_value, web.request(
        "POST",
        "/token",
        `{"name": "bo", "password": "battery staple"}`
    ));
    expect_eq(answer.status, 200);
    var token = "";
    match json.parse_json(answer.body) {
        case ok(j) {
            match json.text_field(j, "token") {
                case ok(t) {
                    set token = t;
                }
                case err(_) {
                }
            }
        }
        case err(_) {
        }
    }
    let signed = web.with_header(
        web.request("POST", "/notes", `{"text": "mine"}`),
        "Authorization",
        "Bearer " + token
    );
    expect_eq(
        web.handle_request(test_app(), store_value, signed).body,
        `{"id":1,"owner":"bo","text":"mine"}`
    );
    let admin = web.with_header(
        web.request("GET", "/admin/users", ""),
        "Authorization",
        "Bearer " + token
    );
    expect_eq(web.handle_request(test_app(), store_value, admin).status, 403);
}

test "answers carry the safe headers" {
    let r = web.handle_request(test_app(), store.new_store(), web.request("GET", "/notes", ""));
    expect_eq(r.status, 401);
    expect_eq(r.headers[1].value, "Bearer");
    expect_eq(r.headers[2].name, "X-Content-Type-Options");
}

# A browser's request as the frontend's page sends it: a form or JSON body, Sec-Fetch-Site, the cookie.
fn from_browser(
    store_value: store.Store,
    method: str,
    path: str,
    body: str,
    cookie: str,
    site: str
) -> http.Response {
    let r = web.request(method, path, body);
    if body != "" and find(body, "{") != 0 {
        set r.headers = [
            new http.Header { name: "Content-Type", value: "application/x-www-form-urlencoded" }
        ];
    }
    push(r.headers, new http.Header { name: "Sec-Fetch-Site", value: site });
    if cookie != "" {
        push(r.headers, new http.Header { name: "Cookie", value: "__Host-session=" + cookie });
    }
    return web.handle_request(test_app(), store_value, r);
}

fn header(r: http.Response, name: str) -> str {
    for h in r.headers {
        if h.name == name {
            return h.value;
        }
    }
    return "";
}

test "a browser signs in with the form, keeps notes with the cookie, and signs out" {
    let store_value = store.new_store();
    let failed = from_browser(
        store_value,
        "POST",
        "/sign-in",
        "name=bo&password=guess&next=%2Fnotes",
        "",
        "same-origin"
    );
    expect_eq(header(failed, "Location"), "/sign-in?failed=1&next=%2Fnotes");
    let signed = from_browser(
        store_value,
        "POST",
        "/sign-in",
        "name=bo&password=battery+staple&next=%2Fnotes",
        "",
        "same-origin"
    );
    expect_eq(header(signed, "Location"), "/notes");
    let cookie = option.or_else(
        web.read_cookie(header(signed, "Set-Cookie"), "__Host-session"),
        ""
    );
    expect_eq(
        from_browser(store_value, "POST", "/notes", `{"text": "buy bread"}`, cookie, "same-origin").status,
        201
    );
    expect_eq(
        from_browser(store_value, "GET", "/notes", "", cookie, "same-origin").body,
        `[{"id":1,"owner":"bo","text":"buy bread"}]`
    );
    expect_eq(
        from_browser(store_value, "POST", "/notes", `{"text": "from elsewhere"}`, cookie, "cross-site").status,
        403
    );
    expect_eq(len(store_value.notes), 1);
    expect_eq(
        from_browser(store_value, "POST", "/sign-out", "", cookie, "same-origin").status,
        303
    );
    expect_eq(len(store_value.sessions), 0);
    expect_eq(from_browser(store_value, "GET", "/notes", "", cookie, "same-origin").status, 401);
}

test "a token and a session cookie reach the same operations under the same rules" {
    let store_value = store.new_store();
    let signed = from_browser(
        store_value,
        "POST",
        "/sign-in",
        "name=ada&password=correct+horse",
        "",
        "same-origin"
    );
    let cookie = option.or_else(
        web.read_cookie(header(signed, "Set-Cookie"), "__Host-session"),
        ""
    );
    expect_eq(
        from_browser(store_value, "GET", "/admin/users", "", cookie, "same-origin").body,
        `["ada","bo"]`
    );
    expect_eq(call(store_value, ada(), "GET", "/admin/users", "").body, `["ada","bo"]`);
    expect_eq(
        from_browser(store_value, "GET", "/admin/users", "", cookie, "cross-site").status,
        200
    );
}
