# The status board: reading the service's JSON documents and rendering the board. Everything here is
# pure (no `uses`): it never touches the network, so the tests feed it JSON text directly.
import std.json.Json;
import std.json.as_array;
import std.json.bool_field;
import std.json.field;
import std.json.int_field;
import std.json.parse_json;
import std.json.text_field;
import std.text.align_left;
import std.text.align_right;

export record Service {
    name: str;
    up: bool;
    latency_ms: int;
}

export record Incident {
    service: str;
    title: str;
    open: bool;
}

# The services in /status.json: {"checked": ..., "services": [{"name", "up", "latency_ms"}, ...]}.
export fn services_from(doc: Json) -> result[list[Service]] {
    let out = new list[Service];
    for s in try as_array(try field(doc, "services")) {
        push(out, new Service { name: try text_field(s, "name"), up: try bool_field(s, "up"), latency_ms: try int_field(s, "latency_ms") });
    }
    return ok(out);
}

# The incidents in /incidents.json: [{"service", "title", "open"}, ...].
export fn incidents_from(doc: Json) -> result[list[Incident]] {
    let out = new list[Incident];
    for i in try as_array(doc) {
        push(out, new Incident { service: try text_field(i, "service"), title: try text_field(i, "title"), open: try bool_field(i, "open") });
    }
    return ok(out);
}

export fn down_count(services: list[Service]) -> int {
    var n = 0;
    for s in services {
        if not s.up {
            set n = n + 1;
        }
    }
    return n;
}

# One line per service (down ones first, then by name), the slowest service that is up, and the
# open incidents.
export fn render(services: list[Service], incidents: list[Incident]) -> str {
    let rows = new list[Service];
    for s in services {
        push(rows, s);
    }
    sort_by(rows, fn(s: Service) -> str {
        return s.name;
    });
    sort_by(rows, fn(s: Service) -> int {
        if s.up {
            return 1;
        }
        return 0;
    });
    var w = 0;
    for s in rows {
        if len(chars(s.name)) > w {
            set w = len(chars(s.name));
        }
    }
    var out = str(len(rows) - down_count(rows)) + " of " + str(len(rows)) + " services up\n\n";
    var slowest = "";
    var slowest_ms = -1;
    for s in rows {
        if s.up {
            set out = out + "  up    " + align_left(s.name, w) + align_right(str(s.latency_ms), 6) + " ms\n";
            if s.latency_ms > slowest_ms {
                set slowest = s.name;
                set slowest_ms = s.latency_ms;
            }
        } else {
            set out = out + "  DOWN  " + s.name + "\n";
        }
    }
    if slowest_ms >= 0 {
        set out = out + "\nslowest: " + slowest + " (" + str(slowest_ms) + " ms)\n";
    }
    var open = "";
    for i in incidents {
        if i.open {
            set open = open + "  " + i.service + ": " + i.title + "\n";
        }
    }
    if open != "" {
        set out = out + "\nopen incidents:\n" + open;
    }
    return out;
}

fn parsed(text: str) -> Json {
    match parse_json(text) {
        case ok(j) {
            return j;
        }
        case err(e) {
            return Json.text(e);
        }
    }
}

@spec("FR-001")
test "services are read from /status.json" {
    let doc = parsed("{\"services\": [{\"name\": \"api\", \"up\": true, \"latency_ms\": 42}]}");
    expect_eq(services_from(doc), ok([new Service { name: "api", up: true, latency_ms: 42 }]));
}

@spec("FR-002")
test "a missing field is an error naming it" {
    let doc = parsed("{\"services\": [{\"name\": \"api\", \"up\": true}]}");
    expect_eq(services_from(doc), err("no field `latency_ms`"));
}

@spec("FR-003", "FR-004", "FR-005")
test "down services come first and the slowest up one is named" {
    let s = [new Service { name: "web", up: true, latency_ms: 90 }, new Service { name: "db", up: false, latency_ms: 0 }, new Service { name: "api", up: true, latency_ms: 30 }];
    let i = [new Incident { service: "db", title: "disk full", open: true }, new Incident { service: "web", title: "old", open: false }];
    expect_eq(render(s, i), "2 of 3 services up\n\n  DOWN  db\n  up    api    30 ms\n  up    web    90 ms\n\nslowest: web (90 ms)\n\nopen incidents:\n  db: disk full\n");
    expect_eq(down_count(s), 1);
}

@spec("FR-006")
test "all up, no incidents" {
    expect_eq(render([new Service { name: "api", up: true, latency_ms: 5 }], new list[Incident]), "1 of 1 services up\n\n  up    api     5 ms\n\nslowest: api (5 ms)\n");
}
