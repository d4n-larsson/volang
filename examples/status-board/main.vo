# A status board for a service on localhost: fetches /status.json and /incidents.json over plain
# HTTP, prints which services are up, and exits with status 2 when one is down (for scripts).
#   vo run main.vo -- PORT                        talk to the service (PORT defaults to 8000)
#   vo run --record r.jsonl main.vo -- PORT       ... and save every response
#   vo replay r.jsonl                             run again from the saved responses, no network
# The grant is `net("localhost")`: any other host is refused at run time (R0010).
import board.Incident;
import board.Service;
import board.down_count;
import board.incidents_from;
import board.render;
import board.services_from;
import std.http.get;
import std.json.Json;
import std.json.parse_json;

# GET base + path, which must answer 200 with JSON.
fn fetch(base: str, path: str) -> result[Json] uses net("localhost") {
    let r = try get(base + path);
    if r.status != 200 {
        return err(path + ": HTTP " + str(r.status));
    }
    return parse_json(r.body);
}

fn main() -> result[void] uses console, net("localhost") {
    var port = "8000";
    if len(args()) > 0 {
        set port = args()[0];
    }
    let base = "http://localhost:" + port;
    let services = try services_from(try fetch(base, "/status.json"));
    let incidents = try incidents_from(try fetch(base, "/incidents.json"));
    write(render(services, incidents));
    if down_count(services) > 0 {
        exit(2);
    }
    return ok();
}

fn parsed(text: str) -> Json {
    match parse_json(text) {
        case ok(j) {
            return j;
        }
        case err(e) {
            return Json.text(e);
        }
    }
}

test "services are read from /status.json" {
    let doc = parsed("{\"services\": [{\"name\": \"api\", \"up\": true, \"latency_ms\": 42}]}");
    expect_eq(services_from(doc), ok([new Service { name: "api", up: true, latency_ms: 42 }]));
}

test "a missing field is an error naming it" {
    let doc = parsed("{\"services\": [{\"name\": \"api\", \"up\": true}]}");
    expect_eq(services_from(doc), err("no field `latency_ms`"));
}

test "down services come first and the slowest up one is named" {
    let s = [new Service { name: "web", up: true, latency_ms: 90 }, new Service { name: "db", up: false, latency_ms: 0 }, new Service { name: "api", up: true, latency_ms: 30 }];
    let i = [new Incident { service: "db", title: "disk full", open: true }, new Incident { service: "web", title: "old", open: false }];
    expect_eq(render(s, i), "2 of 3 services up\n\n  DOWN  db\n  up    api    30 ms\n  up    web    90 ms\n\nslowest: web (90 ms)\n\nopen incidents:\n  db: disk full\n");
    expect_eq(down_count(s), 1);
}

test "all up, no incidents" {
    expect_eq(render([new Service { name: "api", up: true, latency_ms: 5 }], new list[Incident]), "1 of 1 services up\n\n  up    api     5 ms\n\nslowest: api (5 ms)\n");
}
