# The status board's service: answers GET /status.json and /incidents.json from the files in site/,
# and 404 for anything else, on port 8000 of this machine.
#   vo run main.vo                                serve until Ctrl-C
#   vo run --record r.jsonl main.vo               ... and save every request and response
#   vo replay r.jsonl                             answer the saved requests again, no port opened
# The grant is `serve("8000")` (this machine only) and `file.read("site/")`.
import std.http.Header;
import std.http.Request;
import std.http.Response;
import std.http.serve;

# The answer to one request: a file of site/ for the two known paths.
fn answer(r: Request) -> Response uses file.read("site/") {
    if r.method != "GET" and r.method != "HEAD" {
        return new Response { status: 405, headers: [new Header { name: "Allow", value: "GET, HEAD" }], body: "" };
    }
    if r.path != "/status.json" and r.path != "/incidents.json" {
        return new Response { status: 404, headers: new list[Header], body: "no such page\n" };
    }
    match read_file("site" + r.path) {
        case ok(body) {
            return new Response { status: 200, headers: [new Header { name: "Content-Type", value: "application/json" }], body: body };
        }
        case err(e) {
            return new Response { status: 500, headers: new list[Header], body: e + "\n" };
        }
    }
}

fn main() -> result[void] uses console, file.read("site/"), serve("8000") {
    print("serving site/ on http://localhost:8000 (Ctrl-C stops)");
    try serve("8000", answer);
    print("stopped");
    return ok();
}

fn get(path: str) -> Request {
    return new Request { method: "GET", path: path, query: "", headers: new list[Header], body: "" };
}

@spec("SV-001")
test "the two pages are JSON from site/" uses file.read("site/") {
    let r = answer(get("/status.json"));
    expect_eq(r.status, 200);
    expect(len(r.body) > 0);
    expect_eq(answer(get("/incidents.json")).status, 200);
}

@spec("SV-002")
test "anything else is 404, other methods 405" uses file.read("site/") {
    expect_eq(answer(get("/secrets")).status, 404);
    expect_eq(answer(new Request { method: "POST", path: "/status.json", query: "", headers: new list[Header], body: "" }).status, 405);
}
