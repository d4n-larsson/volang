# The HTTP API: the route table, each operation's input (checked by std.web before it runs) and its answer.
# The operations fail with a NoteError, which note_problem answers with a status: one function, so
# every way to fail has its status (spec 032); bad input becomes 400 or 422.
import notes.Note;
import notes.NoteError;
import notes.add_note;
import notes.all_notes;
import notes.db_error;
import notes.find_note;
import notes.mark_done;
import notes.prepare;
import notes.remove_note;
import std.http.Response;
import std.json.int_field;
import std.json.parse_json;
import std.json.text_field;
import std.sqlite.Database;
import std.sqlite.Value;
import std.sqlite.open;
import std.sqlite.open_memory;
import std.sqlite.query;
import std.sqlite.sql;
import std.web.App;
import std.web.HealthCheck;
import std.web.NoInput;
import std.web.Problem;
import std.web.created;
import std.web.handle_request;
import std.web.health_route;
import std.web.json_reply;
import std.web.no_content;
import std.web.on_delete;
import std.web.on_get;
import std.web.on_post;
import std.web.request;
import std.web.typed;
import std.web.web_app;

# Where the notes are kept: the database in data/, read and written.
const data_dir = "data/";

export effects Storage = file.read(data_dir), file.write(data_dir);

# Each worker's context: its connection to the notes database.
export record Notes[D: effects] {
    db: Database[D];
}

record NoteText {
    @size(1, 200)
    text: str;
}

record NewNote {
    body: NoteText;
}

record NoteId {
    id: int;
}

# GET /notes, POST /notes, GET /notes/ID, POST /notes/ID/done, DELETE /notes/ID, GET /health.
# Each operation is typed(op, note_problem); the types are written out because the operations are
# generic in the database's effects, which inference does not follow through two generic calls.
export fn notes_app[D: effects]() -> App[Notes[D], uses D] {
    let listing: fn(Notes[D], NoInput) -> result[Response] uses D = typed(list_notes, note_problem);
    let adding: fn(Notes[D], NewNote) -> result[Response] uses D = typed(create, note_problem);
    let showing: fn(Notes[D], NoteId) -> result[Response] uses D = typed(show, note_problem);
    let finishing: fn(Notes[D], NoteId) -> result[Response] uses D = typed(done, note_problem);
    let erasing: fn(Notes[D], NoteId) -> result[Response] uses D = typed(erase, note_problem);
    return web_app([
        on_get("/notes", listing),
        on_post("/notes", adding),
        on_get("/notes/{id}", showing),
        on_post("/notes/{id}/done", finishing),
        on_delete("/notes/{id}", erasing),
        health_route([new HealthCheck { name: "database", check: alive }])
    ]);
}

# serve_app's setup: data/notes.db, with its table the first time.
export fn open_notes() -> result[Notes[uses Storage]] uses Storage {
    let db = try open(data_dir + "notes.db");
    try prepare(db);
    return ok(new Notes { db: db });
}

# The status and detail of each way the notes can fail (a database failure is 500, with no detail).
fn note_problem(e: NoteError) -> Problem {
    match e {
        case not_found(id) {
            return new Problem { status: 404, detail: "no note " + str(id) };
        }
        case blank {
            return new Problem { status: 422, detail: "the text is only spaces" };
        }
        case database(_) {
            return new Problem { status: 500, detail: "" };
        }
    }
}

fn list_notes[D: effects](app: Notes[D], input: NoInput) -> result[Response, NoteError] uses D {
    return ok(json_reply(200, try map_err(all_notes(app.db), db_error)));
}

fn create[D: effects](app: Notes[D], input: NewNote) -> result[Response, NoteError] uses D {
    let text = trim(input.body.text);
    if text == "" {
        return err(NoteError.blank);
    }
    let note = try map_err(add_note(app.db, text), db_error);
    return ok(created("/notes/" + str(note.id), note));
}

fn show[D: effects](app: Notes[D], input: NoteId) -> result[Response, NoteError] uses D {
    return ok(json_reply(200, try find_note(app.db, input.id)));
}

fn done[D: effects](app: Notes[D], input: NoteId) -> result[Response, NoteError] uses D {
    return ok(json_reply(200, try mark_done(app.db, input.id)));
}

fn erase[D: effects](app: Notes[D], input: NoteId) -> result[Response, NoteError] uses D {
    try remove_note(app.db, input.id);
    return ok(no_content());
}

fn alive[D: effects](app: Notes[D]) -> result[void] uses D {
    let _ = try query(app.db, sql("select 1"), new list[Value]);
    return ok();
}

fn memory() -> Notes {
    let db = open_memory();
    match prepare(db) {
        case ok() {
        }
        case err(_) {
        }
    }
    return new Notes { db: db };
}

fn call(n: Notes, method: str, path: str, body: str) -> Response {
    return handle_request(notes_app(), n, request(method, path, body));
}

@spec("FR-001")
test "GET /notes lists the notes as JSON" {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "water the plants"}`);
    let r = call(n, "GET", "/notes", "");
    expect_eq(r.status, 200);
    expect_eq(r.body, `[{"id":1,"text":"water the plants","done":false}]`);
}

@spec("FR-002")
test "POST /notes adds a note with the next id" {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "a"}`);
    let r = call(n, "POST", "/notes", `{"text": " buy bread "}`);
    expect_eq(r.status, 201);
    expect_eq(r.body, `{"id":2,"text":"buy bread","done":false}`);
    expect_eq(r.headers[1].value, "/notes/2");
}

@spec("FR-003")
test "a missing, empty or too long text is refused with the reason" {
    let n = memory();
    expect_eq(call(n, "POST", "/notes", "{}").status, 400);
    expect_eq(call(n, "POST", "/notes", `{"text": "   "}`).status, 422);
    expect_eq(call(n, "POST", "/notes", "not json").status, 400);
    match parse_json(call(n, "POST", "/notes", `{"txt": "typo"}`).body) {
        case ok(j) {
            expect_eq(int_field(j, "status"), ok(400));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
}

@spec("FR-004")
test "one note: read, mark done, delete" {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "call home"}`);
    expect_eq(call(n, "GET", "/notes/1", "").body, `{"id":1,"text":"call home","done":false}`);
    match parse_json(call(n, "POST", "/notes/1/done", "").body) {
        case ok(j) {
            expect_eq(text_field(j, "text"), ok("call home"));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
    expect_eq(call(n, "DELETE", "/notes/1", "").status, 204);
    expect_eq(call(n, "GET", "/notes", "").body, "[]");
}

@spec("FR-005")
test "unknown notes and paths are 404, other methods 405" {
    let n = memory();
    expect_eq(call(n, "GET", "/notes/9", "").status, 404);
    expect_eq(call(n, "GET", "/notes/x", "").status, 400);
    expect_eq(call(n, "GET", "/", "").status, 404);
    expect_eq(call(n, "PUT", "/notes", "").status, 405);
}

@spec("FR-006")
test "the notes are kept in the database between requests" {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "one"}`);
    let _ = call(n, "POST", "/notes", `{"text": "two"}`);
    expect_eq(all_notes(n.db), ok([
        new Note { id: 1, text: "one", done: false },
        new Note { id: 2, text: "two", done: false }
    ]));
}

@spec("FR-002")
prop "added notes get distinct ids" (texts: list[str]) {
    let n = memory();
    let ids = new map[int, bool];
    for t in texts {
        match add_note(n.db, t) {
            case ok(note) {
                expect(not has(ids, note.id));
                set ids[note.id] = true;
            }
            case err(e) {
                expect_eq(e, "");
            }
        }
    }
    expect_eq(len(ids), len(texts));
}
