# vo effects record: update with `vo effects --update`
api.vo:alive uses D
api.vo:call pure
api.vo:create uses D
api.vo:done uses D
api.vo:erase uses D
api.vo:list_notes uses D
api.vo:memory pure
api.vo:notes_app pure
api.vo:open_notes uses file.read("data/"), file.write("data/")
api.vo:prop "added notes get distinct ids" pure
api.vo:show uses D
api.vo:test "GET /notes lists the notes as JSON" pure
api.vo:test "POST /notes adds a note with the next id" pure
api.vo:test "a missing, empty or too long text is refused with the reason" pure
api.vo:test "one note: read, mark done, delete" pure
api.vo:test "the notes are kept in the database between requests" pure
api.vo:test "unknown notes and paths are 404, other methods 405" pure
main.vo:main uses console, file.read("data/"), file.write("data/"), serve("8080")
notes.vo:add_note uses D
notes.vo:all_notes uses D
notes.vo:find_note uses D
notes.vo:mark_done uses D
notes.vo:note_of pure
notes.vo:prepare uses D
notes.vo:remove_note uses D
