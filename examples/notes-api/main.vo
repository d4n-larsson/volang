# A notes service: a JSON API over plain HTTP, the notes kept in data/notes.json.
#   vo run main.vo                                serve on http://localhost:8080 until Ctrl-C
#   vo run --record r.jsonl main.vo               ... and save every request, file access and response
#   vo replay r.jsonl                             answer the saved requests again: no port, no files
# The grant is `serve("8080")` (this machine only) and data/ for reading and writing.
import api.handle;
import std.http.serve;

fn main() -> result[void] uses console, file.read("data/"), file.write("data/"), serve("8080") {
    print("notes on http://localhost:8080/notes (Ctrl-C stops)");
    try serve("8080", handle);
    print("stopped");
    return ok();
}
