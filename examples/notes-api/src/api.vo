# The HTTP API: the route table, each operation's input (checked by std.web before it runs) and its answer.
# The operations fail with a NoteError, which note_problem answers with a status: one function, so
# every way to fail has its status; bad input becomes 400 or 422.
import notes;
import std.http;
import std.json;
import std.log;
import std.metrics;
import std.sqlite;
import std.web;

# Where the notes are kept: the database in data/, read and written.
const data_dir = "data/";

export effects Storage = file.read(data_dir), file.write(data_dir);

# Each worker's context: its connection to the notes database.
export record Notes[D: effects] {
    db: sqlite.Database[uses D];
}

record NoteText {
    @size(1, 200)
    text: str;
}

record NewNote {
    body: NoteText;
}

record NoteId {
    id: int;
}

# GET /notes, POST /notes, GET /notes/ID, POST /notes/ID/done, DELETE /notes/ID, GET /health, /health/live,
# /health/ready and /metrics; each request gets an id, a log record and its metrics.
# Each operation is typed(op, note_problem); the types are written out because the operations are
# generic in the database's effects, which inference does not follow through two generic calls.
export fn notes_app[D: effects]() -> web.App[Notes[uses D], uses clock, random, log, D] {
    let listing: fn(Notes[uses D], web.NoInput) -> result[http.Response] uses D = web.typed(
        list_notes,
        note_problem
    );
    let adding: fn(Notes[uses D], NewNote) -> result[http.Response] uses log, D = web.typed(
        create,
        note_problem
    );
    let showing: fn(Notes[uses D], NoteId) -> result[http.Response] uses D = web.typed(
        show,
        note_problem
    );
    let finishing: fn(Notes[uses D], NoteId) -> result[http.Response] uses D = web.typed(
        done,
        note_problem
    );
    let erasing: fn(Notes[uses D], NoteId) -> result[http.Response] uses D = web.typed(
        erase,
        note_problem
    );
    let database: list[web.HealthCheck[Notes[uses D], uses clock, random, log, D]] = [
        new web.HealthCheck { name: "database", check: alive }
    ];
    let routes: list[web.Route[Notes[uses D], uses clock, random, log, D]] = [
        web.on_get("/notes", listing),
        web.on_post("/notes", adding),
        web.on_get("/notes/{id}", showing),
        web.on_post("/notes/{id}/done", finishing),
        web.on_delete("/notes/{id}", erasing),
        web.health_route(database),
        web.metrics_route([notes_created()])
    ];
    for r in web.health_routes(database) {
        push(routes, r);
    }
    return new web.App {
        routes: routes,
        steps: [web.request_ids(web.random_id), web.request_logs(), web.request_metrics()],
        errors: new list[web.ErrorStatus]
    };
}

fn notes_created() -> metrics.Metric {
    return metrics.counter("notes_created_total", "Notes created.", new list[str]);
}

# serve_app's setup: data/notes.db, with its table the first time.
export fn open_notes() -> result[Notes[uses Storage]] uses Storage {
    let db = try sqlite.open(data_dir + "notes.db");
    try notes.prepare(db);
    return ok(new Notes { db: db });
}

# The status and detail of each way the notes can fail (a database failure is 500, with no detail).
fn note_problem(e: notes.NoteError) -> web.Problem {
    match e {
        case not_found(id) {
            return new web.Problem { status: 404, detail: "no note " + str(id) };
        }
        case blank {
            return new web.Problem { status: 422, detail: "the text is only spaces" };
        }
        case database(_) {
            return new web.Problem { status: 500, detail: "" };
        }
    }
}

fn list_notes[D: effects](
    app: Notes[uses D],
    input: web.NoInput
) -> result[http.Response, notes.NoteError] uses D {
    return ok(web.json_reply(200, try map_err(notes.all_notes(app.db), notes.db_error)));
}

fn create[D: effects](app: Notes[uses D], input: NewNote) -> result[http.Response, notes.NoteError]
    uses log, D {
    let text = trim(input.body.text);
    if text == "" {
        return err(notes.NoteError.blank);
    }
    let note = try map_err(notes.add_note(app.db, text), notes.db_error);
    metrics.add_to(notes_created(), new list[str], 1);
    log.log_info("note created", [log.field("id", note.id)]);
    return ok(web.created("/notes/" + str(note.id), note));
}

fn show[D: effects](app: Notes[uses D], input: NoteId) -> result[http.Response, notes.NoteError]
    uses D {
    return ok(web.json_reply(200, try notes.find_note(app.db, input.id)));
}

fn done[D: effects](app: Notes[uses D], input: NoteId) -> result[http.Response, notes.NoteError]
    uses D {
    return ok(web.json_reply(200, try notes.mark_done(app.db, input.id)));
}

fn erase[D: effects](app: Notes[uses D], input: NoteId) -> result[http.Response, notes.NoteError]
    uses D {
    try notes.remove_note(app.db, input.id);
    return ok(web.no_content());
}

fn alive[D: effects](app: Notes[uses D]) -> result[void] uses D {
    let _ = try sqlite.query(app.db, sqlite.sql("select 1"), new list[sqlite.Value]);
    return ok();
}

fn memory() -> Notes {
    let db = sqlite.open_memory();
    match notes.prepare(db) {
        case ok() {
        }
        case err(_) {
        }
    }
    return new Notes { db: db };
}

fn call(n: Notes, method: str, path: str, body: str) -> http.Response uses clock, random, log {
    return web.handle_request(notes_app(), n, web.request(method, path, body));
}

@spec("FR-001")
test "GET /notes lists the notes as JSON" uses clock, random, log {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "water the plants"}`);
    let r = call(n, "GET", "/notes", "");
    expect_eq(r.status, 200);
    expect_eq(r.body, `[{"id":1,"text":"water the plants","done":false}]`);
}

@spec("FR-002")
test "POST /notes adds a note with the next id" uses clock, random, log {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "a"}`);
    let r = call(n, "POST", "/notes", `{"text": " buy bread "}`);
    expect_eq(r.status, 201);
    expect_eq(r.body, `{"id":2,"text":"buy bread","done":false}`);
    expect_eq(r.headers[1].value, "/notes/2");
}

@spec("FR-003")
test "a missing, empty or too long text is refused with the reason" uses clock, random, log {
    let n = memory();
    expect_eq(call(n, "POST", "/notes", "{}").status, 400);
    expect_eq(call(n, "POST", "/notes", `{"text": "   "}`).status, 422);
    expect_eq(call(n, "POST", "/notes", "not json").status, 400);
    match json.parse_json(call(n, "POST", "/notes", `{"txt": "typo"}`).body) {
        case ok(j) {
            expect_eq(json.int_field(j, "status"), ok(400));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
}

@spec("FR-004")
test "one note: read, mark done, delete" uses clock, random, log {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "call home"}`);
    expect_eq(call(n, "GET", "/notes/1", "").body, `{"id":1,"text":"call home","done":false}`);
    match json.parse_json(call(n, "POST", "/notes/1/done", "").body) {
        case ok(j) {
            expect_eq(json.text_field(j, "text"), ok("call home"));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
    expect_eq(call(n, "DELETE", "/notes/1", "").status, 204);
    expect_eq(call(n, "GET", "/notes", "").body, "[]");
}

@spec("FR-005")
test "unknown notes and paths are 404, other methods 405" uses clock, random, log {
    let n = memory();
    expect_eq(call(n, "GET", "/notes/9", "").status, 404);
    expect_eq(call(n, "GET", "/notes/x", "").status, 400);
    expect_eq(call(n, "GET", "/", "").status, 404);
    expect_eq(call(n, "PUT", "/notes", "").status, 405);
}

@spec("FR-006")
test "the notes are kept in the database between requests" uses clock, random, log {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "one"}`);
    let _ = call(n, "POST", "/notes", `{"text": "two"}`);
    expect_eq(notes.all_notes(n.db), ok([
        new notes.Note { id: 1, text: "one", done: false },
        new notes.Note { id: 2, text: "two", done: false }
    ]));
}

@spec("FR-007")
test "a created note is logged with its request's id, beside the request's own record"
    uses clock, random, log {
    let n = memory();
    let r = web.handle_request(notes_app(), n, web.with_header(
        web.request("POST", "/notes", `{"text": "a"}`),
        "X-Request-Id",
        "id-7"
    ));
    expect_eq(r.status, 201);
    expect_eq(log.logged(), [
        `{"time":"1970-01-01T00:00:00.001Z","level":"info","message":"note created","request_id":"id-7","id":1}`,
        `{"time":"1970-01-01T00:00:00.003Z","level":"info","message":"request","request_id":"id-7","method":"POST","route":"/notes","status":201,"ms":3}`
    ]);
}

@spec("FR-010")
test "/metrics counts created notes and requests by route" uses clock, random, log {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "a"}`);
    let _ = call(n, "GET", "/notes/1", "");
    let text = call(n, "GET", "/metrics", "").body;
    expect(find(text, "notes_created_total 1\n") >= 0);
    expect(find(text, `http_requests_total{method="GET",route="/notes/{id}",status="2xx"} 1`) >= 0);
}

@spec("FR-015")
test "live and ready answer apart from /health" uses clock, random, log {
    let n = memory();
    expect_eq(call(n, "GET", "/health/live", "").body, `{"status":"up"}`);
    expect_eq(call(n, "GET", "/health/ready", "").body, `{"status":"up"}`);
    expect_eq(call(n, "GET", "/health", "").status, 200);
}

@spec("FR-002")
prop "added notes get distinct ids" (texts: list[str]) {
    let n = memory();
    let ids = new map[int, bool];
    for t in texts {
        match notes.add_note(n.db, t) {
            case ok(note) {
                expect(not has(ids, note.id));
                set ids[note.id] = true;
            }
            case err(e) {
                expect_eq(e, "");
            }
        }
    }
    expect_eq(len(ids), len(texts));
}
