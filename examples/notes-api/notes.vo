# Notes in SQLite: every function takes the database, so the tests use one in memory and the server a file.
import std.sqlite.Database;
import std.sqlite.Row;
import std.sqlite.Value;
import std.sqlite.exec;
import std.sqlite.get_int;
import std.sqlite.get_str;
import std.sqlite.query;
import std.sqlite.sql;

export record Note {
    id: int;
    text: str;
    done: bool;
}

export fn prepare[D: effects](db: Database[D]) -> result[void] uses D {
    let _ = try exec(
        db,
        sql(
            "create table if not exists notes (id integer primary key, text text not null, done integer not null default 0)"
        ),
        new list[Value]
    );
    return ok();
}

export fn all_notes[D: effects](db: Database[D]) -> result[list[Note]] uses D {
    let out = new list[Note];
    for row in try query(db, sql("select id, text, done from notes order by id"), new list[Value]) {
        push(out, try note_of(row));
    }
    return ok(out);
}

# The note with this id, or err("not_found: ...") (std.web answers 404).
export fn find_note[D: effects](db: Database[D], id: int) -> result[Note] uses D {
    let rows = try query(db, sql("select id, text, done from notes where id = ?"), [
        Value.integer(id)
    ]);
    if len(rows) == 0 {
        return err("not_found: no note " + str(id));
    }
    return note_of(rows[0]);
}

export fn add_note[D: effects](db: Database[D], text: str) -> result[Note] uses D {
    let c = try exec(db, sql("insert into notes (text) values (?)"), [Value.text(text)]);
    return ok(new Note { id: c.last_id, text: text, done: false });
}

export fn mark_done[D: effects](db: Database[D], id: int) -> result[Note] uses D {
    let _ = try find_note(db, id);
    let _ = try exec(db, sql("update notes set done = 1 where id = ?"), [Value.integer(id)]);
    return find_note(db, id);
}

export fn remove_note[D: effects](db: Database[D], id: int) -> result[void] uses D {
    let _ = try find_note(db, id);
    let _ = try exec(db, sql("delete from notes where id = ?"), [Value.integer(id)]);
    return ok();
}

fn note_of(row: Row) -> result[Note] {
    return ok(new Note {
        id: try get_int(row, "id"),
        text: try get_str(row, "text"),
        done: try get_int(row, "done") == 1
    });
}
