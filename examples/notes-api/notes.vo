# Notes in SQLite: every function takes the database, so the tests use one in memory and the server a file.
import std.sqlite;

export record Note {
    id: int;
    text: str;
    done: bool;
}

export fn prepare[D: effects](db: sqlite.Database[uses D]) -> result[void] uses D {
    let _ = try sqlite.exec(
        db,
        sqlite.sql(
            "create table if not exists notes (id integer primary key, text text not null, done integer not null default 0)"
        ),
        new list[sqlite.Value]
    );
    return ok();
}

export fn all_notes[D: effects](db: sqlite.Database[uses D]) -> result[list[Note]] uses D {
    let out = new list[Note];
    for row in try sqlite.query(
        db,
        sqlite.sql("select id, text, done from notes order by id"),
        new list[sqlite.Value]
    ) {
        push(out, try note_of(row));
    }
    return ok(out);
}

# How the notes can fail: the API answers each with its own status (api.vo, note_problem).
export variant NoteError {
    # No note has this id.
    not_found(int);
    # A note's text is only spaces.
    blank;
    # The database failed; the message is for the log, not the client.
    database(str);
}

# A database message as a NoteError (for map_err).
export fn db_error(message: str) -> NoteError {
    return NoteError.database(message);
}

# The note with this id, or err(NoteError.not_found(id)).
export fn find_note[D: effects](db: sqlite.Database[uses D], id: int) -> result[Note, NoteError]
    uses D {
    let rows = try map_err(
        sqlite.query(db, sqlite.sql("select id, text, done from notes where id = ?"), [
            sqlite.Value.integer(id)
        ]),
        db_error
    );
    if len(rows) == 0 {
        return err(NoteError.not_found(id));
    }
    return map_err(note_of(rows[0]), db_error);
}

# A new note; `returning id` gives its id (the same statement works on PostgreSQL).
export fn add_note[D: effects](db: sqlite.Database[uses D], text: str) -> result[Note] uses D {
    let rows = try sqlite.query(
        db,
        sqlite.sql("insert into notes (text) values (?) returning id"),
        [sqlite.Value.text(text)]
    );
    return ok(new Note { id: try sqlite.int_column(rows[0], "id"), text: text, done: false });
}

export fn mark_done[D: effects](db: sqlite.Database[uses D], id: int) -> result[Note, NoteError]
    uses D {
    let _ = try find_note(db, id);
    let _ = try map_err(
        sqlite.exec(db, sqlite.sql("update notes set done = 1 where id = ?"), [
            sqlite.Value.integer(id)
        ]),
        db_error
    );
    return find_note(db, id);
}

export fn remove_note[D: effects](db: sqlite.Database[uses D], id: int) -> result[void, NoteError]
    uses D {
    let _ = try find_note(db, id);
    let _ = try map_err(
        sqlite.exec(db, sqlite.sql("delete from notes where id = ?"), [sqlite.Value.integer(id)]),
        db_error
    );
    return ok();
}

fn note_of(row: sqlite.Row) -> result[Note] {
    return ok(new Note {
        id: try sqlite.int_column(row, "id"),
        text: try sqlite.text_column(row, "text"),
        done: try sqlite.int_column(row, "done") == 1
    });
}
