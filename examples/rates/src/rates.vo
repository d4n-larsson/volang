# Exchange rates from a public service (api.frankfurter.dev, no key): what the rate service answers and
# how to read it. The service's answer is recorded for the test of fetch_rate, which then runs offline.
import std.http;
import std.json;

const rates_host = "api.frankfurter.dev";

# The address of the latest rate from one currency to another (three-letter codes).
export fn rate_url(from: str, to: str) -> str {
    return "https://" + rates_host + "/v1/latest?base=" + from + "&symbols=" + to;
}

# The rate in the service's answer, such as {"base":"EUR","rates":{"SEK":11.2}}.
export fn parse_rate(body: str, to: str) -> result[float] {
    return json.float_field(try json.member(try json.parse_json(body), "rates"), to);
}

# The latest rate from one currency to another, asked of the service.
export fn fetch_rate(from: str, to: str) -> result[float] uses net(rates_host) {
    let r = try http.get(rate_url(from, to));
    if r.status != 200 {
        return err("the rate service answered " + str(r.status));
    }
    return parse_rate(r.body, to);
}

test "a rate is read from the service's answer" {
    expect_eq(parse_rate(`{"amount":1.0,"base":"EUR","rates":{"SEK":11.25}}`, "SEK"), ok(11.25));
    expect(parse_rate(`{"rates":{}}`, "SEK") != ok(0.0));
}

# Recorded: `vo test --record recordings/tests main.vo` asks the real service once; `--replay` runs offline.
test "the service gives a positive rate from EUR to SEK" uses net(rates_host) {
    match fetch_rate("EUR", "SEK") {
        case ok(rate) {
            expect(rate > 0.0);
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
}
