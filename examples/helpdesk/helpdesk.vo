# Help-desk triage with the built-in collections: a priority queue of tickets, an ordered map of
# on-call shifts, an ordered set of people, and a deque of the last tickets handled.
import std.collections.difference;
import std.collections.key_at_or_below;
import std.collections.pop_front;
import std.text.align_left;
import std.text.align_right;
import std.text.lines;
import std.text.words;

# A record whose fields are all ordered is itself ordered, field by field: the most urgent
# severity first, then the earlier ticket, then the title. No comparison function is needed.
export record Ticket {
    severity: int;
    minute: int;
    title: str;
}

# Who handled a ticket: the person whose shift started last at or before the ticket's minute.
export record Handled {
    ticket: Ticket;
    on_call: str;
}

fn number(text: str, what: str, line: str) -> result[int] {
    match parse_int(text) {
        case ok(n) {
            return ok(n);
        }
        case err(_) {
            return err("bad " + what + " `" + text + "` in line `" + line + "`");
        }
    }
}

# Meaningful lines of a data file: blank lines and `#` comments are skipped.
fn data_lines(text: str) -> list[list[str]] {
    var out = new list[list[str]];
    for line in lines(text) {
        let ws = words(line);
        if len(ws) == 0 or slice(ws[0], 0, 1) == "#" {
            continue;
        }
        push(out, ws);
    }
    return out;
}

# `MINUTE SEVERITY TITLE...` per line.
export fn parse_tickets(text: str) -> result[list[Ticket]] {
    var out = new list[Ticket];
    for ws in data_lines(text) {
        let line = join(ws, " ");
        if len(ws) < 3 {
            return err("a ticket needs a minute, a severity and a title: `" + line + "`");
        }
        let minute = try number(ws[0], "minute", line);
        let severity = try number(ws[1], "severity", line);
        push(out, new Ticket { severity: severity, minute: minute, title: join(slice(ws, 2, len(ws)), " ") });
    }
    return ok(out);
}

# `MINUTE NAME` per line: shifts keyed by their start, kept in order.
export fn parse_shifts(text: str) -> result[ordered_map[int, str]] {
    let shifts = new ordered_map[int, str];
    for ws in data_lines(text) {
        let line = join(ws, " ");
        if len(ws) != 2 {
            return err("a shift needs a minute and a name: `" + line + "`");
        }
        set shifts[try number(ws[0], "minute", line)] = ws[1];
    }
    return ok(shifts);
}

# The person on call at a minute.
export fn on_call(shifts: ordered_map[int, str], minute: int) -> result[str] {
    match key_at_or_below(shifts, minute) {
        case ok(start) {
            return ok(shifts[start]);
        }
        case err(_) {
            return err("nobody is on call at minute " + str(minute));
        }
    }
}

# The tickets in the order they are handled: most urgent first.
export fn triage(tickets: list[Ticket]) -> list[Ticket] {
    let queue = new priority_queue[Ticket];
    for t in tickets {
        push(queue, t);
    }
    var order = new list[Ticket];
    for t in queue {
        push(order, t);
    }
    return order;
}

# Adds a title to the history, keeping only the last `keep`.
export fn remember(history: deque[str], title: str, keep: int) {
    push(history, title);
    while len(history) > keep {
        match pop_front(history) {
            case ok(_) {
            }
            case err(_) {
            }
        }
    }
}

export fn handle(tickets: list[Ticket], shifts: ordered_map[int, str]) -> result[list[Handled]] {
    var out = new list[Handled];
    for t in triage(tickets) {
        push(out, new Handled { ticket: t, on_call: try on_call(shifts, t.minute) });
    }
    return ok(out);
}

fn line_of(h: Handled) -> str {
    let t = h.ticket;
    let when = "minute " + align_right(str(t.minute), 2);
    return "  sev " + str(t.severity) + "  " + when + "  " + align_left(t.title, 26) + "on call: " + h.on_call;
}

fn names(s: ordered_set[str]) -> str {
    var out = new list[str];
    for name in s {
        push(out, name);
    }
    return join(out, ", ");
}

export fn report(handled: list[Handled], shifts: ordered_map[int, str]) -> str {
    var out = ["triage order"];
    let paged = new ordered_set[str];
    let history = new deque[str];
    for h in handled {
        push(out, line_of(h));
        push(paged, h.on_call);
        remember(history, h.ticket.title, 3);
    }
    let everyone = new ordered_set[str];
    for start in keys(shifts) {
        push(everyone, shifts[start]);
    }
    var last = new list[str];
    for title in history {
        push(last, title);
    }
    push(out, "paged: " + names(paged));
    push(out, "never paged: " + names(difference(everyone, paged)));
    push(out, "last " + str(len(last)) + " handled: " + join(last, "; "));
    return join(out, "\n") + "\n";
}

fn ticket(severity: int, minute: int, title: str) -> Ticket {
    return new Ticket { severity: severity, minute: minute, title: title };
}

@spec("FR-001")
test "the most urgent ticket first, then the earliest" {
    let order = triage([ticket(2, 1, "b"), ticket(1, 9, "late"), ticket(1, 3, "early"), ticket(2, 1, "a")]);
    expect_eq(order, [ticket(1, 3, "early"), ticket(1, 9, "late"), ticket(2, 1, "a"), ticket(2, 1, "b")]);
}

@spec("FR-002")
test "on call: the shift that started last at or before the minute" {
    let shifts = new ordered_map[int, str];
    set shifts[8] = "ann";
    set shifts[16] = "ben";
    expect_eq(on_call(shifts, 8), ok("ann"));
    expect_eq(on_call(shifts, 15), ok("ann"));
    expect_eq(on_call(shifts, 99), ok("ben"));
    expect_eq(on_call(shifts, 7), err("nobody is on call at minute 7"));
}

@spec("FR-003")
test "the history keeps the last three" {
    let history = new deque[str];
    for title in ["a", "b", "c", "d", "e"] {
        remember(history, title, 3);
    }
    expect_eq(history[0], "c");
    expect_eq(len(history), 3);
}

@spec("FR-004")
test "a malformed line is an error that shows the line" {
    expect_eq(parse_tickets("5 x printer"), err("bad severity `x` in line `5 x printer`"));
    expect_eq(parse_shifts("0 alice extra"), err("a shift needs a minute and a name: `0 alice extra`"));
}

# The priority queue and `sort` agree: both use the record's order, field by field.
@spec("FR-001")
prop "triage is the sorted order" (tickets: list[Ticket]) {
    let order = triage(tickets);
    # a copy to sort: lists are references, and `tickets` must stay as generated
    var sorted = slice(tickets, 0, len(tickets));
    sort(sorted);
    expect_eq(order, sorted);
}
