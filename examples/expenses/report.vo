# Expenses and the report built from them. Everything here is pure: no `uses`, so these functions
# cannot print, read files or touch the network, and their tests need no setup.
import std.decimal.Decimal;
import std.decimal.add;
import std.decimal.decimal;
import std.decimal.decimal_text;
import std.decimal.total;
import std.json.Json;
import std.json.as_array;
import std.json.int_field;
import std.json.parse_json;
import std.json.text_field;
import std.text.align_left;
import std.text.align_right;
import std.text.repeat;
import std.time.parse_time;

export record Expense {
    date: str;
    category: str;
    amount: Decimal;
    note: str;
}

export record Total {
    name: str;
    amount: Decimal;
}

# A date that does not parse, and why.
export record DateProblem {
    date: str;
    reason: str;
}

# How reading the expenses can fail: callers can tell a bad date from a negative amount.
export variant ExpenseError {
    # The JSON is not an array of objects with the four fields; the message says where.
    shape(str);
    # A date that is not a calendar date.
    bad_date(DateProblem);
    # An amount below zero, on this date.
    negative(str);
}

# The message for an ExpenseError.
export fn describe(e: ExpenseError) -> str {
    match e {
        case shape(message) {
            return message;
        }
        case bad_date(p) {
            return "bad date `" + p.date + "`: " + p.reason;
        }
        case negative(date) {
            return "negative amount on " + date;
        }
    }
}

fn shape_error(message: str) -> ExpenseError {
    return ExpenseError.shape(message);
}

# The expenses in a parsed JSON array of objects with date, category, cents and note.
export fn expenses_from(doc: Json) -> result[list[Expense], ExpenseError] {
    let out = new list[Expense];
    for item in try map_err(as_array(doc), shape_error) {
        let date = try map_err(text_field(item, "date"), shape_error);
        match parse_time(date) {
            case ok(_) {
            }
            case err(e) {
                return err(ExpenseError.bad_date(new DateProblem { date: date, reason: e }));
            }
        }
        let cents = try map_err(int_field(item, "cents"), shape_error);
        if cents < 0 {
            return err(ExpenseError.negative(date));
        }
        push(out, new Expense {
            date: date,
            category: try map_err(text_field(item, "category"), shape_error),
            amount: amount_of(cents),
            note: try map_err(text_field(item, "note"), shape_error)
        });
    }
    return ok(out);
}

# An amount read as whole cents: 129050 is 1290.50, exactly.
export fn amount_of(cents: int) -> Decimal
    requires cents >= 0 {
    return decimal(cents, 2);
}

# The sum of the amounts for each key, in the order the keys first appear.
export fn totals(xs: list[Expense], key: fn(Expense) -> str) -> list[Total] {
    let sums = new map[str, Decimal];
    for e in xs {
        let k = key(e);
        set sums[k] = add(get_or(sums, k, decimal(0, 2)), e.amount);
    }
    let out = new list[Total];
    for k in keys(sums) {
        push(out, new Total { name: k, amount: sums[k] });
    }
    return out;
}

export fn sum(xs: list[Total]) -> Decimal {
    return add(decimal(0, 2), total(map(xs, fn(t: Total) -> Decimal {
        return t.amount;
    })));
}

# A titled table: one row per total, names padded to the widest, amounts right-aligned.
fn table(title: str, rows: list[Total]) -> str {
    var w = len(chars(title));
    for t in rows {
        if len(chars(t.name)) > w {
            set w = len(chars(t.name));
        }
    }
    var out = align_left(title, w) + "  " + align_right("amount", 10) + "\n";
    set out = out + repeat("-", w + 12) + "\n";
    for t in rows {
        set out = out + align_left(t.name, w) + "  " + align_right(decimal_text(t.amount), 10) + "\n";
    }
    return out + align_left("total", w) + "  " + align_right(decimal_text(sum(rows)), 10) + "\n";
}

# The whole report: by category (largest first) and by month (in date order).
export fn render(xs: list[Expense]) -> str {
    let by_category = totals(xs, fn(e: Expense) -> str {
        return e.category;
    });
    sort_by(by_category, fn(t: Total) -> int {
        return 0 - t.amount.units;
    });
    let by_month = totals(xs, fn(e: Expense) -> str {
        return slice(e.date, 0, 7);
    });
    sort_by(by_month, fn(t: Total) -> str {
        return t.name;
    });
    return str(len(xs)) + " expenses\n\n" + table("category", by_category) + "\n" + table("month", by_month);
}

fn expense(category: str, cents: int) -> Expense {
    return new Expense {
        date: "2026-01-01",
        category: category,
        amount: amount_of(cents),
        note: ""
    };
}

@spec("FR-001")
test "amounts print with two decimals" {
    expect_eq(decimal_text(amount_of(0)), "0.00");
    expect_eq(decimal_text(amount_of(5)), "0.05");
    expect_eq(decimal_text(amount_of(129050)), "1290.50");
}

@spec("FR-002")
test "totals keep the first-seen order" {
    let xs = [expense("b", 1), expense("a", 2), expense("b", 3)];
    let t = totals(xs, fn(e: Expense) -> str {
        return e.category;
    });
    expect_eq(t, [
        new Total { name: "b", amount: amount_of(4) },
        new Total { name: "a", amount: amount_of(2) }
    ]);
}

@spec("FR-004")
test "a bad date is an error, not a crash" {
    match parse_json(`[{"date": "2026-02-30", "category": "x", "cents": 1, "note": ""}]`) {
        case ok(doc) {
            expect_eq(expenses_from(doc), err(
                ExpenseError.bad_date(new DateProblem {
                    date: "2026-02-30",
                    reason: "day 30 is not in that month"
                })
            ));
        }
        case err(e) {
            expect_eq(e, "the test's JSON parses");
        }
    }
}

# Whatever the amounts, grouping never loses or invents money.
@spec("FR-003")
prop "totals add up to the sum of the expenses" (amounts: list[int]) {
    let xs = new list[Expense];
    var expected = 0;
    for a in amounts {
        assume(a >= 0 and a < 1000000);
        push(xs, expense(str(a % 3), a));
        set expected = expected + a;
    }
    expect_eq(sum(totals(xs, fn(e: Expense) -> str {
        return e.category;
    })), amount_of(expected));
}

@spec("FR-005")
test "an empty report" {
    expect_eq(slice(render(new list[Expense]), 0, 11), "0 expenses\n");
}
