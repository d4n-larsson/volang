# Expenses and the report built from them. Everything here is pure: no `uses`, so these functions
# cannot print, read files or touch the network, and their tests need no setup.
import std.json.Json;
import std.json.as_array;
import std.json.int_field;
import std.json.parse_json;
import std.json.text_field;
import std.text.align_left;
import std.text.align_right;
import std.text.repeat;
import std.time.parse_time;

export record Expense {
    date: str;
    category: str;
    cents: int;
    note: str;
}

export record Total {
    name: str;
    cents: int;
}

# The expenses in a parsed JSON array of objects with date, category, cents and note.
export fn expenses_from(doc: Json) -> result[list[Expense]] {
    let out = new list[Expense];
    for item in try as_array(doc) {
        let date = try text_field(item, "date");
        match parse_time(date) {
            case ok(_) {
            }
            case err(e) {
                return err("bad date `" + date + "`: " + e);
            }
        }
        let cents = try int_field(item, "cents");
        if cents < 0 {
            return err("negative amount on " + date);
        }
        push(out, new Expense {
            date: date,
            category: try text_field(item, "category"),
            cents: cents,
            note: try text_field(item, "note")
        });
    }
    return ok(out);
}

# Cents as units and two decimals: 129050 is "1290.50".
export fn money(cents: int) -> str
    requires cents >= 0 {
    let c = cents % 100;
    if c < 10 {
        return str(cents / 100) + ".0" + str(c);
    }
    return str(cents / 100) + "." + str(c);
}

# The sum of the amounts for each key, in the order the keys first appear.
export fn totals(xs: list[Expense], key: fn(Expense) -> str) -> list[Total] {
    let sums = new map[str, int];
    for e in xs {
        let k = key(e);
        set sums[k] = get_or(sums, k, 0) + e.cents;
    }
    let out = new list[Total];
    for k in keys(sums) {
        push(out, new Total { name: k, cents: sums[k] });
    }
    return out;
}

export fn sum(xs: list[Total]) -> int {
    var s = 0;
    for t in xs {
        set s = s + t.cents;
    }
    return s;
}

# A titled table: one row per total, names padded to the widest, amounts right-aligned.
fn table(title: str, rows: list[Total]) -> str {
    var w = len(chars(title));
    for t in rows {
        if len(chars(t.name)) > w {
            set w = len(chars(t.name));
        }
    }
    var out = align_left(title, w) + "  " + align_right("amount", 10) + "\n";
    set out = out + repeat("-", w + 12) + "\n";
    for t in rows {
        set out = out + align_left(t.name, w) + "  " + align_right(money(t.cents), 10) + "\n";
    }
    return out + align_left("total", w) + "  " + align_right(money(sum(rows)), 10) + "\n";
}

# The whole report: by category (largest first) and by month (in date order).
export fn render(xs: list[Expense]) -> str {
    let by_category = totals(xs, fn(e: Expense) -> str {
        return e.category;
    });
    sort_by(by_category, fn(t: Total) -> int {
        return 0 - t.cents;
    });
    let by_month = totals(xs, fn(e: Expense) -> str {
        return slice(e.date, 0, 7);
    });
    sort_by(by_month, fn(t: Total) -> str {
        return t.name;
    });
    return str(len(xs)) + " expenses\n\n" + table("category", by_category) + "\n" + table("month", by_month);
}

fn expense(category: str, cents: int) -> Expense {
    return new Expense { date: "2026-01-01", category: category, cents: cents, note: "" };
}

@spec("FR-001")
test "money pads the cents" {
    expect_eq(money(0), "0.00");
    expect_eq(money(5), "0.05");
    expect_eq(money(129050), "1290.50");
}

@spec("FR-002")
test "totals keep the first-seen order" {
    let xs = [expense("b", 1), expense("a", 2), expense("b", 3)];
    let t = totals(xs, fn(e: Expense) -> str {
        return e.category;
    });
    expect_eq(t, [new Total { name: "b", cents: 4 }, new Total { name: "a", cents: 2 }]);
}

@spec("FR-004")
test "a bad date is an error, not a crash" {
    match parse_json(
        "[{\"date\": \"2026-02-30\", \"category\": \"x\", \"cents\": 1, \"note\": \"\"}]"
    ) {
        case ok(doc) {
            expect_eq(expenses_from(doc), err(
                "bad date `2026-02-30`: day 30 is not in that month"
            ));
        }
        case err(e) {
            expect_eq(e, "the test's JSON parses");
        }
    }
}

# Whatever the amounts, grouping never loses or invents money.
@spec("FR-003")
prop "totals add up to the sum of the expenses" (amounts: list[int]) {
    let xs = new list[Expense];
    var expected = 0;
    for a in amounts {
        assume(a >= 0 and a < 1000000);
        push(xs, expense(str(a % 3), a));
        set expected = expected + a;
    }
    expect_eq(sum(totals(xs, fn(e: Expense) -> str {
        return e.category;
    })), expected);
}

@spec("FR-005")
test "an empty report" {
    expect_eq(slice(render(new list[Expense]), 0, 11), "0 expenses\n");
}
