# Reads data/expenses.json, prints a report and saves it to out/report.txt. The `uses` clause is
# the whole grant: this program can read only under data/ and write only under out/.
# `vo run main.vo` runs main; `vo test main.vo` runs the tests and the property in report.vo, next to
# the code they test.
import report.expenses_from;
import report.render;
import std.json.parse_json;

fn main() -> result[void] uses console, file.read("data/"), file.write("out/") {
    let doc = try parse_json(try read_file("data/expenses.json"));
    let text = render(try expenses_from(doc));
    write(text);
    try write_file("out/report.txt", text);
    return ok();
}
