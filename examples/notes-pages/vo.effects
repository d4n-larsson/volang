pages.vo:page pure
pages.vo:pages_app pure
pages.vo:test "an empty or missing text is refused" pure
pages.vo:test "done answers the note's new markup to the script, the list to a form" pure
pages.vo:test "the add form adds a note and goes back to the list" pure
pages.vo:test "the list page shows the notes, escaped, in the layout" pure
pages.vo:test "the script is served by the app, as the page's security policy requires" pure
