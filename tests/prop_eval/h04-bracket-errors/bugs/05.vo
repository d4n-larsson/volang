# replaces: main.vo
fn closer(open: str) -> str {
    if open == "(" {
        return ")";
    }
    if open == "[" {
        return "]";
    }
    return "}";
}

export fn check(s: str) -> str {
    let cs = chars(s);
    let stack = new list[int];
    var quote = 0;
    for i in 0..len(cs) {
        let c = cs[i];
        let col = "error at column " + str(i + 1) + ": ";
        if quote > 0 {
            if c == "\"" {
                set quote = 0;
            }
        } else if c == "\"" {
            set quote = i + 1;
        } else if c == "(" or c == "[" or c == "{" {
            push(stack, i);
        } else if c == ")" or c == "]" or c == "}" {
            match pop(stack) {
                case ok(p) {
                    let want = closer(cs[p]);
                    if want != c {
                        return col + "expected " + want + " but found " + c;
                    }
                }
                case err(_) {
                    return col + "unexpected " + c;
                }
            }
        }
    }
    if quote > 0 {
        return "error at column " + str(len(cs)) + ": unclosed \"";
    }
    if len(stack) > 0 {
        return "error at column " + str(stack[0] + 1) + ": unclosed " + cs[stack[0]];
    }
    return "ok";
}

fn main() uses console, input {
    while true {
        match read_line() {
            case ok(line) {
                print(check(line));
            }
            case err(_) {
                break;
            }
        }
    }
}
