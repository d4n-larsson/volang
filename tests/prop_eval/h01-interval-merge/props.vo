import main.solve;

# Properties of the interval merge, written from task.md. Inputs are built from generated ints,
# reduced to small values (-9..9) so that intervals often overlap, touch or nest.
fn small(n: int) -> int {
    return n % 10;
}

fn pick(n: int, k: int) -> int {
    return (n % k + k) % k;
}

fn blank(n: int) -> str {
    return ["", " ", "\t", "  ", " \t "][pick(n, 5)];
}

fn gap(n: int) -> str {
    return [" ", "\t", "   ", " \t", "\t\t "][pick(n, 5)];
}

fn pairs(xs: list[int], ys: list[int]) -> list[list[int]] {
    let out = new list[list[int]];
    for i in 0..min(len(xs), len(ys)) {
        push(out, [small(xs[i]), small(ys[i])]);
    }
    return out;
}

fn lines_of(ps: list[list[int]], shift: int) -> list[str] {
    return map(ps, fn(p: list[int]) -> str {
        return str(p[0] + shift) + " " + str(p[1] + shift);
    });
}

fn run(lines: list[str]) -> list[str] {
    match solve(lines) {
        case ok(v) {
            return v;
        }
        case err(e) {
            return ["error: " + e];
        }
    }
}

# The output lines as [start, end] pairs; err if a line is not exactly `start end`.
fn read_out(out: list[str]) -> result[list[list[int]]] {
    let got = new list[list[int]];
    for line in out {
        let parts = split(line, " ");
        if len(parts) != 2 {
            return err("bad line: " + line);
        }
        let a = try parse_int(parts[0]);
        let b = try parse_int(parts[1]);
        if str(a) + " " + str(b) != line {
            return err("bad line: " + line);
        }
        push(got, [a, b]);
    }
    return ok(got);
}

fn covers(ps: list[list[int]], x2: int) -> bool {
    return any(ps, fn(p: list[int]) -> bool {
        return 2 * min(p[0], p[1]) <= x2 and x2 <= 2 * max(p[0], p[1]);
    });
}

prop "output is the sorted, disjoint union of the input" (xs: list[int], ys: list[int]) {
    let ps = pairs(xs, ys);
    let out = run(lines_of(ps, 0));
    if len(ps) == 0 {
        expect_eq(out, ["empty"]);
    } else {
        match read_out(out) {
            case ok(got) {
                expect(len(got) > 0);
                for i in 0..len(got) {
                    expect(got[i][0] <= got[i][1]);
                    if i > 0 {
                        expect(got[i - 1][1] < got[i][0]);
                    }
                }
                # Doubled coordinates also test the points between integers, so `1 2` + `3 4`
                # (no common point) must stay apart and `1 3` + `3 5` must become one.
                for x2 in -20..21 {
                    expect_eq(covers(got, x2), covers(ps, x2));
                }
            }
            case err(e) {
                expect_eq(e, "");
            }
        }
    }
}

prop "spaces, tabs and blank lines do not change the output" (xs: list[int], ys: list[int], pads: list[int]) {
    let ps = pairs(xs, ys);
    let messy = new list[str];
    for i in 0..len(ps) {
        let p = pad_at(pads, i);
        push(messy, blank(p));
        push(messy, blank(p + 1) + str(ps[i][0]) + gap(p + 2) + str(ps[i][1]) + blank(p + 3));
    }
    for p in pads {
        push(messy, blank(p));
    }
    expect_eq(run(messy), run(lines_of(ps, 0)));
}

fn pad_at(pads: list[int], i: int) -> int {
    if len(pads) == 0 {
        return i;
    }
    return pick(pads[i % len(pads)], 5) + i;
}

prop "line order and the order of the two ends do not matter" (xs: list[int], ys: list[int]) {
    let ps = pairs(xs, ys);
    let flipped = new list[list[int]];
    var i = len(ps) - 1;
    while i >= 0 {
        push(flipped, [ps[i][1], ps[i][0]]);
        set i = i - 1;
    }
    expect_eq(run(lines_of(flipped, 0)), run(lines_of(ps, 0)));
}

prop "merging the output again changes nothing" (xs: list[int], ys: list[int]) {
    let ps = pairs(xs, ys);
    assume(len(ps) > 0);
    let once = run(lines_of(ps, 0));
    expect_eq(run(once), once);
}

prop "values up to 10^15 in size shift the output exactly" (xs: list[int], ys: list[int], up: bool) {
    let ps = pairs(xs, ys);
    assume(len(ps) > 0);
    var c = 999999999999991;
    if not up {
        set c = -c;
    }
    match read_out(run(lines_of(ps, 0))) {
        case ok(got) {
            expect_eq(run(lines_of(ps, c)), lines_of(got, c));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
}
