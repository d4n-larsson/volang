# replaces: main.vo
record Span {
    lo: int;
    hi: int;
}

fn fields(s: str) -> list[str] {
    let out = new list[str];
    let cs = chars(s);
    var start = -1;
    for i in 0..len(cs) {
        if cs[i] == " " or cs[i] == "\t" {
            if start >= 0 {
                push(out, slice(s, start, i));
                set start = -1;
            }
        } else if start < 0 {
            set start = i;
        }
    }
    if start >= 0 {
        push(out, slice(s, start, len(cs)));
    }
    return out;
}

fn parse(lines: list[str]) -> result[list[Span]] {
    let spans = new list[Span];
    for line in lines {
        let t = fields(line);
        if len(t) >= 2 {
            let a = try parse_int(t[0]);
            let b = try parse_int(t[1]);
            push(spans, new Span { lo: min(a, b), hi: max(a, b) });
        }
    }
    return ok(spans);
}

fn merge(input: list[Span]) -> list[Span] {
    let spans = slice(input, 0, len(input));
    sort_by(spans, fn(s: Span) -> int {
        return s.hi;
    });
    let out = new list[Span];
    for s in spans {
        if len(out) > 0 and s.lo <= out[len(out) - 1].hi {
            let last = out[len(out) - 1];
            set last.hi = max(last.hi, s.hi);
        } else {
            push(out, new Span { lo: s.lo, hi: s.hi });
        }
    }
    return out;
}

fn render(spans: list[Span]) -> list[str] {
    let out = new list[str];
    if len(spans) == 0 {
        push(out, "empty");
    }
    for s in spans {
        push(out, str(s.lo) + " " + str(s.hi));
    }
    return out;
}

fn solve(lines: list[str]) -> result[list[str]] {
    let spans = try parse(lines);
    return ok(render(merge(spans)));
}

fn main() -> result[void] uses console, input {
    let lines = new list[str];
    while true {
        match read_line() {
            case ok(line) {
                push(lines, line);
            }
            case err(_) {
                break;
            }
        }
    }
    for line in try solve(lines) {
        print(line);
    }
    return ok();
}
