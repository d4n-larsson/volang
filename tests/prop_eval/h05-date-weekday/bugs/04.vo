# replaces: main.vo
fn is_leap(y: int) -> bool {
    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0);
}

fn month_len(y: int, m: int) -> int {
    if m == 2 {
        if is_leap(y) {
            return 29;
        }
        return 28;
    }
    if m == 4 or m == 6 or m == 9 or m == 11 {
        return 30;
    }
    return 31;
}

export fn answer(line: str) -> result[str] {
    let s = trim(line);
    if len(s) != 10 {
        return ok("invalid");
    }
    let cs = chars(s);
    for i in 0..10 {
        let dash = i == 4 or i == 7;
        let digit = cs[i] >= "0" and cs[i] <= "9";
        if dash and cs[i] != "-" {
            return ok("invalid");
        }
        if not dash and not digit {
            return ok("invalid");
        }
    }
    let y = try parse_int(slice(s, 0, 4));
    let m = try parse_int(slice(s, 5, 7));
    let d = try parse_int(slice(s, 8, 10));
    if y < 1 or m < 1 or m > 12 or d < 1 {
        return ok("invalid");
    }
    if d > month_len(y, m) {
        return ok("invalid");
    }
    var doy = d;
    for mm in 1..m {
        set doy = doy + month_len(y, mm);
    }
    let p = y - 1;
    let days = 365 * p + p / 4 - p / 100 + p / 400 + doy - 1;
    let names = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    return ok(names[days % 7] + " " + str(doy));
}

fn main() -> result[void] uses console, input {
    while true {
        match read_line() {
            case ok(line) {
                print(try answer(line));
            }
            case err(_) {
                break;
            }
        }
    }
    return ok();
}
