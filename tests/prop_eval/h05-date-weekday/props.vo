import main.answer;

# Independent model: proleptic Gregorian, 0001-01-01 is a Monday.
fn leap(y: int) -> bool {
    return y % 400 == 0 or y % 4 == 0 and y % 100 != 0;
}

fn mlen(y: int, m: int) -> int {
    let lens = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if m == 2 and leap(y) {
        return 29;
    }
    return lens[m - 1];
}

fn pad(n: int, w: int) -> str {
    var s = str(n);
    while len(s) < w {
        set s = "0" + s;
    }
    return s;
}

fn date(y: int, m: int, d: int) -> str {
    return pad(y, 4) + "-" + pad(m, 2) + "-" + pad(d, 2);
}

fn model(y: int, m: int, d: int) -> str {
    if y < 1 or y > 9999 or m < 1 or m > 12 or d < 1 or d > mlen(y, m) {
        return "invalid";
    }
    var doy = d;
    for k in 1..m {
        set doy = doy + mlen(y, k);
    }
    let p = y - 1;
    let days = p * 365 + p / 4 - p / 100 + p / 400 + doy - 1;
    let names = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
    return names[days % 7] + " " + str(doy);
}

# Reduce any int (even the minimum) to 0..n-1.
fn small(x: int, n: int) -> int {
    return abs(x % n);
}

prop "matches the model on generated dates" (a: int, b: int, c: int) {
    let y = small(a, 10000);
    let m = small(b, 14);
    let d = small(c, 33);
    expect_eq(answer(date(y, m, d)), ok(model(y, m, d)));
}

prop "century and leap-year edges match the model" (a: int, b: int, c: int) {
    let bases = [4, 100, 400, 1, 3];
    let y = max(1, min(9999, bases[small(b, 5)] * (1 + small(a, 25)) + small(c, 3) - 1));
    for md in [[2, 28], [2, 29], [3, 1], [12, 31], [1, 1]] {
        expect_eq(answer(date(y, md[0], md[1])), ok(model(y, md[0], md[1])));
    }
}

prop "the next day is the next weekday" (a: int, b: int, c: int) {
    let y = 1 + small(a, 9998);
    let m = 1 + small(b, 12);
    let d = 1 + small(c, mlen(y, m));
    var ny = y;
    var nm = m;
    var nd = d + 1;
    if nd > mlen(y, m) {
        set nd = 1;
        set nm = m + 1;
        if nm == 13 {
            set nm = 1;
            set ny = y + 1;
        }
    }
    let today = split(model(y, m, d), " ");
    let names = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday", "Monday"];
    var i = 0;
    while names[i] != today[0] {
        set i = i + 1;
    }
    let ndoy = parse_int(today[1]);
    match ndoy {
        case ok(doy) {
            var next_doy = doy + 1;
            if nm == 1 and nd == 1 {
                set next_doy = 1;
            }
            expect_eq(answer(date(y, m, d)), ok(today[0] + " " + today[1]));
            expect_eq(answer(date(ny, nm, nd)), ok(names[i + 1] + " " + str(next_doy)));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
}

prop "anything not shaped YYYY-MM-DD is invalid" (s: str, a: int, b: int, c: int, k: int) {
    let y = 1 + small(a, 9999);
    let m = 1 + small(b, 12);
    let d = 1 + small(c, 28);
    let good = date(y, m, d);
    expect(answer(good) != ok("invalid"));
    let junk = [" ", "+", "-", "/", "a", "é", "日", "0"];
    let j = junk[small(k, len(junk))];
    let pos = small(k, 11);
    let changed = slice(good, 0, pos) + j + slice(good, pos, 10);
    expect_eq(answer(changed), ok("invalid"));
    let replaced = slice(good, 0, min(pos, 9)) + j + slice(good, min(pos, 9) + 1, 10);
    if j != "0" and pos != 4 and pos != 7 {
        expect_eq(answer(replaced), ok("invalid"));
    }
    expect_eq(answer(good + s), answer(good + s));
    if s != "" {
        expect_eq(answer(good + s), ok("invalid"));
        expect_eq(answer(s + good), ok("invalid"));
    }
}

prop "explicit edges" (x: int) {
    expect_eq(answer("2024-03-01"), ok("Friday 61"));
    expect_eq(answer("0000-01-01"), ok("invalid"));
    expect_eq(answer("0001-01-01"), ok("Monday 1"));
    expect_eq(answer("9999-12-31"), ok(model(9999, 12, 31)));
    expect_eq(answer("1900-02-29"), ok("invalid"));
    expect_eq(answer("2000-02-29"), ok(model(2000, 2, 29)));
    expect_eq(answer("2024-00-10"), ok("invalid"));
    expect_eq(answer("2024-13-10"), ok("invalid"));
    expect_eq(answer("2024-01-00"), ok("invalid"));
    expect_eq(answer("2024-04-31"), ok("invalid"));
    expect_eq(answer(""), ok("invalid"));
    expect_eq(answer("2024-3-01"), ok("invalid"));
    expect_eq(answer("2024-03-1 "), ok("invalid"));
    expect_eq(answer("-024-03-01"), ok("invalid"));
    expect_eq(answer("2024-+3-01"), ok("invalid"));
    expect_eq(answer("2024-03--1"), ok("invalid"));
    expect_eq(answer(str(x)), ok("invalid"));
}
