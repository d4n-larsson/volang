# The HTTP API: the route table, each operation's input (checked by std.web before it runs) and its answer.
# The operations fail with a NoteError, which note_problem answers with a status: one function, so
# every way to fail has its status; bad input becomes 400 or 422.
import notes;
import postgres.client;
import postgres.client.connect;
import postgres.client.exec;
import postgres.client.query;
import postgres.client.sql;
import std.http;
import std.json;
import std.tcp;
import std.web;

# Where the notes are kept: the PostgreSQL server of tests/postgres.py (quickstart.md's container).
export effects Storage = net("127.0.0.1:54329"), entropy;

# Each worker's context: its connection to the notes database.
export record Notes[D: effects] {
    db: Database[D];
}

record NoteText {
    @size(1, 200)
    text: str;
}

record NewNote {
    body: NoteText;
}

record NoteId {
    id: int;
}

# GET /notes, POST /notes, GET /notes/ID, POST /notes/ID/done, DELETE /notes/ID, GET /health.
# Each operation is typed(op, note_problem); the types are written out because the operations are
# generic in the database's effects, which inference does not follow through two generic calls.
export fn notes_app[D: effects]() -> web.App[Notes[D], uses D] {
    let listing: fn(Notes[D], web.NoInput) -> result[http.Response] uses D = web.typed(list_notes, note_problem);
    let adding: fn(Notes[D], NewNote) -> result[http.Response] uses D = web.typed(create, note_problem);
    let showing: fn(Notes[D], NoteId) -> result[http.Response] uses D = web.typed(show, note_problem);
    let finishing: fn(Notes[D], NoteId) -> result[http.Response] uses D = web.typed(done, note_problem);
    let erasing: fn(Notes[D], NoteId) -> result[http.Response] uses D = web.typed(erase, note_problem);
    return web.web_app([
        web.on_get("/notes", listing),
        web.on_post("/notes", adding),
        web.on_get("/notes/{id}", showing),
        web.on_post("/notes/{id}/done", finishing),
        web.on_delete("/notes/{id}", erasing),
        web.health_route([new web.HealthCheck { name: "database", check: alive }])
    ]);
}

# serve_app's setup: a connection to the server, with the table the first time.
export fn open_notes() -> result[Notes[uses net]] uses Storage {
    let db = try connect(new Options {
        host: "127.0.0.1",
        port: 54329,
        database: "vo",
        user: "vo",
        password: "secret",
        plain_text: true,
        connect_ms: 10000,
        statement_ms: 30000
    });
    try notes.prepare(db);
    return ok(new Notes { db: db });
}

# The status and detail of each way the notes can fail (a database failure is 500, with no detail).
fn note_problem(e: notes.NoteError) -> web.Problem {
    match e {
        case not_found(id) {
            return new web.Problem { status: 404, detail: "no note " + str(id) };
        }
        case blank {
            return new web.Problem { status: 422, detail: "the text is only spaces" };
        }
        case database(_) {
            return new web.Problem { status: 500, detail: "" };
        }
    }
}

fn list_notes[D: effects](app: Notes[D], input: web.NoInput) -> result[http.Response, notes.NoteError] uses D {
    return ok(web.json_reply(200, try map_err(notes.all_notes(app.db), notes.db_error)));
}

fn create[D: effects](app: Notes[D], input: NewNote) -> result[http.Response, notes.NoteError] uses D {
    let text = trim(input.body.text);
    if text == "" {
        return err(notes.NoteError.blank);
    }
    let note = try map_err(notes.add_note(app.db, text), notes.db_error);
    return ok(web.created("/notes/" + str(note.id), note));
}

fn show[D: effects](app: Notes[D], input: NoteId) -> result[http.Response, notes.NoteError] uses D {
    return ok(web.json_reply(200, try notes.find_note(app.db, input.id)));
}

fn done[D: effects](app: Notes[D], input: NoteId) -> result[http.Response, notes.NoteError] uses D {
    return ok(web.json_reply(200, try notes.mark_done(app.db, input.id)));
}

fn erase[D: effects](app: Notes[D], input: NoteId) -> result[http.Response, notes.NoteError] uses D {
    try notes.remove_note(app.db, input.id);
    return ok(web.no_content());
}

fn alive[D: effects](app: Notes[D]) -> result[void] uses D {
    let _ = try query(app.db, sql("select 1"), new list[Value]);
    return ok();
}

# The tests' database: an empty notes table on the server. Each test (and each case of a property)
# connects, and a test's connections stay open until `vo test` ends: the earlier ones are ended here,
# so the server's connection limit is not reached.
fn fresh[D: effects](n: Notes[D]) -> result[void] uses D {
    let _ = try query(
        n.db,
        sql(
            "select pg_terminate_backend(pid) from pg_stat_activity where usename = current_user and pid <> pg_backend_pid()"
        ),
        new list[Value]
    );
    let _ = try exec(n.db, sql("drop table if exists notes"), new list[Value]);
    return notes.prepare(n.db);
}

fn memory() -> Notes[uses net] uses Storage {
    match open_notes() {
        case ok(n) {
            match fresh(n) {
                case ok() {
                }
                case err(_) {
                }
            }
            return n;
        }
        case err(_) {
            # no server: a closed connection, so every request in the test fails with `connection: closed`
            let none = new tcp.Conn[uses net] { id: 0, peer: "" };
            return new Notes {
                db: new Database[uses net] {
                    conn: none,
                    statement_ms: 1,
                    in_transaction: false,
                    failed: false,
                    closed: true
                }
            };
        }
    }
}

fn call(n: Notes[uses net], method: str, path: str, body: str) -> http.Response uses net {
    return web.handle_request(notes_app(), n, web.request(method, path, body));
}

@spec("FR-001")
test "GET /notes lists the notes as JSON" uses Storage {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "water the plants"}`);
    let r = call(n, "GET", "/notes", "");
    expect_eq(r.status, 200);
    expect_eq(r.body, `[{"id":1,"text":"water the plants","done":false}]`);
}

@spec("FR-002")
test "POST /notes adds a note with the next id" uses Storage {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "a"}`);
    let r = call(n, "POST", "/notes", `{"text": " buy bread "}`);
    expect_eq(r.status, 201);
    expect_eq(r.body, `{"id":2,"text":"buy bread","done":false}`);
    expect_eq(r.headers[1].value, "/notes/2");
}

@spec("FR-003")
test "a missing, empty or too long text is refused with the reason" uses Storage {
    let n = memory();
    expect_eq(call(n, "POST", "/notes", "{}").status, 400);
    expect_eq(call(n, "POST", "/notes", `{"text": "   "}`).status, 422);
    expect_eq(call(n, "POST", "/notes", "not json").status, 400);
    match json.parse_json(call(n, "POST", "/notes", `{"txt": "typo"}`).body) {
        case ok(j) {
            expect_eq(json.int_field(j, "status"), ok(400));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
}

@spec("FR-004")
test "one note: read, mark done, delete" uses Storage {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "call home"}`);
    expect_eq(call(n, "GET", "/notes/1", "").body, `{"id":1,"text":"call home","done":false}`);
    match json.parse_json(call(n, "POST", "/notes/1/done", "").body) {
        case ok(j) {
            expect_eq(json.text_field(j, "text"), ok("call home"));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
    expect_eq(call(n, "DELETE", "/notes/1", "").status, 204);
    expect_eq(call(n, "GET", "/notes", "").body, "[]");
}

@spec("FR-005")
test "unknown notes and paths are 404, other methods 405" uses Storage {
    let n = memory();
    expect_eq(call(n, "GET", "/notes/9", "").status, 404);
    expect_eq(call(n, "GET", "/notes/x", "").status, 400);
    expect_eq(call(n, "GET", "/", "").status, 404);
    expect_eq(call(n, "PUT", "/notes", "").status, 405);
}

@spec("FR-006")
test "the notes are kept in the database between requests" uses Storage {
    let n = memory();
    let _ = call(n, "POST", "/notes", `{"text": "one"}`);
    let _ = call(n, "POST", "/notes", `{"text": "two"}`);
    expect_eq(notes.all_notes(n.db), ok([
        new notes.Note { id: 1, text: "one", done: false },
        new notes.Note { id: 2, text: "two", done: false }
    ]));
}

@spec("FR-002")
prop "added notes get distinct ids" (texts: list[str]) uses Storage {
    let n = memory();
    let ids = new map[int, bool];
    for t in texts {
        match notes.add_note(n.db, t) {
            case ok(note) {
                expect(not has(ids, note.id));
                set ids[note.id] = true;
            }
            case err(e) {
                expect_eq(e, "");
            }
        }
    }
    expect_eq(len(ids), len(texts));
}
