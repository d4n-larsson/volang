import std.json;

fn bad(n: int) uses console {
    print("bad line " + str(n));
    exit(1);
}

fn main() -> result[void] uses console, input {
    let items = new list[json.Json];
    var total = 0;
    var n = 0;
    while true {
        match read_line() {
            case ok(line) {
                set n = n + 1;
                if trim(line) == "" {
                    continue;
                }
                let parts = split(line, ",");
                if len(parts) != 3 {
                    bad(n);
                    return ok();
                }
                match parse_int(trim(parts[1])) {
                    case ok(qty) {
                        match parse_int(trim(parts[2])) {
                            case ok(unit) {
                                let line_total = qty * unit;
                                set total = total + line_total;
                                let obj = new map[str, json.Json];
                                set obj["name"] = json.Json.text(parts[0]);
                                set obj["quantity"] = json.Json.integer(qty);
                                set obj["total_cents"] = json.Json.integer(line_total);
                                push(items, json.Json.object(obj));
                            }
                            case err(_) {
                                bad(n);
                                return ok();
                            }
                        }
                    }
                    case err(_) {
                        bad(n);
                        return ok();
                    }
                }
            }
            case err(_) {
                break;
            }
        }
    }
    let top = new map[str, json.Json];
    set top["items"] = json.Json.array(items);
    set top["total_cents"] = json.Json.integer(total);
    print(try json.write_json(json.Json.object(top)));
    return ok();
}
