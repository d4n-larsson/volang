import std.json;

fn main() -> result[void] uses console, input {
    let items = new list[json.Json];
    var total = 0;
    var n = 0;
    for line in split(read_all(), "\n") {
        set n = n + 1;
        if line == "" {
            continue;
        }
        let parts = split(line, ",");
        if len(parts) != 3 {
            print("bad line " + str(n));
            exit(1);
        }
        match parse_int(parts[1]) {
            case ok(q) {
                match parse_int(parts[2]) {
                    case ok(c) {
                        let item = new map[str, json.Json];
                        set item["name"] = json.Json.text(parts[0]);
                        set item["quantity"] = json.Json.integer(q);
                        set item["total_cents"] = json.Json.integer(q * c);
                        push(items, json.Json.object(item));
                        set total = total + q * c;
                    }
                    case err(_) {
                        print("bad line " + str(n));
                        exit(1);
                    }
                }
            }
            case err(_) {
                print("bad line " + str(n));
                exit(1);
            }
        }
    }
    let out = new map[str, json.Json];
    set out["items"] = json.Json.array(items);
    set out["total_cents"] = json.Json.integer(total);
    print(try json.write_json(json.Json.object(out)));
    return ok();
}
