import std.text;

fn trim_punct(w: str) -> str {
    let cs = chars(w);
    var a = 0;
    var b = len(cs);
    let p = ".,;:!?\"()";
    while a < b and find(p, cs[a]) >= 0 {
        set a = a + 1;
    }
    while b > a and find(p, cs[b - 1]) >= 0 {
        set b = b - 1;
    }
    return join(slice(cs, a, b), "");
}

fn main() uses console, input {
    let counts = new map[str, int];
    for raw in text.words(read_all()) {
        let w = trim_punct(lower(raw));
        if w == "" {
            continue;
        }
        if has(counts, w) {
            set counts[w] = counts[w] + 1;
        } else {
            set counts[w] = 1;
        }
    }
    let ks = keys(counts);
    sort(ks);
    sort_by(ks, fn(k) => 0 - counts[k]);
    var i = 0;
    while i < len(ks) and i < 5 {
        print(ks[i] + ": " + str(counts[ks[i]]));
        set i = i + 1;
    }
    print("distinct: " + str(len(ks)));
}
