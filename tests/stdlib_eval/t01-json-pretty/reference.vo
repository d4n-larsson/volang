import std.json;

fn main() -> result[void] uses console, input {
    match json.parse_json(read_all()) {
        case ok(j) {
            print(try json.write_json(j));
            print(try json.write_json_pretty(j));
        }
        case err(e) {
            print("invalid: " + e);
            exit(1);
        }
    }
    return ok();
}
