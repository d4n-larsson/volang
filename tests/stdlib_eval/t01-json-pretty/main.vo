import std.json;

fn main() uses console, input {
    let text = read_all();
    match json.parse_json(text) {
        case ok(doc) {
            match json.write_json(doc) {
                case ok(compact) {
                    print(compact);
                }
                case err(e) {
                    print("invalid: " + e);
                    exit(1);
                }
            }
            match json.write_json_pretty(doc) {
                case ok(pretty) {
                    print(pretty);
                }
                case err(e) {
                    print("invalid: " + e);
                    exit(1);
                }
            }
        }
        case err(e) {
            print("invalid: " + e);
            exit(1);
        }
    }
}
