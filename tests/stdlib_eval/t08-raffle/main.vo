import std.random.pick;
import std.random.shuffled;

fn read_n() -> int {
    let a = args();
    if len(a) != 1 {
        return 0;
    }
    match parse_int(a[0]) {
        case ok(v) {
            return v;
        }
        case err(_) {
            return 0;
        }
    }
}

fn main() uses console, random {
    let n = read_n();
    if n < 1 {
        print("bad N");
        exit(1);
        return;
    }
    let xs = new list[int];
    for i in 1..n + 1 {
        push(xs, i);
    }
    let shuffled = shuffled(xs);
    print(join(map(shuffled, fn(x: int) -> str {
        return str(x);
    }), " "));
    match pick(shuffled) {
        case ok(w) {
            print("winner: " + str(w));
        }
        case err(e) {
            print(e);
        }
    }
}
