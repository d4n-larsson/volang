import std.random.pick;
import std.random.shuffled;

fn main() -> result[void] uses console, random {
    match parse_int(args()[0]) {
        case ok(n) {
            if n < 1 {
                print("bad N");
                exit(1);
            }
            let xs = new list[int];
            for i in 1..n + 1 {
                push(xs, i);
            }
            let s = shuffled(xs);
            let parts = new list[str];
            for x in s {
                push(parts, str(x));
            }
            print(join(parts, " "));
            print("winner: " + str(try pick(s)));
        }
        case err(_) {
            print("bad N");
            exit(1);
        }
    }
    return ok();
}
