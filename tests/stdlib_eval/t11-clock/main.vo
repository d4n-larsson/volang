import std.text;
import std.time;

fn main() uses console, clock {
    let t = now_ms();
    print(time.format_time(t));
    let d = time.from_ms(t + time.days(30));
    print(text.pad_left(str(d.year), 4, "0") + "-" + text.pad_left(str(d.month), 2, "0") + "-" + text.pad_left(str(d.day), 2, "0"));
}
