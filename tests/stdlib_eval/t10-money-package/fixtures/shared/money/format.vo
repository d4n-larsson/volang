# money.format: Formats amounts of money.

# Formats an amount in cents as units, a point and two decimals, with a minus sign when negative.
#     cents(-1234) is "-12.34"
export fn cents(n: int) -> str {
    if n < 0 {
        return "-" + cents(0 - n);
    }
    let c = n % 100;
    if c < 10 {
        return str(n / 100) + ".0" + str(c);
    }
    return str(n / 100) + "." + str(c);
}
