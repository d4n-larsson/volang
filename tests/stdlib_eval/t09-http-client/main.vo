import std.http;
import std.json;

fn main() -> result[void] uses console, net("localhost") {
    let a = args();
    if len(a) != 1 {
        return err("expected one argument: the port");
    }
    let base = "http://localhost:" + a[0];
    let r1 = try http.get(base + "/json");
    let doc = try json.parse_json(r1.body);
    let name = try json.text_field(doc, "name");
    let tags = try json.as_array(try json.member(doc, "tags"));
    print("name: " + name);
    print("tags: " + str(len(tags)));
    let r2 = try http.get(base + "/status/404");
    print("status: " + str(r2.status));
    return ok();
}
