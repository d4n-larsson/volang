import std.http.get;
import std.json.as_array;
import std.json.field;
import std.json.parse_json;
import std.json.text_field;

fn main() -> result[void] uses console, net("localhost") {
    let a = args();
    if len(a) != 1 {
        return err("expected one argument: the port");
    }
    let base = "http://localhost:" + a[0];
    let r1 = try get(base + "/json");
    let doc = try parse_json(r1.body);
    let name = try text_field(doc, "name");
    let tags = try as_array(try field(doc, "tags"));
    print("name: " + name);
    print("tags: " + str(len(tags)));
    let r2 = try get(base + "/status/404");
    print("status: " + str(r2.status));
    return ok();
}
