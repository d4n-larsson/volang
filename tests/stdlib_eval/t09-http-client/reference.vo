import std.http;
import std.json;

fn run(port: str) -> result[void] uses console, net("localhost") {
    let r = try http.get("http://localhost:" + port + "/json");
    let doc = try json.parse_json(r.body);
    print("name: " + try json.text_field(doc, "name"));
    print("tags: " + str(len(try json.as_array(try json.member(doc, "tags")))));
    let s = try http.get("http://localhost:" + port + "/status/404");
    print("status: " + str(s.status));
    return ok();
}

fn main() uses console, net("localhost") {
    match run(args()[0]) {
        case ok() {
        }
        case err(e) {
            print("error: " + e);
            exit(1);
        }
    }
}
