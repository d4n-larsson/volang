import std.time;

fn main() uses console {
    let a = args();
    match time.parse_time(a[0]) {
        case ok(ms) {
            match parse_int(a[1]) {
                case ok(n) {
                    let t = ms + time.days(n);
                    let d = time.from_ms(t);
                    let names = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
                    print(a[0] + " + " + a[1] + " days = " + slice(time.format_time(t), 0, 10) + " (" + names[d.weekday - 1] + ")");
                    print("days in that month: " + str(time.days_in_month(d.year, d.month)));
                }
                case err(_) {
                    print("invalid input");
                    exit(1);
                }
            }
        }
        case err(_) {
            print("invalid input");
            exit(1);
        }
    }
}
