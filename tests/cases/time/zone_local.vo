# A calendar time in a zone as an instant: once, skipped, repeated, or not a time.
import std.time;

fn at(year: int, month: int, day: int, hour: int, minute: int) -> time.DateTime {
    return new time.DateTime { year: year, month: month, day: day, hour: hour, minute: minute, second: 0, ms: 0, weekday: 0 };
}

fn show(z: time.Zone, d: time.DateTime) uses console {
    let head = format("{} {}-{:02}-{:02} {:02}:{:02}: ", z.name, d.year, d.month, d.day, d.hour, d.minute);
    match time.from_local(z, d) {
        case ok(ms) {
            var law = "";
            if time.in_zone(z, ms) != from_local_fields(d, time.in_zone(z, ms).weekday) {
                set law = " BUT in_zone DISAGREES";
            }
            print(head + "once, " + time.format_in(z, ms) + law);
        }
        case err(e) {
            match e {
                case invalid(m) {
                    print(head + "invalid, " + m);
                }
                case skipped(change) {
                    print(head + "skipped, the clocks change at " + time.format_time(change) + " to " + time.format_in(z, change));
                }
                case repeated(r) {
                    print(head + "repeated, " + time.format_in(z, r.first) + " and " + time.format_in(z, r.second));
                }
            }
        }
    }
}

fn from_local_fields(d: time.DateTime, weekday: int) -> time.DateTime {
    return new time.DateTime { year: d.year, month: d.month, day: d.day, hour: d.hour, minute: d.minute, second: d.second, ms: d.ms, weekday: weekday };
}

fn main() -> result[void] uses console {
    let stockholm = try time.load_zone("Europe/Stockholm");
    show(stockholm, at(2026, 3, 29, 9, 0));
    show(stockholm, at(2026, 3, 29, 1, 59));
    show(stockholm, at(2026, 3, 29, 2, 0));
    show(stockholm, at(2026, 3, 29, 2, 30));
    show(stockholm, at(2026, 3, 29, 3, 0));
    show(stockholm, at(2026, 10, 25, 1, 59));
    show(stockholm, at(2026, 10, 25, 2, 0));
    show(stockholm, at(2026, 10, 25, 2, 30));
    show(stockholm, at(2026, 10, 25, 3, 0));
    # After the listed changes: the rule.
    show(stockholm, at(2090, 3, 26, 2, 30));
    show(stockholm, at(2090, 10, 29, 2, 30));
    show(stockholm, at(2026, 13, 1, 0, 0));
    show(stockholm, at(2026, 2, 30, 0, 0));
    show(stockholm, at(2026, 1, 1, 24, 0));
    # South of the equator the year starts in summer time.
    let sydney = try time.load_zone("Australia/Sydney");
    show(sydney, at(2026, 1, 1, 12, 0));
    show(sydney, at(2026, 4, 5, 2, 30));
    show(sydney, at(2026, 10, 4, 2, 30));
    # Samoa skipped a whole day when it crossed the date line.
    let apia = try time.load_zone("Pacific/Apia");
    show(apia, at(2011, 12, 29, 23, 59));
    show(apia, at(2011, 12, 30, 12, 0));
    show(apia, at(2011, 12, 31, 0, 0));
    # A repeated time at a change of standard offset, with no summer time involved.
    let caracas = try time.load_zone("America/Caracas");
    show(caracas, at(2007, 12, 9, 2, 45));
    # Milliseconds are kept.
    match time.from_local(stockholm, new time.DateTime { year: 2026, month: 7, day: 1, hour: 14, minute: 0, second: 0, ms: 123, weekday: 0 }) {
        case ok(ms) {
            print(time.format_time(ms));
        }
        case err(_) {
            print("not once");
        }
    }
    return ok();
}
