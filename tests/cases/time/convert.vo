# from_ms and to_ms across the epoch, leap days, century years and the ends of the range.
import std.time.DateTime;
import std.time.date;
import std.time.format_time;
import std.time.from_ms;
import std.time.to_ms;

fn show(ms: int) uses console {
    let d = from_ms(ms);
    print(format_time(ms) + " weekday " + str(d.weekday) + " " + str(d.year) + "/" + str(d.month) + "/" + str(d.day));
    match to_ms(d) {
        case ok(back) {
            if back != ms {
                print("  round trip differs: " + str(back));
            }
        }
        case err(e) {
            print("  to_ms: " + e);
        }
    }
}

fn day(y: int, m: int, d: int) uses console {
    match date(y, m, d) {
        case ok(ms) {
            show(ms);
        }
        case err(e) {
            print(str(y) + "-" + str(m) + "-" + str(d) + ": " + e);
        }
    }
}

fn main() uses console {
    show(0);
    show(-1);
    show(1);
    show(951782400000);
    day(2000, 2, 29);
    day(1900, 2, 28);
    day(1900, 3, 1);
    day(1900, 2, 29);
    day(2024, 2, 29);
    day(2023, 2, 29);
    day(2026, 1, 31);
    day(2026, 4, 30);
    day(2026, 4, 31);
    day(1, 1, 1);
    day(9999, 12, 31);
    day(0, 12, 31);
    day(10000, 1, 1);
    show(-62135596800000);
    show(253402300799999);
    show(-86400000);
    let bad = new DateTime { year: 2026, month: 13, day: 1, hour: 0, minute: 0, second: 0, ms: 0, weekday: 1 };
    match to_ms(bad) {
        case ok(v) {
            print(str(v));
        }
        case err(e) {
            print("month 13: " + e);
        }
    }
    let late = new DateTime { year: 2026, month: 1, day: 1, hour: 24, minute: 0, second: 0, ms: 0, weekday: 1 };
    match to_ms(late) {
        case ok(v) {
            print(str(v));
        }
        case err(e) {
            print("hour 24: " + e);
        }
    }
}
