# Leap years, month lengths and durations.
import std.time;

fn main() uses console {
    for y in [1900, 2000, 2023, 2024, 2100, 2400] {
        print(str(y) + " leap " + str(time.is_leap(y)) + ", February " + str(time.days_in_month(y, 2)));
    }
    for m in 1..13 {
        print("2026-" + str(m) + ": " + str(time.days_in_month(2026, m)));
    }
    print(str(time.seconds(90)) + " " + str(time.minutes(2)) + " " + str(time.hours(3)) + " " + str(time.days(1)) + " " + str(time.days(-1)));
}
