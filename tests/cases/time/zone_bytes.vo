# Zones from the built-in tz database: no changes, a rule, an alias, and names that are not there.
import std.time;

fn show(name: str) uses console {
    match time.load_zone(name) {
        case ok(z) {
            print(format("{}: {} changes, offsets {} to {}, {} rule", z.name, len(z.starts_s), z.offsets_s[0], z.offsets_s[len(z.offsets_s) - 1], len(z.rules)));
        }
        case err(e) {
            print(e);
        }
    }
}

fn main() uses console {
    show("UTC");
    show("Etc/GMT+5");
    show("Europe/Stockholm");
    show("Europe/Berlin");
    show("US/Eastern");
    show("Europe/Atlantis");
    show("");
    show("../etc/passwd");
    show("europe/stockholm");
    show("Europe/Stockholm ");
    print(str(time.load_zone("Europe/Oslo") == time.load_zone("Europe/Oslo")));
    let names = time.zone_names();
    print(format("{} names, {} to {}, data {}", len(names), names[0], names[len(names) - 1], time.tzdata_version()));
}
