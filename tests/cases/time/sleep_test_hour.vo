# Spec 022 US2: tests use a fixed clock, so an hour of sleeping takes no time.
import std.time.sleep;

test "an hour of retries" uses clock {
    let a = now_ms();
    for _ in 0..60 {
        sleep(60000);
    }
    expect_eq(now_ms() - a, 3600001);
}

test "each test starts at 0" uses clock {
    expect_eq(now_ms(), 0);
    sleep(10);
    expect_eq(now_ms(), 11);
}
