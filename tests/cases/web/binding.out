POST /boards/home/notes {"text": "milk", "tags": ["shop"]} -> 200 "home: milk by ada #1"
POST /boards/home/notes {"tags": ["a", 2]} -> 400 {"type":"about:blank","title":"Bad Request","status":400,"errors":[{"field":"tags[1]","reason":"expected string, got number"},{"field":"text","reason":"missing"}]}
POST /boards/home/notes {"text": ""} -> 422 {"type":"about:blank","title":"Unprocessable Content","status":422,"errors":[{"field":"text","reason":"at least 1 character, got 0"}]}
POST /boards/home/notes {"text": "x", "tags": ["a", "b", "c"], "color": "red"} -> 400 {"type":"about:blank","title":"Bad Request","status":400,"errors":[{"field":"tags","reason":"at most 2 items, got 3"},{"field":"color","reason":"unknown field"}]}
POST /boards/home/notes {"text": 5} -> 400 {"type":"about:blank","title":"Bad Request","status":400,"errors":[{"field":"text","reason":"expected string, got number"}]}
POST /boards/home/notes not json -> 400 {"type":"about:blank","title":"Bad Request","status":400,"errors":[{"field":"body","reason":"invalid json at line 1, column 1: expected `null`"}]}
POST /boards/home/notes  -> 400 {"type":"about:blank","title":"Bad Request","status":400,"errors":[{"field":"body","reason":"missing"}]}
GET /boards/home/notes  -> 200 "home limit 10 done false newest tags "
GET /boards/home/notes?limit=3&done=true&sort=oldest&tag=a&tag=b&utm=x  -> 200 "home limit 3 done true oldest tags a,b"
GET /boards/home/notes?limit=99  -> 422 {"type":"about:blank","title":"Unprocessable Content","status":422,"errors":[{"field":"limit","reason":"at most 50"}]}
GET /boards/home/notes?limit=x&done=maybe&sort=random  -> 400 {"type":"about:blank","title":"Bad Request","status":400,"errors":[{"field":"limit","reason":"expected integer, got \"x\""},{"field":"done","reason":"expected true or false, got \"maybe\""},{"field":"sort","reason":"unknown case \"random\" (expected one of: newest, oldest)"}]}
GET /boards/home/notes?limit=1&limit=2  -> 400 {"type":"about:blank","title":"Bad Request","status":400,"errors":[{"field":"limit","reason":"given more than once"}]}
GET /boards/h%C3%A9/notes?tag=a%20b  -> 200 "hé limit 10 done false newest tags a b"
