# Answers and errors in one form (spec 029 US3): helpers for 200/201/204, a hand-built Response passed
# through, `err("kind: detail")` mapped by the default table and the application's entries, any other
# err and a runtime error answered 500 with no detail.
import std.http;
import std.web;

record Item {
    id: int;
    name: str;
}

record Fail {
    kind: str;
}

fn answer(n: int, input: Fail) -> result[http.Response] {
    if input.kind == "ok" {
        return ok(web.json_reply(200, new Item { id: 1, name: "cup" }));
    }
    if input.kind == "created" {
        return ok(web.created("/items/2", new Item { id: 2, name: "pot" }));
    }
    if input.kind == "none" {
        return ok(web.no_content());
    }
    if input.kind == "accepted" {
        return ok(web.json_reply(202, "queued"));
    }
    if input.kind == "raw" {
        return ok(new http.Response { status: 302, headers: [new http.Header { name: "Location", value: "/elsewhere" }], body: "" });
    }
    if input.kind == "crash" {
        return ok(web.json_reply(200, 10 / (len(input.kind) - 5)));
    }
    if input.kind == "plain" {
        return err("disk full");
    }
    return err(input.kind + ": the " + input.kind + " detail");
}

fn routes() -> list[web.Route[int]] {
    return [web.on_get("/{kind}", answer)];
}

fn main() uses console {
    let app = new web.App { routes: routes(), steps: new list[web.Step[int]], errors: [web.error_status("quota", 429), web.error_status("conflict", 423)] };
    for kind in ["ok", "created", "none", "accepted", "raw", "bad_request", "unauthorized", "forbidden", "not_found", "conflict", "gone", "unprocessable", "quota", "teapot", "plain", "crash"] {
        let r = web.handle_request(app, 0, web.request("GET", "/" + kind, ""));
        var extra = "";
        for h in r.headers {
            set extra = extra + " [" + h.name + ": " + h.value + "]";
        }
        print(kind + " -> " + str(r.status) + extra + " " + r.body);
    }
}
