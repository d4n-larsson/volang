# Spec 055 US3: request_metrics counts requests by method, route pattern and status class, times them (1 ms
# each under a fixed clock: two clock reads) and counts those in flight: a scrape of /metrics counts itself.
# metrics_route lists the service's own metrics, shown before their first update.
import std.http;
import std.metrics;
import std.web;

record NoteId {
    id: int;
}

fn read_note(n: int, input: NoteId) -> result[http.Response] {
    return ok(web.json_reply(200, input.id));
}

fn create(n: int, input: web.NoInput) -> result[http.Response] uses log {
    metrics.add_to(metrics.counter("notes_created_total", "Notes created.", new list[str]), new list[str], 1);
    return ok(web.json_reply(201, "made"));
}

fn main() uses log, clock, console {
    let created = metrics.counter("notes_created_total", "Notes created.", new list[str]);
    let app = new web.App[int, uses log, clock] {
        routes: [web.on_get("/notes/{id}", read_note), web.on_post("/notes", create), web.metrics_route([created])],
        steps: [web.request_metrics()],
        errors: new list[web.ErrorStatus]
    };
    for path in ["/notes/1", "/notes/2", "/missing"] {
        let _ = web.handle_request(app, 0, web.request("GET", path, ""));
    }
    let _ = web.handle_request(app, 0, web.request("POST", "/notes", ""));
    let scrape = web.handle_request(app, 0, web.request("GET", "/metrics", ""));
    print(str(scrape.status) + " " + scrape.headers[0].name + ": " + scrape.headers[0].value);
    write(scrape.body);
}
