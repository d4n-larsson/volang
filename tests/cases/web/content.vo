# A body that is not JSON is 415; a body sent to an operation that takes none is 400; operations
# without input take NoInput, which a test can also build itself.
import std.http;
import std.web;

record Text {
    body: str;
}

fn ping(n: int, input: web.NoInput) -> result[http.Response] {
    return ok(web.json_reply(200, "pong"));
}

fn echo(n: int, input: Text) -> result[http.Response] {
    return ok(web.json_reply(200, input.body));
}

fn routes() -> list[web.Route[int]] {
    return [web.on_post("/ping", ping), web.on_post("/echo", echo)];
}

fn show(app: web.App[int], r: http.Request) uses console {
    let resp = web.handle_request(app, 0, r);
    print(r.path + " -> " + str(resp.status) + " " + resp.body);
}

fn main() uses console {
    let app = new web.App { routes: routes(), steps: new list[web.Step[int]], errors: new list[web.ErrorStatus] };
    show(app, web.request("POST", "/ping", ""));
    show(app, web.request("POST", "/ping", "{}"));
    show(app, web.request("POST", "/echo", "\"hi\""));
    show(app, new http.Request { method: "POST", path: "/echo", query: "", headers: [new http.Header { name: "Content-Type", value: "text/plain" }], body: "hi" });
    show(app, new http.Request { method: "POST", path: "/echo", query: "", headers: [new http.Header { name: "content-type", value: "application/json; charset=utf-8" }], body: "\"hi\"" });
    match ping(0, new web.NoInput {}) {
        case ok(r) {
            print("direct: " + r.body);
        }
        case err(e) {
            print(e);
        }
    }
}
