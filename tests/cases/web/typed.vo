# Typed operations (spec 032): an operation fails with its own error type, and one function maps each
# error to its status; the answers are the problems the "kind: detail" form gives.
import std.http;
import std.web;

variant NoteError {
    not_found(int);
    duplicate(str);
}

record ById {
    id: int;
}

fn note_problem(e: NoteError) -> web.Problem {
    match e {
        case not_found(id) {
            return new web.Problem { status: 404, detail: "no note " + str(id) };
        }
        case duplicate(title) {
            return new web.Problem { status: 409, detail: "a note is already called " + title };
        }
    }
}

fn show(n: int, input: ById) -> result[http.Response, NoteError] {
    if input.id == 7 {
        return ok(web.json_reply(200, "seven"));
    }
    if input.id == 8 {
        return err(NoteError.duplicate("eight"));
    }
    return err(NoteError.not_found(input.id));
}

fn old_style(n: int, input: ById) -> result[http.Response] {
    return err("not_found: no note " + str(input.id));
}

fn routes() -> list[web.Route[int]] {
    return [web.on_get("/notes/{id}", web.typed(show, note_problem)), web.on_get("/old/{id}", old_style)];
}

fn main() uses console {
    let app = new web.App {
        routes: routes(),
        steps: new list[web.Step[int]],
        errors: [web.error_status("quota", 429)]
    };
    for path in ["/notes/7", "/notes/8", "/notes/3", "/old/3"] {
        let r = web.handle_request(app, 0, web.request("GET", path, ""));
        print(path + " -> " + str(r.status) + " " + r.body);
    }
}
