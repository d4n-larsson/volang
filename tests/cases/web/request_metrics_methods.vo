# Spec 055 US3: a method outside GET, HEAD, POST, PUT, PATCH, DELETE and OPTIONS is counted as "other".
import std.metrics;
import std.web;

fn main() uses log, clock, console {
    let app = new web.App[int, uses log, clock] { routes: new list[web.Route[int, uses log, clock]], steps: [web.request_metrics()], errors: new list[web.ErrorStatus] };
    let _ = web.handle_request(app, 0, web.request("PROPFIND", "/x", ""));
    let text = metrics.metrics_text(new list[metrics.Metric]);
    print(slice(text, find(text, "http_requests_total{"), len(text)));
}
