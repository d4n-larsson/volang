# Health and info routes (spec 029 US7): 200 {"status":"up"} when every check passes, 503 naming the
# failing ones; info gives the name and version.
import std.web.App;
import std.web.ErrorStatus;
import std.web.HealthCheck;
import std.web.Step;
import std.web.handle_request;
import std.web.health_route;
import std.web.info_route;
import std.web.request;

record Deps {
    db_up: bool;
    queue_up: bool;
}

fn db(d: Deps) -> result[void] {
    if d.db_up {
        return ok();
    }
    return err("no answer in 5 s");
}

fn queue(d: Deps) -> result[void] {
    if d.queue_up {
        return ok();
    }
    return err("connection refused");
}

fn main() uses console {
    let app = new App { routes: [health_route([new HealthCheck { name: "database", check: db }, new HealthCheck { name: "queue", check: queue }]), info_route("notes", "2.1.0")], steps: new list[Step[Deps]], errors: new list[ErrorStatus] };
    for d in [new Deps { db_up: true, queue_up: true }, new Deps { db_up: false, queue_up: true }, new Deps { db_up: false, queue_up: false }] {
        let r = handle_request(app, d, request("GET", "/health", ""));
        print(str(r.status) + " " + r.body);
    }
    let i = handle_request(app, new Deps { db_up: true, queue_up: true }, request("GET", "/info", ""));
    print(str(i.status) + " " + i.body);
}
