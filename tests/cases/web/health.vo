# Health and info routes (spec 029 US7): 200 {"status":"up"} when every check passes, 503 naming the
# failing ones; info gives the name and version.
import std.web;

record Deps {
    db_up: bool;
    queue_up: bool;
}

fn db(d: Deps) -> result[void] {
    if d.db_up {
        return ok();
    }
    return err("no answer in 5 s");
}

fn queue(d: Deps) -> result[void] {
    if d.queue_up {
        return ok();
    }
    return err("connection refused");
}

fn main() uses console {
    let app = new web.App { routes: [web.health_route([new web.HealthCheck { name: "database", check: db }, new web.HealthCheck { name: "queue", check: queue }]), web.info_route("notes", "2.1.0")], steps: new list[web.Step[Deps]], errors: new list[web.ErrorStatus] };
    for d in [new Deps { db_up: true, queue_up: true }, new Deps { db_up: false, queue_up: true }, new Deps { db_up: false, queue_up: false }] {
        let r = web.handle_request(app, d, web.request("GET", "/health", ""));
        print(str(r.status) + " " + r.body);
    }
    let i = web.handle_request(app, new Deps { db_up: true, queue_up: true }, web.request("GET", "/info", ""));
    print(str(i.status) + " " + i.body);
}
