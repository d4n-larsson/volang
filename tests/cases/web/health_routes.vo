# Spec 055 US4: /health/ready answers 503 naming a failing check; /health/live answers 200 without running any
# check; with the check passing both are 200; health_route's /health is unchanged.
import std.http.Response;
import std.web.App;
import std.web.ErrorStatus;
import std.web.HealthCheck;
import std.web.Step;
import std.web.handle_request;
import std.web.health_route;
import std.web.health_routes;
import std.web.request;

record Db {
    up: bool;
    calls: list[int];
}

fn database(db: Db) -> result[void] {
    push(db.calls, 1);
    if db.up {
        return ok();
    }
    return err("cannot read data/notes.db");
}

fn show(resp: Response) -> str {
    return str(resp.status) + " " + resp.body;
}

fn main() uses console {
    let checks = [new HealthCheck[Db] { name: "database", check: database }];
    let app = new App[Db] { routes: health_routes(checks), steps: new list[Step[Db]], errors: new list[ErrorStatus] };
    let down = new Db { up: false, calls: new list[int] };
    print("ready " + show(handle_request(app, down, request("GET", "/health/ready", ""))));
    print("live " + show(handle_request(app, down, request("GET", "/health/live", ""))));
    print("checks run: " + str(len(down.calls)));
    let up = new Db { up: true, calls: new list[int] };
    print("ready " + show(handle_request(app, up, request("GET", "/health/ready", ""))));
    print("live " + show(handle_request(app, up, request("GET", "/health/live", ""))));
    let old = new App[Db] { routes: [health_route(checks)], steps: new list[Step[Db]], errors: new list[ErrorStatus] };
    print("health " + show(handle_request(old, down, request("GET", "/health", ""))));
}
