# Spec 055 US4: /health/ready answers 503 naming a failing check; /health/live answers 200 without running any
# check; with the check passing both are 200; health_route's /health is unchanged.
import std.http;
import std.web;

record Db {
    up: bool;
    calls: list[int];
}

fn database(db: Db) -> result[void] {
    push(db.calls, 1);
    if db.up {
        return ok();
    }
    return err("cannot read data/notes.db");
}

fn show(resp: http.Response) -> str {
    return str(resp.status) + " " + resp.body;
}

fn main() uses console {
    let checks = [new web.HealthCheck[Db] { name: "database", check: database }];
    let app = new web.App[Db] { routes: web.health_routes(checks), steps: new list[web.Step[Db]], errors: new list[web.ErrorStatus] };
    let down = new Db { up: false, calls: new list[int] };
    print("ready " + show(web.handle_request(app, down, web.request("GET", "/health/ready", ""))));
    print("live " + show(web.handle_request(app, down, web.request("GET", "/health/live", ""))));
    print("checks run: " + str(len(down.calls)));
    let up = new Db { up: true, calls: new list[int] };
    print("ready " + show(web.handle_request(app, up, web.request("GET", "/health/ready", ""))));
    print("live " + show(web.handle_request(app, up, web.request("GET", "/health/live", ""))));
    let old = new web.App[Db] { routes: [web.health_route(checks)], steps: new list[web.Step[Db]], errors: new list[web.ErrorStatus] };
    print("health " + show(web.handle_request(old, down, web.request("GET", "/health", ""))));
}
