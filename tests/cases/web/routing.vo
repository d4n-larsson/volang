# Routes from a table (spec 029 US1): each request reaches its operation with its path variables;
# 404 for an unknown path, 405 with Allow for another method, a literal beats a variable, a malformed
# number in a path is 400 naming the variable.
import std.http;
import std.option;
import std.web;

record Shop {
    name: str;
}

record NoteId {
    id: int;
}

record Pair {
    shelf: str;
    slot: int;
}

fn list_notes(shop: Shop, input: web.NoInput) -> result[http.Response] {
    return ok(web.json_reply(200, [shop.name, "notes"]));
}

fn add_note(shop: Shop, input: web.NoInput) -> result[http.Response] {
    return ok(web.no_content());
}

fn show_note(shop: Shop, input: NoteId) -> result[http.Response] {
    return ok(web.json_reply(200, input.id * 10));
}

fn latest(shop: Shop, input: web.NoInput) -> result[http.Response] {
    return ok(web.json_reply(200, "latest"));
}

fn remove_note(shop: Shop, input: NoteId) -> result[http.Response] {
    return ok(web.no_content());
}

fn slot(shop: Shop, input: Pair) -> result[http.Response] {
    return ok(web.json_reply(200, input.shelf + "/" + str(input.slot)));
}

fn routes() -> list[web.Route[Shop]] {
    return [web.on_get("/notes", list_notes), web.on_post("/notes", add_note), web.on_get("/notes/{id}", show_note), web.on_get("/notes/latest", latest), web.on_delete("/notes/{id}", remove_note), web.on_get("/shelves/{shelf}/slots/{slot}", slot)];
}

fn show(app: web.App[Shop], method: str, path: str) uses console {
    let r = web.handle_request(app, new Shop { name: "corner" }, web.request(method, path, ""));
    var allow = "";
    match option.to_result(http.response_header(r, "Allow"), "no header `" + "Allow" + "`") {
        case ok(a) {
            set allow = " Allow: " + a;
        }
        case err(_) {
        }
    }
    print(method + " " + path + " -> " + str(r.status) + allow + " " + r.body);
}

fn main() uses console {
    let app = new web.App { routes: routes(), steps: new list[web.Step[Shop]], errors: new list[web.ErrorStatus] };
    show(app, "GET", "/notes");
    show(app, "POST", "/notes");
    show(app, "GET", "/notes/7");
    show(app, "GET", "/notes/latest");
    show(app, "DELETE", "/notes/7");
    show(app, "PUT", "/notes/7");
    show(app, "GET", "/users");
    show(app, "GET", "/notes/abc");
    show(app, "GET", "/shelves/a%20b/slots/3");
    show(app, "HEAD", "/notes/7");
    show(app, "OPTIONS", "/notes/7");
    show(app, "GET", "/notes/");
    show(app, "GET", "/notes//7");
    show(app, "GET", "/");
}
