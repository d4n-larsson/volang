# Routes from a table (spec 029 US1): each request reaches its operation with its path variables;
# 404 for an unknown path, 405 with Allow for another method, a literal beats a variable, a malformed
# number in a path is 400 naming the variable.
import std.http.Request;
import std.http.Response;
import std.http.header;
import std.web.App;
import std.web.ErrorStatus;
import std.web.NoInput;
import std.web.Route;
import std.web.Step;
import std.web.handle_request;
import std.web.json_reply;
import std.web.no_content;
import std.web.on_delete;
import std.web.on_get;
import std.web.on_post;
import std.web.request;

record Shop {
    name: str;
}

record NoteId {
    id: int;
}

record Pair {
    shelf: str;
    slot: int;
}

fn list_notes(shop: Shop, input: NoInput) -> result[Response] {
    return ok(json_reply(200, [shop.name, "notes"]));
}

fn add_note(shop: Shop, input: NoInput) -> result[Response] {
    return ok(no_content());
}

fn show_note(shop: Shop, input: NoteId) -> result[Response] {
    return ok(json_reply(200, input.id * 10));
}

fn latest(shop: Shop, input: NoInput) -> result[Response] {
    return ok(json_reply(200, "latest"));
}

fn remove_note(shop: Shop, input: NoteId) -> result[Response] {
    return ok(no_content());
}

fn slot(shop: Shop, input: Pair) -> result[Response] {
    return ok(json_reply(200, input.shelf + "/" + str(input.slot)));
}

fn routes() -> list[Route[Shop]] {
    return [on_get("/notes", list_notes), on_post("/notes", add_note), on_get("/notes/{id}", show_note), on_get("/notes/latest", latest), on_delete("/notes/{id}", remove_note), on_get("/shelves/{shelf}/slots/{slot}", slot)];
}

fn show(app: App[Shop], method: str, path: str) uses console {
    let r = handle_request(app, new Shop { name: "corner" }, request(method, path, ""));
    var allow = "";
    match header(r, "Allow") {
        case ok(a) {
            set allow = " Allow: " + a;
        }
        case err(_) {
        }
    }
    print(method + " " + path + " -> " + str(r.status) + allow + " " + r.body);
}

fn main() uses console {
    let app = new App { routes: routes(), steps: new list[Step[Shop]], errors: new list[ErrorStatus] };
    show(app, "GET", "/notes");
    show(app, "POST", "/notes");
    show(app, "GET", "/notes/7");
    show(app, "GET", "/notes/latest");
    show(app, "DELETE", "/notes/7");
    show(app, "PUT", "/notes/7");
    show(app, "GET", "/users");
    show(app, "GET", "/notes/abc");
    show(app, "GET", "/shelves/a%20b/slots/3");
    show(app, "HEAD", "/notes/7");
    show(app, "OPTIONS", "/notes/7");
    show(app, "GET", "/notes/");
    show(app, "GET", "/notes//7");
    show(app, "GET", "/");
}
