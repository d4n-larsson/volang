# The ready steps (spec 029 US5): request ids (kept when sent, else from random_id), one log line per
# request (to stderr), CORS for listed origins, bearer tokens and API keys checked by the program's
# function, the identity passed on as X-Identity (and never taken from the client).
import std.http;
import std.web;

record Caller {
    @header("X-Identity")
    @default("anonymous")
    who: str;
}

fn whoami(n: int, input: Caller) -> result[http.Response] {
    return ok(web.json_reply(200, input.who));
}

fn token_ok(n: int, token: str) -> result[str] {
    if token == "secret" {
        return ok("ada");
    }
    return err("unknown token");
}

fn key_ok(n: int, key: str) -> result[str] {
    if key == "k1" {
        return ok("service-1");
    }
    return err("unknown key");
}

fn app() -> web.App[int, uses console, clock, random] {
    let routes: list[web.Route[int, uses console, clock, random]] = [web.on_get("/me", whoami), web.on_get("/admin/me", whoami), web.on_get("/svc/me", whoami)];
    return new web.App { routes: routes, steps: [web.request_ids(web.random_id), web.log_requests(fn() => now_ms(), web.to_stderr), web.cors(["https://app.example"]), web.bearer_auth("/admin", token_ok), web.api_key_auth("/svc", "X-Api-Key", key_ok)], errors: new list[web.ErrorStatus] };
}

fn show(label: str, r: http.Request) uses console, clock, random {
    let resp = web.handle_request(app(), 0, r);
    var hs = "";
    for h in resp.headers {
        if h.name != "Content-Type" {
            set hs = hs + " [" + h.name + ": " + h.value + "]";
        }
    }
    print(label + " -> " + str(resp.status) + hs + " " + resp.body);
}

fn main() uses console, clock, random {
    show("plain", web.request("GET", "/me", ""));
    show("own id", web.with_header(web.request("GET", "/me", ""), "X-Request-Id", "abc"));
    show("spoofed identity", web.with_header(web.request("GET", "/me", ""), "X-Identity", "root"));
    show("admin without token", web.request("GET", "/admin/me", ""));
    show("admin bad token", web.with_header(web.request("GET", "/admin/me", ""), "Authorization", "Bearer nope"));
    show("admin good token", web.with_header(web.request("GET", "/admin/me", ""), "Authorization", "Bearer secret"));
    show("service key", web.with_header(web.request("GET", "/svc/me", ""), "X-Api-Key", "k1"));
    show("service bad key", web.with_header(web.request("GET", "/svc/me", ""), "X-Api-Key", "k2"));
    show("cors listed", web.with_header(web.request("GET", "/me", ""), "Origin", "https://app.example"));
    show("cors other", web.with_header(web.request("GET", "/me", ""), "Origin", "https://evil.example"));
    show("preflight", web.with_header(web.with_header(web.request("OPTIONS", "/me", ""), "Origin", "https://app.example"), "Access-Control-Request-Method", "POST"));
}
