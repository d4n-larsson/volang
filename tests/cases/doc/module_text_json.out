{"v":1,"kind":"doc","module":"std.text","name":"starts_with","item":"fn","signature":"fn starts_with(s: str, prefix: str) -> bool","tparams":[],"params":[{"name":"s","type":"str"},{"name":"prefix","type":"str"}],"returns":"bool","effects":[],"description":"Whether s starts with prefix.","example":"starts_with(\"report.txt\", \"rep\") is true"}
{"v":1,"kind":"doc","module":"std.text","name":"ends_with","item":"fn","signature":"fn ends_with(s: str, suffix: str) -> bool","tparams":[],"params":[{"name":"s","type":"str"},{"name":"suffix","type":"str"}],"returns":"bool","effects":[],"description":"Whether s ends with suffix.","example":"ends_with(\"report.txt\", \".txt\") is true"}
{"v":1,"kind":"doc","module":"std.text","name":"contains","item":"fn","signature":"fn contains(s: str, sub: str) -> bool","tparams":[],"params":[{"name":"s","type":"str"},{"name":"sub","type":"str"}],"returns":"bool","effects":[],"description":"Whether sub occurs in s.","example":"contains(\"report.txt\", \"port\") is true"}
{"v":1,"kind":"doc","module":"std.text","name":"replace","item":"fn","signature":"fn replace(s: str, old: str, replacement: str) -> str","tparams":[],"params":[{"name":"s","type":"str"},{"name":"old","type":"str"},{"name":"replacement","type":"str"}],"returns":"str","effects":[],"description":"s with every occurrence of old replaced by replacement, left to right (an empty old is R0007).","example":"replace(\"a-b-c\", \"-\", \"+\") is \"a+b+c\""}
{"v":1,"kind":"doc","module":"std.text","name":"repeat","item":"fn","signature":"fn repeat(s: str, n: int) -> str","tparams":[],"params":[{"name":"s","type":"str"},{"name":"n","type":"int"}],"returns":"str","effects":[],"description":"s repeated n times (\"\" when n <= 0).","example":"repeat(\"ab\", 3) is \"ababab\""}
{"v":1,"kind":"doc","module":"std.text","name":"pad_left","item":"fn","signature":"fn pad_left(s: str, width: int, fill: str) -> str","tparams":[],"params":[{"name":"s","type":"str"},{"name":"width","type":"int"},{"name":"fill","type":"str"}],"returns":"str","effects":[],"description":"s padded on the left with fill (one character) to width characters.","example":"pad_left(\"7\", 3, \"0\") is \"007\""}
{"v":1,"kind":"doc","module":"std.text","name":"pad_right","item":"fn","signature":"fn pad_right(s: str, width: int, fill: str) -> str","tparams":[],"params":[{"name":"s","type":"str"},{"name":"width","type":"int"},{"name":"fill","type":"str"}],"returns":"str","effects":[],"description":"s padded on the right with fill (one character) to width characters.","example":"pad_right(\"ab\", 4, \".\") is \"ab..\""}
{"v":1,"kind":"doc","module":"std.text","name":"align_left","item":"fn","signature":"fn align_left(s: str, width: int) -> str","tparams":[],"params":[{"name":"s","type":"str"},{"name":"width","type":"int"}],"returns":"str","effects":[],"description":"s, then spaces up to width characters: s aligned left in a column.","example":"align_left(\"ab\", 4) + \"|\" is \"ab  |\""}
{"v":1,"kind":"doc","module":"std.text","name":"align_right","item":"fn","signature":"fn align_right(s: str, width: int) -> str","tparams":[],"params":[{"name":"s","type":"str"},{"name":"width","type":"int"}],"returns":"str","effects":[],"description":"Spaces, then s, up to width characters: s aligned right in a column.","example":"align_right(\"7\", 3) is \"  7\""}
{"v":1,"kind":"doc","module":"std.text","name":"lines","item":"fn","signature":"fn lines(s: str) -> list[str]","tparams":[],"params":[{"name":"s","type":"str"}],"returns":"list[str]","effects":[],"description":"The lines of s: split on newlines, a trailing carriage return dropped, no final empty line.","example":"lines(\"a\\nb\\n\") == [\"a\", \"b\"] is true"}
{"v":1,"kind":"doc","module":"std.text","name":"words","item":"fn","signature":"fn words(s: str) -> list[str]","tparams":[],"params":[{"name":"s","type":"str"}],"returns":"list[str]","effects":[],"description":"The words of s: runs of characters between spaces, tabs, newlines and carriage returns.","example":"words(\"  to be\\tor \") == [\"to\", \"be\", \"or\"] is true"}
