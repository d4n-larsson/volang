# money.format: Formats amounts of money.

# Formats an amount in cents as units and two decimals.
#     cents(1234) is "12.34"
fn cents(n: int) -> str {
    return str(n / 100) + "." + two(n % 100);
}

fn two(n: int) -> str {
    if n < 10 {
        return "0" + str(n);
    }
    return str(n);
}

# An amount with its currency code.
record Amount {
    cents: int;
    currency: str;
}
