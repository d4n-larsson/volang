builtins:
sort_by (xs: list[T], key: fn(T) -> C)
    in place, stable; `C` is `int`, `float` or `str` (E0313)
map (xs: list[T], f: fn(T) -> U) -> list[U]
    `f` of each element, in order
filter (xs: list[T], f: fn(T) -> bool) -> list[T]
    the elements for which `f` is true, in order
fold (xs: list[T], init: A, f: fn(A, T) -> A) -> A
    `f(f(init, xs[0]), xs[1])` ..., `init` for an empty list
any, all (xs: list[T], f: fn(T) -> bool) -> bool
    stop at the first element that decides
concurrent_map (xs: list[T], limit: int, f: fn(T) -> U) -> list[U]
    like `map`, at most `limit` (1 to 64, else R0007) tasks at a time
map_err (r: result[T, E1], f: fn(E1) -> E2) -> result[T, E2]
    an `ok` unchanged; `err(e)` becomes `err(f(e))`
print (s: str)
    stdout, adds `\n`
write (s: str)
    stdout, no newline
eprint (s: str)
    stderr, adds `\n`
read_line () -> result[str]
    one line of stdin without its `\n` (or `\r\n`); `err("eof")` at end of input
read_all () -> str
    the rest of stdin
read_file (path: str) -> result[str]
    the whole file; `err` if it cannot be read or is not UTF-8
write_file (path: str, s: str) -> result[void]
    creates or replaces the file
args () -> list[str]
    arguments after `--` in `vo run f.vo -- a b`
exit (code: int)
    ends the program; code 0–63, else R0008
now_ms () -> int
    wall-clock milliseconds; with `--clock-ms N`: N, N+1, ...
random_int (lo: int, hi: int) -> int
    uniform in `lo..hi` inclusive; R0007 if `lo > hi`; fixed by `--seed N`
env (name: str) -> result[str]
    an environment variable; `err("not set")`
str (x: int | float | bool) -> str
    a float as the shortest text `parse_float` reads back as the same value; `str(1.0)` is `"1.0"`
format (template: str, args...) -> str
    `template` a string literal; each `{}` or `{:spec}` takes the next argument (see Types)
int (f: float) -> int
    truncates toward zero; R0007 for NaN or out of range
float (i: int) -> float
    exact up to 2^53, else the nearest float
parse_int (s: str) -> result[int]
    the whole text must be the number: no spaces, no `+` (`trim` first); else `err("invalid int: ...")`
parse_float (s: str) -> result[float]
    `-`, digits, optionally `.` and digits, at most 17 significant digits; else `err("invalid float: ...")`
len (x: str | list[T] | map[K, T]) -> int
    for `str`: bytes, not characters
slice (s: str, a: int, b: int) -> str
    bytes `a` to `b - 1`; R0003 out of range; R0007 if it splits a UTF-8 character
slice (xs: list[T], a: int, b: int) -> list[T]
    a new list; R0003 out of range
find (s: str, sub: str) -> int
    byte offset of the first match, or -1
split (s: str, sep: str) -> list[str]
    `split("a,,b", ",")` is `["a", "", "b"]`; empty `sep` is R0007
join (xs: list[str], sep: str) -> str
    the strings with `sep` between them
trim (s: str) -> str
    removes ASCII whitespace at both ends
chars (s: str) -> list[str]
    one string per code point
byte_at (s: str, i: int) -> int
    byte `i`, 0 to 255, without a list; R0003 out of range
upper, lower (s: str) -> str
    ASCII letters only
ord (s: str) -> int
    code point of a one-character string (R0007 otherwise)
chr (i: int) -> str
    the one-character string for a code point
abs (x: int | float) -> int | float
    same type as `x`
min, max (a: C, b: C) -> C
    `C` is `int`, `float` or `str`
push (xs: list[T], v: T)
    appends
pop (xs: list[T]) -> result[T]
    removes the last element; `err("empty")`
sort (xs: list[C])
    in place, ascending, stable
has (m: map[K, T], k: K) -> bool
    whether the map has the key
get_or (m: map[K, T], k: K, default: T) -> T
    the default when the key is missing; never adds it
remove (m: map[K, T], k: K)
    no effect if the key is missing
keys (m: map[K, T]) -> list[K]
    in insertion order
ok (v: T) -> result[T]
    success; `ok()` for `result[void]`; its type comes from its place
err (message: str) -> result[T]
    failure with a message
todo (what: str) -> T
    a hole of any type: the program checks; reaching it is R0011
assume (cond: bool)
    only in `prop`: discards an input that does not apply
expect (cond: bool)
    only inside `test` (E0410)
expect_eq (actual: T, expected: T)
    only inside `test` (E0410); reports both values
modules:
  std.json JSON values: parse, write, and read fields and elements.
  std.time UTC calendar time, ISO 8601 text and durations in milliseconds.
  std.text Text helpers: search, replace, repeat, pad, lines and words.
  std.random Random floats, picks and shuffles (fixed by --seed; not for secrets: std.crypto.random_bytes).
  std.http HTTP and HTTPS requests (needs net), and serving plain HTTP requests (needs serve).
  std.collections Operations on the built-in ordered_map, ordered_set, priority_queue and deque.
  std.fs Directories and file information (needs file.read), and file changes (needs file.write, file.delete).
  std.process Running other programs to their end, with no shell (needs process).
  std.math Square roots, powers, logarithms, trigonometry and rounding to int, correctly rounded.
  std.bytes Conversions of binary data with text, integers, hex and base64, and standard input and output as bytes.
  std.regex Regular expressions that run in linear time: test, find, replace and split with compiled patterns.
  std.sqlite SQLite databases in files (file.read, file.write) or in memory (no effect), with checked statements and ? parameters.
  std.web Building HTTP APIs: a route table, typed request input, JSON answers, errors mapped in one place, steps around requests, settings, health, and tests without a network.
  std.option a value that may be absent: Option[T] is some(value) or none (spec 032).
  std.crypto Hashes, message signatures, secret random bytes and password storage.
  std.tcp TCP connections: connect, send, read, TLS, listen and accept, for protocols other than HTTP.
