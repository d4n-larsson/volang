# Spec 035: storing and checking passwords.
import std.crypto;

test "two hashes of one password differ and name the method and cost" uses entropy {
    let a = crypto.hash_password("correct horse");
    let b = crypto.hash_password("correct horse");
    expect(a != b);
    expect_eq(slice(a, 0, 21), "pbkdf2-sha256$600000$");
    expect_eq(len(split(a, "$")), 4);
}

test "a hashed password verifies" uses entropy {
    expect(crypto.verify_password("correct horse", crypto.hash_password("correct horse")));
}

test "a stored text with another cost verifies; a wrong password does not" {
    expect(crypto.verify_password("hunter2", "pbkdf2-sha256$1000$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
    expect(not crypto.verify_password("hunter3", "pbkdf2-sha256$1000$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
    expect(not crypto.verify_password("", "pbkdf2-sha256$1000$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
}

test "the empty password can be stored" {
    expect(crypto.verify_password("", "pbkdf2-sha256$10$MDEyMzQ1Njc4OWFiY2RlZg==$yBNYYDUi55WKQdi8jYMfeeyNHWlyV3jJLh9T59G16hU="));
}

test "anything else is false, never an error" {
    expect(not crypto.verify_password("hunter2", ""));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$1000$MDEyMzQ1Njc4OWFiY2RlZg=="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha1$1000$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$0$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$x$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$01000$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$10000001$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$1000$!!EyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$1000$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQ!!!="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$1000$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQhw=="));
    expect(not crypto.verify_password("hunter2", "pbkdf2-sha256$1000$MDEyMzQ1Njc4OWFiY2RlZg==$pj4T35D2v4tYmC1sTJ1y5tcMADOdtnQGvuHmyYDQh2g=$extra"));
    expect(not crypto.verify_password("hunter2", "not a hash"));
}
