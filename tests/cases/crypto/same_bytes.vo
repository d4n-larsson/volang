import std.bytes;
import std.crypto;

fn main() uses console {
    print(str(crypto.same_bytes(bytes.from_text("secret-token"), bytes.from_text("secret-token"))));
    print(str(crypto.same_bytes(bytes.from_text("secret-token"), bytes.from_text("Xecret-token"))));
    print(str(crypto.same_bytes(bytes.from_text("secret-token"), bytes.from_text("secret-tokeX"))));
    print(str(crypto.same_bytes(bytes.from_text("secret-token"), bytes.from_text("secret-toke"))));
    print(str(crypto.same_bytes(bytes.from_text(""), bytes.from_text(""))));
}
