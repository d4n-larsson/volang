import std.bytes.from_text;
import std.crypto.same_bytes;

fn main() uses console {
    print(str(same_bytes(from_text("secret-token"), from_text("secret-token"))));
    print(str(same_bytes(from_text("secret-token"), from_text("Xecret-token"))));
    print(str(same_bytes(from_text("secret-token"), from_text("secret-tokeX"))));
    print(str(same_bytes(from_text("secret-token"), from_text("secret-toke"))));
    print(str(same_bytes(from_text(""), from_text(""))));
}
