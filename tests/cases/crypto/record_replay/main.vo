import std.bytes;
import std.crypto;

fn main() uses console, entropy {
    let key = crypto.random_bytes(32);
    print(bytes.to_hex(crypto.random_bytes(0)) + bytes.to_hex(crypto.random_bytes(5)));
    print(bytes.to_hex(crypto.hmac_sha256(key, crypto.sha256(bytes.from_text("body")))));
    let stored = crypto.hash_password("pw");
    print(stored + " " + str(crypto.verify_password("pw", stored)) + " " + str(crypto.same_bytes(key, key)));
}
