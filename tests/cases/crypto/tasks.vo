import std.bytes;
import std.crypto;

fn draw(n: int) -> str uses entropy {
    return bytes.to_hex(crypto.random_bytes(n));
}

fn main() uses console, entropy {
    let xs = concurrent_map([8, 8, 8], 3, draw);
    print(str(len(xs[0])) + " " + str(xs[0] != xs[1] and xs[1] != xs[2] and xs[0] != xs[2]));
}
