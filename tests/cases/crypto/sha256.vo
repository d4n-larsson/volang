# Spec 035: the SHA-256 vectors of FIPS 180-4.
import std.bytes;
import std.crypto;
import std.text;

fn main() uses console {
    print(bytes.to_hex(crypto.sha256(bytes.from_text(""))));
    print(bytes.to_hex(crypto.sha256(bytes.from_text("abc"))));
    print(bytes.to_hex(crypto.sha256(bytes.from_text("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))));
    print(bytes.to_hex(crypto.sha256(bytes.from_text(text.repeat("a", 1000000)))));
    print(str(len(crypto.sha256(bytes.from_text("x")))));
}
