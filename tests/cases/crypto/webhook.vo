# Spec 035: checking a signed webhook body.
import std.bytes;
import std.crypto;

fn signed_by(secret: str, body: bytes, signature: bytes) -> bool {
    return crypto.same_bytes(crypto.hmac_sha256(bytes.from_text(secret), body), signature);
}

fn main() -> result[void] uses console {
    let body = bytes.from_text("{\"event\":\"paid\",\"amount\":1200}");
    let header = bytes.to_hex(crypto.hmac_sha256(bytes.from_text("whsec_1"), body));
    let signature = try bytes.from_hex(header);
    print(str(signed_by("whsec_1", body, signature)));
    print(str(signed_by("whsec_1", bytes.from_text("{\"event\":\"paid\",\"amount\":9900}"), signature)));
    print(str(signed_by("whsec_2", body, signature)));
    return ok();
}
