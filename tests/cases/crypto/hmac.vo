# Spec 035: the HMAC-SHA256 vectors of RFC 4231 (cases 1, 2, 3, 4, 6 and 7).
import std.bytes;
import std.crypto;
import std.text;

fn show(key_hex: str, data: bytes) -> result[void] uses console {
    print(bytes.to_hex(crypto.hmac_sha256(try bytes.from_hex(key_hex), data)));
    return ok();
}

fn main() -> result[void] uses console {
    try show(text.repeat("0b", 20), bytes.from_text("Hi There"));
    try show("4a656665", bytes.from_text("what do ya want for nothing?"));
    try show(text.repeat("aa", 20), try bytes.from_hex(text.repeat("dd", 50)));
    try show("0102030405060708090a0b0c0d0e0f10111213141516171819", try bytes.from_hex(text.repeat("cd", 50)));
    try show(text.repeat("aa", 131), bytes.from_text("Test Using Larger Than Block-Size Key - Hash Key First"));
    try show(
        text.repeat("aa", 131),
        bytes.from_text("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.")
    );
    return ok();
}
