record Size {
    w: int;
    h: int;
}

variant Shape {
    rect(Size);
    dot;
}

fn area(s: Shape) -> int {
    match s {
        case rect(r) {
            return r.w * r.h;
        }
        case dot {
            return 0;
        }
    }
}

fn main() uses console {
    let a = Shape.rect(new Size { w: 2, h: 3 });
    let b = Shape.rect(new Size { h: 3, w: 2 });
    print(
        str(a == b) + " " + str(a == Shape.rect(new Size { w: 3, h: 2 })) + " " + str(a < Shape.rect(new Size { w: 2, h: 4 }))
    );
    let names = new map[Shape, str];
    set names[a] = "six";
    print(names[b]);
    var shapes = [
        Shape.rect(new Size { w: 5, h: 1 }),
        Shape.dot,
        Shape.rect(new Size { w: 1, h: 2 })
    ];
    sort(shapes);
    print(join(map(shapes, fn(s) => str(area(s))), ","));
}
