record Product {
    sku: str;
    name: str;
    price: int;
}

record Box {
    price: int;
}

fn add_item(items: list[Product], sku: str, name: str, price: int) uses console {
    push(items, new Product { sku: sku, name: name, price: price });
    print("add_item " + sku);
}

fn total(items: list[Product]) -> int {
    var sum = 0;
    for it in items {
        set sum = sum + it.price;
    }
    return sum;
}
