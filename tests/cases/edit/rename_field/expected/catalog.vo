record Item {
    sku: str;
    name: str;
    price_cents: int;
}

record Box {
    price: int;
}

fn add_item(items: list[Item], sku: str, name: str, price: int) uses console {
    push(items, new Item { sku: sku, name: name, price_cents: price });
    print("add_item " + sku);
}

fn total(items: list[Item]) -> int {
    var sum = 0;
    for it in items {
        set sum = sum + it.price_cents;
    }
    return sum;
}
