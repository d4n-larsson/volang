# Spec 018 US3: coverage counts only the program's own files, not the standard library or packages.
import money.format;
import std.text;

fn label(n: int) -> str {
    if n < 0 {
        return "minus " + format.cents(0 - n);
    }
    return text.pad_left(format.cents(n), 8, " ");
}

test "label" {
    expect_eq(label(1234), "   12.34");
}
