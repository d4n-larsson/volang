# Spec 047: a worker's runtime error or exit is a value in the program, after the messages it sent.
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, workers.WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[workers.Worker[int, int], workers.WorkerError]) -> workers.Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn two_then_zero(link: workers.Link[int, int]) uses console {
    give(link, 1);
    give(link, 2);
    print("worker: about to divide");
    let zero = len(chars(""));
    give(link, 10 / zero);
}

fn leaves(link: workers.Link[int, int]) {
    match workers.next_message(link, workers.Wait.forever) {
        case ok(n) {
            exit(n);
        }
        case err(_) {
        }
    }
}

fn main() uses console {
    let w = worker_of(workers.start_worker(two_then_zero));
    print(show(workers.receive(w, workers.Wait.forever)));
    print(show(workers.receive(w, workers.Wait.forever)));
    print("a tell before the failure is received: " + sent(workers.tell(w, 0)));
    print(show(workers.receive(w, workers.Wait.forever)));
    print("the program goes on");
    print("a tell after it: " + sent(workers.tell(w, 0)));
    print(show(workers.receive(w, workers.Wait.forever)));

    let zero = worker_of(workers.start_worker(leaves));
    print(sent(workers.tell(zero, 0)));
    print("exit(0): " + show(workers.receive(zero, workers.Wait.forever)));
    let three = worker_of(workers.start_worker(leaves));
    print(sent(workers.tell(three, 3)));
    print("exit(3): " + show(workers.receive(three, workers.Wait.forever)));
}
