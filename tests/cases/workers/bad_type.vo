# Spec 047: a message type that holds a function is refused when the worker is started (R0015).
import std.workers.Link;
import std.workers.Wait;
import std.workers.Worker;
import std.workers.WorkerError;
import std.workers.emit;
import std.workers.next_message;
import std.workers.receive;
import std.workers.start_worker;
import std.workers.stop_worker;
import std.workers.tell;

fn why(e: WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: Link[int, int], n: int) {
    match emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[Worker[int, int], WorkerError]) -> Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn body(link: Link[int, fn(int) -> int]) {
}

fn main() uses console {
    print("before");
    match start_worker(body) {
        case ok(_) {
            print("started");
        }
        case err(e) {
            print(why(e));
        }
    }
}
