# Spec 047: a worker's effects are declared by the function that starts it, as for any function it calls.
import std.workers;

fn noisy(link: workers.Link[int, int]) uses console {
    print("hi");
}

fn main() {
    match workers.start_worker(noisy) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}
