# Spec 047: each worker has its own random sequence, fixed by --seed and its number among the workers.
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, workers.WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[workers.Worker[int, int], workers.WorkerError]) -> workers.Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn dice(link: workers.Link[int, int]) uses random {
    for i in 0..3 {
        give(link, random_int(0, 1000000) + i - i);
    }
}

fn main() uses console, random {
    let a = worker_of(workers.start_worker(dice));
    let b = worker_of(workers.start_worker(dice));
    print("the program: " + str(random_int(0, 1000000)));
    for i in 0..3 {
        print(show(workers.receive(a, workers.Wait.forever)) + " | " + show(workers.receive(b, workers.Wait.forever)) + " (" + str(i) + ")");
    }
}
