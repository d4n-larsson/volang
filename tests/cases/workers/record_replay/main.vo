# Spec 047: a recording holds what the program got from its workers; the replay starts none and
# prints and ends as the recorded run did.
import std.workers.Link;
import std.workers.Wait;
import std.workers.Worker;
import std.workers.WorkerError;
import std.workers.emit;
import std.workers.next_message;
import std.workers.receive;
import std.workers.receive_first;
import std.workers.start_worker;
import std.workers.stop_worker;
import std.workers.tell;

fn why(e: WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: Link[int, int], n: int) {
    match emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn reads(link: Link[int, int]) uses console, file.read {
    match read_file("data.txt") {
        case ok(text) {
            print("worker: read " + trim(text));
            give(link, len(trim(text)));
        }
        case err(e) {
            print("worker: " + e);
        }
    }
    match next_message(link, Wait.forever) {
        case ok(n) {
            eprint("worker: told " + str(n));
            give(link, n + 1);
        }
        case err(_) {
        }
    }
}

fn fails(link: Link[int, int]) uses console {
    print("failing worker: one line");
    let zero = len(chars(""));
    give(link, 1 / zero);
}

fn silent(link: Link[int, int]) uses console {
    print("silent worker: started");
    match next_message(link, Wait.forever) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

fn main() uses console, file.read {
    match start_worker(reads) {
        case ok(w) {
            print(show(receive(w, Wait.forever)));
            match tell(w, 41) {
                case ok() {
                }
                case err(e) {
                    print(why(e));
                }
            }
            print(show(receive(w, Wait.forever)));
            print(show(receive(w, Wait.forever)));
            match receive_first([w], Wait.forever) {
                case ok(_) {
                    print("an arrival");
                }
                case err(e) {
                    print("first: " + why(e));
                }
            }
        }
        case err(e) {
            print(why(e));
        }
    }
    match start_worker(silent) {
        case ok(w) {
            print(show(receive(w, Wait.at_most(200))));
            match receive_first([w], Wait.at_most(1)) {
                case ok(_) {
                    print("an arrival");
                }
                case err(e) {
                    print("first: " + why(e));
                }
            }
            stop_worker(w);
            print(show(receive(w, Wait.forever)));
        }
        case err(e) {
            print(why(e));
        }
    }
    match start_worker(fails) {
        case ok(w) {
            match receive_first([w], Wait.forever) {
                case ok(a) {
                    print(str(a.index) + ": " + slice(show(a.message), 0, 6));
                }
                case err(e) {
                    print("first: " + why(e));
                }
            }
        }
        case err(e) {
            print(why(e));
        }
    }
    match start_worker(fails) {
        case ok(_) {
            print("the last worker's failure is not received");
        }
        case err(e) {
            print(why(e));
        }
    }
    match start_worker(silent) {
        case ok(w) {
            print(show(receive(w, Wait.at_most(200))));
        }
        case err(e) {
            print(why(e));
        }
    }
}
