# Spec 047: a recording holds what the program got from its workers; the replay starts none and
# prints and ends as the recorded run did.
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn reads(link: workers.Link[int, int]) uses console, file.read {
    match read_file("data.txt") {
        case ok(text) {
            print("worker: read " + trim(text));
            give(link, len(trim(text)));
        }
        case err(e) {
            print("worker: " + e);
        }
    }
    match workers.next_message(link, workers.Wait.forever) {
        case ok(n) {
            eprint("worker: told " + str(n));
            give(link, n + 1);
        }
        case err(_) {
        }
    }
}

fn fails(link: workers.Link[int, int]) uses console {
    print("failing worker: one line");
    let zero = len(chars(""));
    give(link, 1 / zero);
}

fn silent(link: workers.Link[int, int]) uses console {
    print("silent worker: started");
    match workers.next_message(link, workers.Wait.forever) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

fn main() uses console, file.read {
    match workers.start_worker(reads) {
        case ok(w) {
            print(show(workers.receive(w, workers.Wait.forever)));
            match workers.tell(w, 41) {
                case ok() {
                }
                case err(e) {
                    print(why(e));
                }
            }
            print(show(workers.receive(w, workers.Wait.forever)));
            print(show(workers.receive(w, workers.Wait.forever)));
            match workers.receive_first([w], workers.Wait.forever) {
                case ok(_) {
                    print("an arrival");
                }
                case err(e) {
                    print("first: " + why(e));
                }
            }
        }
        case err(e) {
            print(why(e));
        }
    }
    match workers.start_worker(silent) {
        case ok(w) {
            print(show(workers.receive(w, workers.Wait.at_most(200))));
            match workers.receive_first([w], workers.Wait.at_most(1)) {
                case ok(_) {
                    print("an arrival");
                }
                case err(e) {
                    print("first: " + why(e));
                }
            }
            workers.stop_worker(w);
            print(show(workers.receive(w, workers.Wait.forever)));
        }
        case err(e) {
            print(why(e));
        }
    }
    match workers.start_worker(fails) {
        case ok(w) {
            match workers.receive_first([w], workers.Wait.forever) {
                case ok(a) {
                    print(str(a.index) + ": " + slice(show(a.message), 0, 6));
                }
                case err(e) {
                    print("first: " + why(e));
                }
            }
        }
        case err(e) {
            print(why(e));
        }
    }
    match workers.start_worker(fails) {
        case ok(_) {
            print("the last worker's failure is not received");
        }
        case err(e) {
            print(why(e));
        }
    }
    match workers.start_worker(silent) {
        case ok(w) {
            print(show(workers.receive(w, workers.Wait.at_most(200))));
        }
        case err(e) {
            print(why(e));
        }
    }
}
