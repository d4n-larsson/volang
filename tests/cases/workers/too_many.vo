# Spec 047: at most 64 workers at a time; a stopped or ended one makes room.
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, workers.WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[workers.Worker[int, int], workers.WorkerError]) -> workers.Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn waits(link: workers.Link[int, int]) {
    match workers.next_message(link, workers.Wait.forever) {
        case ok(n) {
            give(link, n);
        }
        case err(_) {
        }
    }
}

fn main() uses console {
    let ws = new list[workers.Worker[int, int]];
    for i in 0..64 {
        push(ws, worker_of(workers.start_worker(waits)));
    }
    match workers.start_worker(waits) {
        case ok(_) {
            print("a 65th started");
        }
        case err(e) {
            print("the 65th: " + why(e));
        }
    }
    workers.stop_worker(ws[10]);
    match workers.start_worker(waits) {
        case ok(w) {
            print("after a stop: started");
            print("the stopped one: " + show(workers.receive(ws[10], workers.Wait.forever)));
            print(sent(workers.tell(w, 5)) + ", " + show(workers.receive(w, workers.Wait.forever)));
        }
        case err(e) {
            print("after a stop: " + why(e));
        }
    }
    print(sent(workers.tell(ws[20], 7)) + ", " + show(workers.receive(ws[20], workers.Wait.forever)) + ", " + show(workers.receive(ws[20], workers.Wait.forever)));
    match workers.start_worker(waits) {
        case ok(_) {
            print("after an end: started");
        }
        case err(e) {
            print("after an end: " + why(e));
        }
    }
    match workers.start_worker(waits) {
        case ok(_) {
            print("one more started");
        }
        case err(e) {
            print("one more: " + why(e));
        }
    }
}
