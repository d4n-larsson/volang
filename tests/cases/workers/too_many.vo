# Spec 047: at most 64 workers at a time; a stopped or ended one makes room.
import std.workers.Link;
import std.workers.Wait;
import std.workers.Worker;
import std.workers.WorkerError;
import std.workers.emit;
import std.workers.next_message;
import std.workers.receive;
import std.workers.start_worker;
import std.workers.stop_worker;
import std.workers.tell;

fn why(e: WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: Link[int, int], n: int) {
    match emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[Worker[int, int], WorkerError]) -> Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn waits(link: Link[int, int]) {
    match next_message(link, Wait.forever) {
        case ok(n) {
            give(link, n);
        }
        case err(_) {
        }
    }
}

fn main() uses console {
    let ws = new list[Worker[int, int]];
    for i in 0..64 {
        push(ws, worker_of(start_worker(waits)));
    }
    match start_worker(waits) {
        case ok(_) {
            print("a 65th started");
        }
        case err(e) {
            print("the 65th: " + why(e));
        }
    }
    stop_worker(ws[10]);
    match start_worker(waits) {
        case ok(w) {
            print("after a stop: started");
            print("the stopped one: " + show(receive(ws[10], Wait.forever)));
            print(sent(tell(w, 5)) + ", " + show(receive(w, Wait.forever)));
        }
        case err(e) {
            print("after a stop: " + why(e));
        }
    }
    print(sent(tell(ws[20], 7)) + ", " + show(receive(ws[20], Wait.forever)) + ", " + show(receive(ws[20], Wait.forever)));
    match start_worker(waits) {
        case ok(_) {
            print("after an end: started");
        }
        case err(e) {
            print("after an end: " + why(e));
        }
    }
    match start_worker(waits) {
        case ok(_) {
            print("one more started");
        }
        case err(e) {
            print("one more: " + why(e));
        }
    }
}
