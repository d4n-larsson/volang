# Spec 047: the first message from any of several workers; the earliest in the list when several wait.
import std.time;
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, workers.WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[workers.Worker[int, int], workers.WorkerError]) -> workers.Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn gives(n: int) -> fn(workers.Link[int, int]) {
    return fn(link: workers.Link[int, int]) {
        give(link, n);
        give(link, n + 1);
    };
}

fn fails(link: workers.Link[int, int]) {
    let zero = len(chars(""));
    give(link, 1 / zero);
}

fn silent(link: workers.Link[int, int]) {
    match workers.next_message(link, workers.Wait.forever) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

fn one(ws: list[workers.Worker[int, int]], wait: workers.Wait) -> str {
    match workers.receive_first(ws, wait) {
        case ok(a) {
            return str(a.index) + ": " + show(a.message);
        }
        case err(e) {
            return "none: " + why(e);
        }
    }
}

fn main() uses console, clock {
    let ws = [worker_of(workers.start_worker(gives(10))), worker_of(workers.start_worker(fails)), worker_of(workers.start_worker(gives(30)))];
    time.sleep(300);
    # all three have finished: the order is the list's
    for i in 0..9 {
        print(one(ws, workers.Wait.forever) + " (" + str(i) + ")");
    }
    let quiet = [worker_of(workers.start_worker(silent)), worker_of(workers.start_worker(silent))];
    print(one(quiet, workers.Wait.at_most(0)));
    print(one(quiet, workers.Wait.at_most(50)));
    let none = new list[workers.Worker[int, int]];
    print(one(none, workers.Wait.forever));
}
