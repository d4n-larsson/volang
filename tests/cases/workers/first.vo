# Spec 047: the first message from any of several workers; the earliest in the list when several wait.
import std.workers.Link;
import std.workers.Wait;
import std.workers.Worker;
import std.workers.WorkerError;
import std.workers.emit;
import std.workers.next_message;
import std.workers.receive;
import std.workers.start_worker;
import std.workers.stop_worker;
import std.workers.tell;
import std.workers.receive_first;
import std.time.sleep;

fn why(e: WorkerError) -> str {
    match e {
        case timeout {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: Link[int, int], n: int) {
    match emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[Worker[int, int], WorkerError]) -> Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn gives(n: int) -> fn(Link[int, int]) {
    return fn(link: Link[int, int]) {
        give(link, n);
        give(link, n + 1);
    };
}

fn fails(link: Link[int, int]) {
    let zero = len(chars(""));
    give(link, 1 / zero);
}

fn silent(link: Link[int, int]) {
    match next_message(link, Wait.forever) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

fn one(ws: list[Worker[int, int]], wait: Wait) -> str {
    match receive_first(ws, wait) {
        case ok(a) {
            return str(a.index) + ": " + show(a.message);
        }
        case err(e) {
            return "none: " + why(e);
        }
    }
}

fn main() uses console, clock {
    let ws = [worker_of(start_worker(gives(10))), worker_of(start_worker(fails)), worker_of(start_worker(gives(30)))];
    sleep(300);
    # all three have finished: the order is the list's
    for i in 0..9 {
        print(one(ws, Wait.forever) + " (" + str(i) + ")");
    }
    let quiet = [worker_of(start_worker(silent)), worker_of(start_worker(silent))];
    print(one(quiet, Wait.at_most(0)));
    print(one(quiet, Wait.at_most(50)));
    let none = new list[Worker[int, int]];
    print(one(none, Wait.forever));
}
