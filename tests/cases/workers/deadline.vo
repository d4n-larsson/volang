# Spec 047: a time limit for one call, and stopping a worker whatever it does.
import std.time;
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, workers.WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[workers.Worker[int, int], workers.WorkerError]) -> workers.Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn spin() -> int {
    var n = 0;
    while true {
        set n = n + 1;
    }
    return n;
}

fn loops(link: workers.Link[int, int]) {
    while true {
    }
}

fn sleeps(link: workers.Link[int, int]) uses clock {
    time.sleep(60000);
}

fn main() uses console, clock {
    let numbers = [1, 2, 3];
    print("in time: " + show(workers.with_deadline(5000, fn() { push(numbers, 4); return len(numbers); })));
    print("the program's list: " + str(len(numbers)));
    print("never returns: " + show(workers.with_deadline(100, spin)));
    print("fails: " + show(workers.with_deadline(5000, fn() => 1 / (len(numbers) - 3))));

    let a = worker_of(workers.start_worker(loops));
    workers.stop_worker(a);
    print("stopped while computing: " + show(workers.receive(a, workers.Wait.forever)) + ", " + sent(workers.tell(a, 1)));
    workers.stop_worker(a);
    let b = worker_of(workers.start_worker(sleeps));
    workers.stop_worker(b);
    print("stopped while sleeping: " + show(workers.receive(b, workers.Wait.forever)));
}
