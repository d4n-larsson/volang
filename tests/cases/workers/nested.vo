# Spec 047: workers are started by the program itself: R0007 in a worker; concurrent_map works inside one.
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, workers.WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[workers.Worker[int, int], workers.WorkerError]) -> workers.Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn square(n: int) -> int {
    return n * n;
}

fn maps(link: workers.Link[int, int]) {
    let squares = concurrent_map([1, 2, 3, 4], 2, square);
    give(link, squares[0] + squares[1] + squares[2] + squares[3]);
}

fn inner(link: workers.Link[int, int]) {
}

fn starts(link: workers.Link[int, int]) {
    match workers.start_worker(inner) {
        case ok(_) {
            give(link, 1);
        }
        case err(_) {
            give(link, 2);
        }
    }
}

fn main() uses console {
    let m = worker_of(workers.start_worker(maps));
    print("concurrent_map in a worker: " + show(workers.receive(m, workers.Wait.forever)));
    let s = worker_of(workers.start_worker(starts));
    print(show(workers.receive(s, workers.Wait.forever)));
}
