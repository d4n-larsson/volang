# Spec 047: workers are started by the program itself: R0007 in a worker; concurrent_map works inside one.
import std.workers.Link;
import std.workers.Wait;
import std.workers.Worker;
import std.workers.WorkerError;
import std.workers.emit;
import std.workers.next_message;
import std.workers.receive;
import std.workers.start_worker;
import std.workers.stop_worker;
import std.workers.tell;

fn why(e: WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: Link[int, int], n: int) {
    match emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[Worker[int, int], WorkerError]) -> Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn square(n: int) -> int {
    return n * n;
}

fn maps(link: Link[int, int]) {
    let squares = concurrent_map([1, 2, 3, 4], 2, square);
    give(link, squares[0] + squares[1] + squares[2] + squares[3]);
}

fn inner(link: Link[int, int]) {
}

fn starts(link: Link[int, int]) {
    match start_worker(inner) {
        case ok(_) {
            give(link, 1);
        }
        case err(_) {
            give(link, 2);
        }
    }
}

fn main() uses console {
    let m = worker_of(start_worker(maps));
    print("concurrent_map in a worker: " + show(receive(m, Wait.forever)));
    let s = worker_of(start_worker(starts));
    print(show(receive(s, Wait.forever)));
}
