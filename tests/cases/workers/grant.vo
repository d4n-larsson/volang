# Spec 047: a worker runs under the program's grant: a read outside the declared directory is `failed` with R0010.
import std.workers.Link;
import std.workers.Wait;
import std.workers.Worker;
import std.workers.WorkerError;
import std.workers.emit;
import std.workers.next_message;
import std.workers.receive;
import std.workers.start_worker;
import std.workers.stop_worker;
import std.workers.tell;

fn why(e: WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: Link[int, int], n: int) {
    match emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[Worker[int, int], WorkerError]) -> Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn reader(link: Link[str, int]) uses file.read("data/") {
    match next_message(link, Wait.forever) {
        case ok(path) {
            match read_file(path) {
                case ok(text) {
                    match emit(link, len(text)) {
                        case ok() {
                        }
                        case err(_) {
                        }
                    }
                }
                case err(_) {
                    match emit(link, -1) {
                        case ok() {
                        }
                        case err(_) {
                        }
                    }
                }
            }
        }
        case err(_) {
        }
    }
}

fn main() uses console, file.read("data/") {
    match start_worker(reader) {
        case ok(w) {
            print(sent(tell(w, "other/x.txt")));
            print(show(receive(w, Wait.forever)));
            print("the program goes on");
        }
        case err(e) {
            print(why(e));
        }
    }
}
