# Spec 047: a worker runs under the program's grant: a read outside the declared directory is `failed` with R0010.
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, workers.WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[workers.Worker[int, int], workers.WorkerError]) -> workers.Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn reader(link: workers.Link[str, int]) uses file.read("data/") {
    match workers.next_message(link, workers.Wait.forever) {
        case ok(path) {
            match read_file(path) {
                case ok(text) {
                    match workers.emit(link, len(text)) {
                        case ok() {
                        }
                        case err(_) {
                        }
                    }
                }
                case err(_) {
                    match workers.emit(link, -1) {
                        case ok() {
                        }
                        case err(_) {
                        }
                    }
                }
            }
        }
        case err(_) {
        }
    }
}

fn main() uses console, file.read("data/") {
    match workers.start_worker(reader) {
        case ok(w) {
            print(sent(workers.tell(w, "other/x.txt")));
            print(show(workers.receive(w, workers.Wait.forever)));
            print("the program goes on");
        }
        case err(e) {
            print(why(e));
        }
    }
}
