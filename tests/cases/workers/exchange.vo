# Spec 047, story 1: a worker beside the program; messages in order, each once; copies; the end.
import std.workers.Arrival;
import std.workers.Link;
import std.workers.Wait;
import std.workers.Worker;
import std.workers.WorkerError;
import std.workers.emit;
import std.workers.next_message;
import std.workers.receive;
import std.workers.receive_first;
import std.workers.start_worker;
import std.workers.stop_worker;
import std.workers.tell;
import std.workers.with_deadline;

fn why(e: WorkerError) -> str {
    match e {
        case timeout {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

record Job {
    id: int;
    words: list[str];
    counts: map[str, int];
}

variant Answer {
    done(Job);
    skipped;
}

fn doubler(link: Link[int, int]) {
    while true {
        match next_message(link, Wait.forever) {
            case ok(n) {
                match emit(link, n * 2) {
                    case ok() {
                    }
                    case err(_) {
                        return;
                    }
                }
            }
            case err(_) {
                return;
            }
        }
    }
}

fn three(link: Link[int, int]) uses console {
    for i in 1..4 {
        print("worker: before " + str(i));
        match emit(link, i) {
            case ok() {
            }
            case err(_) {
            }
        }
    }
    print("worker: after the last");
}

fn silent(link: Link[int, int]) {
    match next_message(link, Wait.forever) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[Worker[int, int], WorkerError]) -> Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

fn main() uses console {
    # 1,000 numbers out, 1,000 doubles back, in order
    let d = worker_of(start_worker(doubler));
    for i in 0..1000 {
        match tell(d, i) {
            case ok() {
            }
            case err(e) {
                print("tell: " + why(e));
            }
        }
    }
    var in_order = 0;
    for i in 0..1000 {
        if receive(d, Wait.forever) == ok(i * 2) {
            set in_order = in_order + 1;
        }
    }
    print("in order: " + str(in_order));
    stop_worker(d);
    stop_worker(d);
    print("after stop: " + show(receive(d, Wait.forever)) + ", " + sent(tell(d, 1)));

    # copies: what the worker changes is its own, and the reverse
    let shared = [1, 2, 3];
    let c = worker_of(start_worker(fn(link: Link[int, int]) {
        push(shared, 4);
        match emit(link, len(shared)) {
            case ok() {
            }
            case err(_) {
            }
        }
        match next_message(link, Wait.forever) {
            case ok(_) {
                match emit(link, len(shared)) {
                    case ok() {
                    }
                    case err(_) {
                    }
                }
            }
            case err(_) {
            }
        }
    }));
    print("the worker's list: " + show(receive(c, Wait.forever)) + "; the program's: " + str(len(shared)));
    push(shared, 5);
    push(shared, 6);
    print(sent(tell(c, 0)));
    print("the worker's list: " + show(receive(c, Wait.forever)) + "; the program's: " + str(len(shared)));

    # three messages, printed lines in order with them, then the end, twice
    let t = worker_of(start_worker(three));
    for i in 0..3 {
        print("program: " + show(receive(t, Wait.forever)));
    }
    print("a tell before the end is received: " + sent(tell(t, 9)));
    print("program: " + show(receive(t, Wait.forever)));
    print("program: " + show(receive(t, Wait.forever)));
    print("a tell after it: " + sent(tell(t, 9)));

    # time limits on a worker that never emits
    let s = worker_of(start_worker(silent));
    print("no wait: " + show(receive(s, Wait.at_most(0))));
    print("50 ms: " + show(receive(s, Wait.at_most(50))));
    stop_worker(s);

    # records, lists, maps, variants and results as messages
    let j = start_worker(fn(link: Link[Job, result[Answer]]) {
        match next_message(link, Wait.forever) {
            case ok(job) {
                set job.counts["seen"] = len(job.words);
                match emit(link, ok(Answer.done(job))) {
                    case ok() {
                    }
                    case err(_) {
                    }
                }
                match emit(link, ok(Answer.skipped)) {
                    case ok() {
                    }
                    case err(_) {
                    }
                }
                match emit(link, err("no more")) {
                    case ok() {
                    }
                    case err(_) {
                    }
                }
            }
            case err(_) {
            }
        }
    });
    match j {
        case ok(w) {
            let counts = new map[str, int];
            set counts["x"] = 1;
            print(sent(tell(w, new Job { id: 7, words: ["a", "b"], counts: counts })));
            let after = new map[str, int];
            set after["x"] = 1;
            set after["seen"] = 2;
            for i in 0..3 {
                match receive(w, Wait.forever) {
                    case ok(answer) {
                        print(str(answer == ok(Answer.done(new Job { id: 7, words: ["a", "b"], counts: after })))
                            + " " + str(answer == ok(Answer.skipped)) + " " + str(answer == err("no more")));
                    }
                    case err(e) {
                        print(why(e));
                    }
                }
            }
        }
        case err(e) {
            print(why(e));
        }
    }
}
