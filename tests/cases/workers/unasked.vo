# Spec 047: a failure no receive returned is reported when the program ends, with status 70; what the workers printed comes out in the order they were started.
import std.time;
import std.workers;

fn why(e: workers.WorkerError) -> str {
    match e {
        case timed_out {
            return "timeout";
        }
        case ended {
            return "ended";
        }
        case failed(text) {
            return "failed: " + text;
        }
        case full {
            return "full";
        }
        case too_large {
            return "too_large";
        }
        case too_many {
            return "too_many";
        }
    }
}

fn show(r: result[int, workers.WorkerError]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return why(e);
        }
    }
}

fn sent(r: result[void, workers.WorkerError]) -> str {
    match r {
        case ok() {
            return "sent";
        }
        case err(e) {
            return why(e);
        }
    }
}

fn give(link: workers.Link[int, int], n: int) {
    match workers.emit(link, n) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn worker_of(r: result[workers.Worker[int, int], workers.WorkerError]) -> workers.Worker[int, int] {
    match r {
        case ok(w) {
            return w;
        }
        case err(e) {
            todo("no worker: " + why(e));
        }
    }
}

# Says that it runs before it fails: the program ends every worker still running when it ends itself, so
# it waits for this message and then gives the worker time for its last two statements (see main).
fn fails(link: workers.Link[int, int]) uses console {
    give(link, 0);
    print("first worker: before the error");
    let zero = len(chars(""));
    give(link, 1 / zero);
}

fn talks(link: workers.Link[int, int]) uses console {
    print("second worker: one line");
    give(link, 1);
    print("second worker: after its message");
}

fn main() uses console, clock {
    let a = worker_of(workers.start_worker(fails));
    print("program: " + show(workers.receive(a, workers.Wait.forever)));
    let b = worker_of(workers.start_worker(talks));
    print("program: " + show(workers.receive(b, workers.Wait.forever)));
    print("program: " + show(workers.receive(b, workers.Wait.forever)));
    # Nothing tells the program that a worker has failed except the receive this case must not make.
    time.sleep(500);
    print("program: done, " + sent(workers.tell(a, 1)));
}
