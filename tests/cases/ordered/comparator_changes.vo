import std.collections.ordered_set_by;

# Spec 014 (research R6): a comparison function may change other collections, never the one it orders.
fn main() uses console {
    let other = new ordered_set[int];
    let s: ordered_set[int] = ordered_set_by(fn(a: int, b: int) -> int {
        push(other, a);
        return a - b;
    });
    push(s, 1);
    push(s, 2);
    print("another collection changed: " + str(len(other)));
    let holder = new list[ordered_set[int]];
    let own: ordered_set[int] = ordered_set_by(fn(a: int, b: int) -> int {
        if len(holder) > 0 {
            push(holder[0], 99);
        }
        return a - b;
    });
    push(holder, own);
    push(own, 1);
    push(own, 2);
    print("never");
}
