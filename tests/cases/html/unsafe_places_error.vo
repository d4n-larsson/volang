import std.html.Html;
import std.html.html;
import std.html.html_text;

fn main() uses console {
    let v = "x";
    print(html_text(html("<script>var a = '{}';</script>", v)));
    print(html_text(html("<style>p { color: {}; }</style>", v)));
    print(html_text(html(`<button onclick="go('{}')">go</button>`, v)));
    print(html_text(html(`<p style="color: {}">x</p>`, v)));
    print(html_text(html("<!-- {} --><p>x</p>", v)));
    print(html_text(html("<p {}>x</p>", v)));
    print(html_text(html("<{}>x</{}>", v, v)));
    print(html_text(html(`<a href="{}/notes">x</a>`, v)));
    print(html_text(html(`<a href="java{}">x</a>`, v)));
}
