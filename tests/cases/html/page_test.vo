# Spec 051 US4, US5: one item template inside the list page and alone as a fragment (the same markup);
# pages tested through handle_request, with no browser and no network.
import std.html.Html;
import std.html.html;
import std.html.html_text;
import std.http.Response;
import std.text.contains;
import std.web.App;
import std.web.handle_request;
import std.web.html_reply;
import std.web.on_get;
import std.web.on_post;
import std.web.request;
import std.web.web_app;

record NoteId {
    id: int;
}

record NoInput {
}

fn notes() -> list[str] {
    return ["water the plants", "<script>alert(1)</script>"];
}

fn item(id: int, text: str) -> Html {
    return html(
        `<li id="note-{}">{} <button formaction="/notes/{}/done">done</button></li>`,
        id,
        text,
        id
    );
}

fn page(n: int, input: NoInput) -> result[Response] {
    let items = new list[Html];
    for i, text in notes() {
        push(items, item(i, text));
    }
    return ok(html_reply(200, html("<!DOCTYPE html><html><body><ul>{}</ul></body></html>", items)));
}

fn done(n: int, input: NoteId) -> result[Response] {
    return ok(html_reply(200, item(input.id, notes()[input.id])));
}

fn app() -> App[int] {
    return web_app([on_get("/notes", page), on_post("/notes/{id}/done", done)]);
}

fn main() {
}

test "the list page shows every note, escaped" {
    let r = handle_request(app(), 0, request("GET", "/notes", ""));
    expect_eq(r.status, 200);
    expect(contains(r.body, "&lt;script&gt;alert(1)&lt;/script&gt;"));
    expect(not contains(r.body, "<script>"));
}

test "the fragment is the item's markup in the page" {
    let fragment = handle_request(app(), 0, request("POST", "/notes/1/done", "")).body;
    expect_eq(fragment, html_text(item(1, notes()[1])));
    expect(contains(handle_request(app(), 0, request("GET", "/notes", "")).body, fragment));
}
