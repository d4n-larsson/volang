import std.json;
import std.text;

fn main() uses console {
    for n in [512, 513] {
        match json.parse_json(text.repeat("[", n) + text.repeat("]", n)) {
            case ok(_) {
                print(str(n) + ": ok");
            }
            case err(e) {
                print(str(n) + ": err " + e);
            }
        }
    }
}
