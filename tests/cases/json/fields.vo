import std.json;

fn show[T](label: str, r: result[T], text: fn(T) -> str) uses console {
    match r {
        case ok(v) {
            print(label + ": ok " + text(v));
        }
        case err(e) {
            print(label + ": err " + e);
        }
    }
}

fn main() -> result[void] uses console {
    let doc = try json.parse_json("{\"name\": \"ana\", \"age\": 3, \"score\": 9.5, \"admin\": true, \"tags\": [1]}");
    show("name", json.text_field(doc, "name"), fn(s: str) -> str { return s; });
    show("age", json.int_field(doc, "age"), fn(i: int) -> str { return str(i); });
    show("age as float", json.float_field(doc, "age"), fn(f: float) -> str { return str(f); });
    show("score", json.float_field(doc, "score"), fn(f: float) -> str { return str(f); });
    show("admin", json.bool_field(doc, "admin"), fn(b: bool) -> str { return str(b); });
    show("missing", json.text_field(doc, "email"), fn(s: str) -> str { return s; });
    show("wrong kind", json.text_field(doc, "age"), fn(s: str) -> str { return s; });
    show("score as int", json.int_field(doc, "score"), fn(i: int) -> str { return str(i); });
    show("admin as text", json.text_field(doc, "admin"), fn(s: str) -> str { return s; });
    show("not an object", json.text_field(json.Json.array(new list[json.Json]), "a"), fn(s: str) -> str { return s; });
    let tags = try json.member(doc, "tags");
    show("at 0", json.at(tags, 0), fn(j: json.Json) -> str { return "a value"; });
    show("at 5", json.at(tags, 5), fn(j: json.Json) -> str { return "a value"; });
    show("at on an object", json.at(doc, 0), fn(j: json.Json) -> str { return "a value"; });
    return ok();
}
