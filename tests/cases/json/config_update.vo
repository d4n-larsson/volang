import std.json;

fn main() -> result[void] uses console {
    let text = "{\"name\": \"svc\", \"port\": 8080, \"debug\": false, \"hosts\": [\"a\", \"b\"], \"limits\": {}}";
    let doc = try json.parse_json(text);
    let m = try json.as_object(doc);
    set m["port"] = json.Json.integer(9090);
    set m["debug"] = json.Json.boolean(true);
    set m["added"] = json.Json.null;
    print(try json.write_json_pretty(doc));
    return ok();
}
