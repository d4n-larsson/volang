import std.json;

record Line {
    item: str;
    count: int;
    price: float;
}

fn main() -> result[void] uses console {
    let lines = [new Line { item: "tea \"green\"", count: 2, price: 3.5 }, new Line { item: "café", count: 1, price: 0.1 }];
    let rows = new list[json.Json];
    var total = 0.0;
    for l in lines {
        let m = new map[str, json.Json];
        set m["item"] = json.Json.text(l.item);
        set m["count"] = json.Json.integer(l.count);
        set m["price"] = json.Json.number(l.price);
        push(rows, json.Json.object(m));
        set total = total + float(l.count) * l.price;
    }
    let report = new map[str, json.Json];
    set report["lines"] = json.Json.array(rows);
    set report["total"] = json.Json.number(total);
    print(try json.write_json(json.Json.object(report)));
    return ok();
}
