import std.json.Json;
import std.json.write_json;

record Line {
    item: str;
    count: int;
    price: float;
}

fn main() -> result[void] uses console {
    let lines = [new Line { item: "tea \"green\"", count: 2, price: 3.5 }, new Line { item: "café", count: 1, price: 0.1 }];
    let rows = new list[Json];
    var total = 0.0;
    for l in lines {
        let m = new map[str, Json];
        set m["item"] = Json.text(l.item);
        set m["count"] = Json.integer(l.count);
        set m["price"] = Json.number(l.price);
        push(rows, Json.object(m));
        set total = total + float(l.count) * l.price;
    }
    let report = new map[str, Json];
    set report["lines"] = Json.array(rows);
    set report["total"] = Json.number(total);
    print(try write_json(Json.object(report)));
    return ok();
}
