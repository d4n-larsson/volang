import std.json;

fn main() uses console {
    let z = 0.0;
    for f in [z / z, 1.0 / z, -1.0 / z, 2.5] {
        match json.write_json(json.Json.array([json.Json.number(f)])) {
            case ok(t) {
                print("ok " + t);
            }
            case err(e) {
                print("err " + e);
            }
        }
    }
}
