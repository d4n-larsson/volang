# Spec 026 (US1): a file database is created, filled and kept.
import std.sqlite;

fn main() -> result[void] uses console, file.read("data/"), file.write("data/") {
    let db = try sqlite.open("data/inventory.db");
    let _ = try sqlite.exec(db, sqlite.sql("create table items(name text primary key, qty integer not null)"), new list[sqlite.Value]);
    for item in [["bolt", "3"], ["nut", "40"], ["washer", "7"]] {
        let c = try sqlite.exec(db, sqlite.sql("insert into items values (?, ?)"), [sqlite.Value.text(item[0]), sqlite.Value.integer(try parse_int(item[1]))]);
        print(item[0] + " " + str(c.changed) + " " + str(c.last_id));
    }
    return ok();
}
