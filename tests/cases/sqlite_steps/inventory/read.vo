# Spec 026 (US1): a second program reads it, read-only.
import std.sqlite;

fn main() -> result[void] uses console, file.read("data/") {
    let db = try sqlite.open_readonly("data/inventory.db");
    for row in try sqlite.query(db, sqlite.sql("select name, qty from items where qty < ? order by name"), [sqlite.Value.integer(10)]) {
        print(try sqlite.text_column(row, "name") + " " + str(try sqlite.int_column(row, "qty")));
    }
    return ok();
}
