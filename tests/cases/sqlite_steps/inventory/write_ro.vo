# Spec 026 (US1): a read-only connection refuses changes with an err.
import std.sqlite;

fn main() -> result[void] uses console, file.read("data/") {
    let db = try sqlite.open_readonly("data/inventory.db");
    match sqlite.exec(db, sqlite.sql("insert into items values ('gear', 1)"), new list[sqlite.Value]) {
        case ok(c) {
            print("changed " + str(c.changed));
        }
        case err(e) {
            print(e);
        }
    }
    match sqlite.open_readonly("data/missing.db") {
        case ok(_) {
            print("opened");
        }
        case err(e) {
            print(e);
        }
    }
    return ok();
}
