# The effects record lists the file effects of every function that uses a file database, the
# in-memory one adds none.
import std.sqlite;

fn add(db: sqlite.Database[uses file.read, file.write], name: str) -> result[void] uses file.read, file.write {
    let _ = try sqlite.exec(db, sqlite.sql("insert into people(name) values (?)"), [sqlite.Value.text(name)]);
    return ok();
}

fn names(db: sqlite.Database[uses file.read, file.write]) -> result[list[sqlite.Row]] uses file.read, file.write {
    return sqlite.query(db, sqlite.sql("select name from people"), new list[sqlite.Value]);
}

fn scratch() -> result[list[sqlite.Row]] {
    return sqlite.query(sqlite.open_memory(), sqlite.sql("select 1 as x"), new list[sqlite.Value]);
}

fn main() -> result[void] uses console, file.read, file.write {
    let db = try sqlite.open("people.db");
    let _ = try sqlite.exec(db, sqlite.sql("create table if not exists people(name text)"), new list[sqlite.Value]);
    try add(db, "Ada");
    print(str(len(try names(db))) + " " + str(len(try scratch())));
    return ok();
}
