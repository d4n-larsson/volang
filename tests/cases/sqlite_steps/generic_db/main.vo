# One function for every database: generic over the database's effects, so it takes the file database
# under a scoped grant and an in-memory one in tests. `Database[D]` and `Database[uses D]` are the same.
import std.sqlite;

fn setup[D: effects](db: sqlite.Database[D]) -> result[int] uses D {
    let c = try sqlite.exec(db, sqlite.sql("create table if not exists t(x)"), new list[sqlite.Value]);
    return ok(c.changed);
}

fn count[D: effects](db: sqlite.Database[uses D]) -> result[int] uses D {
    let _ = try sqlite.exec(db, sqlite.sql("insert into t values (1)"), new list[sqlite.Value]);
    return ok(len(try sqlite.query(db, sqlite.sql("select x from t"), new list[sqlite.Value])));
}

fn main() -> result[void] uses console, file.read("data/", "imports/"), file.write("data/") {
    let file = try sqlite.open("data/app.db");
    let _ = try setup(file);
    let memory = sqlite.open_memory();
    let _ = try setup(memory);
    print(str(try count(file)) + " " + str(try count(memory)));
    return ok();
}

test "an in-memory database needs no effect" {
    let db = sqlite.open_memory();
    expect(setup(db) == ok(0));
    expect(count(db) == ok(1));
}
