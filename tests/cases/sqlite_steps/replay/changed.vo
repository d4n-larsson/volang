# Recorded with --record, replayed with the database file deleted: the same output, no file touched.
import std.bytes;
import std.sqlite;

fn main() -> result[void] uses console, file.read("data/"), file.write("data/") {
    let db = try sqlite.open("data/app.db");
    let _ = try sqlite.exec(db, sqlite.sql("create table if not exists t(id integer primary key, name text, f real, b blob, z)"), new list[sqlite.Value]);
    let c = try sqlite.exec(db, sqlite.sql("insert into t(name, f, b, z) values (?, ?, ?, ?)"), [sqlite.Value.text("Ada \"q\" ü"), sqlite.Value.real(0.1), sqlite.Value.blob(bytes.from_ints([0, 255, 10])), sqlite.Value.null]);
    print("inserted " + str(c.changed) + " id " + str(c.last_id));
    let n: result[int] = sqlite.transaction(db, fn() {
        let x = try sqlite.exec(db, sqlite.sql("insert into t(name) values (?)"), [sqlite.Value.text("Bob")]);
        return ok(x.changed);
    });
    print(str(n == ok(1)));
    print(str(sqlite.exec(db, sqlite.sql("insert into nope values (1)"), new list[sqlite.Value]) == ok(c)));
    for row in try sqlite.query(db, sqlite.sql("select name, f, b, z from t order by id desc"), new list[sqlite.Value]) {
        print(try sqlite.text_column(row, "name") + " " + str(len(row.values)));
    }
    return ok();
}
