import std.sqlite;

fn main() -> result[void] uses console, file.read, file.write {
    let db = try sqlite.open("app.db");
    let _ = try sqlite.exec(db, sqlite.sql("create table t(x)"), new list[sqlite.Value]);
    let _ = try sqlite.exec(db, sqlite.sql("insert into t values (1)"), new list[sqlite.Value]);
    print("created");
    return ok();
}
