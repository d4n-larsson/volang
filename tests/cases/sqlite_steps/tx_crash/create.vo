import std.sqlite.open;
import std.sqlite.sql;
import std.sqlite.exec;
import std.sqlite.Value;

fn main() -> result[void] uses console, file.read, file.write {
    let db = try open("app.db");
    let _ = try exec(db, sql("create table t(x)"), new list[Value]);
    let _ = try exec(db, sql("insert into t values (1)"), new list[Value]);
    print("created");
    return ok();
}
