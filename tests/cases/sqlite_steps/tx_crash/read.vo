import std.sqlite;

fn main() -> result[void] uses console, file.read {
    let db = try sqlite.open_readonly("app.db");
    for row in try sqlite.query(db, sqlite.sql("select x from t order by x"), new list[sqlite.Value]) {
        print(str(try sqlite.int_column(row, "x")));
    }
    return ok();
}
