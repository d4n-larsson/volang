import std.sqlite.open_readonly;
import std.sqlite.sql;
import std.sqlite.query;
import std.sqlite.get_int;
import std.sqlite.Value;

fn main() -> result[void] uses console, file.read {
    let db = try open_readonly("app.db");
    for row in try query(db, sql("select x from t order by x"), new list[Value]) {
        print(str(try get_int(row, "x")));
    }
    return ok();
}
