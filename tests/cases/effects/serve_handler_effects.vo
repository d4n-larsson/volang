import std.http;

fn page(r: http.Request) -> http.Response uses file.read("site/") {
    match read_file("site/" + r.path) {
        case ok(body) {
            return new http.Response { status: 200, headers: new list[http.Header], body: body };
        }
        case err(_) {
            return new http.Response { status: 404, headers: new list[http.Header], body: "" };
        }
    }
}

fn main() -> result[void] uses serve("8000") {
    try http.serve("8000", page);
    return ok();
}
