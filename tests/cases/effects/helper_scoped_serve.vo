import std.tcp;

# Spec 050: a function that listens where it is told, under a caller that declares the address.
fn open(address: str) -> result[tcp.Listener, tcp.TcpError] uses serve {
    return tcp.listen(address);
}

fn main() uses console, serve("0") {
    match open("0") {
        case ok(l) {
            tcp.close_listener(l);
            print("listening");
        }
        case err(_) {
            print("not listening");
        }
    }
}
