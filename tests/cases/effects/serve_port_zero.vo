import std.tcp;

fn main() uses console, serve("0", "0.0.0.0:0") {
    match tcp.listen("0") {
        case ok(l) {
            print(str(l.port > 0));
            tcp.close_listener(l);
        }
        case err(_) {
            print("no listener");
        }
    }
    match tcp.listen("0.0.0.0:0") {
        case ok(l) {
            print(str(l.port > 0));
            tcp.close_listener(l);
        }
        case err(_) {
            print("no listener");
        }
    }
}
