import std.tcp;

fn attempt[N: effects](
    d: fn(str, int, int) -> result[tcp.Conn[uses net], tcp.TcpError] uses N,
    port: int
) -> str uses N {
    match d("127.0.0.1", port, 1000) {
        case ok(_) {
            return "open";
        }
        case err(e) {
            return tcp.tcp_error_text(e);
        }
    }
}

# Spec 050: a library function as a value, under a scoped grant.
fn main() uses console, net("127.0.0.1:1") {
    print(attempt(tcp.connect, 1));
}
