import std.tcp;

fn open() {
    match tcp.connect("db.internal", 5432, 1000) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

fn wait() {
    match tcp.listen("9000") {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

# Using a connection needs its effect.
fn first(c: tcp.Conn[uses net]) -> int {
    match tcp.read(c, 1, 1000) {
        case ok(b) {
            return b[0];
        }
        case err(_) {
            return -1;
        }
    }
}

fn main() {
    open();
    wait();
}
