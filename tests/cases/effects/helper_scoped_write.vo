import std.fs.make_dir;

# Spec 050: a writer that is given its path, under a caller that declares a directory.
fn save(path: str, text: str) -> result[void] uses file.write {
    return write_file(path, text);
}

fn main() -> result[void] uses console, file.read("out/"), file.write("out/") {
    try make_dir("out");
    try save("out/a.txt", "saved");
    print(try read_file("out/a.txt"));
    return ok();
}
