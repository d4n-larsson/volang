import std.fs;

# Spec 050: a function that deletes what it is given, under a caller that declares a directory.
fn discard(path: str) -> result[void] uses file.delete {
    return fs.delete(path);
}

fn main() -> result[void] uses console, file.write("tmp/"), file.delete("tmp/") {
    try fs.make_dir("tmp");
    try write_file("tmp/a.txt", "x");
    try discard("tmp/a.txt");
    print("deleted");
    return ok();
}
