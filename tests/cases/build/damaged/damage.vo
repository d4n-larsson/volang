import std.bytes;
import std.fs;

# flipped: one byte of the program part changed; short: the last ten bytes cut off.
fn main() -> result[void] uses file.read, file.write {
    let b = try fs.read_bytes("app");
    let n = len(b);
    let at = n - 100;
    try fs.write_bytes("flipped", slice(b, 0, at) + bytes.from_ints([(b[at] + 1) % 256]) + slice(b, at + 1, n));
    try fs.write_bytes("short", slice(b, 0, n - 10));
    return ok();
}
