fn main() uses console, file.read("data") {
    print("ran");
    let paths = ["data/a.txt"];
    for a in args() {
        push(paths, a);
    }
    for path in paths {
        match read_file(path) {
            case ok(t) {
                print(t);
            }
            case err(e) {
                print("err " + e);
            }
        }
    }
}
