# A recorded concurrent run replays exactly, with no server; the events are in task order.
import std.http.get;

fn fetch(job: str) -> str uses console, net("127.0.0.1") {
    let parts = split(job, " ");
    print("fetching " + parts[1]);
    match get("http://127.0.0.1:" + parts[0] + "/delay/" + parts[1]) {
        case ok(r) {
            return trim(r.body);
        }
        case err(e) {
            return e;
        }
    }
}

fn main() uses console, net("127.0.0.1") {
    let port = args()[0];
    let rs = concurrent_map([port + " 200", port + " 100", port + " 0"], 3, fetch);
    print(join(rs, "; "));
}
