# Tasks 1 and 3 fail; task 3 fails first in time, but task 1 is reported, every run.
import std.http.get;

fn work(job: str) -> int uses net("127.0.0.1") {
    let parts = split(job, " ");
    match get("http://127.0.0.1:" + parts[0] + "/delay/" + parts[2]) {
        case ok(_) {
        }
        case err(_) {
        }
    }
    let xs = [1, 2];
    if parts[1] == "1" {
        return 10 / (len(xs) - 2);
    }
    if parts[1] == "3" {
        return xs[5];
    }
    return 0;
}

fn main() uses console, net("127.0.0.1") {
    let p = args()[0];
    let rs = concurrent_map([p + " 0 0", p + " 1 300", p + " 2 0", p + " 3 0"], 4, work);
    print(str(len(rs)));
}
