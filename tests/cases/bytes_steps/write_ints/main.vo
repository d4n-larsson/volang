# Spec 021 US2: bytes from integers, written to a file.
import std.bytes;
import std.fs;

fn main() -> result[void] uses console, file.write("./") {
    var xs = new list[int];
    for i in 0..256 {
        push(xs, i);
    }
    try fs.write_bytes("out.bin", bytes.from_ints(xs));
    print("written");
    return ok();
}
