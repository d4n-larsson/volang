# Spec 021 US3: run (text) still refuses binary output, and names run_bytes.
import std.process.Output;
import std.process.run;

fn main() uses console, process("bin/allbytes") {
    match run("bin/allbytes", new list[str]) {
        case ok(out) {
            print("ok " + str(out.code));
        }
        case err(e) {
            print(e);
        }
    }
}
