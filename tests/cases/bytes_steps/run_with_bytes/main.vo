# Spec 021 US3: binary input to a program and back, unchanged.
import std.bytes;
import std.process;

fn main() -> result[void] uses console, file.read("./"), process("bin/cat_in") {
    let input = bytes.from_ints([0, 1, 128, 255, 10, 13, 0]);
    let out = try process.run_with_bytes("bin/cat_in", new list[str], input, new list[str], "./");
    print(str(out.code) + " " + bytes.to_hex(out.stdout) + " " + str(out.stdout == input));
    return ok();
}
