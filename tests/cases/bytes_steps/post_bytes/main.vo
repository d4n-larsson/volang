# Spec 021 US6: a binary request body, echoed back unchanged.
import std.bytes;
import std.http;

fn main() -> result[void] uses console, net("127.0.0.1") {
    let body = bytes.from_ints([0, 255, 10, 13, 128, 0, 1]);
    let r = try http.post_bytes(args()[0], "application/octet-stream", body);
    print(str(r.status) + " " + bytes.to_hex(r.body) + " " + str(r.body == body));
    return ok();
}
