# Spec 021 US6: a server answering with binary data, and echoing a binary upload.
import std.bytes;
import std.http;

fn handle(r: http.BytesRequest) -> http.BytesResponse {
    if r.method == "POST" {
        return new http.BytesResponse { status: 200, headers: new list[http.Header], body: r.body };
    }
    return new http.BytesResponse { status: 200, headers: [new http.Header { name: "Content-Type", value: "application/octet-stream" }], body: bytes.from_ints([0, 1, 254, 255]) };
}

fn main() -> result[void] uses console, serve("{vport}") {
    try http.serve_bytes("{vport}", handle);
    print("stopped");
    return ok();
}
