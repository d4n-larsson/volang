# Spec 021 US2: appending bytes creates the file, then adds to it.
import std.bytes;
import std.fs;

fn main() -> result[void] uses console, file.read("./"), file.write("./") {
    try fs.append_bytes("log.bin", bytes.from_ints([0, 255]));
    try fs.append_bytes("log.bin", bytes.from_ints([10]));
    print(bytes.to_hex(try fs.read_bytes("log.bin")));
    return ok();
}
