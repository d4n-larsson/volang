# Spec 021 US2: joining and slicing make new values; the originals stay as they were.
import std.bytes;

fn main() uses console {
    let a = bytes.from_ints([1, 2, 3]);
    let b = bytes.from_ints([250]);
    let c = a + b;
    let d = slice(c, 2, 4);
    print(bytes.to_hex(a) + " " + bytes.to_hex(b) + " " + bytes.to_hex(c) + " " + bytes.to_hex(d) + " " + str(len(a)));
}
