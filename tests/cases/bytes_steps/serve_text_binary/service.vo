# Spec 021 US6: a text serve handler is not called for a body that is not UTF-8: the answer is 400.
import std.http;

fn handle(r: http.Request) -> http.Response {
    return new http.Response { status: 200, headers: new list[http.Header], body: "got " + r.body };
}

fn main() -> result[void] uses console, serve("{vport}") {
    try http.serve("{vport}", handle);
    print("stopped");
    return ok();
}
