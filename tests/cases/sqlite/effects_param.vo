# A function without uses that queries a file database it was given: E0501 names the file effects.
import std.sqlite;

fn names(db: sqlite.Database[uses file.read, file.write]) -> result[list[sqlite.Row]] {
    return sqlite.query(db, sqlite.sql("select name from people"), new list[sqlite.Value]);
}

fn main() -> result[void] uses console, file.read, file.write {
    let db = try sqlite.open("people.db");
    print(str(len(try names(db))));
    return ok();
}
