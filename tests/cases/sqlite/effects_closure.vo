# A file database captured by an anonymous function passed to map: the anonymous function and the
# function around it have no uses, so the query is E0501.
import std.sqlite;

fn counts(db: sqlite.Database[uses file.read, file.write], tables: list[str]) -> list[int] {
    return map(tables, fn(t: str) -> int {
        match sqlite.query(db, sqlite.sql("select name from people"), new list[sqlite.Value]) {
            case ok(rows) {
                return len(rows);
            }
            case err(_) {
                return -1;
            }
        }
    });
}

fn main() -> result[void] uses console, file.read, file.write {
    let db = try sqlite.open("people.db");
    print(str(counts(db, ["people"])[0]));
    return ok();
}
