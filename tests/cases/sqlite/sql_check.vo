import std.sqlite;

fn statements(name: str) -> list[sqlite.Statement] {
    return [sqlite.sql("selec * from items"), sqlite.sql("select 'abc from t"), sqlite.sql("select # from t"), sqlite.sql("select * from"), sqlite.sql(name), sqlite.sql("select 1 " + name), sqlite.sql("create table a(x); create table b(y)"), sqlite.sql("select * from t where id = :id and k = :k"), sqlite.sql("select ?1, ?2"), sqlite.sql("select @a, @a"), sqlite.sql("select random()"), sqlite.sql("select randomblob(4)"), sqlite.sql("select current_timestamp"), sqlite.sql("select datetime('now')"), sqlite.sql("pragma temp_store_directory = '/tmp'"), sqlite.sql("pragma journal_mode = WAL"), sqlite.sql("pragma foreign_keys = off"), sqlite.sql("select * from no_such_table")];
}

fn main() -> result[void] uses console, file.read, file.write {
    let db = sqlite.open_memory();
    let _ = try sqlite.exec(db, sqlite.sql("insert into t values (?, ?)"), [sqlite.Value.integer(1), sqlite.Value.integer(2), sqlite.Value.integer(3)]);
    let _ = try sqlite.query(db, sqlite.sql("select ?"), new list[sqlite.Value]);
    let _ = try sqlite.open(":memory:");
    print(str(len(statements("x"))));
    return ok();
}
