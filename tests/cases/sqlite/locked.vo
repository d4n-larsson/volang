# Two connections to one file (locks are per open file, so this is what a second process sees): while
# the first holds a write transaction, the second's write waits (at most 5 s) and returns busy.
import std.sqlite;

fn show(r: result[sqlite.Changes]) -> str {
    match r {
        case ok(c) {
            return "ok " + str(c.changed);
        }
        case err(e) {
            return "err " + e;
        }
    }
}

fn main() -> result[void] uses console, file.read, file.write {
    let a = try sqlite.open("shared.db");
    let b = try sqlite.open("shared.db");
    let _ = try sqlite.exec(a, sqlite.sql("create table t(x)"), new list[sqlite.Value]);
    let r: result[int] = sqlite.transaction(a, fn() {
        let _ = try sqlite.exec(a, sqlite.sql("insert into t values (1)"), new list[sqlite.Value]);
        print("second while the first writes: " + show(sqlite.exec(b, sqlite.sql("insert into t values (2)"), new list[sqlite.Value])));
        return ok(0);
    });
    print("first committed: " + str(r == ok(0)));
    print("second afterwards: " + show(sqlite.exec(b, sqlite.sql("insert into t values (2)"), new list[sqlite.Value])));
    return ok();
}
