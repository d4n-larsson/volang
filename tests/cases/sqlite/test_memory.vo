import std.sqlite;

fn ran(r: result[sqlite.Changes]) -> bool {
    match r {
        case ok(_) {
            return true;
        }
        case err(_) {
            return false;
        }
    }
}

fn count(db: sqlite.Database) -> int {
    match sqlite.query(db, sqlite.sql("select count(*) as n from t"), new list[sqlite.Value]) {
        case ok(rows) {
            match sqlite.int_column(rows[0], "n") {
                case ok(n) {
                    return n;
                }
                case err(_) {
                    return -1;
                }
            }
        }
        case err(_) {
            return -1;
        }
    }
}

test "first test sees its own rows" {
    let db = sqlite.open_memory();
    expect(ran(sqlite.exec(db, sqlite.sql("create table t(x)"), new list[sqlite.Value])));
    expect(ran(sqlite.exec(db, sqlite.sql("insert into t values (?), (?)"), [sqlite.Value.integer(1), sqlite.Value.integer(2)])));
    expect_eq(count(db), 2);
}

test "second test starts empty" {
    let db = sqlite.open_memory();
    expect(ran(sqlite.exec(db, sqlite.sql("create table t(x)"), new list[sqlite.Value])));
    expect(ran(sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(3)])));
    expect_eq(count(db), 1);
}

test "stops mid-way with the database open" {
    let db = sqlite.open_memory();
    expect(ran(sqlite.exec(db, sqlite.sql("create table t(x)"), new list[sqlite.Value])));
    let none = new list[int];
    expect_eq(none[0], 0);
}

test "passes after the error" {
    let db = sqlite.open_memory();
    expect(ran(sqlite.exec(db, sqlite.sql("create table t(x)"), new list[sqlite.Value])));
    expect_eq(count(db), 0);
}

prop "every case has its own database" (n: int) {
    let db = sqlite.open_memory();
    expect(db.id >= 0);
    expect(ran(sqlite.exec(db, sqlite.sql("create table t(x)"), new list[sqlite.Value])));
    expect(ran(sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(n)])));
    expect_eq(count(db), 1);
}
