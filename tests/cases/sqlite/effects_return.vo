# A file database returned from a helper and queried by a function without uses: E0501.
import std.sqlite;

fn connect() -> result[sqlite.Database[uses file.read, file.write]] uses file.read, file.write {
    return sqlite.open("people.db");
}

fn names() -> result[list[sqlite.Row]] {
    let db = try connect();
    return sqlite.query(db, sqlite.sql("select name from people"), new list[sqlite.Value]);
}

fn main() -> result[void] uses console {
    print(str(len(try names())));
    return ok();
}
