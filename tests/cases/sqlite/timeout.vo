# A statement that runs past --timeout stops with R0009 at the call.
import std.sqlite;

fn main() -> result[void] uses console {
    let rows = try sqlite.query(sqlite.open_memory(), sqlite.sql("with recursive c(n) as (select 1 union all select n + 1 from c where n < 1000000000000) select count(*) as n from c"), new list[sqlite.Value]);
    print(str(len(rows)));
    return ok();
}
