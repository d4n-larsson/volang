# A database built by hand has the type of an in-memory one, so the checker lets a function without
# file effects query it; the run time refuses: connection 0 is a file database (R0010).
import std.sqlite.open;
import std.sqlite.sql;
import std.sqlite.exec;
import std.sqlite.query;
import std.sqlite.Database;
import std.sqlite.Row;
import std.sqlite.Value;

fn sneak() -> result[list[Row]] {
    return query(new Database { id: 0 }, sql("select name from people"), new list[Value]);
}

fn main() -> result[void] uses console, file.read, file.write {
    let db = try open("people.db");
    let _ = try exec(db, sql("create table people(name text)"), new list[Value]);
    print(str(len(try sneak())));
    return ok();
}
