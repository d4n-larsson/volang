# A database built by hand has the type of an in-memory one, so the checker lets a function without
# file effects query it; the run time refuses: connection 0 is a file database (R0010).
import std.sqlite;

fn sneak() -> result[list[sqlite.Row]] {
    return sqlite.query(new sqlite.Database { id: 0 }, sqlite.sql("select name from people"), new list[sqlite.Value]);
}

fn main() -> result[void] uses console, file.read, file.write {
    let db = try sqlite.open("people.db");
    let _ = try sqlite.exec(db, sqlite.sql("create table people(name text)"), new list[sqlite.Value]);
    print(str(len(try sneak())));
    return ok();
}
