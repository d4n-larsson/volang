import std.sqlite;

fn count(db: sqlite.Database) -> int {
    match sqlite.query(db, sqlite.sql("select count(*) as n from t"), new list[sqlite.Value]) {
        case ok(rows) {
            match sqlite.int_column(rows[0], "n") {
                case ok(n) {
                    return n;
                }
                case err(_) {
                    return -1;
                }
            }
        }
        case err(_) {
            return -1;
        }
    }
}

fn show(r: result[int]) -> str {
    match r {
        case ok(n) {
            return "ok " + str(n);
        }
        case err(e) {
            return "err " + e;
        }
    }
}

fn main() -> result[void] uses console {
    let db = sqlite.open_memory();
    let _ = try sqlite.exec(db, sqlite.sql("create table t(x integer unique)"), new list[sqlite.Value]);

    let committed: result[int] = sqlite.transaction(db, fn() {
        let a = try sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(1)]);
        let b = try sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(2)]);
        return ok(a.changed + b.changed);
    });
    print("commit: " + str(committed == ok(2)) + ", rows " + str(count(db)));

    let failed: result[int] = sqlite.transaction(db, fn() {
        let _ = try sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(3)]);
        let _ = try sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(1)]);
        return ok(0);
    });
    print("rolled back: " + show(failed) + ", rows " + str(count(db)));

    let mine: result[int] = sqlite.transaction(db, fn() {
        let _ = try sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(4)]);
        return err("changed my mind");
    });
    print("own err: " + show(mine) + ", rows " + str(count(db)));

    let nested: result[int] = sqlite.transaction(db, fn() {
        let _ = try sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(5)]);
        return sqlite.transaction(db, fn() => ok(1));
    });
    print("nested: " + show(nested) + ", rows " + str(count(db)));

    let after: result[int] = sqlite.transaction(db, fn() {
        let _ = try sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.integer(6)]);
        return ok(1);
    });
    print("after: " + show(after) + ", rows " + str(count(db)));
    return ok();
}
