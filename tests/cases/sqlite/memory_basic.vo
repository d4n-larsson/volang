import std.bytes;
import std.sqlite;

fn show(v: sqlite.Value) -> str {
    match v {
        case integer(i) {
            return "integer " + str(i);
        }
        case real(f) {
            return "real " + str(f);
        }
        case text(s) {
            return "text " + s;
        }
        case blob(b) {
            return "blob " + str(len(b));
        }
        case null {
            return "null";
        }
    }
}

fn main() -> result[void] uses console {
    let db = sqlite.open_memory();
    let _ = try sqlite.exec(db, sqlite.sql("create table t(n integer, f real, s text, b blob, z)"), new list[sqlite.Value]);
    let c = try sqlite.exec(db, sqlite.sql("insert into t values (?, ?, ?, ?, ?)"), [sqlite.Value.integer(1), sqlite.Value.real(1.5), sqlite.Value.text("a"), sqlite.Value.blob(bytes.from_text("xy")), sqlite.Value.null]);
    print(str(c.changed) + " " + str(c.last_id));
    let _ = try sqlite.exec(db, sqlite.sql("insert into t values (?, ?, ?, ?, ?)"), [sqlite.Value.integer(2), sqlite.Value.real(-0.25), sqlite.Value.text("é"), sqlite.Value.blob(bytes.from_text("")), sqlite.Value.integer(9)]);
    let c3 = try sqlite.exec(db, sqlite.sql("insert into t values (3, 3.0, 'c', x'00ff', null)"), new list[sqlite.Value]);
    print(str(c3.last_id));
    for row in try sqlite.query(db, sqlite.sql("select n, f, s, b, z from t order by n desc"), new list[sqlite.Value]) {
        var parts = new list[str];
        for v in row.values {
            push(parts, show(v));
        }
        print(join(row.columns, ",") + ": " + join(parts, " | "));
    }
    return ok();
}
