import std.sqlite.open_memory;
import std.sqlite.sql;
import std.sqlite.exec;
import std.sqlite.query;
import std.sqlite.Value;
import std.bytes.from_text;

fn show(v: Value) -> str {
    match v {
        case integer(i) {
            return "integer " + str(i);
        }
        case real(f) {
            return "real " + str(f);
        }
        case text(s) {
            return "text " + s;
        }
        case blob(b) {
            return "blob " + str(len(b));
        }
        case null {
            return "null";
        }
    }
}

fn main() -> result[void] uses console {
    let db = open_memory();
    let _ = try exec(db, sql("create table t(n integer, f real, s text, b blob, z)"), new list[Value]);
    let c = try exec(db, sql("insert into t values (?, ?, ?, ?, ?)"), [Value.integer(1), Value.real(1.5), Value.text("a"), Value.blob(from_text("xy")), Value.null]);
    print(str(c.changed) + " " + str(c.last_id));
    let _ = try exec(db, sql("insert into t values (?, ?, ?, ?, ?)"), [Value.integer(2), Value.real(-0.25), Value.text("é"), Value.blob(from_text("")), Value.integer(9)]);
    let c3 = try exec(db, sql("insert into t values (3, 3.0, 'c', x'00ff', null)"), new list[Value]);
    print(str(c3.last_id));
    for row in try query(db, sql("select n, f, s, b, z from t order by n desc"), new list[Value]) {
        var parts = new list[str];
        for v in row.values {
            push(parts, show(v));
        }
        print(join(row.columns, ",") + ": " + join(parts, " | "));
    }
    return ok();
}
