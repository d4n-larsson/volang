# The same shapes with in-memory databases: no effect, no diagnostic.
import std.sqlite;

record Store {
    db: sqlite.Database;
}

fn param(db: sqlite.Database) -> result[list[sqlite.Row]] {
    return sqlite.query(db, sqlite.sql("select 1 as x"), new list[sqlite.Value]);
}

fn field(s: Store) -> result[list[sqlite.Row]] {
    return sqlite.query(s.db, sqlite.sql("select 1 as x"), new list[sqlite.Value]);
}

fn element(dbs: list[sqlite.Database]) -> result[list[sqlite.Row]] {
    return sqlite.query(dbs[0], sqlite.sql("select 1 as x"), new list[sqlite.Value]);
}

fn captured(db: sqlite.Database, xs: list[int]) -> list[int] {
    return map(xs, fn(x: int) -> int {
        match sqlite.query(db, sqlite.sql("select 1 as x"), new list[sqlite.Value]) {
            case ok(rows) {
                return len(rows) + x;
            }
            case err(_) {
                return -1;
            }
        }
    });
}

fn returned() -> result[list[sqlite.Row]] {
    return sqlite.query(sqlite.open_memory(), sqlite.sql("select 1 as x"), new list[sqlite.Value]);
}

fn main() -> result[void] uses console {
    let db = sqlite.open_memory();
    let a = len(try param(db)) + len(try field(new Store { db: db })) + len(try element([db]));
    print(str(a + captured(db, [1])[0] + len(try returned())));
    return ok();
}
