# The same shapes with in-memory databases: no effect, no diagnostic.
import std.sqlite.open_memory;
import std.sqlite.sql;
import std.sqlite.query;
import std.sqlite.Database;
import std.sqlite.Row;
import std.sqlite.Value;

record Store {
    db: Database;
}

fn param(db: Database) -> result[list[Row]] {
    return query(db, sql("select 1 as x"), new list[Value]);
}

fn field(s: Store) -> result[list[Row]] {
    return query(s.db, sql("select 1 as x"), new list[Value]);
}

fn element(dbs: list[Database]) -> result[list[Row]] {
    return query(dbs[0], sql("select 1 as x"), new list[Value]);
}

fn captured(db: Database, xs: list[int]) -> list[int] {
    return map(xs, fn(x: int) -> int {
        match query(db, sql("select 1 as x"), new list[Value]) {
            case ok(rows) {
                return len(rows) + x;
            }
            case err(_) {
                return -1;
            }
        }
    });
}

fn returned() -> result[list[Row]] {
    return query(open_memory(), sql("select 1 as x"), new list[Value]);
}

fn main() -> result[void] uses console {
    let db = open_memory();
    let a = len(try param(db)) + len(try field(new Store { db: db })) + len(try element([db]));
    print(str(a + captured(db, [1])[0] + len(try returned())));
    return ok();
}
