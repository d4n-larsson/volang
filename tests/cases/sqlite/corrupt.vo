# Damaged database files are err("corrupt: ..."), never a crash: a file that is not a database, and
# a database cut in half.
import std.bytes;
import std.fs;
import std.sqlite;

fn show(r: result[list[sqlite.Row]]) -> str {
    match r {
        case ok(rows) {
            return "ok " + str(len(rows));
        }
        case err(e) {
            return "err " + e;
        }
    }
}

fn noise() -> bytes {
    var xs = new list[int];
    var x = 7;
    for i in 0..4096 {
        set x = (x * 1103515245 + 12345) % 2147483648;
        push(xs, x % 256);
    }
    return bytes.from_ints(xs);
}

fn main() -> result[void] uses console, file.read, file.write {
    try fs.write_bytes("noise.db", noise());
    match sqlite.open("noise.db") {
        case ok(db) {
            print("noise: " + show(sqlite.query(db, sqlite.sql("select * from sqlite_schema"), new list[sqlite.Value])));
        }
        case err(e) {
            print("noise: open err " + e);
        }
    }

    let db = try sqlite.open("whole.db");
    let _ = try sqlite.exec(db, sqlite.sql("create table t(x text)"), new list[sqlite.Value]);
    for i in 0..400 {
        let _ = try sqlite.exec(db, sqlite.sql("insert into t values (?)"), [sqlite.Value.text("row number " + str(i) + " with some padding text")]);
    }
    sqlite.close(db);
    let whole = try fs.read_bytes("whole.db");
    try fs.write_bytes("half.db", slice(whole, 0, len(whole) / 2));
    match sqlite.open("half.db") {
        case ok(half) {
            print("half: " + show(sqlite.query(half, sqlite.sql("select count(*) as n, max(x) as m from t"), new list[sqlite.Value])));
        }
        case err(e) {
            print("half: open err " + e);
        }
    }
    return ok();
}
