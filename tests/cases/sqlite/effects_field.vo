# A record field holding a file database: reaching it from a function without uses is E0501.
import std.sqlite.open;
import std.sqlite.sql;
import std.sqlite.query;
import std.sqlite.Database;
import std.sqlite.Row;
import std.sqlite.Value;

record Store {
    db: Database[uses file.read, file.write];
}

fn names(s: Store) -> result[list[Row]] {
    return query(s.db, sql("select name from people"), new list[Value]);
}

fn main() -> result[void] uses console, file.read, file.write {
    let s = new Store { db: try open("people.db") };
    print(str(len(try names(s))));
    return ok();
}
