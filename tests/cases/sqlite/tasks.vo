# A database belongs to the task that opened it: using it inside concurrent_map stops with R0007.
import std.sqlite;

fn main() uses console {
    let db = sqlite.open_memory();
    let counts = concurrent_map([1, 2], 2, fn(x: int) -> int {
        match sqlite.query(db, sqlite.sql("select 1 as x"), new list[sqlite.Value]) {
            case ok(rows) {
                return len(rows) + x;
            }
            case err(_) {
                return -1;
            }
        }
    });
    print(str(counts[0]));
}
