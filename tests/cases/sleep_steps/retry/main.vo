# Spec 022 US1: retry with pauses that double (50, 100, 200 ms) against a service that keeps failing.
import std.http;
import std.time;

fn main() uses console, clock, net("127.0.0.1") {
    let start = now_ms();
    var pause = 50;
    var tries = 0;
    while tries < 4 {
        set tries = tries + 1;
        match http.get(args()[0]) {
            case ok(r) {
                print("try " + str(tries) + ": status " + str(r.status));
                if r.status == 200 {
                    break;
                }
            }
            case err(e) {
                print("try " + str(tries) + ": " + e);
            }
        }
        if tries < 4 {
            time.sleep(pause);
            set pause = pause * 2;
        }
    }
    print("waited enough: " + str(now_ms() - start >= 350));
}
