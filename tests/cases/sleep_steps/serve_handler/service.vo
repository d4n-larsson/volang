# Spec 022 US5: a serve handler that sleeps answers after the pause; SIGTERM stops the server.
import std.http;
import std.time;

fn handle(r: http.Request) -> http.Response uses clock {
    time.sleep(100);
    return new http.Response { status: 200, headers: new list[http.Header], body: "rested\n" };
}

fn main() -> result[void] uses console, clock, serve("{vport}") {
    try http.serve("{vport}", handle);
    print("stopped");
    return ok();
}
