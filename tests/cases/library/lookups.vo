# Spec 056 (FR-005): a lookup that finds nothing gives `none`; one that finds something `some(value)`.
import std.collections;
import std.http;
import std.option;
import std.regex;

fn show(o: option.Option[int]) -> str {
    match o {
        case some(v) {
            return "some(" + str(v) + ")";
        }
        case none {
            return "none";
        }
    }
}

fn main() uses console {
    let m = new ordered_map[int, str];
    print(show(collections.first_key(m)) + " " + show(collections.key_after(m, 1)));
    set m[10] = "a";
    set m[20] = "b";
    print(show(collections.first_key(m)) + " " + show(collections.key_after(m, 10)) + " " + show(collections.key_after(m, 20)));
    let s = new ordered_set[int];
    print(show(collections.first(s)));
    push(s, 3);
    print(show(collections.first(s)) + " " + show(collections.after(s, 3)));
    let q = new priority_queue[int];
    print(show(collections.peek(q)));
    let r = new http.Request { method: "GET", path: "/", query: "", headers: [new http.Header { name: "Host", value: "x" }], body: "" };
    print(str(http.request_header(r, "host") == option.Option.some("x")) + " " + str(http.request_header(r, "Cookie") == option.Option.none));
    print(str(regex.first_match("aaa", regex.regex("b+")) == option.Option.none));
}
