# Spec 056 (FR-016): every exported error variant has a text function with one sentence per case.
import std.tcp;
import std.time;
import std.workers;

fn main() uses console {
    print(tcp.tcp_error_text(tcp.TcpError.timed_out));
    print(tcp.tcp_error_text(tcp.TcpError.invalid("the time limit must be 0 to 600000 ms")));
    for e in [workers.WorkerError.timed_out, workers.WorkerError.ended, workers.WorkerError.failed("exit status 3"), workers.WorkerError.full,
              workers.WorkerError.too_large, workers.WorkerError.too_many] {
        print(workers.worker_error_text(e));
    }
    print(time.local_error_text(time.LocalError.invalid("month 13")));
    print(time.local_error_text(time.LocalError.skipped(1711846800000)));
    print(time.local_error_text(time.LocalError.repeated { first: 1729990800000, second: 1729994400000 }));
}
