# Spec 057 (FR-008): the three run forms that gained a working directory, called in their 0.2 form:
# one E0214 each, with a fix inserting "./" (the start directory) after the variables.
import std.bytes;
import std.process;

fn main() -> result[void] uses console, process("true") {
    let a = try process.run_with("true", [], "", []);
    let b = try process.run_with_bytes("true", [], bytes.from_text(""), []);
    let c = try process.run_lines("true", [], "", [], fn(line: str) -> result[bool] {
        print(line);
        return ok(true);
    });
    print(str(a.code + b.code + c.code));
    return ok();
}
