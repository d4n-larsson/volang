# Spec 056 (FR-008): every time limit is 0 to 600000 ms, 0 meaning the longest; another value is refused with
# the same text in every module.
import std.http;
import std.tcp;

fn opened(r: result[tcp.Conn[uses net], tcp.TcpError]) -> str {
    match r {
        case ok(_) {
            return "open";
        }
        case err(e) {
            return tcp.tcp_error_text(e);
        }
    }
}

fn main() uses console, net("127.0.0.1") {
    print(opened(tcp.connect("127.0.0.1", 1, 0)));
    print(opened(tcp.connect("127.0.0.1", 1, 700000)));
    match http.send("GET", "http://127.0.0.1:1/", new list[http.Header], "", 700000) {
        case ok(_) {
            print("sent");
        }
        case err(e) {
            print(e);
        }
    }
}
