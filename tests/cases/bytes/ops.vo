# Spec 021: the core operations of bytes.
import std.bytes;

fn main() uses console {
    let a = bytes.from_ints([1, 2, 255]);
    let b = bytes.from_text("hé");
    print(str(len(a)) + " " + str(a[0]) + " " + str(a[2]) + " " + str(len(b)) + " " + str(b[1]));
    print(bytes.to_hex(a + b) + " " + bytes.to_hex(slice(a, 1, 3)) + " " + bytes.to_hex(a));
    print(str(a == bytes.from_ints([1, 2, 255])) + " " + str(a != b) + " " + str(bytes.from_ints([1, 2]) < a) + " " + str(a < bytes.from_ints([1, 3])) + " " + str(bytes.from_ints([2]) > a));
    let xs = [bytes.from_ints([3]), bytes.from_ints([1, 9]), bytes.from_ints([1]), bytes.from_text("")];
    sort(xs);
    var out = "";
    for x in xs {
        set out = out + "[" + bytes.to_hex(x) + "]";
    }
    print(out + " " + bytes.to_hex(min(a, b)) + " " + bytes.to_hex(max(a, b)));
    let s = new ordered_set[bytes];
    push(s, bytes.from_ints([9]));
    push(s, bytes.from_ints([0, 1]));
    push(s, bytes.from_ints([9]));
    print(str(len(s)) + " " + str(has(s, bytes.from_ints([0, 1]))));
}
