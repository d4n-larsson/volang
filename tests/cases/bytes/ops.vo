# Spec 021: the core operations of bytes.
import std.bytes.from_ints;
import std.bytes.from_text;
import std.bytes.to_hex;

fn main() uses console {
    let a = from_ints([1, 2, 255]);
    let b = from_text("hé");
    print(str(len(a)) + " " + str(a[0]) + " " + str(a[2]) + " " + str(len(b)) + " " + str(b[1]));
    print(to_hex(a + b) + " " + to_hex(slice(a, 1, 3)) + " " + to_hex(a));
    print(str(a == from_ints([1, 2, 255])) + " " + str(a != b) + " " + str(from_ints([1, 2]) < a) + " " + str(a < from_ints([1, 3])) + " " + str(from_ints([2]) > a));
    let xs = [from_ints([3]), from_ints([1, 9]), from_ints([1]), from_text("")];
    sort(xs);
    var out = "";
    for x in xs {
        set out = out + "[" + to_hex(x) + "]";
    }
    print(out + " " + to_hex(min(a, b)) + " " + to_hex(max(a, b)));
    let s = new ordered_set[bytes];
    push(s, from_ints([9]));
    push(s, from_ints([0, 1]));
    push(s, from_ints([9]));
    print(str(len(s)) + " " + str(has(s, from_ints([0, 1]))));
}
