# Spec 021: the empty bytes value.
import std.bytes;

fn main() uses console {
    let e = bytes.from_text("");
    print(str(len(e)) + " " + str(e == bytes.from_ints(new list[int])) + " [" + bytes.to_hex(e) + "] " + bytes.to_hex(e + bytes.from_ints([7])));
    let f = slice(bytes.from_ints([1, 2]), 1, 1);
    print(str(f == e) + " " + str(e < f) + " " + str(1 / len(e)));
}
