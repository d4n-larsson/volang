# Spec 021 US4: hex of every byte value and back; uppercase is accepted.
import std.bytes;

fn main() uses console {
    var xs = new list[int];
    for i in 0..256 {
        push(xs, i);
    }
    let b = bytes.from_ints(xs);
    let h = bytes.to_hex(b);
    print(str(len(h)) + " " + slice(h, 0, 8) + " " + slice(h, 504, 512) + " " + str(bytes.from_hex(h) == ok(b)));
    print(str(bytes.from_hex("ABcdEF") == bytes.from_hex("abcdef")) + " " + str(bytes.from_hex("") == ok(bytes.from_ints(new list[int]))));
}
