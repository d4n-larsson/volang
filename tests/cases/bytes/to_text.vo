# Spec 021 US4: bytes to text when they are UTF-8; latin1.txt's bytes are not.
import std.bytes;
import std.fs;

fn main() -> result[void] uses console, file.read {
    print(str(bytes.to_text(bytes.from_text("héllo")) == ok("héllo")));
    let b = try fs.read_bytes(args()[0]);
    match bytes.to_text(b) {
        case ok(s) {
            print("ok " + s);
        }
        case err(e) {
            print(e);
        }
    }
    return ok();
}
