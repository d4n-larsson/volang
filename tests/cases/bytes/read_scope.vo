# Spec 021 US1: read_bytes needs file.read with a scope that covers the path (R0010 otherwise).
import std.fs.read_bytes;

fn main() uses console, file.read("only-here/") {
    match read_bytes("/etc/hostname") {
        case ok(b) {
            print("ok");
        }
        case err(e) {
            print(e);
        }
    }
}
