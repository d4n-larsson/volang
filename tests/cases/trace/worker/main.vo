# Spec 047: a worker's trace records follow a `worker` record with its number.
import std.workers;

fn twice(n: int) -> int {
    return n * 2;
}

fn body(link: workers.Link[int, int]) {
    match workers.emit(link, twice(4)) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn main() uses console {
    match workers.start_worker(body) {
        case ok(w) {
            print(str(workers.receive(w, workers.Wait.forever) == ok(8)));
            print(str(workers.receive(w, workers.Wait.forever) == ok(8)));
        }
        case err(_) {
            print("no worker");
        }
    }
}
