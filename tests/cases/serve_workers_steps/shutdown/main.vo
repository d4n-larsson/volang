# Three workers, five slow requests read before SIGTERM (three running, two waiting): all five are
# answered, then serve_workers returns ok().
import std.http;
import std.time;

fn setup() -> result[int] {
    return ok(0);
}

fn handle(n: int, r: http.Request) -> http.Response uses clock {
    time.sleep(400);
    return new http.Response { status: 200, headers: new list[http.Header], body: r.path };
}

fn main() -> result[void] uses console, clock, serve("{vport}") {
    try http.serve_workers("{vport}", 3, setup, handle);
    print("stopped");
    return ok();
}
