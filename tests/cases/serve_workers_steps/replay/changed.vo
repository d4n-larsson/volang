# Recorded with two workers, replayed in one process: the same responses (database results, random
# values per request) with the database gone.
import std.http;
import std.sqlite;

fn setup() -> result[sqlite.Database[uses file.read, file.write]] uses file.read("data/"), file.write("data/") {
    let db = try sqlite.open("data/other.db");
    let _ = try sqlite.exec(db, sqlite.sql("create table if not exists items (id integer primary key, tag integer)"), new list[sqlite.Value]);
    return ok(db);
}

fn respond(status: int, body: str) -> http.Response {
    return new http.Response { status: status, headers: new list[http.Header], body: body };
}

fn handle(db: sqlite.Database[uses file.read, file.write], r: http.Request) -> http.Response uses random, file.read("data/"), file.write("data/") {
    if r.path == "/count" {
        match sqlite.query(db, sqlite.sql("select count(*) as n from items"), new list[sqlite.Value]) {
            case ok(rows) {
                match sqlite.int_column(rows[0], "n") {
                    case ok(n) {
                        return respond(200, str(n));
                    }
                    case err(e) {
                        return respond(500, e);
                    }
                }
            }
            case err(e) {
                return respond(500, e);
            }
        }
    }
    let tag = random_int(0, 1000000);
    match sqlite.exec(db, sqlite.sql("insert into items (tag) values (?)"), [sqlite.Value.integer(tag)]) {
        case ok(c) {
            return respond(200, str(tag));
        }
        case err(e) {
            return respond(500, e);
        }
    }
}

fn main() -> result[void] uses console, random, file.read("data/"), file.write("data/"), serve("{vport}") {
    try http.serve_workers("{vport}", 2, setup, handle);
    return ok();
}
