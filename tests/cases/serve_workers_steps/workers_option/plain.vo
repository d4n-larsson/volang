# A plain serve program: --workers changes nothing but prints a note.
import std.http;

fn handle(r: http.Request) -> http.Response {
    return new http.Response { status: 200, headers: new list[http.Header], body: r.path };
}

fn main() -> result[void] uses console, serve("{vport}") {
    try http.serve("{vport}", handle);
    print("stopped");
    return ok();
}
