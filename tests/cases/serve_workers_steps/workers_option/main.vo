# The program of ../queue (two workers declared), run with --workers.
# free worker, the fast one the next; each handler prints its path when it ends.
import std.http.Header;
import std.http.Request;
import std.http.Response;
import std.http.serve_workers;
import std.time.sleep;

fn setup() -> result[int] {
    return ok(0);
}

fn handle(n: int, r: Request) -> Response uses console, clock {
    if r.path == "/s1" {
        sleep(300);
    } else if r.path == "/s2" {
        sleep(600);
    } else if r.path == "/s3" {
        sleep(500);
    }
    print("done " + r.path);
    return new Response { status: 200, headers: new list[Header], body: r.path };
}

fn main() -> result[void] uses console, clock, serve("{vport}") {
    try serve_workers("{vport}", 2, setup, handle);
    print("stopped");
    return ok();
}
