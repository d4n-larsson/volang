# The program of ../queue (two workers declared), run with --workers.
# free worker, the fast one the next; each handler prints its path when it ends.
import std.http;
import std.time;

fn setup() -> result[int] {
    return ok(0);
}

fn handle(n: int, r: http.Request) -> http.Response uses console, clock {
    if r.path == "/s1" {
        time.sleep(300);
    } else if r.path == "/s2" {
        time.sleep(600);
    } else if r.path == "/s3" {
        time.sleep(500);
    }
    print("done " + r.path);
    return new http.Response { status: 200, headers: new list[http.Header], body: r.path };
}

fn main() -> result[void] uses console, clock, serve("{vport}") {
    try http.serve_workers("{vport}", 2, setup, handle);
    print("stopped");
    return ok();
}
