# A setup returning err: the server stops starting (no request is served) and serve_workers returns it.
import std.http;

fn setup() -> result[int] uses console {
    print("setting up");
    return err("no database");
}

fn handle(n: int, r: http.Request) -> http.Response {
    return new http.Response { status: 200, headers: new list[http.Header], body: r.path };
}

fn main() -> result[void] uses console, serve("{vport}") {
    try http.serve_workers("{vport}", 2, setup, handle);
    print("not reached");
    return ok();
}
