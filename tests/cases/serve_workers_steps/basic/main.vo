# Two workers, each running the setup once: every request gets the setup's value with its path.
import std.http;

fn setup() -> result[str] {
    return ok("ready");
}

fn handle(state: str, r: http.Request) -> http.Response {
    return new http.Response { status: 200, headers: new list[http.Header], body: state + " " + r.path };
}

fn main() -> result[void] uses console, serve("{vport}") {
    print("serving");
    try http.serve_workers("{vport}", 2, setup, handle);
    print("stopped");
    return ok();
}
