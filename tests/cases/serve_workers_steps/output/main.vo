# Two workers, two requests printing three lines each with pauses between them: each request's lines
# appear together (written when its response is sent); a handler's runtime error report appears whole.
import std.http.Header;
import std.http.Request;
import std.http.Response;
import std.http.serve_workers;
import std.time.sleep;

fn setup() -> result[int] {
    return ok(0);
}

fn handle(zero: int, r: Request) -> Response uses console, clock {
    if r.path == "/crash" {
        eprint("before the crash");
        return new Response { status: 200, headers: new list[Header], body: str(1 / zero) };
    }
    var pause = 150;
    if r.path == "/a" {
        set pause = 100;
    }
    for i in 1..4 {
        print(r.path + " line " + str(i));
        sleep(pause);
    }
    return new Response { status: 200, headers: new list[Header], body: r.path };
}

fn main() -> result[void] uses console, clock, serve("{vport}") {
    try serve_workers("{vport}", 2, setup, handle);
    print("stopped");
    return ok();
}
