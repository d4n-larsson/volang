# Two workers, two requests printing three lines each with pauses between them: each request's lines
# appear together (written when its response is sent); a handler's runtime error report appears whole.
import std.http;
import std.time;

fn setup() -> result[int] {
    return ok(0);
}

fn handle(zero: int, r: http.Request) -> http.Response uses console, clock {
    if r.path == "/crash" {
        eprint("before the crash");
        return new http.Response { status: 200, headers: new list[http.Header], body: str(1 / zero) };
    }
    var pause = 150;
    if r.path == "/a" {
        set pause = 100;
    }
    for i in 1..4 {
        print(r.path + " line " + str(i));
        time.sleep(pause);
    }
    return new http.Response { status: 200, headers: new list[http.Header], body: r.path };
}

fn main() -> result[void] uses console, clock, serve("{vport}") {
    try http.serve_workers("{vport}", 2, setup, handle);
    print("stopped");
    return ok();
}
