# A handler whose task fails answers 500, and the server goes on.
import std.http;

fn inverse(x: int) -> int {
    return 100 / x;
}

fn main() -> result[void] uses console, serve("{vport}") {
    print("serving");
    try http.serve("{vport}", fn(r) {
        let xs = [1, 2, len(r.query)];
        let ys = concurrent_map(xs, 3, inverse);
        return new http.Response { status: 200, headers: new list[http.Header], body: str(ys[2]) };
    });
    print("stopped");
    return ok();
}
