import std.http;

# Spec 013 (H7, H8, H9): hostile bytes and framing never stop the server.
fn handle(r: http.Request) -> http.Response {
    return new http.Response { status: 200, headers: new list[http.Header], body: r.method + " " + r.path + " query=" + str(len(r.query)) + " body=" + str(len(r.body)) + "\n" };
}

fn main() -> result[void] uses console, serve("{vport}") {
    print("serving");
    try http.serve("{vport}", handle);
    print("stopped");
    return ok();
}
