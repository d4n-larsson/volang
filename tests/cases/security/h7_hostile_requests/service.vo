import std.http.Header;
import std.http.Request;
import std.http.Response;
import std.http.serve;

# Spec 013 (H7, H8, H9): hostile bytes and framing never stop the server.
fn handle(r: Request) -> Response {
    return new Response { status: 200, headers: new list[Header], body: r.method + " " + r.path + " query=" + str(len(r.query)) + " body=" + str(len(r.body)) + "\n" };
}

fn main() -> result[void] uses console, serve("{vport}") {
    print("serving");
    try serve("{vport}", handle);
    print("stopped");
    return ok();
}
