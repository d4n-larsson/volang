import std.http;

# Spec 013 (M5): a header built from request data cannot split the response.
fn handle(r: http.Request) -> http.Response {
    if r.path == "/name" {
        return new http.Response { status: 200, headers: [new http.Header { name: r.body, value: "1" }], body: "named\n" };
    }
    return new http.Response { status: 200, headers: [new http.Header { name: "X-Echo", value: r.body }], body: "echoed\n" };
}

fn main() -> result[void] uses console, serve("{vport}") {
    print("serving");
    try http.serve("{vport}", handle);
    print("stopped");
    return ok();
}
