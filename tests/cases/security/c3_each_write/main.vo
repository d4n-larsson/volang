fn each[T, E: effects](xs: list[T], f: fn(T) uses E) uses E {
    for x in xs {
        f(x);
    }
}

fn main() uses console, file.write("out/") {
    each(["pwned.txt"], fn(p: str) {
        match write_file(p, "x") {
            case ok() {
                print("wrote " + p);
            }
            case err(e) {
                print("err: " + e);
            }
        }
    });
}
