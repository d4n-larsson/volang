import std.http;

fn handle(r: http.Request) -> http.Response {
    if r.path == "/div" {
        let n = len(r.query) - len(r.query);
        return new http.Response { status: 200, headers: new list[http.Header], body: str(10 / n) };
    }
    if r.path == "/callback" {
        let xs = map([3, 2, 0], fn(x: int) -> int {
            return 6 / x;
        });
        return new http.Response { status: 200, headers: new list[http.Header], body: str(len(xs)) };
    }
    if r.path == "/index" {
        let xs = [1, 2];
        return new http.Response { status: 200, headers: new list[http.Header], body: str(xs[len(r.path)]) };
    }
    return new http.Response { status: 200, headers: new list[http.Header], body: "fine\n" };
}

fn main() -> result[void] uses console, serve("{vport}") {
    try http.serve("{vport}", handle);
    print("stopped");
    return ok();
}
