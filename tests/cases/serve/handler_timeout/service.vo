import std.http;

fn handle(r: http.Request) -> http.Response {
    if r.path == "/loop" {
        var n = 0;
        while n >= 0 {
            set n = n + 1;
        }
    }
    return new http.Response { status: 200, headers: new list[http.Header], body: "fine\n" };
}

fn main() -> result[void] uses console, serve("{vport}") {
    try http.serve("{vport}", handle);
    print("stopped");
    return ok();
}
