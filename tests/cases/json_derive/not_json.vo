# Types without a JSON form are E0328 where they are bound, naming the part that has none.
import std.json;
import std.sqlite;

record Handler {
    name: str;
    on_save: fn(int) -> int;
}

record Wrapper {
    items: list[Handler];
}

record Conn {
    db: sqlite.Database;
}

fn twice(x: int) -> int {
    return x * 2;
}

fn convert[T](v: T) -> json.Json {
    return json.to_json(v);
}

fn main() {
    let a = json.to_json(new Wrapper { items: [new Handler { name: "a", on_save: twice }] });
    let by_id = new map[int, str];
    let b = json.to_json(by_id);
    let c = json.to_json(new ordered_map[str, int]);
    let d = json.to_json(parse_int("1"));
    let e = json.to_json(new Conn { db: sqlite.open_memory() });
    let f = json.to_json(twice);
}
