# A value nested far deeper than any real document: a problem from from_json, never a crash.
import std.json;

record Node {
    kids: list[Node];
}

fn main() uses console {
    var j = json.Json.array(new list[json.Json]);
    for i in 0..10000 {
        let m = new map[str, json.Json];
        set m["kids"] = json.Json.array([j]);
        set j = json.Json.object(m);
    }
    let r: result[Node] = json.from_json(j);
    match r {
        case ok(_) {
            print("ok");
        }
        case err(e) {
            print(slice(e, len(e) - 40, len(e)));
        }
    }
    let shallow: result[Node] = json.from_json(json.Json.object(new map[str, json.Json]));
    print(str(shallow == err("kids: missing")));
}
