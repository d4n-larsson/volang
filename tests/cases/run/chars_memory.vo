# `chars` of 3 MB of ASCII text fits in 64 MiB: one-character strings are shared, not made anew.
fn main() uses console {
    let parts = new list[str];
    for i in 0..300000 {
        push(parts, "abcdefghi\n");
    }
    let cs = chars(join(parts, ""));
    var lines = 0;
    for c in cs {
        if c == "\n" {
            set lines = lines + 1;
        }
    }
    print(
        str(len(cs)) + " " + str(lines) + " " + cs[8] + slice("xyz", 1, 2) + chr(65) + join(chars("aé"), "|")
    );
}
