import std.decimal;

fn d(s: str) -> decimal.Decimal {
    match decimal.parse_decimal(s) {
        case ok(v) {
            return v;
        }
        case err(_) {
            return decimal.decimal(0, 0);
        }
    }
}

fn parsed(s: str) -> str {
    match decimal.parse_decimal(s) {
        case ok(v) {
            return "[" + s + "] " + str(v.units) + " at " + str(v.places) + " is " + decimal.decimal_text(v);
        }
        case err(m) {
            return "[" + s + "] error: " + m;
        }
    }
}

fn modes(x: decimal.Decimal, places: int) -> str {
    let all_value = [
        decimal.Rounding.half_even,
        decimal.Rounding.half_up,
        decimal.Rounding.down,
        decimal.Rounding.up,
        decimal.Rounding.floor,
        decimal.Rounding.ceiling
    ];
    let out = new list[str];
    for m in all_value {
        push(out, decimal.decimal_text(decimal.round_to(x, places, m)));
    }
    return decimal.decimal_text(x) + " -> " + join(out, " ");
}

fn listed(r: result[list[decimal.Decimal]]) -> str {
    match r {
        case ok(parts) {
            return join(map(parts, decimal.decimal_text), " ") + " = " + decimal.decimal_text(decimal.total(parts));
        }
        case err(m) {
            return "error: " + m;
        }
    }
}

fn whole(x: decimal.Decimal) -> str {
    match decimal.to_int(x) {
        case ok(n) {
            return str(n);
        }
        case err(m) {
            return "error: " + m;
        }
    }
}

fn main() uses console {
    print("-- text");
    for s in [
        "12.50",
        "0",
        "-0.00",
        "-0.05",
        "007.50",
        "9223372036854775807",
        "-9223372036854775808",
        "0.000000000000000001"
    ] {
        print(parsed(s));
    }
    for s in [
        "",
        "abc",
        "1.2.3",
        "1e3",
        ".5",
        "5.",
        " 1",
        "+1",
        "1,000",
        "-",
        "0.0000000000000000001",
        "9223372036854775808"
    ] {
        print(parsed(s));
    }
    print(
        decimal.grouped_text(d("-1234567.80")) + " " + decimal.grouped_text(d("999.5")) + " " + decimal.grouped_text(d("1000")) + " " + decimal.grouped_text(d(
            "-0.05"
        ))
    );
    print("-- sums");
    print(
        decimal.decimal_text(decimal.add(d("1.5"), d("2.25"))) + " " + decimal.decimal_text(decimal.sub(d("1.5"), d("2.25"))) + " " + decimal.decimal_text(decimal.sub(
            d("10"),
            d("0.001")
        ))
    );
    print(
        decimal.decimal_text(decimal.total([d("0.10"), d("0.20"), d("0.3")])) + " " + decimal.decimal_text(decimal.total(
            new list[decimal.Decimal]
        ))
    );
    print(
        decimal.decimal_text(decimal.negate(d("1.50"))) + " " + decimal.decimal_text(decimal.absolute(d("-1.50"))) + " " + decimal.decimal_text(decimal.from_int(
            -7
        ))
    );
    print(decimal.decimal_text(decimal.add(d("-0.3"), d("922337203685477581"))));
    print("-- products and rounding");
    print(decimal.decimal_text(decimal.mul(d("19.99"), d("0.25"))));
    print(modes(d("4.9975"), 2));
    print(modes(d("0.125"), 2));
    print(modes(d("-0.125"), 2));
    print(modes(d("0.121"), 2));
    print(modes(d("-0.121"), 2));
    print(modes(d("1.5"), 3));
    print(modes(d("2.5"), 0));
    print("-- division");
    print(
        decimal.decimal_text(decimal.div(d("10"), d("3"), 2, decimal.Rounding.half_even)) + " " + decimal.decimal_text(decimal.div(
            d("2"),
            d("3"),
            2,
            decimal.Rounding.half_even
        ))
    );
    print(decimal.decimal_text(decimal.div(d("1.000000000000000000"), d("3"), 18, decimal.Rounding.half_even)));
    print(
        decimal.decimal_text(decimal.div(d("-1"), d("8"), 2, decimal.Rounding.half_even)) + " " + decimal.decimal_text(decimal.div(
            d("-1"),
            d("8"),
            2,
            decimal.Rounding.floor
        ))
    );
    print(
        decimal.decimal_text(decimal.div(d("0.000000000000000005"), d("1"), 17, decimal.Rounding.half_even)) + " " + decimal.decimal_text(decimal.div(
            d("100.00"),
            d("0.07"),
            0,
            decimal.Rounding.up
        ))
    );
    print(
        decimal.decimal_text(decimal.div(d("-9223372036854775808"), d("1"), 0, decimal.Rounding.down)) + " " + decimal.decimal_text(decimal.div(
            d("1"),
            d("-9223372036854775808"),
            18,
            decimal.Rounding.half_even
        ))
    );
    print("-- comparing");
    print(
        str(decimal.compare(d("1.5"), d("1.50"))) + " " + str(decimal.compare(d("1.49"), d("1.5"))) + " " + str(decimal.compare(d("-0.5"), d("0.5"))) + " " + str(decimal.compare(
            d("9000000000000000000"),
            d("0.000000000000000001")
        ))
    );
    print(
        str(decimal.equal(d("1.5"), d("1.50"))) + " " + str(d("1.5") == d("1.50")) + " " + str(decimal.normalize(d("1.50")) == d("1.5")) + " " + decimal.decimal_text(decimal.normalize(d("0.00"))) + " " + decimal.decimal_text(decimal.normalize(
            d("1200")
        ))
    );
    print(
        str(decimal.is_zero(d("0.00"))) + " " + str(decimal.is_negative(d("-0.01"))) + " " + str(decimal.is_negative(d(
            "0.00"
        )))
    );
    let seen = new map[decimal.Decimal, int];
    for s in ["1.5", "1.50", "1.500", "2"] {
        let k = decimal.normalize(d(s));
        set seen[k] = get_or(seen, k, 0) + 1;
    }
    print(str(len(seen)) + " " + str(seen[d("1.5")]));
    print("-- converting");
    print(whole(d("12.00")) + "; " + whole(d("12.50")) + "; " + whole(d("-3")));
    print(
        str(decimal.to_float(d("12.50"))) + " " + str(decimal.to_float(d("0.1"))) + " " + str(decimal.to_float(d(
            "9223372036854775.807"
        )))
    );
    print("-- splitting");
    print(listed(decimal.split_evenly(d("100.00"), 3)));
    print(listed(decimal.split_evenly(d("-100.00"), 3)));
    print(listed(decimal.split_evenly(d("0.02"), 5)));
    print(listed(decimal.split_evenly(d("1.00"), 0)));
    print(listed(decimal.allocate(d("100.00"), [1, 1, 2])));
    print(listed(decimal.allocate(d("0.05"), [3, 7])));
    print(listed(decimal.allocate(d("0.05"), [0, 3, 7])));
    print(listed(decimal.allocate(d("1.00"), new list[int])));
    print(listed(decimal.allocate(d("1.00"), [1, -1])));
    print(listed(decimal.allocate(d("1.00"), [0, 0])));
    print(listed(decimal.allocate(d("1.00"), [2147483647, 1])));
}
