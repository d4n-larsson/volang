import std.bits;

fn pairs(a: int, b: int) uses console {
    print(format("{} {}: and {} or {} xor {}", a, b, bits.bit_and(a, b), bits.bit_or(a, b), bits.bit_xor(a, b)));
    print(format("  add {} sub {} mul {}", bits.wrapping_add(a, b), bits.wrapping_sub(a, b), bits.wrapping_mul(a, b)));
}

fn counts(a: int, n: int) uses console {
    print(format("{} by {}: left {} right {} logical {}", a, n, bits.shift_left(a, n), bits.shift_right(a, n), bits.shift_right_logical(a, n)));
    print(format("  rotate left {} right {}", bits.rotate_left(a, n), bits.rotate_right(a, n)));
}

fn main() uses console {
    let low = -9223372036854775807 - 1;
    let values = [0, 1, -1, 9223372036854775807, low];
    for a in values {
        print(format("not {} is {}", a, bits.bit_not(a)));
        for b in values {
            pairs(a, b);
        }
        for n in [0, 1, 63] {
            counts(a, n);
        }
    }
    print(str(bits.bit_and(12, 10)) + " " + str(bits.bit_or(12, 10)) + " " + str(bits.bit_xor(12, 10)) + " " + str(bits.bit_not(0)));
    print(str(bits.shift_left(1, 63)) + " " + str(bits.shift_right(-8, 1)) + " " + str(bits.shift_right_logical(-1, 60)));
    print(str(bits.rotate_left(1, 63)) + " " + str(bits.wrapping_add(9223372036854775807, 1)));
}
