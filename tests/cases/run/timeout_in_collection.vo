# --timeout stops a program whose time goes into split and the collections of its huge live heap.
fn main() uses console {
    var s = "a,";
    for i in 0..22 {
        set s = s + s;
    }
    var total = 0;
    for round in 0..8 {
        let xs = split(s, ",");
        set total = total + len(xs);
    }
    print(str(total));
}
