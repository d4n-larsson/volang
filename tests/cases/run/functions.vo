fn fib(n: int) -> int {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn sign(x: int) -> str {
    if x < 0 {
        return "negative";
    }
    if x == 0 {
        return "zero";
    }
    return "positive";
}

fn main() uses console {
    print(str(fib(20)));
    print(sign(-5));
    print(sign(0));
    print(sign(7));
}
