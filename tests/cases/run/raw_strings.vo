import std.regex.Regex;
import std.regex.is_match;
import std.regex.regex;

const digits = `\d+`;

# Spec 042: a raw string is its text, as written.
fn main() uses console {
    print(str(`\d+"x"` == "\\d+\"x\"") + " " + str(len(`\d+"x"`)));
    let json = `{"count": 7, "name": "a\tb"}`;
    print(json);
    let sql = `select id
  from notes  # not a comment
 where title = "x" // nor this: fn let if`;
    print(sql);
    print(str(sql == "select id\n  from notes  # not a comment\n where title = \"x\" // nor this: fn let if"));
    print(str(is_match(regex(`^\d{3}-\d{4}$`), "555-1234")) + " " + str(is_match(regex(digits), "abc")));
    print(format(`{} said "{}"`, "she", "hi"));
    print("[" + `` + "]" + str(len(`
`)));
}
