variant Shape {
    circle(int);
    empty;
}

fn size(s: Shape) -> int {
    match s {
        case circle(r) {
            for i in 0..3 {
                if i == 2 {
                    return 10 / (r - r);
                }
            }
            return r;
        }
        case empty {
            return 0;
        }
    }
}

fn main() uses console {
    print(str(size(Shape.circle(4))));
}
