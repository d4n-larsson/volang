import std.bits;

fn show(what: str, r: result[int]) uses console {
    match r {
        case ok(v) {
            print(what + " -> " + str(v));
        }
        case err(m) {
            print(what + " -> " + m);
        }
    }
}

fn main() uses console {
    for s in ["ff", "FF", "0", "7fffffffffffffff", "8000000000000000", "FFFFFFFFFFFFFFFF", "00000000000000001", "", "-1", "0xff", "fg", " ff"] {
        show("hex " + s, bits.parse_hex(s));
    }
    let ones = "1111111111111111111111111111111111111111111111111111111111111111";
    for s in ["1010", "0", ones, ones + "1", "", "-1", "0b1", "102"] {
        show("binary " + s, bits.parse_binary(s));
    }
}
