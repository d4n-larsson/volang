# Spec 004: comparisons and equality on type parameters.
record Pt {
    x: int;
    y: int;
}

fn largest[T: ordered](xs: list[T]) -> T {
    var best = xs[0];
    for x in xs {
        if x > best {
            set best = x;
        }
    }
    return best;
}

fn same[T](a: T, b: T) -> bool {
    return a == b;
}

fn order[T: ordered](a: T, b: T) -> str {
    return str(a < b) + str(a <= b) + str(a > b) + str(a >= b) + str(a != b);
}

fn main() uses console {
    print(str(largest([3, 9, 2])));
    print(str(largest([1.5, -2.0, 0.25])));
    print(largest(["b", "abc", "c"]));
    let p = new Pt { x: 1, y: 2 };
    print(str(same([1, 2], [1, 2])) + str(same("a", "b")) + str(same(p, p)) + str(same(1.0, 1.0)));
    print(order(2, 3));
    print(order("b", "a"));
    print(order(1.0, 1.0));
}
