import report;

fn main() uses console {
    let t = report.total("food", 250);
    match report.level(t) {
        case low {
            print("low");
        }
        case high(c) {
            print(t.name + " high " + str(c));
        }
    }
    let u = new report.Total { name: "rent", cents: 50 };
    match report.level(u) {
        case low {
            print(u.name + " low");
        }
        case high(_) {
            print("high");
        }
    }
}
