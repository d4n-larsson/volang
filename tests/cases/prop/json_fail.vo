fn dedupe(xs: list[int]) -> list[int] {
    let out = new list[int];
    for x in xs {
        if len(out) == 0 or out[len(out) - 1] != x {
            push(out, x);
        }
    }
    return out;
}

prop "dedupe has no repeats" (xs: list[int]) {
    let d = dedupe(xs);
    for i in 0..len(d) {
        for j in 0..len(d) {
            if i != j {
                expect(d[i] != d[j]);
            }
        }
    }
}
