fn merge(a: list[int], b: list[int]) -> list[int] {
    let out = new list[int];
    var i = 0;
    var j = 0;
    while i < len(a) and j < len(b) {
        if a[i] < b[j] {
            push(out, a[i]);
            set i = i + 1;
        } else if b[j] < a[i] {
            push(out, b[j]);
            set j = j + 1;
        } else {
            push(out, a[i]);
            set i = i + 1;
            set j = j + 1;
        }
    }
    while i < len(a) {
        push(out, a[i]);
        set i = i + 1;
    }
    while j < len(b) {
        push(out, b[j]);
        set j = j + 1;
    }
    return out;
}

prop "merge keeps every element" (a: list[int], b: list[int]) {
    let x = slice(a, 0, len(a));
    let y = slice(b, 0, len(b));
    sort(x);
    sort(y);
    expect_eq(len(merge(x, y)), len(x) + len(y));
}
