# A route pattern may be a constant; a problem in it is reported at its use, with the value.
import std.http;
import std.web;

const note_path = "/notes/{id}";
const bad_path = "/notes/{id";

record ById {
    id: int;
}

fn show(n: int, input: ById) -> result[http.Response] {
    return ok(web.json_reply(200, input.id + n));
}

fn routes() -> list[web.Route[int]] {
    return [web.on_get(note_path, show), web.on_get(bad_path, show)];
}

fn main() {
}
