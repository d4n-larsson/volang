# A format template, a regex pattern and an SQL statement may be constants: they are checked as if
# their values were written there.
import std.regex.is_match;
import std.regex.regex;
import std.sqlite.Value;
import std.sqlite.exec;
import std.sqlite.open_memory;
import std.sqlite.sql;

const row = "{:<6}|{:>4}";
const code_pattern = "^[a-z]+" + "[0-9]$";
const create = "CREATE TABLE notes (id INTEGER PRIMARY KEY, text TEXT)";

fn main() -> result[void] uses console {
    print(format(row, "tea", 3));
    print(
        str(is_match(regex(code_pattern), "ab1")) + " " + str(is_match(regex(code_pattern), "1ab"))
    );
    let db = open_memory();
    let _ = try exec(db, sql(create), new list[Value]);
    print("table made");
    return ok();
}
