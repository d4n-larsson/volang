# Replacing a literal scope by a constant of the same value changes nothing in review; changing the
# constant is reported for every function that uses it.
const out_dir = "out/";

fn save(text: str) -> result[void] uses file.write(out_dir) {
    return write_file(out_dir + "report.txt", text);
}

fn log(line: str) -> result[void] uses file.write(out_dir) {
    return write_file(out_dir + "log.txt", line);
}

fn main() uses console {
    print("ready");
}
