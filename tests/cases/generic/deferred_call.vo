# A generic call without arguments as a later argument of another generic call takes its type from that
# parameter (handle_request(notes_app(), ...)), and a generic function value inside it from the route's.
import std.http;
import std.sqlite;
import std.web;

record Notes[D: effects] {
    db: sqlite.Database[D];
}

fn count[D: effects](app: Notes[D], input: web.NoInput) -> result[http.Response] uses D {
    let rows = try sqlite.query(app.db, sqlite.sql("select 1 as one"), new list[sqlite.Value]);
    return ok(web.json_reply(200, len(rows)));
}

fn notes_app[D: effects]() -> web.App[Notes[D], uses D] {
    return new web.App { routes: [web.on_get("/count", count)], steps: new list[web.Step[Notes[D], uses D]], errors: new list[web.ErrorStatus] };
}

fn open_notes() -> result[Notes[uses file.read, file.write]] uses file.read("data/"), file.write("data/") {
    return ok(new Notes { db: try sqlite.open("data/n.db") });
}

test "counts" {
    let r = web.handle_request(notes_app(), new Notes { db: sqlite.open_memory() }, web.request("GET", "/count", ""));
    expect_eq(r.body, "1");
}

fn main() -> result[void] uses file.read("data/"), file.write("data/"), serve("8080") {
    return web.serve_app("8080", 4, open_notes, notes_app());
}
