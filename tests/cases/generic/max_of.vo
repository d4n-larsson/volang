fn max_of[T: ordered](xs: list[T], start: T) -> T {
    var best = start;
    for x in xs {
        if x > best {
            set best = x;
        }
    }
    return best;
}

fn main() uses console {
    print(str(max_of([3, 9, 4], 0)));
    print(max_of(["pear", "apple", "plum"], ""));
    print(str(max_of([1.5, 0.5], 0.0)));
}
