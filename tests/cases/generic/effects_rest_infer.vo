# Spec 055 (research R9): a generic step that carries its own effects (`uses console, E`) placed in an app
# whose effects include them: E is inferred as the app's effects without console.
import std.http;
import std.web;

fn tag[C, E: effects]() -> web.Step[C, uses console, E] {
    return new web.Step {
        prefix: "/",
        run: fn(ctx: C, r: http.Request, next: fn(http.Request) -> http.Response uses console, E) -> http.Response {
            eprint("tag " + r.path);
            return next(r);
        }
    };
}

fn now(n: int, input: web.NoInput) -> result[http.Response] uses clock {
    return ok(web.json_reply(200, now_ms()));
}

fn main() uses console, clock {
    let app = new web.App[int, uses console, clock] {
        routes: [web.on_get("/now", now)],
        steps: [tag()],
        errors: new list[web.ErrorStatus]
    };
    print(str(web.handle_request(app, 0, web.request("GET", "/now", "")).status));
}
