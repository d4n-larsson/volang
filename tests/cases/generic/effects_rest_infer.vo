# Spec 055 (research R9): a generic step that carries its own effects (`uses console, E`) placed in an app
# whose effects include them: E is inferred as the app's effects without console.
import std.http.Request;
import std.http.Response;
import std.web.App;
import std.web.ErrorStatus;
import std.web.NoInput;
import std.web.Step;
import std.web.handle_request;
import std.web.json_reply;
import std.web.on_get;
import std.web.request;

fn tag[C, E: effects]() -> Step[C, uses console, E] {
    return new Step {
        prefix: "/",
        run: fn(ctx: C, r: Request, next: fn(Request) -> Response uses console, E) -> Response {
            eprint("tag " + r.path);
            return next(r);
        }
    };
}

fn now(n: int, input: NoInput) -> result[Response] uses clock {
    return ok(json_reply(200, now_ms()));
}

fn main() uses console, clock {
    let app = new App[int, uses console, clock] {
        routes: [on_get("/now", now)],
        steps: [tag()],
        errors: new list[ErrorStatus]
    };
    print(str(handle_request(app, 0, request("GET", "/now", "")).status));
}
