# Spec 020 SC-005: math is pure; a function with no `uses` may call every std.math function.
import std.math;

fn everything(x: float) -> float {
    let a = math.sqrt(x) + math.pow(x, 2.0) + math.exp(x) + math.log(x) + math.sin(x) + math.cos(x) + math.tan(x) + math.asin(x) + math.acos(x) + math.atan(x) + math.atan2(x, 1.0) + math.pi();
    return a + float(math.floor(x) + math.ceil(x) + math.round(x));
}

fn main() uses console {
    print(str(everything(0.5)));
}
