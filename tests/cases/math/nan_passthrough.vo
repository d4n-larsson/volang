# Spec 020: a NaN argument is not out of domain; it gives NaN (pow(nan, 0.0) and pow(1.0, nan) are 1.0).
import std.math.sqrt;
import std.math.exp;
import std.math.log;
import std.math.sin;
import std.math.cos;
import std.math.tan;
import std.math.asin;
import std.math.acos;
import std.math.atan;
import std.math.atan2;
import std.math.pow;

fn main() uses console {
    let n = 0.0 / 0.0;
    print(str(sqrt(n)) + " " + str(exp(n)) + " " + str(log(n)) + " " + str(sin(n)) + " " + str(cos(n)) + " " + str(tan(n)));
    print(str(asin(n)) + " " + str(acos(n)) + " " + str(atan(n)) + " " + str(atan2(n, 1.0)) + " " + str(pow(n, 2.0)));
    print(str(pow(n, 0.0)) + " " + str(pow(1.0, n)));
}
