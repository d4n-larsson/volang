# Spec 020: a NaN argument is not out of domain; it gives NaN (pow(nan, 0.0) and pow(1.0, nan) are 1.0).
import std.math;

fn main() uses console {
    let n = 0.0 / 0.0;
    print(str(math.sqrt(n)) + " " + str(math.exp(n)) + " " + str(math.log(n)) + " " + str(math.sin(n)) + " " + str(math.cos(n)) + " " + str(math.tan(n)));
    print(str(math.asin(n)) + " " + str(math.acos(n)) + " " + str(math.atan(n)) + " " + str(math.atan2(n, 1.0)) + " " + str(math.pow(n, 2.0)));
    print(str(math.pow(n, 0.0)) + " " + str(math.pow(1.0, n)));
}
