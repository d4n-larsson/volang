# Spec 020: functions keep the IEEE sign of zero, which a division shows.
import std.math;

fn main() uses console {
    let z = -0.0;
    print(str(1.0 / math.sin(z)) + " " + str(1.0 / math.sqrt(z)) + " " + str(1.0 / math.atan(z)) + " " + str(1.0 / math.tan(z)) + " " + str(1.0 / math.asin(z)));
    print(str(math.atan2(0.0, -1.0)) + " " + str(math.atan2(z, -1.0)) + " " + str(math.atan2(0.0, 0.0)) + " " + str(1.0 / math.atan2(z, 1.0)));
}
