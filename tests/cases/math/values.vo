# Spec 020 US1: correctly rounded values, as str (15 digits) and as exact JSON text (17 digits).
import std.math.pi;
import std.math.sqrt;
import std.math.pow;
import std.math.exp;
import std.math.log;
import std.math.sin;
import std.math.cos;
import std.math.tan;
import std.math.asin;
import std.math.acos;
import std.math.atan;
import std.math.atan2;
import std.json.Json;
import std.json.write_json;

fn show(x: float) uses console {
    match write_json(Json.number(x)) {
        case ok(t) {
            print(str(x) + " " + t);
        }
        case err(e) {
            print(e);
        }
    }
}

fn main() uses console {
    show(sqrt(2.0));
    show(pow(1.05, 10.0));
    show(exp(1.0));
    show(log(10.0));
    show(sin(pi() / 6.0));
    show(cos(1.0));
    show(tan(1.0));
    show(asin(0.5));
    show(acos(0.5));
    show(atan(1.0));
    show(atan2(1.0, 1.0));
    show(pi());
}
