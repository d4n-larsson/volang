# Spec 020 US1: correctly rounded values, as str (15 digits) and as exact JSON text (17 digits).
import std.json;
import std.math;

fn show(x: float) uses console {
    match json.write_json(json.Json.number(x)) {
        case ok(t) {
            print(str(x) + " " + t);
        }
        case err(e) {
            print(e);
        }
    }
}

fn main() uses console {
    show(math.sqrt(2.0));
    show(math.pow(1.05, 10.0));
    show(math.exp(1.0));
    show(math.log(10.0));
    show(math.sin(math.pi() / 6.0));
    show(math.cos(1.0));
    show(math.tan(1.0));
    show(math.asin(0.5));
    show(math.acos(0.5));
    show(math.atan(1.0));
    show(math.atan2(1.0, 1.0));
    show(math.pi());
}
