# Spec 020: huge arguments are reduced exactly; values checked against mpmath.
import std.json;
import std.math;

fn main() uses console {
    let x = 1000000000000.0 * 10000000000.0;
    match json.write_json(json.Json.array([json.Json.number(x), json.Json.number(math.sin(x)), json.Json.number(math.cos(x))])) {
        case ok(t) {
            print(t);
        }
        case err(e) {
            print(e);
        }
    }
}
