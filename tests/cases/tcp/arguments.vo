import std.bytes;
import std.tcp;

fn opened(r: result[tcp.Conn[uses net], tcp.TcpError]) -> str {
    match r {
        case ok(_) {
            return "ok";
        }
        case err(e) {
            return tcp.tcp_error_text(e);
        }
    }
}

fn got(r: result[bytes, tcp.TcpError]) -> str {
    match r {
        case ok(b) {
            return "ok " + str(len(b));
        }
        case err(e) {
            return tcp.tcp_error_text(e);
        }
    }
}

fn done(r: result[void, tcp.TcpError]) -> str {
    match r {
        case ok() {
            return "ok";
        }
        case err(e) {
            return tcp.tcp_error_text(e);
        }
    }
}

# Every argument out of range is an error value before anything is opened; a connection that is not
# open is "closed" for every operation.
fn main() uses console, net("127.0.0.1"), serve("0") {
    print(opened(tcp.connect("127.0.0.1", 0, 1000)));
    print(opened(tcp.connect("127.0.0.1", 65536, 1000)));
    print(opened(tcp.connect("127.0.0.1", 80, -1)));
    print(opened(tcp.connect("127.0.0.1", 80, 600001)));
    print(opened(tcp.connect("", 80, 1000)));
    print(opened(tcp.connect("http://127.0.0.1", 80, 1000)));
    print(opened(tcp.connect("127.0.0.1:80", 80, 1000)));
    print(opened(tcp.connect_tls("127.0.0.1", 0, 1000)));
    let c = new tcp.Conn[uses net] { id: 0, peer: "nowhere:1" };
    print(got(tcp.read(c, 0, 1000)));
    print(got(tcp.read(c, 16777217, 1000)));
    print(got(tcp.read_exact(c, 0, 1000)));
    print(got(tcp.read(c, 10, 1000)));
    print(got(tcp.read_exact(c, 10, 1000)));
    print(got(tcp.read_until(c, bytes.from_text("\n"), 1000)));
    print(done(tcp.write_all(c, bytes.from_text("x"), 1000)));
    print(done(tcp.start_tls(c, "nowhere", 1000)));
    tcp.close_conn(c);
    tcp.close_conn(c);
    match tcp.listen("nine thousand") {
        case ok(_) {
            print("ok");
        }
        case err(e) {
            print(tcp.tcp_error_text(e));
        }
    }
    match tcp.listen("0") {
        case ok(l) {
            match tcp.accept(l, -1) {
                case ok(_) {
                    print("ok");
                }
                case err(e) {
                    print(tcp.tcp_error_text(e));
                }
            }
            let empty = bytes.from_text("");
            tcp.close_listener(l);
            tcp.close_listener(l);
            match tcp.accept(l, 100) {
                case ok(_) {
                    print("ok");
                }
                case err(e) {
                    print(tcp.tcp_error_text(e));
                }
            }
            print(str(len(empty)));
        }
        case err(e) {
            print(tcp.tcp_error_text(e));
        }
    }
    for e in [
        tcp.TcpError.refused,
        tcp.TcpError.timed_out,
        tcp.TcpError.closed,
        tcp.TcpError.not_found,
        tcp.TcpError.unreachable,
        tcp.TcpError.tls("why"),
        tcp.TcpError.in_use,
        tcp.TcpError.too_large,
        tcp.TcpError.too_many,
        tcp.TcpError.invalid("what"),
        tcp.TcpError.other("why")
    ] {
        print(tcp.tcp_error_text(e));
    }
}
