# Spec 047: workers are ended with their test; a failure the test did not receive fails it, at the
# place in the worker where it happened; one it did receive does not.
import std.workers;

fn waits(link: workers.Link[int, int]) {
    match workers.next_message(link, workers.Wait.forever) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

fn fails(link: workers.Link[int, int]) {
    let zero = len(chars(""));
    match workers.emit(link, 1 / zero) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn leaves(link: workers.Link[int, int]) {
    exit(3);
}

# What the worker gives within ms milliseconds; -1 when it gives no number.
fn answer(r: result[workers.Worker[int, int], workers.WorkerError], ms: int) -> int {
    match r {
        case ok(w) {
            match workers.receive(w, workers.Wait.at_most(ms)) {
                case ok(n) {
                    return n;
                }
                case err(_) {
                    return -1;
                }
            }
        }
        case err(_) {
            return -2;
        }
    }
}

test "two workers left running" {
    expect(workers.start_worker(waits) != err(workers.WorkerError.too_many));
    expect(workers.start_worker(waits) != err(workers.WorkerError.too_many));
}

test "a failure nobody received" {
    expect(workers.start_worker(fails) != err(workers.WorkerError.too_many));
    expect_eq(answer(workers.start_worker(waits), 300), -1);
}

test "a failure the test received" {
    expect_eq(answer(workers.start_worker(fails), 5000), -1);
}

test "an exit nobody received" {
    expect(workers.start_worker(leaves) != err(workers.WorkerError.too_many));
    expect_eq(answer(workers.start_worker(waits), 300), -1);
}

test "the next test starts with no worker" {
    var started = 0;
    for i in 0..70 {
        if workers.start_worker(waits) != err(workers.WorkerError.too_many) {
            set started = started + i - i + 1;
        }
    }
    expect_eq(started, 64);
}
