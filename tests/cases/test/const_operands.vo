# A failing check shows a constant among its operands, with its value; a check of constants alone
# cannot depend on the program (W0603).
const max_items = 2;

fn count(xs: list[int]) -> int {
    return len(xs) + max_items;
}

test "limit holds" {
    let xs = [1, 2, 3];
    expect(len(xs) <= max_items);
}

test "count" {
    expect_eq(count([1]), max_items + 1);
}

test "constants only" {
    expect(max_items == 2);
}
