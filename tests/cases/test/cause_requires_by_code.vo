# Spec 018 US2: a `requires` broken by a call inside the program is `requires_broken_by_code`.
fn isqrt(n: int) -> int
    requires n >= 0 {
    var r = 0;
    while (r + 1) * (r + 1) <= n {
        set r = r + 1;
    }
    return r;
}

fn side(area: int) -> int {
    return isqrt(area - 100);
}

test "small area" {
    expect_eq(side(36), 6);
}
