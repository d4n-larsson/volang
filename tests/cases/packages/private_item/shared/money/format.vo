# money.format: Formats amounts of money.

# Cents as `units.cents`.
#     cents(1234) is "12.34"
export fn cents(n: int) -> str {
    return str(n / 100) + "." + pad2(n % 100);
}

export fn whole(n: int) -> str {
    return str(n / 100);
}

fn pad2(n: int) -> str {
    if n < 10 {
        return "0" + str(n);
    }
    return str(n);
}
