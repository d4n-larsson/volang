import std.crypto;
import std.tcp;

# Where to connect.
export record Options {
    host: str;
    port: int;
}

# Spec 050: a package's connect is given its host; the program's scopes apply.
export fn open(o: Options) -> result[tcp.Conn[uses net], tcp.TcpError] uses net, entropy {
    return tcp.connect(o.host, o.port, 999 + len(crypto.random_bytes(1)));
}
