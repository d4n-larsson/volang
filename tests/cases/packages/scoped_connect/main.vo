import pg.client;
import std.tcp;

fn try_port(port: int) -> str uses net, entropy {
    match client.open(new client.Options { host: "127.0.0.1", port: port }) {
        case ok(c) {
            tcp.close_conn(c);
            return "open";
        }
        case err(e) {
            return tcp.tcp_error_text(e);
        }
    }
}

fn main() uses console, net("127.0.0.1:1"), entropy {
    print(try_port(1));
    print(try_port(2));
}
