import std.collections;

# Spec 014: the built-in order needs an ordered element type; a comparison function orders anything.
fn main() uses console {
    let bad = new ordered_set[list[int]];
    let good = collections.ordered_set_by(fn(a: list[int], b: list[int]) -> int { return len(a) - len(b); });
    push(good, [1, 2]);
    print(str(len(good)));
}
