fn main() uses console {
    let xs = [1, 2, 3, 4, 5, 6];
    let squares = map(xs, fn(x) => x * x);
    let evens = filter(xs, fn(x) => x % 2 == 0);
    let sum = fold(xs, 0, fn(acc, x) => acc + x);
    let texts = map(squares, fn(x) => str(x));
    print(join(texts, ","));
    print(str(len(evens)) + " evens, sum " + str(sum));
    let words = fold(["a", "b", "c"], "", fn(acc, w) => acc + w);
    print(words);
}
