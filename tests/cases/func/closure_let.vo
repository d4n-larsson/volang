fn make_adder(n: int) -> fn(int) -> int {
    return fn(x) => x + n;
}

fn main() uses console {
    let add5 = make_adder(5);
    print(str(add5(10)));
    print(str(make_adder(1)(2)));
    let base = 100;
    let nested: fn(int) -> fn(int) -> int = fn(a) => fn(b) => base + a + b;
    print(str(nested(10)(1)));
}
