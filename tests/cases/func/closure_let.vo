fn make_adder(n: int) -> fn(int) -> int {
    return fn(x: int) -> int {
        return x + n;
    };
}

fn main() uses console {
    let add5 = make_adder(5);
    print(str(add5(10)));
    print(str(make_adder(1)(2)));
    let base = 100;
    let nested = fn(a: int) -> fn(int) -> int {
        return fn(b: int) -> int {
            return base + a + b;
        };
    };
    print(str(nested(10)(1)));
}
