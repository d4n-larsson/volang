# Spec 019: the same program, but asking for each URL over https://. GET each URL given as an argument (POST URL BODY with `post`), and print the response.
import std.http.Response;
import std.http.get;
import std.http.post;

fn show(r: result[Response]) uses console {
    match r {
        case ok(resp) {
            print("status " + str(resp.status));
            for h in resp.headers {
                print("header " + h.name + ": " + h.value);
            }
            print("body (" + str(len(resp.body)) + "):");
            print(resp.body);
        }
        case err(e) {
            print("err " + e);
        }
    }
}

fn main() uses console, net("127.0.0.1") {
    let a = args();
    if len(a) == 3 and a[0] == "post" {
        show(post(a[1], "text/plain", a[2]));
        return;
    }
    for url in a {
        show(get("https" + slice(url, 4, len(url))));
    }
}
