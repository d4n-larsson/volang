# Spec 017 (US3): over 16 MiB of output, or output that is not UTF-8, is an err.
import std.process;

fn show(what: str, r: result[process.Output]) uses console {
    match r {
        case ok(out) {
            print(what + ": code " + str(out.code));
            write(out.stdout);
            if out.stderr != "" {
                print("stderr: " + out.stderr);
            }
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() uses console, process("bin/bad_utf8", "bin/flood") {
    show("flood", process.run("bin/flood", new list[str]));
    show("bad utf-8", process.run("bin/bad_utf8", new list[str]));
}
