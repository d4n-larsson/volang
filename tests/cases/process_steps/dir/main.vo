# Spec 057 (US1): each run form starts the program in the directory it is given; "./" is the start
# directory. bin/cat_file is found under the start directory while it runs in work/ (FR-004).
import std.bytes.from_text;
import std.bytes.to_text;
import std.process.Output;
import std.process.run_lines;
import std.process.run_with;
import std.process.run_with_bytes;

fn show(what: str, r: result[Output]) uses console {
    match r {
        case ok(out) {
            write(what + ": " + out.stdout);
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() -> result[void] uses console, file.read("./"), process("bin/cat_file") {
    show("run_with work/", run_with("bin/cat_file", ["a.txt"], "", [], "work/"));
    show("run_with ./", run_with("bin/cat_file", ["a.txt"], "", [], "./"));
    let b = try run_with_bytes("bin/cat_file", ["a.txt"], from_text(""), [], "work/");
    write("run_with_bytes work/: " + try to_text(b.stdout));
    let l = try run_lines(
        "bin/cat_file",
        ["a.txt"],
        "",
        [],
        "work/",
        fn(line: str) -> result[bool] {
            print("run_lines work/: " + line);
            return ok(true);
        }
    );
    print("run_lines code " + str(l.code));
    return ok();
}
