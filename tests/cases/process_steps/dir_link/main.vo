# Spec 057 (US1): a directory is resolved like a file path: a link to a directory, and "..", lead where
# they point.
import std.process;

fn show(what: str, r: result[process.Output]) uses console {
    match r {
        case ok(out) {
            write(what + ": " + out.stdout);
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() uses console, file.read("./"), process("bin/cat_file") {
    show("linked/", process.run_with("bin/cat_file", ["a.txt"], "", [], "linked/"));
    show("work/../work/", process.run_with("bin/cat_file", ["a.txt"], "", [], "work/../work/"));
}
