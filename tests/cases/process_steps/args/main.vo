# Spec 017 (US3): arguments reach the program unchanged: there is no shell.
import std.process;

fn show(what: str, r: result[process.Output]) uses console {
    match r {
        case ok(out) {
            print(what + ": code " + str(out.code));
            write(out.stdout);
            if out.stderr != "" {
                print("stderr: " + out.stderr);
            }
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() uses console, file.read("./"), process("bin/args") {
    show("args", process.run("bin/args", [
        "a b",
        "'quoted'",
        "\"double\"",
        "x; rm -rf /",
        "$(echo no)",
        "*",
        "",
        "héllo"
    ]));
    show("none", process.run("bin/args", new list[str]));
    show("with", process.run_with("bin/args", ["one"], "", new list[str], "./"));
}
