# Spec 017 (US3): no descriptor of the vo program reaches the child, also from a task.
import std.process.Output;
import std.process.run;
import std.process.run_with;

fn show(what: str, r: result[Output]) uses console {
    match r {
        case ok(out) {
            print(what + ": code " + str(out.code));
            write(out.stdout);
            if out.stderr != "" {
                print("stderr: " + out.stderr);
            }
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn fds(n: int) -> str uses process("bin/fds") {
    match run("bin/fds", new list[str]) {
        case ok(out) {
            return "task " + str(n) + ": [" + out.stdout + "]";
        }
        case err(e) {
            return e;
        }
    }
}

fn main() uses console, process("bin/fds") {
    show("main", run("bin/fds", new list[str]));
    for line in concurrent_map([1, 2], 2, fds) {
        print(line);
    }
}
