# Spec 017 (US3): a program gets exactly the environment given (none for run).
import std.process.Output;
import std.process.run;
import std.process.run_with;

fn show(what: str, r: result[Output]) uses console {
    match r {
        case ok(out) {
            print(what + ": code " + str(out.code));
            write(out.stdout);
            if out.stderr != "" {
                print("stderr: " + out.stderr);
            }
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() uses console, process("bin/env_dump") {
    show("run", run("bin/env_dump", new list[str]));
    show("run_with", run_with("bin/env_dump", new list[str], "", ["B=x y", "A=1", "EMPTY="]));
}
