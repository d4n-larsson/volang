# Spec 017 (US3): a file without execute permission is err("permission denied").
import std.process;

fn show(what: str, r: result[process.Output]) uses console {
    match r {
        case ok(out) {
            print(what + ": code " + str(out.code));
            write(out.stdout);
            if out.stderr != "" {
                print("stderr: " + out.stderr);
            }
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() uses console, process("bin/args") {
    show("not executable", process.run("bin/args", new list[str]));
}
