# Spec 017 (US3): programs run inside concurrent_map tasks; results come back in input order.
import std.process.Output;
import std.process.run;
import std.process.run_with;

fn show(what: str, r: result[Output]) uses console {
    match r {
        case ok(out) {
            print(what + ": code " + str(out.code));
            write(out.stdout);
            if out.stderr != "" {
                print("stderr: " + out.stderr);
            }
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn one(n: int) -> str uses process("bin/args") {
    match run("bin/args", [str(n)]) {
        case ok(out) {
            return out.stdout;
        }
        case err(e) {
            return e;
        }
    }
}

fn main() uses console, process("bin/args") {
    for s in concurrent_map([3, 1, 2], 3, one) {
        write(s);
    }
}
