# Spec 017 (US3): run_with gives the program its input; run gives none (end of input at once).
import std.process;

fn show(what: str, r: result[process.Output]) uses console {
    match r {
        case ok(out) {
            print(what + ": code " + str(out.code));
            write(out.stdout);
            if out.stderr != "" {
                print("stderr: " + out.stderr);
            }
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() uses console, file.read("./"), process("bin/cat_in") {
    show("with input", process.run_with(
        "bin/cat_in",
        new list[str],
        "line one\nline two\n",
        new list[str],
        "./"
    ));
    show("without", process.run("bin/cat_in", new list[str]));
}
