# Spec 057 (US4): ... replayed running the same command in other/: R0014, as for other arguments.
import std.process.run_with;

fn main() -> result[void] uses console, file.read("./"), process("bin/cat_file") {
    write((try run_with("bin/cat_file", ["a.txt"], "", [], "other/")).stdout);
    return ok();
}
