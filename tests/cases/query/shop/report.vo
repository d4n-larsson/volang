import io;
import model;

export fn summary(lines: list[str]) -> list[int] {
    return map(lines, io.parse_line);
}

export fn describe(e: model.Event) -> str {
    match e {
        case added(it) {
            return "added " + it.name;
        }
        case removed(name) {
            return "removed " + name;
        }
        case cleared {
            return "cleared";
        }
    }
}

export fn total(items: list[model.Item]) -> int
    requires len(items) > 0
    ensures ret >= 0 {
    var sum = 0;
    for it in items {
        set sum = sum + it.price;
    }
    return sum;
}
