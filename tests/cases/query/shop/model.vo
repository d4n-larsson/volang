export record Item {
    name: str;
    price: int;
}

export variant Event {
    added(Item);
    removed(str);
    cleared;
}

export record Pair[A, B] {
    first: A;
    second: B;
}

export fn swap[A, B](p: Pair[A, B]) -> Pair[B, A] {
    return new Pair[B, A] { first: p.second, second: p.first };
}
