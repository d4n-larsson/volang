import io;
import model;
import report;

fn main() uses console {
    let parse_line_text = "parse_line";
    let name = "local";
    let first = io.parse_line(" 42 ");
    let items = [new model.Item { name: "pen", price: 3 }, new model.Item { name: name, price: 4 }];
    let all_value = io.load(["1", "2"]);
    let sums = report.summary(["5"]);
    let p = model.swap(new model.Pair[int, str] { first: first, second: parse_line_text });
    print(p.first + " " + str(p.second) + " " + io.label(items[0]) + " " + str(len(all_value) + len(sums)));
    print(report.describe(model.Event.added(items[1])) + " " + report.describe(model.Event.cleared) + " " + str(report.total(items)));
}

test "parse" {
    expect_eq(io.parse_line("7"), 7);
}

prop "parse never fails" (s: str) {
    let n = io.parse_line(s);
    expect(n == n);
}
