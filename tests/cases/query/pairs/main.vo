# A for with two variables: both are locals that tools can find, type and rename.
fn total(prices: map[str, int]) -> int {
    var sum = 0;
    for name, price in prices {
        if name != "" {
            set sum = sum + price;
        }
    }
    return sum;
}

fn main() uses console {
    let prices = new map[str, int];
    set prices["tea"] = 3;
    for i, word in ["a", "b"] {
        print(format("{} {}", i, word));
    }
    print(str(total(prices)));
}
