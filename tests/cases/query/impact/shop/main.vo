import cart;
import pricing;

fn main() uses console {
    print(str(cart.checkout([100, 200])));
    print(str(len(cart.with_tax_values([1]))));
}

test "checkout total" {
    expect_eq(cart.checkout([100]), 125);
}

test "discount only" {
    expect_eq(pricing.discount(200, 10), 20);
}

prop "subtotal grows" (x: int) {
    assume(x >= 0 and x < 1000);
    expect(cart.checkout([x, 1]) >= cart.checkout([x]));
}
