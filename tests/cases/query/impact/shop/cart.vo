import pricing;

fn subtotal(prices: list[int]) -> int {
    var sum = 0;
    for p in prices {
        set sum = sum + p + pricing.tax(p);
    }
    return sum;
}

export fn checkout(prices: list[int]) -> int {
    return subtotal(prices);
}

export fn with_tax_values(prices: list[int]) -> list[int] {
    return map(prices, pricing.tax);
}
