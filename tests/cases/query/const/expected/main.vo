import config.item_limit;
import config.twice;

const out_dir = "out/";

record Note {
    @size(1, item_limit)
    text: str;
}

fn add(xs: list[str]) -> bool {
    return len(xs) >= item_limit;
}

fn save() -> result[void] uses file.write(out_dir) {
    return write_file(out_dir + "x", str(twice));
}

fn main() uses console {
    print(str(add(["a"])) + " " + str(new Note { text: "a" }.text == "a"));
}
