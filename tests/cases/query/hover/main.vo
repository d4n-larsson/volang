import geo;
import std.math;

fn helper(n: int) -> int {
    return n + 1;
}

fn main() uses console {
    let p = new geo.Point { x: 1.0, y: 2.0 };
    let d = math.sqrt(geo.dist2(p, geo.origin()));
    let s = geo.Shape.circle(1.0);
    print(str(d) + " " + str(p.x) + " " + str(p.y) + " " + str(len([1, 2])) + " " + str(helper(1)));
    print(str(geo.first([1, 2]) == ok(1)));
    match s {
        case circle(r) {
            print(str(r));
        }
        case square(w) {
            print(str(w));
        }
    }
}
