import more;

fn double(x: int) -> int {
    return x * 2;
}

fn main() uses console {
    print(str(double(more.triple(1))));
}

@spec("FR-001", "US1/AC1")
test "doubles" {
    expect_eq(double(2), 4);
}

@spec("FR-001")
prop "doubles are even" (x: int) {
    expect(double(x % 1000) % 2 == 0);
}

test "not annotated" {
    expect_eq(double(0), 0);
}
