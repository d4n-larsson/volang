import std.regex;

fn patterns() -> list[regex.Regex] {
    return [regex.regex("(?=x)"), regex.regex("(?!x)"), regex.regex("(?<=x)"), regex.regex("(?<!x)"), regex.regex("(a)\\1"), regex.regex("\\k<n>"), regex.regex("(?>a)"), regex.regex("a*+"), regex.regex("\\p{L}"), regex.regex("\\A"), regex.regex("(?#c)"), regex.regex("(?P<y>a)"), regex.regex("(?x)a")];
}

fn main() uses console {
    print(str(len(patterns())));
}
