import std.regex;

fn main() uses console {
    print(regex.replace_matches("a  b\t\tc", regex.regex("\\s+"), " "));
    print(regex.replace_matches("19/11/2026 and 01/02/2003", regex.regex("(\\d{2})/(\\d{2})/(\\d{4})"), "$3-$2-$1"));
    print(regex.replace_matches("5 and 7", regex.regex("(\\d+)"), "$$$1"));
    print(regex.replace_matches("1 2", regex.regex("(\\d)"), "${1}0"));
    print(regex.replace_matches("hi vo", regex.regex("(?<word>[a-z]+)"), "<${word}>"));
    print(regex.replace_matches("1234567812345678", regex.regex("^\\d{12}(\\d{4})$"), "************$1"));
    print(regex.replace_matches("ab", regex.regex("(a)|b"), "[$1]"));
    print(regex.replace_matches("abc", regex.regex("z"), "-"));
}
