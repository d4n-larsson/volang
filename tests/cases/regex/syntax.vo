import std.regex;

fn patterns() -> list[regex.Regex] {
    return [regex.regex("(a"), regex.regex("a)"), regex.regex("[abc"), regex.regex("*a"), regex.regex("[z-a]"), regex.regex("a{3,1}"), regex.regex("a{1001}"), regex.regex("x{"), regex.regex("(?<n>a)(?<n>b)"), regex.regex("a**"), regex.regex("\\"), regex.regex("[\\d-z]")];
}

fn main() uses console {
    print(str(len(patterns())));
}
