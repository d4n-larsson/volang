import std.regex;

fn main() uses console {
    for p in ["(a", "a)", "[abc", "*a", "[z-a]", "a{3,1}", "(?=x)", "(a)\\1", "(?P<y>a)", "\\p{L}"] {
        match regex.parse_regex(p) {
            case ok(r) {
                print("ok " + r.pattern);
            }
            case err(e) {
                print(e);
            }
        }
    }
    print(str(regex.is_match("x", new regex.Regex { pattern: "(" })));
}
