import std.regex.regex;
import std.regex.first_match;
import std.option.to_result;

fn main() uses console {
    let s = "é日本 x42 ü";
    match to_result(first_match(s, regex("x(\\d+)")), "no match") {
        case ok(m) {
            print(str(m.start) + " " + str(m.end) + " " + m.groups[1] + " " + slice(s, m.start, m.end));
        }
        case err(e) {
            print(e);
        }
    }
    match to_result(first_match(s, regex("本.x")), "no match") {
        case ok(m) {
            print(str(m.start) + " " + str(m.end) + " " + m.text);
        }
        case err(e) {
            print(e);
        }
    }
}
