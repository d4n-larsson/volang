import std.option;
import std.regex;

fn main() uses console {
    let s = "é日本 x42 ü";
    match option.to_result(regex.first_match(s, regex.regex("x(\\d+)")), "no match") {
        case ok(m) {
            print(str(m.start) + " " + str(m.end) + " " + m.groups[1] + " " + slice(s, m.start, m.end));
        }
        case err(e) {
            print(e);
        }
    }
    match option.to_result(regex.first_match(s, regex.regex("本.x")), "no match") {
        case ok(m) {
            print(str(m.start) + " " + str(m.end) + " " + m.text);
        }
        case err(e) {
            print(e);
        }
    }
}
