import std.regex;
import std.text;

fn show(p: str) uses console {
    match regex.parse_regex(p) {
        case ok(_) {
            print("ok");
        }
        case err(e) {
            print(e);
        }
    }
}

fn main() uses console {
    show(text.repeat("a", 20000));
    show("(a{1000}){1000}");
    show(text.repeat("(", 201) + "a" + text.repeat(")", 201));
    show(text.repeat("(", 200) + "a" + text.repeat(")", 200));
    show("a{1000}");
}
