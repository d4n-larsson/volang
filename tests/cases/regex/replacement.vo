import std.regex.regex;
import std.regex.replace_matches;

fn main() uses console {
    let s = "abc";
    print(replace_matches(s, regex("(a)"), "\\1"));
    print(replace_matches(s, regex("(?<x>a)"), "\\g<x>"));
    print(replace_matches(s, regex("(a)"), "$2"));
    let re = regex("(a)");
    print(replace_matches(s, re, "[$2]"));
    print(replace_matches(s, re, "$x"));
    print(replace_matches(s, re, "${nope}"));
    print(replace_matches(s, re, "$1 costs $$5 ${1}0"));
}
