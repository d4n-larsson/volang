import std.regex.regex;
import std.regex.parse_regex;
import std.regex.is_match;

fn main() uses console {
    let id = regex("^[A-Z]{3}-\\d{4}$");
    print(str(is_match(id, "ABC-1234")) + " " + str(is_match(id, "ABC-12345")) + " " + str(is_match(id, "abc-1234")));
    print(str(is_match(regex("a|b"), "xbx")) + " " + str(is_match(regex("colou?r"), "color")));
    print(str(is_match(regex("^$"), "")) + " " + str(is_match(regex("é."), "aéz")) + " " + str(is_match(regex("x"), "")));
    match parse_regex("(") {
        case ok(r) {
            print("ok " + r.pattern);
        }
        case err(e) {
            print(e);
        }
    }
    match parse_regex("a+") {
        case ok(r) {
            print("ok " + r.pattern);
        }
        case err(e) {
            print(e);
        }
    }
}
