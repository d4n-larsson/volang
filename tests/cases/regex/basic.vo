import std.regex;

fn main() uses console {
    let id = regex.regex("^[A-Z]{3}-\\d{4}$");
    print(str(regex.is_match("ABC-1234", id)) + " " + str(regex.is_match("ABC-12345", id)) + " " + str(regex.is_match("abc-1234", id)));
    print(str(regex.is_match("xbx", regex.regex("a|b"))) + " " + str(regex.is_match("color", regex.regex("colou?r"))));
    print(str(regex.is_match("", regex.regex("^$"))) + " " + str(regex.is_match("aéz", regex.regex("é."))) + " " + str(regex.is_match("", regex.regex("x"))));
    match regex.parse_regex("(") {
        case ok(r) {
            print("ok " + r.pattern);
        }
        case err(e) {
            print(e);
        }
    }
    match regex.parse_regex("a+") {
        case ok(r) {
            print("ok " + r.pattern);
        }
        case err(e) {
            print(e);
        }
    }
}
