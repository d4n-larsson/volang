import std.regex.regex;
import std.regex.first_match;
import std.regex.Match;
import std.option.to_result;

fn show(r: result[Match]) uses console {
    match r {
        case ok(m) {
            print("[" + join(m.groups, "|") + "] " + str(m.took_part[1]));
        }
        case err(e) {
            print(e);
        }
    }
}

fn main() uses console {
    let re = regex("(a)?b");
    show(to_result(first_match("b", re), "no match"));
    show(to_result(first_match("ab", re), "no match"));
    show(to_result(first_match("y", regex("(x)|(y)")), "no match"));
}
