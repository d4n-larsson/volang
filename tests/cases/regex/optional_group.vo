import std.option;
import std.regex;

fn show(r: result[regex.Match]) uses console {
    match r {
        case ok(m) {
            print("[" + join(m.groups, "|") + "] " + str(m.took_part[1]));
        }
        case err(e) {
            print(e);
        }
    }
}

fn main() uses console {
    let re = regex.regex("(a)?b");
    show(option.to_result(regex.first_match("b", re), "no match"));
    show(option.to_result(regex.first_match("ab", re), "no match"));
    show(option.to_result(regex.first_match("y", regex.regex("(x)|(y)")), "no match"));
}
