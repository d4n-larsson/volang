import std.regex;

fn main() uses console {
    print(regex.replace_matches("abxd", regex.regex("x*"), "-"));
    for m in regex.all_matches("aé", regex.regex("")) {
        print(str(m.start));
    }
    print(join(regex.split_on("axb", regex.regex("x*")), "|"));
    for m in regex.all_matches("a", regex.regex("|a")) {
        print(str(m.start) + "-" + str(m.end));
    }
}
