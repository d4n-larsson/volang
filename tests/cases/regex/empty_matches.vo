import std.regex.regex;
import std.regex.replace_matches;
import std.regex.all_matches;
import std.regex.split_on;

fn main() uses console {
    print(replace_matches("abxd", regex("x*"), "-"));
    for m in all_matches("aé", regex("")) {
        print(str(m.start));
    }
    print(join(split_on("axb", regex("x*")), "|"));
    for m in all_matches("a", regex("|a")) {
        print(str(m.start) + "-" + str(m.end));
    }
}
