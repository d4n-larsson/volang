import std.regex.regex;
import std.regex.split_on;

fn main() uses console {
    print(join(split_on("a , b,c", regex("\\s*,\\s*")), "|"));
    print(join(split_on("no separator", regex(";")), "|"));
    print(join(split_on(",a,b,", regex(",")), "|"));
    print(str(len(split_on("", regex(",")))));
}
