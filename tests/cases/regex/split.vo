import std.regex;

fn main() uses console {
    print(join(regex.split_on("a , b,c", regex.regex("\\s*,\\s*")), "|"));
    print(join(regex.split_on("no separator", regex.regex(";")), "|"));
    print(join(regex.split_on(",a,b,", regex.regex(",")), "|"));
    print(str(len(regex.split_on("", regex.regex(",")))));
}
