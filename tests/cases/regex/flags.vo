import std.regex;

fn main() uses console {
    let e = regex.regex("(?i)error");
    print(str(regex.is_match("Error", e)) + " " + str(regex.is_match("ERROR", e)) + " " + str(regex.is_match("Error", regex.regex("error"))));
    for m in regex.all_matches("12\nab\n345", regex.regex("(?m)^\\d+$")) {
        print(m.text);
    }
    print(str(regex.is_match("a\nb", regex.regex("(?s)a.b"))) + " " + str(regex.is_match("a\nb", regex.regex("a.b"))));
    let scoped = regex.regex("a(?i:b)c");
    print(str(regex.is_match("aBc", scoped)) + " " + str(regex.is_match("ABC", scoped)));
    print(str(regex.is_match("É", regex.regex("(?i)é"))) + " " + str(regex.is_match("x\n", regex.regex("x$"))) + " " + str(regex.is_match("x\n", regex.regex("(?m)x$"))));
    print(str(regex.is_match("Ab", regex.regex("(?i)a(?-i)b"))) + " " + str(regex.is_match("AB", regex.regex("(?i)a(?-i)b"))));
}
