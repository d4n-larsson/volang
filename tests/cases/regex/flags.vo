import std.regex.regex;
import std.regex.is_match;
import std.regex.all_matches;

fn main() uses console {
    let e = regex("(?i)error");
    print(str(is_match(e, "Error")) + " " + str(is_match(e, "ERROR")) + " " + str(is_match(regex("error"), "Error")));
    for m in all_matches(regex("(?m)^\\d+$"), "12\nab\n345") {
        print(m.text);
    }
    print(str(is_match(regex("(?s)a.b"), "a\nb")) + " " + str(is_match(regex("a.b"), "a\nb")));
    let scoped = regex("a(?i:b)c");
    print(str(is_match(scoped, "aBc")) + " " + str(is_match(scoped, "ABC")));
    print(str(is_match(regex("(?i)é"), "É")) + " " + str(is_match(regex("x$"), "x\n")) + " " + str(is_match(regex("(?m)x$"), "x\n")));
    print(str(is_match(regex("(?i)a(?-i)b"), "Ab")) + " " + str(is_match(regex("(?i)a(?-i)b"), "AB")));
}
