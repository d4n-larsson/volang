import std.option;
import std.regex;

fn show(r: result[regex.Match]) uses console {
    match r {
        case ok(m) {
            print("[" + join(m.groups, "|") + "] " + str(m.start));
        }
        case err(e) {
            print(e);
        }
    }
}

fn main() uses console {
    show(option.to_result(regex.first_match("ab", regex.regex("a|ab")), "no match"));
    show(option.to_result(regex.first_match("aaa", regex.regex("a*?")), "no match"));
    show(option.to_result(regex.first_match("aaa", regex.regex("(a+)(a*)")), "no match"));
    show(option.to_result(regex.first_match("aaa", regex.regex("(a+?)(a*)")), "no match"));
    show(option.to_result(regex.first_match("aaa", regex.regex("x*")), "no match"));
    show(option.to_result(regex.first_match("abcd", regex.regex("(a|ab)(c|bcd)(d*)")), "no match"));
    show(option.to_result(regex.first_match("aa", regex.regex("(a|)*")), "no match"));
    show(option.to_result(regex.first_match("ab", regex.regex("(?:(a)|b)*")), "no match"));
}
