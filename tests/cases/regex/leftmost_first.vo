import std.regex.regex;
import std.regex.first_match;
import std.regex.Match;
import std.option.to_result;

fn show(r: result[Match]) uses console {
    match r {
        case ok(m) {
            print("[" + join(m.groups, "|") + "] " + str(m.start));
        }
        case err(e) {
            print(e);
        }
    }
}

fn main() uses console {
    show(to_result(first_match("ab", regex("a|ab")), "no match"));
    show(to_result(first_match("aaa", regex("a*?")), "no match"));
    show(to_result(first_match("aaa", regex("(a+)(a*)")), "no match"));
    show(to_result(first_match("aaa", regex("(a+?)(a*)")), "no match"));
    show(to_result(first_match("aaa", regex("x*")), "no match"));
    show(to_result(first_match("abcd", regex("(a|ab)(c|bcd)(d*)")), "no match"));
    show(to_result(first_match("aa", regex("(a|)*")), "no match"));
    show(to_result(first_match("ab", regex("(?:(a)|b)*")), "no match"));
}
