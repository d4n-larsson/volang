# Spec 055 US3: a gauge goes up and down (add with any amount) and is set (set_to).
import std.metrics;

fn main() uses log, console {
    let queued = metrics.gauge("queue_length", "Items waiting.", new list[str]);
    metrics.add_to(queued, new list[str], 5);
    metrics.add_to(queued, new list[str], -2);
    let temp = metrics.gauge("room_temperature", "Degrees.", ["room"]);
    metrics.set_to(temp, ["hall"], 21);
    metrics.set_to(temp, ["hall"], -3);
    write(metrics.metrics_text(new list[metrics.Metric]));
}
