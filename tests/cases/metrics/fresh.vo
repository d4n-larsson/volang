# Spec 055 US3: under vo test each test starts with no metrics.
import std.metrics;

test "first" uses log {
    metrics.add_to(metrics.counter("runs_total", "Runs.", new list[str]), new list[str], 1);
    expect(find(metrics.metrics_text(new list[metrics.Metric]), "runs_total 1\n") >= 0);
}

test "second sees its own count" uses log {
    metrics.add_to(metrics.counter("runs_total", "Runs.", new list[str]), new list[str], 1);
    expect(find(metrics.metrics_text(new list[metrics.Metric]), "runs_total 1\n") >= 0);
}
