# Spec 055 US3: a histogram's buckets are cumulative, then +Inf, the sum and the count.
import std.metrics;

fn main() uses log, console {
    let h = metrics.histogram("job_seconds", "Time per job.", new list[str], [0.1, 1.0]);
    for x in [0.05, 0.5, 5.0] {
        metrics.observe(h, new list[str], x);
    }
    write(metrics.metrics_text(new list[metrics.Metric]));
}
