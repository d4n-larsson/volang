# Spec 055 US3: a counter's series, one per tuple of label values, in the text format.
import std.metrics;

fn main() uses log, console {
    let jobs = metrics.counter("jobs_total", "Jobs run.", ["queue", "outcome"]);
    metrics.add_to(jobs, ["mail", "ok"], 2);
    metrics.add_to(jobs, ["mail", "failed"], 1);
    metrics.add_to(jobs, ["mail", "ok"], 3);
    metrics.add_to(jobs, ["reports", "ok"], 0);
    write(metrics.metrics_text(new list[metrics.Metric]));
}
