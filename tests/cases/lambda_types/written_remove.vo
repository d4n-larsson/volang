record Person {
    name: str;
    age: int;
}

fn main() uses console {
    let people = [new Person { name: "cy", age: 30 }, new Person { name: "al", age: 25 }];
    sort_by(people, fn(p: Person) -> int {
        return p.age;
    });
    let key: fn(Person) -> str = fn(p: Person) -> str {
        return p.name;
    };
    print(key(people[0]));
}
