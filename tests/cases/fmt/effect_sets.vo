# Sets: consecutive declarations stay together; in a clause, effects first, then names alphabetically.
effects Storage=file.write("data/"),file.read("data/");
export   effects Network = net("api.example.com");
effects Logs = file.write("logs/");
fn sync() -> result[void] uses Storage, console, Network, Logs {
    print("sync");
    try write_file("logs/x", "x");
    return write_file("data/x", "x");
}

fn each[E: effects](f: fn() uses E) uses E, clock {
    f();
}
