import std.text;
import std.json;
import geometry;

fn main() -> result[void] uses console {
    let j = try json.parse_json("{\"name\": \"a very long name that pushes the call past the width of a line\"}");
    print(text.pad_left(try json.text_field(j, "name"), 100, ".") + text.repeat("-", 3) + str(geometry.dist2(new geometry.Point { x: 1, y: 2 })));
    return ok();
}
