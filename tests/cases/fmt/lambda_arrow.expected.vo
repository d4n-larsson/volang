fn apply(f: fn(int) -> int, x: int) -> int {
    return f(x);
}

fn main() uses console {
    let inc: fn(int) -> int = fn(x) => x + 1;
    let clamp: fn(int) -> int = fn(x) {
        if x > 10 {
            return 10;
        }
        return x;
    };
    let add: fn(int, int) -> int = fn(a, b) => a + b;
    print(str(apply(fn(x) => x * x, 7)) + str(inc(1)) + str(clamp(3)) + str(add(1, 2)));
    print(str(apply(
        fn(value) => value * 1000000 + value * 1000 + value * 100 + value * 10 + value + 123456789,
        7
    )));
}
