# align_left and align_right pad with spaces to a width in characters (spec 009).
import std.text;

fn main() uses console {
    print("[" + text.align_left("ab", 5) + "]");
    print("[" + text.align_right("ab", 5) + "]");
    print("[" + text.align_left("日本", 4) + "][" + text.align_right("é", 3) + "]");
    print("[" + text.align_left("toolong", 3) + "][" + text.align_right("toolong", 3) + "]");
    print("[" + text.align_left("", 2) + "][" + text.align_right("x", 0) + "]");
}
