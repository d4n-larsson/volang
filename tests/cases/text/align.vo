# align_left and align_right pad with spaces to a width in characters (spec 009).
import std.text.align_left;
import std.text.align_right;

fn main() uses console {
    print("[" + align_left("ab", 5) + "]");
    print("[" + align_right("ab", 5) + "]");
    print("[" + align_left("日本", 4) + "][" + align_right("é", 3) + "]");
    print("[" + align_left("toolong", 3) + "][" + align_right("toolong", 3) + "]");
    print("[" + align_left("", 2) + "][" + align_right("x", 0) + "]");
}
