import std.text;

fn main() uses console {
    for s in ["", "a", "åäö", "日本語", "😀😀", "a\u{0}b"] {
        print(str(text.char_count(s)) + " " + str(len(s)) + " " + str(len(chars(s))));
    }
    print(str(text.equal_fold("Vo", "vO")) + " " + str(text.equal_fold("ΑΒΓ", "αβγ")) + " " + str(text.equal_fold("ß", "SS")));
}
