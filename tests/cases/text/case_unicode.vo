import std.text;

# Spec 042: upper and lower map Latin, Greek and Cyrillic letters; one code point to one code point.
fn main() uses console {
    print(upper("åäö") + " " + lower("ÅÄÖ") + " " + upper("çñü") + " " + lower("ŁÓDŹ"));
    print(upper("σοφία") + " " + lower("ΑΘΗΝΑ") + " " + upper("москва") + " " + lower("КИЇВ"));
    print(upper("straße ŉ") + " " + upper("ıi") + " " + lower("İ") + " " + upper("ÿ") + " " + upper("µ"));
    print(upper("abc 日本 հայ 123") + " " + lower("ABC 日本 ՀԱՅ 123"));
    print(str(text.equal_fold("STRASSE", "strasse")) + " " + str(text.equal_fold("Ångström", "ÅNGSTRÖM")) + " " + str(text.equal_fold("a", "b")));
    print(str(text.char_count("")) + " " + str(text.char_count("abc")) + " " + str(text.char_count("håll€😀")) + " " + str(len("håll€😀")));
}
