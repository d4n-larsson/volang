# std.text on empty strings, multi-byte text and overlapping matches.
import std.text;

fn show(xs: list[str]) -> str {
    var out = "[";
    for x in xs {
        if out != "[" {
            set out = out + ", ";
        }
        set out = out + "\"" + x + "\"";
    }
    return out + "]";
}

fn main() uses console {
    print(str(text.starts_with("", "")) + " " + str(text.starts_with("abc", "")) + " " + str(text.starts_with("", "a")) + " " + str(text.starts_with("héllo", "hé")));
    print(str(text.ends_with("", "")) + " " + str(text.ends_with("abc", "bc")) + " " + str(text.ends_with("bc", "abc")) + " " + str(text.ends_with("naïve", "ïve")));
    print(str(text.contains("", "")) + " " + str(text.contains("abc", "")) + " " + str(text.contains("", "a")) + " " + str(text.contains("日本語", "本")));
    print(text.replace("aaa", "aa", "b"));
    print(text.replace("aaaa", "aa", "b"));
    print(text.replace("", "a", "b"));
    print(text.replace("a.b.c", ".", "::"));
    print(text.replace("日本語の日本", "日本", "nihon"));
    print("[" + text.repeat("ab", 3) + "] [" + text.repeat("ab", 0) + "] [" + text.repeat("ab", -2) + "] [" + text.repeat("", 5) + "]");
    print(text.pad_left("7", 3, "0") + " " + text.pad_left("1234", 3, "0") + " " + text.pad_left("", 2, "x"));
    print(text.pad_left("é", 4, "·") + "|" + text.pad_right("日本", 4, "-") + "|" + text.pad_right("abc", 2, " ") + "|");
    print(show(text.lines("")));
    print(show(text.lines("one")));
    print(show(text.lines("one\ntwo\n")));
    let cr = chr(13);
    print(show(text.lines("one" + cr + "\ntwo" + cr + "\n" + cr + "\nfour")));
    print(show(text.lines("\n\n")));
    print(show(text.words("")));
    print(show(text.words("   ")));
    print(show(text.words("  the quick\tbrown\n\nfox  ")));
    print(show(text.words("héllo wörld")));
}
