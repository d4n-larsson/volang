# A list of file databases: querying an element from a function without uses is E0501.
import std.sqlite.open;
import std.sqlite.sql;
import std.sqlite.query;
import std.sqlite.Database;
import std.sqlite.Row;
import std.sqlite.Value;

fn first_names(dbs: list[Database[uses file.read, file.write]]) -> result[list[Row]] {
    return query(dbs[0], sql("select name from people"), new list[Value]);
}

fn main() -> result[void] uses console, file.read, file.write {
    let dbs = [try open("people.db")];
    print(str(len(try first_names(dbs))));
    return ok();
}
