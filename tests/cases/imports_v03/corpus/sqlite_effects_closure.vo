# A file database captured by an anonymous function passed to map: the anonymous function and the
# function around it have no uses, so the query is E0501.
import std.sqlite.open;
import std.sqlite.sql;
import std.sqlite.query;
import std.sqlite.Database;
import std.sqlite.Row;
import std.sqlite.Value;

fn counts(db: Database[uses file.read, file.write], tables: list[str]) -> list[int] {
    return map(tables, fn(t) {
        match query(db, sql("select name from people"), new list[Value]) {
            case ok(rows) {
                return len(rows);
            }
            case err(_) {
                return -1;
            }
        }
    });
}

fn main() -> result[void] uses console, file.read, file.write {
    let db = try open("people.db");
    print(str(counts(db, ["people"])[0]));
    return ok();
}
