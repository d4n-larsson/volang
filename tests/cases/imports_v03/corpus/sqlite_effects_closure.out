{"v":1,"kind":"diagnostic","code":"E0215","name":"single_name_import","severity":"error","file":"sqlite_effects_closure.vo","start":{"line":3,"col":1},"end":{"line":3,"col":24},"text":"import std.sqlite.open;","message":"Imports name a module, not an item: `import std.sqlite;`, then `sqlite.open`.","fixes":[{"file":"sqlite_effects_closure.vo","start":{"line":3,"col":1},"end":{"line":24,"col":22},"replacement":"import std.sqlite;\n\nfn counts(db: sqlite.Database[uses file.read, file.write], tables: list[str]) -> list[int] {\n    return map(tables, fn(t) {\n        match sqlite.query(db, sqlite.sql(\"select name from people\"), new list[sqlite.Value]) {\n            case ok(rows) {\n                return len(rows);\n            }\n            case err(_) {\n                return -1;\n            }\n        }\n    });\n}\n\nfn main() -> result[void] uses console, file.read, file.write {\n    let db = try sqlite.open"}],"related":[]}
