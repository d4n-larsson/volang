{"v":1,"kind":"diagnostic","code":"E0215","name":"single_name_import","severity":"error","file":"web_binding.vo","start":{"line":4,"col":1},"end":{"line":4,"col":26},"text":"import std.http.Response;","message":"Imports name a module, not an item: `import std.http;`, then `http.Response`.","fixes":[{"file":"web_binding.vo","start":{"line":4,"col":1},"end":{"line":76,"col":99},"replacement":"import std.http;\nimport std.web;\n\nvariant Sort {\n    newest;\n    oldest;\n}\n\nrecord NoteText {\n    @size(1, 20)\n    text: str;\n    @size(0, 2)\n    @default([])\n    tags: list[str];\n}\n\nrecord NewNote {\n    board: str;\n    body: NoteText;\n    @header(\"X-Author\")\n    @default(\"anonymous\")\n    author: str;\n}\n\nrecord Listing {\n    board: str;\n    @range(1, 50)\n    @default(10)\n    limit: int;\n    @default(false)\n    done: bool;\n    @default(Sort.newest)\n    sort: Sort;\n    @default([])\n    tag: list[str];\n}\n\nfn add(n: int, input: NewNote) -> result[http.Response] {\n    return ok(web.json_reply(200, input.board + \": \" + input.body.text + \" by \" + input.author + \" #\" + str(len(input.body.tags))));\n}\n\nfn listing(n: int, input: Listing) -> result[http.Response] {\n    var sort_value = \"newest\";\n    match input.sort {\n        case newest {\n        }\n        case oldest {\n            set sort_value = \"oldest\";\n        }\n    }\n    return ok(web.json_reply(200, input.board + \" limit \" + str(input.limit) + \" done \" + str(input.done) + \" \" + sort_value + \" tags \" + join(input.tag, \",\")));\n}\n\nfn routes() -> list[web.Route[int]] {\n    return [web.on_post(\"/boards/{board}/notes\", add), web.on_get(\"/boards/{board}/notes\", listing)];\n}\n\nfn show(app: web.App[int], method: str, path: str, body: str) uses console {\n    let r = web.handle_request(app, 0, web.with_header(web.request(method, path, body), \"X-Author\", \"ada\"));\n    print(method + \" \" + path + \" \" + body + \" -> \" + str(r.status) + \" \" + r.body);\n}\n\nfn main() uses console {\n    let app = new web.App { routes: routes(), steps: new list[web.Step[int]], errors: new list[web.ErrorStatus"}],"related":[]}
