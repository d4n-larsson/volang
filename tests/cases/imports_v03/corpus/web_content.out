{"v":1,"kind":"diagnostic","code":"E0215","name":"single_name_import","severity":"error","file":"web_content.vo","start":{"line":3,"col":1},"end":{"line":3,"col":24},"text":"import std.http.Header;","message":"Imports name a module, not an item: `import std.http;`, then `http.Header`.","fixes":[{"file":"web_content.vo","start":{"line":3,"col":1},"end":{"line":44,"col":30},"replacement":"import std.http;\nimport std.web;\n\nrecord Text {\n    body: str;\n}\n\nfn ping(n: int, input: web.NoInput) -> result[http.Response] {\n    return ok(web.json_reply(200, \"pong\"));\n}\n\nfn echo(n: int, input: Text) -> result[http.Response] {\n    return ok(web.json_reply(200, input.body));\n}\n\nfn routes() -> list[web.Route[int]] {\n    return [web.on_post(\"/ping\", ping), web.on_post(\"/echo\", echo)];\n}\n\nfn show(app: web.App[int], r: http.Request) uses console {\n    let resp = web.handle_request(app, 0, r);\n    print(r.path + \" -> \" + str(resp.status) + \" \" + resp.body);\n}\n\nfn main() uses console {\n    let app = new web.App { routes: routes(), steps: new list[web.Step[int]], errors: new list[web.ErrorStatus] };\n    show(app, web.request(\"POST\", \"/ping\", \"\"));\n    show(app, web.request(\"POST\", \"/ping\", \"{}\"));\n    show(app, web.request(\"POST\", \"/echo\", \"\\\"hi\\\"\"));\n    show(app, new http.Request { method: \"POST\", path: \"/echo\", query: \"\", headers: [new http.Header { name: \"Content-Type\", value: \"text/plain\" }], body: \"hi\" });\n    show(app, new http.Request { method: \"POST\", path: \"/echo\", query: \"\", headers: [new http.Header { name: \"content-type\", value: \"application/json; charset=utf-8\" }], body: \"\\\"hi\\\"\" });\n    match ping(0, new web.NoInput"}],"related":[]}
