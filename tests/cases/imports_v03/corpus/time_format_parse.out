{"v":1,"kind":"diagnostic","code":"E0215","name":"single_name_import","severity":"error","file":"time_format_parse.vo","start":{"line":2,"col":1},"end":{"line":2,"col":29},"text":"import std.time.format_time;","message":"Imports name a module, not an item: `import std.time;`, then `time.format_time`.","fixes":[{"file":"time_format_parse.vo","start":{"line":2,"col":1},"end":{"line":19,"col":22},"replacement":"import std.time;\n\nfn try_parse(s: str) uses console {\n    match time.parse_time(s) {\n        case ok(ms) {\n            print(\"\\\"\" + s + \"\\\" -> \" + str(ms) + \" = \" + time.format_time(ms));\n        }\n        case err(e) {\n            print(\"\\\"\" + s + \"\\\": \" + e);\n        }\n    }\n}\n\nfn main() uses console {\n    print(time.format_time(1763112600000));\n    print(time.format_time(1763112600123));\n    print(time.format_time"}],"related":[]}
