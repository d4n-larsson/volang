{"v":1,"kind":"diagnostic","code":"E0215","name":"single_name_import","severity":"error","file":"json_fields.vo","start":{"line":1,"col":1},"end":{"line":1,"col":22},"text":"import std.json.Json;","message":"Imports name a module, not an item: `import std.json;`, then `json.Json`.","fixes":[{"file":"json_fields.vo","start":{"line":1,"col":1},"end":{"line":36,"col":31},"replacement":"import std.json;\n\nfn show[T](label: str, r: result[T], text: fn(T) -> str) uses console {\n    match r {\n        case ok(v) {\n            print(label + \": ok \" + text(v));\n        }\n        case err(e) {\n            print(label + \": err \" + e);\n        }\n    }\n}\n\nfn main() -> result[void] uses console {\n    let doc = try json.parse_json(\"{\\\"name\\\": \\\"ana\\\", \\\"age\\\": 3, \\\"score\\\": 9.5, \\\"admin\\\": true, \\\"tags\\\": [1]}\");\n    show(\"name\", json.text_field(doc, \"name\"), fn(s) => s);\n    show(\"age\", json.int_field(doc, \"age\"), fn(i) => str(i));\n    show(\"age as float\", json.float_field(doc, \"age\"), fn(f) => str(f));\n    show(\"score\", json.float_field(doc, \"score\"), fn(f) => str(f));\n    show(\"admin\", json.bool_field(doc, \"admin\"), fn(b) => str(b));\n    show(\"missing\", json.text_field(doc, \"email\"), fn(s) => s);\n    show(\"wrong kind\", json.text_field(doc, \"age\"), fn(s) => s);\n    show(\"score as int\", json.int_field(doc, \"score\"), fn(i) => str(i));\n    show(\"admin as text\", json.text_field(doc, \"admin\"), fn(s) => s);\n    show(\"not an object\", json.text_field(json.Json.array(new list[json.Json]), \"a\"), fn(s) => s);\n    let tags = try json.member(doc, \"tags\");\n    show(\"at 0\", json.at(tags, 0), fn(j) => \"a value\");\n    show(\"at 5\", json.at(tags, 5), fn(j) => \"a value\");\n    show(\"at on an object\", json.at"}],"related":[]}
