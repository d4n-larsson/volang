{"v":1,"kind":"diagnostic","code":"E0215","name":"single_name_import","severity":"error","file":"text_case_unicode.vo","start":{"line":1,"col":1},"end":{"line":1,"col":28},"text":"import std.text.char_count;","message":"Imports name a module, not an item: `import std.text;`, then `text.char_count`.","fixes":[{"file":"text_case_unicode.vo","start":{"line":1,"col":1},"end":{"line":11,"col":84},"replacement":"import std.text;\n\n# Spec 042: upper and lower map Latin, Greek and Cyrillic letters; one code point to one code point.\nfn main() uses console {\n    print(upper(\"åäö\") + \" \" + lower(\"ÅÄÖ\") + \" \" + upper(\"çñü\") + \" \" + lower(\"ŁÓDŹ\"));\n    print(upper(\"σοφία\") + \" \" + lower(\"ΑΘΗΝΑ\") + \" \" + upper(\"москва\") + \" \" + lower(\"КИЇВ\"));\n    print(upper(\"straße ŉ\") + \" \" + upper(\"ıi\") + \" \" + lower(\"İ\") + \" \" + upper(\"ÿ\") + \" \" + upper(\"µ\"));\n    print(upper(\"abc 日本 հայ 123\") + \" \" + lower(\"ABC 日本 ՀԱՅ 123\"));\n    print(str(text.equal_fold(\"STRASSE\", \"strasse\")) + \" \" + str(text.equal_fold(\"Ångström\", \"ÅNGSTRÖM\")) + \" \" + str(text.equal_fold(\"a\", \"b\")));\n    print(str(text.char_count(\"\")) + \" \" + str(text.char_count(\"abc\")) + \" \" + str(text.char_count"}],"related":[]}
