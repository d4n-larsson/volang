# Two functions that differ only in their effects: make one function with an effect parameter.
import std.sqlite;

fn setup_file(db: sqlite.Database[uses file.read, file.write]) -> result[int] uses file.read, file.write {
    let a = try sqlite.exec(db, sqlite.sql("create table if not exists t(x)"), new list[sqlite.Value]);
    let b = try sqlite.exec(db, sqlite.sql("create table if not exists u(y)"), new list[sqlite.Value]);
    return ok(a.changed + b.changed);
}

fn setup_memory(db: sqlite.Database) -> result[int] {
    let a = try sqlite.exec(db, sqlite.sql("create table if not exists t(x)"), new list[sqlite.Value]);
    let b = try sqlite.exec(db, sqlite.sql("create table if not exists u(y)"), new list[sqlite.Value]);
    return ok(a.changed + b.changed);
}

fn main() -> result[void] uses console, file.read, file.write {
    print(str(try setup_file(try sqlite.open("app.db")) + try setup_memory(sqlite.open_memory())));
    return ok();
}
