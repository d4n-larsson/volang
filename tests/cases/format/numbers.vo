fn main() uses console {
    let min = -9223372036854775807 - 1;
    print(format("{:,} {:,.2f} {:,} {:,} {:,}", 1234567, 1234567.891, -1000, 999, 0));
    print(format("{:+} {:+} {:+.1f} {:+.2f} {:+}", 5, 0, -0.25, 0.0, -0.0));
    print(format("{:05} {:05} {:+06.2f} {:08.3f} {:03}", 42, -42, 3.14159, -2.5, 12345));
    print(format("{:x} {:x} {:08b} {:b} {:+x} {:>6x}", 255, -255, 5, 0, 255, 255));
    print(format("{:x} {:b}", min, min));
    print(format("{:,} {:,} {:+} {:010} {:,}", 1234.5, -1234567.25, 2.5, -1.5, 100000000000000000000.0));
    print(format("[{:^9,}] [{:<+8}] [{:>10,.1f}]", 1234567, 42, -98765.43));
}
