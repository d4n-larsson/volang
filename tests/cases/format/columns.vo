fn main() uses console {
    print(format("{:<12}|{:>8.2f}", "coffee", 4.5));
    print(format("[{:5}][{:5}][{:5}][{:5}]", 42, "ab", true, 2.5));
    print(format("[{:^5}][{:^6}][{:>4}][{:<4}]", "ab", "ab", "x", 7));
    print(format("[{:3}][{:6}][{:^7}]", "héllo", "héllo", "é"));
    print(format("[{:>6.2f}][{:<6.2f}][{:^8.1f}]", 1.0 / 0.0, -1.5, 0.25));
    print(format("[{:0}][{:1}][{:12}]", 5, "", -3.25));
}
