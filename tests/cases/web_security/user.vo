# The user in the operation (std.security, story 3): current_user, require_user, require_role and
# has_role on the identity the step passes on; nothing a client sends in its place is believed.
import std.http;
import std.option;
import std.security;
import std.web;

record Caller {
    @header("X-Identity")
    @default("")
    identity: str;
}

record Remove {
    owner: str;
    @header("X-Identity")
    @default("")
    identity: str;
}

fn whoami(n: int, input: Caller) -> result[http.Response] {
    match security.current_user(input.identity) {
        case some(user) {
            return ok(web.json_reply(200, user));
        }
        case none {
            return ok(web.json_reply(200, "nobody"));
        }
    }
}

fn mine(n: int, input: Caller) -> result[http.Response] {
    let user = try security.require_user(input.identity);
    return ok(web.json_reply(200, user.name));
}

fn audit(n: int, input: Caller) -> result[http.Response] {
    let user = try security.require_role(input.identity, ["auditor", "admin"]);
    return ok(web.json_reply(200, user.name));
}

fn delete_note(n: int, input: Remove) -> result[http.Response] {
    let user = try security.require_user(input.identity);
    if input.owner != user.name and not security.has_role(user, "admin") {
        return err("forbidden: not your note");
    }
    return ok(web.json_reply(200, "removed"));
}

fn routes() -> list[web.Route[int]] {
    return [
        web.on_get("/open/whoami", whoami),
        web.on_get("/open/mine", mine),
        web.on_get("/open/audit", audit),
        web.on_get("/whoami", whoami),
        web.on_delete("/notes/{owner}", delete_note)
    ];
}

fn app(ways: list[security.Way[int]]) -> web.App[int] {
    let rules = [security.rule("/open", security.Access.anyone), security.rule("/", security.Access.signed_in)];
    return new web.App {
        routes: routes(),
        steps: [security.secure(security.policy(rules, ways, fn() => 0))],
        errors: new list[web.ErrorStatus]
    };
}

fn token_name(n: int, token: str) -> result[str] {
    return ok("svc");
}

fn show(label: str, a: web.App[int], r: http.Request) uses console {
    let resp = web.handle_request(a, 0, r);
    print(label + " -> " + str(resp.status) + " " + resp.body);
}

fn main() uses console {
    let a = app([security.test_users()]);
    let ada = new security.User { name: "ada", roles: ["admin"] };
    let bo = new security.User { name: "bo", roles: new list[str] };
    let forged = "{\"name\":\"root\",\"roles\":[\"admin\"]}";
    show("the user", a, security.as_user(web.request("GET", "/whoami", ""), ada));
    show("no roles", a, security.as_user(web.request("GET", "/whoami", ""), bo));
    show("open, nobody", a, web.request("GET", "/open/whoami", ""));
    show("open, a user", a, security.as_user(web.request("GET", "/open/whoami", ""), bo));
    show("open, require_user", a, web.request("GET", "/open/mine", ""));
    show("open, require_role without a user", a, web.request("GET", "/open/audit", ""));
    show("require_role without the role", a, security.as_user(web.request("GET", "/open/audit", ""), bo));
    show("require_role with one of them", a, security.as_user(web.request("GET", "/open/audit", ""), ada));
    show("forged X-Identity, nobody", a, web.with_header(web.request("GET", "/open/whoami", ""), "X-Identity", forged));
    show("forged X-Identity, guarded", a, web.with_header(web.request("GET", "/whoami", ""), "X-Identity", forged));
    show("forged X-Identity, bo", a, web.with_header(security.as_user(web.request("GET", "/whoami", ""), bo), "x-identity", forged));
    show("forged X-Test-User, not accepted", app(new list[security.Way[int]]), web.with_header(web.request("GET", "/open/whoami", ""), "X-Test-User", forged));
    show("forged X-Test-User, guarded", app(new list[security.Way[int]]), web.with_header(web.request("GET", "/whoami", ""), "X-Test-User", forged));
    show("owner removes", a, security.as_user(web.request("DELETE", "/notes/bo", ""), bo));
    show("another user", a, security.as_user(web.request("DELETE", "/notes/ada", ""), bo));
    show("admin removes", a, security.as_user(web.request("DELETE", "/notes/bo", ""), ada));
    # The identity std.web.bearer_auth passes on is a bare name: a user without roles.
    let steps: list[web.Step[int]] = [web.bearer_auth("/", token_name)];
    let plain = new web.App { routes: routes(), steps: steps, errors: new list[web.ErrorStatus] };
    show("bearer_auth", plain, web.with_header(web.request("GET", "/whoami", ""), "Authorization", "Bearer t"));
    show("bearer_auth, require_role", plain, web.with_header(web.request("GET", "/open/audit", ""), "Authorization", "Bearer t"));
}
