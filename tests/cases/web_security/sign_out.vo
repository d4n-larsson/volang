# Signing out (spec 052, story 3): the session is ended on the server, the cookie removed, the browser
# sent to the sign-in page; a copy of the cookie taken before signs nobody in. Signing out from another
# site is refused; signing out with no session only redirects.
import std.bytes;
import std.http;
import std.option;
import std.security;
import std.web;

const weak = "pbkdf2-sha256$1$c2FsdA==$VawEblbjCJ/sFpHCJUS2BflBhSFt3gRl5oudV8INrLw=";
const strong = "pbkdf2-sha256$600000$UzaawpluQd/9+wjqxK7k5g==$T77DFP1a//H/wGSMrDAzacBRzngTQcTM4Nma4jsUNWw=";

record Store {
    sessions: map[str, security.Session];
    events: list[str];
    now: int;
    drawn: int;
}

record Who {
    @header("X-Identity")
    @default("")
    identity: str;
}

fn find_account(st: Store, name: str) -> result[option.Option[security.Account]] {
    if name == "ada" {
        return ok(option.Option.some(new security.Account { name: "ada", password_hash: weak, roles: ["admin"], enabled: true }));
    }
    if name == "old" {
        return ok(option.Option.some(new security.Account { name: "old", password_hash: weak, roles: new list[str], enabled: false }));
    }
    if name == "col" {
        return ok(option.Option.some(new security.Account { name: "col", password_hash: strong, roles: new list[str], enabled: true }));
    }
    return ok(option.Option.none);
}

fn the_browser(st: Store) -> security.Browser[Store] {
    return new security.Browser {
        find_account: find_account,
        keep: fn(s, x) {
            set s.sessions[x.key] = x;
            return ok();
        },
        find: fn(s, key) {
            if has(s.sessions, key) {
                return ok(option.Option.some(s.sessions[key]));
            }
            return ok(option.Option.none);
        },
        end: fn(s, key) {
            remove(s.sessions, key);
            return ok();
        },
        random: fn(n) {
            set st.drawn = st.drawn + 1;
            let xs = new list[int];
            for i in 0..n {
                push(xs, (st.drawn * 16 + i) % 256);
            }
            return bytes.from_ints(xs);
        },
        sign_in: "/sign-in",
        sign_out: "/sign-out",
        lifetime_ms: 3600000,
        origin: ""
    };
}

fn notes(st: Store, input: Who) -> result[http.Response] {
    let user = try security.require_user(input.identity);
    return ok(web.json_reply(200, "notes of " + user.name));
}

fn app(st: Store) -> web.App[Store] {
    let b = the_browser(st);
    let p = new security.Policy {
        rules: [
            security.rule("/sign-in", security.Access.anyone),
            security.rule("/sign-out", security.Access.anyone),
            security.rule("/notes", security.Access.signed_in),
            security.rule("/api", security.Access.signed_in)
        ],
        ways: [security.browser(b)],
        now: fn() => st.now,
        on_event: fn(s, e) {
            push(s.events, e.kind + " " + e.name + " (" + e.reason + ")");
        }
    };
    let routes = security.browser_routes(b, p);
    push(routes, web.on_get("/notes", notes));
    push(routes, web.on_get("/api/notes", notes));
    return new web.App { routes: routes, steps: [security.secure(p)], errors: new list[web.ErrorStatus] };
}

fn send(st: Store, r: http.Request, headers: list[http.Header]) -> http.Response {
    for h in headers {
        push(r.headers, h);
    }
    return web.handle_request(app(st), st, r);
}

fn form(body: str, cookie: str) -> list[http.Header] {
    let hs = [
        new http.Header { name: "Content-Type", value: "application/x-www-form-urlencoded" },
        new http.Header { name: "Sec-Fetch-Site", value: "same-origin" }
    ];
    if cookie != "" {
        push(hs, new http.Header { name: "Cookie", value: "__Host-session=" + cookie });
    }
    return hs;
}

fn page_of(cookie: str) -> list[http.Header] {
    let hs = [new http.Header { name: "Accept", value: "text/html,application/xhtml+xml" }];
    if cookie != "" {
        push(hs, new http.Header { name: "Cookie", value: "__Host-session=" + cookie });
    }
    return hs;
}

fn header(r: http.Response, name: str) -> str {
    for h in r.headers {
        if h.name == name {
            return h.value;
        }
    }
    return "-";
}

fn show(what: str, r: http.Response) uses console {
    print(what + ": " + str(r.status) + " Location=" + header(r, "Location") + " Set-Cookie=" + header(r, "Set-Cookie"));
    if r.body != "" {
        print("  " + r.body);
    }
}

fn post(path: str, body: str) -> http.Request {
    let r = web.request("POST", path, "");
    set r.body = body;
    return r;
}

fn cookie_of(r: http.Response) -> str {
    let set_cookie = header(r, "Set-Cookie");
    match web.read_cookie(set_cookie, "__Host-session") {
        case some(v) {
            return v;
        }
        case none {
            return "";
        }
    }
}

fn main() uses console {
    let st = new Store { sessions: new map[str, security.Session], events: new list[str], now: 1000000, drawn: 0 };
    let c = cookie_of(send(st, post("/sign-in", "name=ada&password=passwd"), form("", "")));
    set st.events = new list[str];
    show("from another site", send(st, post("/sign-out", ""), [new http.Header { name: "Cookie", value: "__Host-session=" + c }, new http.Header { name: "Sec-Fetch-Site", value: "cross-site" }]));
    print("sessions: " + str(len(st.sessions)));
    show("sign out", send(st, post("/sign-out", ""), form("", c)));
    print("sessions: " + str(len(st.sessions)));
    show("the copied cookie, on a page", send(st, web.request("GET", "/notes", ""), page_of(c)));
    show("the copied cookie, on the api", send(st, web.request("GET", "/api/notes", ""), [new http.Header { name: "Cookie", value: "__Host-session=" + c }]));
    show("sign out without a session", send(st, post("/sign-out", ""), form("", "")));
    for e in st.events {
        print("event: " + e);
    }
}
