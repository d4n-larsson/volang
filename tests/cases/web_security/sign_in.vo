# Signing in (std.security, story 2): HTTP Basic against the application's accounts, signed tokens,
# the sign-in route, and the security events. Unknown name, wrong password and disabled account get
# the same answer. No password, key or token appears in an event.
import std.bytes;
import std.crypto;
import std.http;
import std.json;
import std.option;
import std.security;
import std.web;

const weak = "pbkdf2-sha256$1$c2FsdA==$VawEblbjCJ/sFpHCJUS2BflBhSFt3gRl5oudV8INrLw=";
const strong = "pbkdf2-sha256$600000$UzaawpluQd/9+wjqxK7k5g==$T77DFP1a//H/wGSMrDAzacBRzngTQcTM4Nma4jsUNWw=";

fn find_account(n: int, name: str) -> result[option.Option[security.Account]] {
    if name == "ada" {
        return ok(option.Option.some(new security.Account { name: "ada", password_hash: weak, roles: ["admin"], enabled: true }));
    }
    if name == "old" {
        return ok(option.Option.some(new security.Account { name: "old", password_hash: weak, roles: new list[str], enabled: false }));
    }
    if name == "col" {
        return ok(option.Option.some(new security.Account { name: "col", password_hash: strong, roles: new list[str], enabled: true }));
    }
    if name == "boom" {
        return err("the database is down");
    }
    return ok(option.Option.none);
}

fn key() -> bytes {
    return bytes.from_text("0123456789abcdef0123456789abcdef");
}

fn old_key() -> bytes {
    return bytes.from_text("fedcba9876543210fedcba9876543210");
}

fn log(n: int, e: security.Event) uses console {
    print(format("  event {} [{}] name={} {} {} at {}", e.kind, e.reason, e.name, e.method, e.path, e.at_ms));
}

record Caller {
    @header("X-Identity")
    @default("")
    identity: str;
}

fn whoami(n: int, input: Caller) -> result[http.Response] {
    return ok(web.json_reply(200, input.identity));
}

fn ran(n: int, input: web.NoInput) -> result[http.Response] {
    return ok(web.json_reply(200, "ran"));
}

fn the_policy(now_ms_value: int) -> security.Policy[int, uses console] {
    return new security.Policy {
        rules: [security.rule("/sign-in", security.Access.anyone), security.rule("/open", security.Access.anyone), security.rule("/", security.Access.signed_in)],
        ways: [security.basic(find_account), security.tokens([key(), old_key()])],
        now: fn() -> int { return now_ms_value; },
        on_event: log
    };
}

fn app(now_ms_value: int) -> web.App[int, uses console] {
    let p = the_policy(now_ms_value);
    return new web.App {
        routes: [web.on_get("/me", whoami), web.on_get("/open", ran), security.sign_in_route("/sign-in", p, find_account, key(), 600)],
        steps: [security.secure(p)],
        errors: new list[web.ErrorStatus]
    };
}

fn show(label: str, a: web.App[int, uses console], r: http.Request) -> str uses console {
    let resp = web.handle_request(a, 0, r);
    var hs = "";
    for h in resp.headers {
        if h.name != "Content-Type" {
            set hs = hs + " [" + h.name + ": " + h.value + "]";
        }
    }
    print(label + " -> " + str(resp.status) + hs + " " + resp.body);
    return resp.body;
}

fn with_basic(r: http.Request, pair: str) -> http.Request {
    return web.with_header(r, "Authorization", "Basic " + bytes.to_base64(bytes.from_text(pair)));
}

fn with_token(r: http.Request, token: str) -> http.Request {
    return web.with_header(r, "Authorization", "Bearer " + token);
}

fn token_of(body: str) -> str {
    match json.parse_json(body) {
        case ok(j) {
            match json.text_field(j, "token") {
                case ok(t) {
                    return t;
                }
                case err(_) {
                }
            }
        }
        case err(_) {
        }
    }
    return "";
}

fn main() uses console {
    let a = app(1000000);
    let me = web.request("GET", "/me", "");
    let _ = show("nobody", a, me);
    let _ = show("basic", a, with_basic(me, "ada:passwd"));
    let wrong = show("basic, wrong password", a, with_basic(me, "ada:nope"));
    let unknown = show("basic, unknown name", a, with_basic(me, "eve:passwd"));
    let disabled = show("basic, disabled", a, with_basic(me, "old:passwd"));
    print(format("the three answers are the same: {}", wrong == unknown and unknown == disabled));
    let _ = show("basic, a password with a colon", a, with_basic(me, "col:pa:ss"));
    let _ = show("basic, lower-case scheme", a, web.with_header(me, "Authorization", "basic " + bytes.to_base64(bytes.from_text("ada:passwd"))));
    let _ = show("basic, not base64", a, web.with_header(me, "Authorization", "Basic !!!"));
    let _ = show("basic, no colon", a, with_basic(me, "ada"));
    let _ = show("basic, empty name", a, with_basic(me, ":passwd"));
    let _ = show("basic, wrong on the open route", a, with_basic(web.request("GET", "/open", ""), "ada:nope"));
    let _ = show("basic, the lookup fails", a, with_basic(me, "boom:x"));
    let _ = show("only the scheme", a, web.with_header(me, "Authorization", "Bearer "));

    let token = token_of(show("sign in", a, web.request("POST", "/sign-in", "{\"name\":\"ada\",\"password\":\"passwd\"}")));
    let _ = show("sign in, wrong password", a, web.request("POST", "/sign-in", "{\"name\":\"ada\",\"password\":\"nope\"}"));
    let _ = show("sign in, disabled", a, web.request("POST", "/sign-in", "{\"name\":\"old\",\"password\":\"passwd\"}"));
    let _ = show("sign in, unknown name", a, web.request("POST", "/sign-in", "{\"name\":\"eve\",\"password\":\"passwd\"}"));
    let _ = show("sign in, no password", a, web.request("POST", "/sign-in", "{\"name\":\"ada\"}"));
    let _ = show("sign in, not JSON", a, web.request("POST", "/sign-in", "ada"));
    let _ = show("sign in, the lookup fails", a, web.request("POST", "/sign-in", "{\"name\":\"boom\",\"password\":\"x\"}"));
    let _ = show("sign in with an expired token along", app(1600000), with_token(web.request("POST", "/sign-in", "{\"name\":\"ada\",\"password\":\"passwd\"}"), token));

    let _ = show("token", a, with_token(me, token));
    let _ = show("token, one second before expiry", app(1599999), with_token(me, token));
    let _ = show("token, at expiry", app(1600000), with_token(me, token));
    let _ = show("token, damaged", a, with_token(me, token + "A"));
    let _ = show("token, not a token", a, with_token(me, "abc"));
    let user = new security.User { name: "bo", roles: ["user"] };
    match security.issue_token(old_key(), user, 1000000, 60) {
        case ok(t) {
            let _ = show("token of the old key", a, with_token(me, t));
            print(format("another key refuses it: {}", security.check_token([key()], 1000000, t) == err("unauthorized: signature")));
            print(format("check_token: {}", security.check_token([old_key()], 1000000, t) == ok(user)));
        }
        case err(e) {
            print(e);
        }
    }
    print(format("password_user: {}", security.password_user(0, find_account, "ada", "passwd") == ok(new security.User { name: "ada", roles: ["admin"] })));
    print(format("password_user, wrong: {}", security.password_user(0, find_account, "ada", "nope") == err("unauthorized: invalid credentials")));
    print(format("password_user, the lookup fails: {}", security.password_user(0, find_account, "boom", "x") == err("the database is down")));
    print(format("outdated: weak {}, strong {}, not a hash {}", crypto.password_outdated(weak), crypto.password_outdated(strong), crypto.password_outdated("x")));
}
