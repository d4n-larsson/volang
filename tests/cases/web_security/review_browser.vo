# Reviewing browser sign-in (spec 052, story 5): review names the browser way with its paths, lifetime
# and origin, a sign-in page nobody could reach, and a cookie sent over plain HTTP.
import std.bytes;
import std.http;
import std.option;
import std.security;
import std.web;

fn ran(n: int, input: web.NoInput) -> result[http.Response] {
    return ok(web.json_reply(200, "ran"));
}

fn the_browser(origin: str) -> security.Browser[int] {
    return new security.Browser {
        find_account: fn(n: int, name: str) -> result[option.Option[security.Account]] {
            return ok(option.Option.none);
        },
        keep: fn(n: int, s: security.Session) -> result[void] {
            return ok();
        },
        find: fn(n: int, key: str) -> result[option.Option[security.Session]] {
            return ok(option.Option.none);
        },
        end: fn(n: int, key: str) -> result[void] {
            return ok();
        },
        random: fn(k: int) -> bytes {
            return bytes.from_text("0123456789abcdef");
        },
        sign_in: "/sign-in",
        sign_out: "/sign-out",
        lifetime_ms: 1800000,
        origin: origin
    };
}

fn show(title: str, rules: list[security.Rule], ways: list[security.Way[int]], b: security.Browser[int]) uses console {
    let routes = security.browser_routes(b, security.policy(rules, ways, fn() -> int { return 0; }));
    push(routes, web.on_get("/notes", ran));
    print(title + ":");
    for line in security.review(web.web_app(routes), security.policy(rules, ways, fn() -> int { return 0; })) {
        print("  " + line);
    }
}

fn main() uses console {
    let open = [security.rule("/sign-in", security.Access.anyone), security.rule("/sign-out", security.Access.anyone), security.rule("/", security.Access.signed_in)];
    let b = the_browser("");
    show("clean", open, [security.browser(b)], b);
    let proxied = the_browser("https://notes.example");
    show("behind a proxy", open, [security.browser(proxied)], proxied);
    let closed = [security.rule("/", security.Access.signed_in)];
    show("sign-in page needs a user", closed, [security.browser(b)], b);
    let plain = the_browser("http://localhost:8080");
    show("plain HTTP, and test_users", open, [security.browser(plain), security.test_users()], plain);
}
