# safe_headers (std.security, story 5): the headers a security scan asks for on every answer, the
# operation's own values kept; and the order of steps with cors and the policy.
import std.http;
import std.security;
import std.web;

fn ran(n: int, input: web.NoInput) -> result[http.Response] {
    return ok(web.json_reply(200, "ran"));
}

fn cached(n: int, input: web.NoInput) -> result[http.Response] {
    let resp = web.json_reply(200, "cached");
    push(resp.headers, new http.Header { name: "cache-control", value: "max-age=60" });
    return ok(resp);
}

fn app(steps: list[web.Step[int]]) -> web.App[int] {
    let routes: list[web.Route[int]] = [web.on_get("/open", ran), web.on_get("/open/cached", cached), web.on_get("/notes", ran)];
    return new web.App { routes: routes, steps: steps, errors: new list[web.ErrorStatus] };
}

fn guard() -> web.Step[int] {
    return security.secure(security.policy([security.rule("/open", security.Access.anyone), security.rule("/", security.Access.signed_in)], new list[security.Way[int]], fn() => 0));
}

fn show(label: str, a: web.App[int], r: http.Request) uses console {
    let resp = web.handle_request(a, 0, r);
    var hs = "";
    for h in resp.headers {
        if h.name != "Content-Type" {
            set hs = hs + " [" + h.name + ": " + h.value + "]";
        }
    }
    print(label + " -> " + str(resp.status) + hs);
}

fn main() uses console {
    let a = app([security.safe_headers(0), guard()]);
    show("an answer", a, web.request("GET", "/open", ""));
    show("the operation's own Cache-Control", a, web.request("GET", "/open/cached", ""));
    show("a refusal", a, web.request("GET", "/notes", ""));
    show("no route", a, web.request("GET", "/open/nothing", ""));
    show("with transport security", app([security.safe_headers(31536000), guard()]), web.request("GET", "/open", ""));
    show("the policy first", app([guard(), security.safe_headers(0)]), web.request("GET", "/notes", ""));
    let preflight = web.with_header(web.with_header(web.request("OPTIONS", "/notes", ""), "Origin", "https://app.example"), "Access-Control-Request-Method", "GET");
    show("preflight, cors before the policy", app([web.cors(["https://app.example"]), guard()]), preflight);
    show("preflight, cors after the policy", app([guard(), web.cors(["https://app.example"])]), preflight);
}
