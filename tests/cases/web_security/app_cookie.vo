# An application's own cookies (spec 052, story 4): an operation reads one from the Cookie header it
# binds, sets one with the safe flags, removes it, and a value a cookie cannot hold is an error.
import std.http;
import std.option;
import std.web;

record Prefs {
    @header("Cookie")
    @default("")
    cookies: str;
}

record Choice {
    show_done: str;
}

fn shown(n: int, input: Prefs) -> result[http.Response] {
    match web.read_cookie(input.cookies, "show_done") {
        case some(v) {
            return ok(web.json_reply(200, "show_done is " + v));
        }
        case none {
            return ok(web.json_reply(200, "no preference"));
        }
    }
}

fn choose(n: int, input: Choice) -> result[http.Response] {
    let c = web.cookie("show_done", input.show_done);
    if input.show_done == "" {
        set c.max_age_ms = 0;
    }
    return web.with_cookie(web.json_reply(200, "saved"), c);
}

fn app() -> web.App[int] {
    return web.web_app([web.on_get("/prefs", shown), web.on_post("/prefs", choose)]);
}

fn show(what: str, r: http.Response) uses console {
    var cookie_header = "-";
    for h in r.headers {
        if h.name == "Set-Cookie" {
            set cookie_header = h.value;
        }
    }
    print(what + ": " + str(r.status) + " " + r.body + " Set-Cookie=" + cookie_header);
}

fn form(body: str) -> http.Request {
    let r = web.with_header(web.request("POST", "/prefs", ""), "Content-Type", "application/x-www-form-urlencoded");
    set r.body = body;
    return r;
}

fn main() uses console {
    show("no cookie", web.handle_request(app(), 0, web.request("GET", "/prefs", "")));
    show("with the cookie", web.handle_request(app(), 0, web.with_header(web.request("GET", "/prefs", ""), "Cookie", "theme=dark; show_done=1")));
    show("set it", web.handle_request(app(), 0, form("show_done=1")));
    show("remove it", web.handle_request(app(), 0, form("show_done=")));
    show("a value a cookie cannot hold", web.handle_request(app(), 0, form("show_done=a+b")));
}
