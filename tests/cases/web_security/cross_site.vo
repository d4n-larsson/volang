# Other sites cannot act for a signed-in browser (spec 052, story 2): a state-changing request signed in
# by the session cookie must say it comes from the application (Sec-Fetch-Site, else Origin against Host
# or the origin the application set); it is refused with 403 before the operation runs otherwise. Reads,
# and requests signed in with a token, are not checked. Posting the sign-in form from elsewhere is
# refused too.
import std.bytes.from_ints;
import std.bytes.from_text;
import std.http.Header;
import std.http.Request;
import std.http.Response;
import std.option.Option;
import std.security.Access;
import std.security.Account;
import std.security.Browser;
import std.security.Event;
import std.security.Policy;
import std.security.Session;
import std.security.User;
import std.security.browser;
import std.security.browser_routes;
import std.security.require_user;
import std.security.rule;
import std.security.issue_token;
import std.security.secure;
import std.security.tokens;
import std.web.App;
import std.web.ErrorStatus;
import std.web.Route;
import std.web.json_reply;
import std.web.handle_request;
import std.web.on_get;
import std.web.on_post;
import std.web.read_cookie;
import std.web.request;

const weak = "pbkdf2-sha256$1$c2FsdA==$VawEblbjCJ/sFpHCJUS2BflBhSFt3gRl5oudV8INrLw=";
const strong = "pbkdf2-sha256$600000$UzaawpluQd/9+wjqxK7k5g==$T77DFP1a//H/wGSMrDAzacBRzngTQcTM4Nma4jsUNWw=";

record Store {
    sessions: map[str, Session];
    events: list[str];
    now: int;
    drawn: int;
    done: list[str];
    origin: str;
}

record Who {
    @header("X-Identity")
    @default("")
    identity: str;
}

fn find_account(st: Store, name: str) -> result[Option[Account]] {
    if name == "ada" {
        return ok(Option.some(new Account { name: "ada", password_hash: weak, roles: ["admin"], enabled: true }));
    }
    if name == "old" {
        return ok(Option.some(new Account { name: "old", password_hash: weak, roles: new list[str], enabled: false }));
    }
    if name == "col" {
        return ok(Option.some(new Account { name: "col", password_hash: strong, roles: new list[str], enabled: true }));
    }
    return ok(Option.none);
}

fn the_browser(st: Store) -> Browser[Store] {
    return new Browser {
        find_account: find_account,
        keep: fn(s: Store, x: Session) -> result[void] {
            set s.sessions[x.key] = x;
            return ok();
        },
        find: fn(s: Store, key: str) -> result[Option[Session]] {
            if has(s.sessions, key) {
                return ok(Option.some(s.sessions[key]));
            }
            return ok(Option.none);
        },
        end: fn(s: Store, key: str) -> result[void] {
            remove(s.sessions, key);
            return ok();
        },
        random: fn(n: int) -> bytes {
            set st.drawn = st.drawn + 1;
            let xs = new list[int];
            for i in 0..n {
                push(xs, (st.drawn * 16 + i) % 256);
            }
            return from_ints(xs);
        },
        sign_in: "/sign-in",
        sign_out: "/sign-out",
        lifetime_s: 3600,
        origin: st.origin
    };
}

record Done {
    id: int;
    @header("X-Identity")
    @default("")
    identity: str;
}

fn done(st: Store, input: Done) -> result[Response] {
    let user = try require_user(input.identity);
    push(st.done, user.name + " " + str(input.id));
    return ok(json_reply(200, "done"));
}

fn signing_key() -> bytes {
    return from_text("0123456789abcdef0123456789abcdef");
}

fn notes(st: Store, input: Who) -> result[Response] {
    let user = try require_user(input.identity);
    return ok(json_reply(200, "notes of " + user.name));
}

fn app(st: Store) -> App[Store] {
    let b = the_browser(st);
    let p = new Policy {
        rules: [
            rule("/sign-in", Access.anyone),
            rule("/sign-out", Access.anyone),
            rule("/notes", Access.signed_in),
            rule("/api", Access.signed_in)
        ],
        ways: [browser(b), tokens([signing_key()])],
        now: fn() -> int {
            return st.now;
        },
        on_event: fn(s: Store, e: Event) {
            push(s.events, e.kind + " " + e.name + " (" + e.reason + ")");
        }
    };
    let routes = browser_routes(b, p);
    push(routes, on_get("/notes", notes));
    push(routes, on_get("/api/notes", notes));
    push(routes, on_post("/notes/{id}/done", done));
    return new App { routes: routes, steps: [secure(p)], errors: new list[ErrorStatus] };
}

fn send(st: Store, r: Request, headers: list[Header]) -> Response {
    for h in headers {
        push(r.headers, h);
    }
    return handle_request(app(st), st, r);
}

fn form(body: str, cookie: str) -> list[Header] {
    let hs = [
        new Header { name: "Content-Type", value: "application/x-www-form-urlencoded" },
        new Header { name: "Sec-Fetch-Site", value: "same-origin" }
    ];
    if cookie != "" {
        push(hs, new Header { name: "Cookie", value: "__Host-session=" + cookie });
    }
    return hs;
}

fn page_of(cookie: str) -> list[Header] {
    let hs = [new Header { name: "Accept", value: "text/html,application/xhtml+xml" }];
    if cookie != "" {
        push(hs, new Header { name: "Cookie", value: "__Host-session=" + cookie });
    }
    return hs;
}

fn header(r: Response, name: str) -> str {
    for h in r.headers {
        if h.name == name {
            return h.value;
        }
    }
    return "-";
}

fn show(what: str, r: Response) uses console {
    print(what + ": " + str(r.status) + " Location=" + header(r, "Location") + " Set-Cookie=" + header(r, "Set-Cookie"));
    if r.body != "" {
        print("  " + r.body);
    }
}

fn post(path: str, body: str) -> Request {
    let r = request("POST", path, "");
    set r.body = body;
    return r;
}

fn cookie_of(r: Response) -> str {
    let set_cookie = header(r, "Set-Cookie");
    match read_cookie(set_cookie, "__Host-session") {
        case some(v) {
            return v;
        }
        case none {
            return "";
        }
    }
}

fn with(cookie: str, name: str, value: str) -> list[Header] {
    let hs = [new Header { name: "Cookie", value: "__Host-session=" + cookie }];
    if name != "" {
        push(hs, new Header { name: name, value: value });
    }
    return hs;
}

fn main() uses console {
    let st = new Store { sessions: new map[str, Session], events: new list[str], now: 1000000, drawn: 0, done: new list[str], origin: "" };
    let c = cookie_of(send(st, post("/sign-in", "name=ada&password=passwd"), form("", "")));
    set st.events = new list[str];
    show("cross-site", send(st, request("POST", "/notes/1/done", ""), with(c, "Sec-Fetch-Site", "cross-site")));
    show("same-site", send(st, request("POST", "/notes/2/done", ""), with(c, "Sec-Fetch-Site", "same-site")));
    show("same-origin", send(st, request("POST", "/notes/3/done", ""), with(c, "Sec-Fetch-Site", "same-origin")));
    let other = with(c, "Origin", "https://evil.example");
    push(other, new Header { name: "Host", value: "notes.example" });
    show("Origin of another site", send(st, request("POST", "/notes/4/done", ""), other));
    let port = with(c, "Origin", "http://notes.example:9090");
    push(port, new Header { name: "Host", value: "notes.example:8080" });
    show("Origin of another port", send(st, request("POST", "/notes/5/done", ""), port));
    let same = with(c, "Origin", "http://notes.example:8080");
    push(same, new Header { name: "Host", value: "notes.example:8080" });
    show("Origin of the Host", send(st, request("POST", "/notes/6/done", ""), same));
    show("neither header", send(st, request("POST", "/notes/7/done", ""), with(c, "", "")));
    show("a read from another site", send(st, request("GET", "/notes", ""), with(c, "Sec-Fetch-Site", "cross-site")));
    let token = "Bearer " + or_empty(issue_token(signing_key(), new User { name: "svc", roles: new list[str] }, st.now, 600));
    show("a token from anywhere", send(st, request("POST", "/notes/8/done", ""), [new Header { name: "Authorization", value: token }, new Header { name: "Sec-Fetch-Site", value: "cross-site" }]));
    show("sign-in form from another site", send(st, post("/sign-in", "name=ada&password=passwd"), [new Header { name: "Content-Type", value: "application/x-www-form-urlencoded" }, new Header { name: "Sec-Fetch-Site", value: "cross-site" }]));
    show("sign-in form with neither header", send(st, post("/sign-in", "name=ada&password=passwd"), [new Header { name: "Content-Type", value: "application/x-www-form-urlencoded" }]));
    set st.origin = "https://notes.example";
    let proxied = with(c, "Origin", "https://notes.example");
    push(proxied, new Header { name: "Host", value: "127.0.0.1:8080" });
    show("behind a proxy, the public origin", send(st, request("POST", "/notes/9/done", ""), proxied));
    let inner = with(c, "Origin", "http://127.0.0.1:8080");
    push(inner, new Header { name: "Host", value: "127.0.0.1:8080" });
    show("behind a proxy, the inner origin", send(st, request("POST", "/notes/10/done", ""), inner));
    print("operations run: " + join(st.done, ", "));
    for e in st.events {
        print("event: " + e);
    }
}

fn or_empty(r: result[str]) -> str {
    match r {
        case ok(t) {
            return t;
        }
        case err(_) {
            return "";
        }
    }
}
