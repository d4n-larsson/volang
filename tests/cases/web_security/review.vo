# Reviewing a policy without a server (std.security, story 4): describe gives who may call each
# route; review lists routes without a rule, rules that decide for no route or for only some requests
# of one, rules nobody can satisfy, and the way of signing in meant for tests.
import std.bytes;
import std.http;
import std.security;
import std.web;

record Id {
    id: str;
}

fn ran(n: int, input: web.NoInput) -> result[http.Response] {
    return ok(web.json_reply(200, "ran"));
}

fn one(n: int, input: Id) -> result[http.Response] {
    return ok(web.json_reply(200, input.id));
}

fn app() -> web.App[int] {
    let routes: list[web.Route[int]] = [
        web.on_get("/health", ran),
        web.on_get("/notes", ran),
        web.on_post("/notes", ran),
        web.on_get("/notes/{id}", one),
        web.on_delete("/notes/{id}", one),
        web.on_get("/admin/users", ran),
        web.on_get("/reports", ran)
    ];
    return web.web_app(routes);
}

fn show(label: str, rules: list[security.Rule], ways: list[security.Way[int]]) uses console {
    print(label + ":");
    print(security.describe(app(), rules));
    let found = security.review(app(), security.policy(rules, ways, fn() -> int { return 0; }));
    if len(found) == 0 {
        print("  nothing to review");
    }
    for f in found {
        print("  " + f);
    }
}

fn main() uses console {
    let real: list[security.Way[int]] = [security.tokens([bytes.from_text("0123456789abcdef0123456789abcdef")])];
    let clean = [
        security.rule("/health", security.Access.anyone),
        security.rule_for(["GET"], "/notes", security.Access.signed_in),
        security.rule("/notes", security.Access.any_role(["editor", "admin"])),
        security.rule("/admin", security.Access.any_role(["admin"])),
        security.rule("/reports", security.Access.nobody)
    ];
    show("clean", clean, real);
    # A misspelt path, a route without a rule (/reports; /admin/users falls to the last rule), a rule
    # hidden behind an earlier one, and the way for tests.
    let faulty = [
        security.rule("/health", security.Access.anyone),
        security.rule("/notes", security.Access.signed_in),
        security.rule_for(["DELETE"], "/notes/{id}", security.Access.any_role(["admin"])),
        security.rule("/admn", security.Access.any_role(["admin"])),
        security.rule("/admin", security.Access.signed_in)
    ];
    show("faulty", faulty, [security.tokens([bytes.from_text("0123456789abcdef0123456789abcdef")]), security.test_users()]);
    # A literal where the route has a variable: /notes/new is some requests of GET /notes/{id}.
    show("partial", [security.rule("/notes/new", security.Access.anyone), security.rule("/", security.Access.signed_in)], real);
    show("no way of signing in", clean, new list[security.Way[int]]);
    show("no rules", new list[security.Rule], real);
}
