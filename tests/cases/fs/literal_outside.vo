# Spec 017: a literal path outside the file.read scope is E0503 at check time, for each std.fs reader.
import std.fs;

fn main() -> result[void] uses console, file.read("data/") {
    let a = try fs.list_dir("secrets");
    let b = try fs.info("secrets/key");
    let c = try fs.walk("data/sub");
    print(str(len(a)) + str(len(c)));
    match b {
        case missing {
            print("missing");
        }
        case file(_) {
        }
        case directory {
        }
        case other {
        }
    }
    return ok();
}
