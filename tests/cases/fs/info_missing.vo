# Spec 017: `info` reports a missing path as a value, not an error.
import std.fs.info;

fn main() -> result[void] uses console, file.read("./") {
    match try info("none.txt") {
        case missing {
            print("missing");
        }
        case file(size) {
            print("file " + str(size));
        }
        case directory {
            print("directory");
        }
        case other {
            print("other");
        }
    }
    return ok();
}
