# Each task has its own random sequence, fixed by --seed; the caller's sequence is untouched.
fn draw(i: int) -> str uses random {
    return str(i) + ": " + str(random_int(1, 1000000)) + " " + str(random_int(1, 1000000));
}

fn main() uses console, random {
    for line in new list[str] {
        print(line);
    }
    print("caller: " + str(random_int(1, 1000000)));
}
