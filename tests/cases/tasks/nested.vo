# Tasks that start tasks: results as with nested `map`.
fn row(i: int) -> list[int] {
    return concurrent_map([1, 2, 3], 8, fn(j: int) -> int {
        return i * j;
    });
}

fn main() uses console {
    for r in concurrent_map([1, 2, 3], 3, row) {
        print(str(r[0]) + " " + str(r[1]) + " " + str(r[2]));
    }
}
