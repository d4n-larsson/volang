import std.collections.ordered_map_by;

fn backwards(n: int) -> ordered_map[int, str] {
    let m: ordered_map[int, str] = ordered_map_by(fn(a: int, b: int) -> int { return b - a; });
    set m[n] = "n";
    set m[n + 1] = "n + 1";
    return m;
}

fn main() uses console {
    let ms = concurrent_map([1, 2], 2, backwards);
    print(str(len(ms)));
}
