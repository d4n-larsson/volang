# An `err` result is not a failure: the caller gets every result, in order.
fn check(i: int) -> result[int] {
    if i % 2 == 1 {
        return err("odd " + str(i));
    }
    return ok(i * 10);
}

fn main() uses console {
    for r in concurrent_map([0, 1, 2, 3], 2, check) {
        match r {
            case ok(v) {
                print("ok " + str(v));
            }
            case err(e) {
                print("err " + e);
            }
        }
    }
}
