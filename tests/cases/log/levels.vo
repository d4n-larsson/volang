# Spec 055 US1: `--log-level warn` writes only warn and error records (stderr, one line each).
import std.log;

fn main() uses log {
    log.log_debug("d", new list[log.Field]);
    log.log_info("i", new list[log.Field]);
    log.log_warn("w", new list[log.Field]);
    log.log_error("e", new list[log.Field]);
}
