# Spec 055 (FR-008): log_requests still writes its text line, byte for byte as before.
import std.web;

test "the text line" {
    let lines = new list[str];
    let app = new web.App[int] {
        routes: new list[web.Route[int]],
        steps: [web.log_requests(fn() -> int { return 0; }, fn(line: str) { push(lines, line); })],
        errors: new list[web.ErrorStatus]
    };
    let resp = web.handle_request(app, 0, web.request("GET", "/x", ""));
    expect_eq(resp.status, 404);
    expect_eq(lines, ["GET /x 404 0ms"]);
}
