# A std.web application recorded with workers and replayed in one process, the database gone: the same
# answers (spec 029 US6, FR-019).
import std.http;
import std.sqlite;
import std.web;

record Notes {
    db: sqlite.Database[uses file.read, file.write];
}

record NoteText {
    @size(1, 50)
    text: str;
}

record NewNote {
    body: NoteText;
}

record NoteId {
    id: int;
}

fn open_notes() -> result[Notes] uses file.read("data/"), file.write("data/") {
    let db = try sqlite.open("data/notes.db");
    let _ = try sqlite.exec(db, sqlite.sql("create table if not exists notes (id integer primary key, text text not null)"), new list[sqlite.Value]);
    return ok(new Notes { db: db });
}

fn add(app: Notes, input: NewNote) -> result[http.Response] uses file.read("data/"), file.write("data/") {
    let c = try sqlite.exec(app.db, sqlite.sql("insert into notes (text) values (?)"), [sqlite.Value.text(input.body.text)]);
    return ok(web.created("/notes/" + str(c.last_id), c.last_id));
}

fn show(app: Notes, input: NoteId) -> result[http.Response] uses file.read("data/"), file.write("data/") {
    let rows = try sqlite.query(app.db, sqlite.sql("select text from notes where id = ?"), [sqlite.Value.integer(input.id)]);
    if len(rows) == 0 {
        return err("not_found: no note " + str(input.id));
    }
    return ok(web.json_reply(200, try sqlite.text_column(rows[0], "text")));
}

fn db_alive(app: Notes) -> result[void] uses file.read("data/"), file.write("data/") {
    let _ = try sqlite.query(app.db, sqlite.sql("select 1"), new list[sqlite.Value]);
    return ok();
}

fn routes() -> list[web.Route[Notes, uses file.read, file.write]] {
    return [web.on_post("/notes", add), web.on_get("/notes/{id}", show), web.health_route([new web.HealthCheck { name: "database", check: db_alive }])];
}

fn main() -> result[void] uses console, file.read("data/"), file.write("data/"), serve("{vport}") {
    print("serving");
    try web.serve_app("{vport}", 2, open_notes, new web.App { routes: routes(), steps: new list[web.Step[Notes, uses file.read, file.write]], errors: new list[web.ErrorStatus] });
    print("stopped");
    return ok();
}
