# Spec 062 (US2, AC 1; research P1): a function passed to g reads what the caller may read, outside g's own scope.
fn rd(p: str) -> str uses file.read {
    match read_file(p) {
        case ok(s) {
            return trim(s);
        }
        case err(_) {
            return "err";
        }
    }
}

fn apply[E: effects](f: fn() -> str uses E) -> str uses E {
    return f();
}

fn outside() -> str {
    return "b/y.txt";
}

fn g[E: effects](p: str, f: fn() -> str uses E) -> str uses E, file.read("a/") {
    return rd(p) + " " + f();
}

fn main() uses console, file.read("a/"), file.read("b/") {
    print(g("a/x.txt", fn() => rd(outside())));
}
