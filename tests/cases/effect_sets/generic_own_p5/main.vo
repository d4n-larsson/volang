# Spec 062 (research P5): g's own wrapper around the callback, called directly.
fn rd(p: str) -> str uses file.read {
    match read_file(p) {
        case ok(s) {
            return trim(s);
        }
        case err(_) {
            return "err";
        }
    }
}

fn apply[E: effects](f: fn() -> str uses E) -> str uses E {
    return f();
}

fn outside() -> str {
    return "b/y.txt";
}

fn g[E: effects](p: str, f: fn() -> str uses E) -> str uses E, file.read("a/") {
    let l = fn() => rd(p) + "+" + f();
    return l();
}

fn main() uses console, file.read("a/"), file.read("b/") {
    print(g("a/x.txt", fn() => rd(outside())));
}
