# Spec 062 (US1, AC 6): g (an effect parameter) and h (none) declare the same scope and are held to it alike.
fn rd(p: str) -> str uses file.read {
    match read_file(p) {
        case ok(s) {
            return trim(s);
        }
        case err(_) {
            return "err";
        }
    }
}

fn apply[E: effects](f: fn() -> str uses E) -> str uses E {
    return f();
}

fn outside() -> str {
    return "b/y.txt";
}

fn g[E: effects](p: str, f: fn() -> str uses E) -> str uses E, file.read("a/") {
    return rd(p) + " " + f();
}

fn h(p: str) -> str uses file.read("a/") {
    return rd(p);
}

fn main() uses console, file.read("a/"), file.read("b/") {
    print(g("a/x.txt", fn() => "-"));
    print(h("a/x.txt"));
    if len(args()) > 0 {
        print(h(outside()));
    }
    print(g(outside(), fn() => "-"));
}
