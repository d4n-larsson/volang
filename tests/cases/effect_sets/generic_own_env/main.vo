# Spec 062 (FR-008): the same rule for a scoped effect that is not a file.
fn rd(p: str) -> str uses file.read {
    match read_file(p) {
        case ok(s) {
            return trim(s);
        }
        case err(_) {
            return "err";
        }
    }
}

fn apply[E: effects](f: fn() -> str uses E) -> str uses E {
    return f();
}

fn outside() -> str {
    return "b/y.txt";
}

fn value_of(name: str) -> str uses env {
    match env(name) {
        case ok(v) {
            return v;
        }
        case err(_) {
            return "unset";
        }
    }
}

fn ge[E: effects](name: str, f: fn() -> str uses E) -> str uses E, env("VO_A") {
    return value_of(name) + " " + f();
}

fn other() -> str {
    return "VO_B";
}

fn main() uses console, env("VO_A"), env("VO_B") {
    print(ge("VO_A", fn() => value_of(other())));
    print(ge(other(), fn() => "-"));
}
