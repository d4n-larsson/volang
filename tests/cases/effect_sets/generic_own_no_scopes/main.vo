# Spec 062 (US2, AC 5): a generic function without scopes of its own is as before.
fn rd(p: str) -> str uses file.read {
    match read_file(p) {
        case ok(s) {
            return trim(s);
        }
        case err(_) {
            return "err";
        }
    }
}

fn apply[E: effects](f: fn() -> str uses E) -> str uses E {
    return f();
}

fn outside() -> str {
    return "b/y.txt";
}

fn only[E: effects](f: fn() -> str uses E) -> str uses E {
    return f();
}

fn wide[E: effects](p: str, f: fn() -> str uses E) -> str uses E, file.read {
    return rd(p) + " " + f();
}

fn main() uses console, file.read("a/"), file.read("b/") {
    print(only(fn() => rd(outside())));
    print(wide(outside(), fn() => rd(outside())));
    print(wide("secret.txt", fn() => "-"));
}
