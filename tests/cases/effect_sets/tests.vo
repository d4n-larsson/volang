# A test declares a set like any clause: it is that test's grant.
import std.fs.make_dir;

effects Storage = file.read("data/"), file.write("data/");

fn save(text: str) -> result[void] uses Storage {
    return write_file("data/t.txt", text);
}

test "saving in data/ works" uses Storage {
    expect(make_dir("data") == ok());
    expect(save("x") == ok());
}
