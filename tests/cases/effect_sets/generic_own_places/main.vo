# Spec 062 (FR-010): the same outcomes in a task, a test and a property.
fn rd(p: str) -> str uses file.read {
    match read_file(p) {
        case ok(s) {
            return trim(s);
        }
        case err(_) {
            return "err";
        }
    }
}

fn apply[E: effects](f: fn() -> str uses E) -> str uses E {
    return f();
}

fn outside() -> str {
    return "b/y.txt";
}

fn g[E: effects](p: str, f: fn() -> str uses E) -> str uses E, file.read("a/") {
    return rd(p) + " " + f();
}

fn in_task(p: str) -> str uses file.read("a/"), file.read("b/") {
    return g(p, fn() => rd(outside()));
}

test "a callback under g reads what the test may read" uses file.read("a/"), file.read("b/") {
    expect_eq(g("a/x.txt", fn() => rd(outside())), "inside other");
}

test "g's own code is held to its scope" uses file.read("a/"), file.read("b/") {
    expect_eq(g(outside(), fn() => "-"), "other -");
}

prop "g under a property" (n: int) uses file.read("a/"), file.read("b/") {
    expect_eq(g("a/x.txt", fn() => rd(outside())), "inside other");
}

fn main() uses console, file.read("a/"), file.read("b/") {
    print(join(concurrent_map(["a/x.txt", "a/w.txt"], 2, in_task), ","));
    print(join(concurrent_map([outside()], 1, in_task), ","));
}
