# Spec 062 (US2, AC 4): a value of a type that carries the effect parameter keeps the caller's grant.
fn rd(p: str) -> str uses file.read {
    match read_file(p) {
        case ok(s) {
            return trim(s);
        }
        case err(_) {
            return "err";
        }
    }
}

fn apply[E: effects](f: fn() -> str uses E) -> str uses E {
    return f();
}

fn outside() -> str {
    return "b/y.txt";
}

record Store[E: effects] {
    get: fn() -> str uses E;
}

fn through[E: effects](s: Store[E]) -> str uses E, file.read("a/") {
    return rd("a/x.txt") + " " + s.get();
}

fn main() uses console, file.read("a/"), file.read("b/") {
    print(through(new Store { get: fn() => rd(outside()) }));
}
