# A dotted IPv4 host needs no name lookup.
import std.http;

fn show(r: result[http.Response]) uses console {
    match r {
        case ok(resp) {
            print("status " + str(resp.status));
            for h in resp.headers {
                print("header " + h.name + ": " + h.value);
            }
            print("body (" + str(len(resp.body)) + "):");
            print(resp.body);
        }
        case err(e) {
            print("err " + e);
        }
    }
}

fn main() uses console, net("127.0.0.1") {
    let a = args();
    show(http.get("http://127.0.0.1:" + a[0] + "/plain"));
}
