# A JSON service: std.http with std.json.
import std.http;
import std.json;

fn main() -> result[void] uses console, net("localhost") {
    let resp = try http.get("http://localhost:" + args()[0] + "/json");
    let doc = try json.parse_json(resp.body);
    print(try json.text_field(doc, "name") + " " + str(try json.int_field(doc, "version")));
    print(try json.as_text(try json.at(try json.member(doc, "tags"), 1)));
    return ok();
}
