# URLs that do not parse are refused before anything is sent (spec 019: https:// is now supported,
# so its forms here are malformed ones).
import std.http.Response;
import std.http.get;

fn show(r: result[Response]) uses console {
    match r {
        case ok(resp) {
            print("status " + str(resp.status));
            for h in resp.headers {
                print("header " + h.name + ": " + h.value);
            }
            print("body (" + str(len(resp.body)) + "):");
            print(resp.body);
        }
        case err(e) {
            print("err " + e);
        }
    }
}

fn main() uses console, net("localhost", "x") {
    show(get("https://"));
    show(get("HTTPS://user@x/"));
    show(get("ftp://localhost/"));
    show(get("http://"));
    show(get("http://x:99999/"));
    show(get("http://x:abc/"));
    show(get("http://user@x/"));
    show(get("localhost/plain"));
}
