# header() finds the first header with a name, ignoring case; a missing one is err.
import std.http.get;
import std.http.response_header;
import std.option.to_result;

fn show(r: result[str]) uses console {
    match r {
        case ok(v) {
            print("[" + v + "]");
        }
        case err(e) {
            print("err " + e);
        }
    }
}

fn main() -> result[void] uses console, net("localhost") {
    let resp = try get("http://localhost:" + args()[0] + "/headers");
    show(to_result(response_header(resp, "x-multi"), "no header `" + "x-multi" + "`"));
    show(to_result(response_header(resp, "X-MULTI"), "no header `" + "X-MULTI" + "`"));
    show(to_result(response_header(resp, "content-type"), "no header `" + "content-type" + "`"));
    show(to_result(response_header(resp, "x-spaces"), "no header `" + "x-spaces" + "`"));
    show(to_result(response_header(resp, "x-missing"), "no header `" + "x-missing" + "`"));
    print(str(len(resp.headers)) + " headers");
    return ok();
}
