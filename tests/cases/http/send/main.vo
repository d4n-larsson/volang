# send: any method, the caller's headers, a body, and a timeout of the request's own.
import std.http;

fn show(what: str, r: result[http.Response]) uses console {
    match r {
        case ok(resp) {
            print(what + ": status " + str(resp.status));
            print(resp.body);
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() uses console, net("localhost") {
    let base = "http://localhost:" + args()[0];
    let none = new list[http.Header];
    let auth = [
        new http.Header { name: "Authorization", value: "Bearer s3cret" },
        new http.Header { name: "Accept", value: "application/json" },
        new http.Header { name: "User-Agent", value: "ledger/1.0" }
    ];
    show("get", http.send("GET", base + "/inspect", auth, "", 0));
    show("put", http.send(
        "PUT",
        base + "/inspect",
        [new http.Header { name: "Content-Type", value: "application/json" }],
        "{\"n\": 1}",
        0
    ));
    show("delete", http.send("DELETE", base + "/inspect", none, "", 5000));
    show("patch, no body", http.send("PATCH", base + "/inspect", none, "", 0));
    show("timeout", http.send("GET", base + "/slow", none, "", 300));
    show("after a timeout", http.send("GET", base + "/plain", none, "", 0));
    show("line break in a value", http.send(
        "GET",
        base + "/inspect",
        [new http.Header { name: "X-A", value: "1\nX-B: 2" }],
        "",
        0
    ));
    show("bad name", http.send(
        "GET",
        base + "/inspect",
        [new http.Header { name: "X A", value: "1" }],
        "",
        0
    ));
    show("reserved", http.send(
        "POST",
        base + "/inspect",
        [new http.Header { name: "content-length", value: "0" }],
        "abc",
        0
    ));
    show("method", http.send("get", base + "/inspect", none, "", 0));
    show("head", http.send("HEAD", base + "/inspect", none, "", 0));
    show("url", http.send("GET", base + "/inspect HTTP/1.1\nX-B: 2", none, "", 0));
    show("negative", http.send("GET", base + "/inspect", none, "", -1));
}
