# Spec 055 US2: @allow("W0506", why) accepts the warning.
import std.log;

record Entry {
    key: str;
}

@allow("W0506", "the map entry's key, not a secret")
fn show(e: Entry) uses log {
    log.log_info("entry", [log.field("key", e.key)]);
}

fn main() uses log {
    show(new Entry { key: "k" });
}
