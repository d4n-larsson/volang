# A for with two variables goes over a map, a list or a deque; the names follow the usual rules.
fn main() uses console {
    let xs = [1, 2];
    let s = new ordered_set[int];
    let q = new priority_queue[int];
    for i, c in "abc" {
        print(str(i) + c);
    }
    for i, x in s {
        print(str(i + x));
    }
    for i, x in q {
        print(str(i + x));
    }
    for i, x in 7 {
        print(str(i));
    }
    for _, c in "abc" {
        print(c);
    }
    for x, x in xs {
        print(str(x));
    }
    for len_value, x in xs {
        print(str(x));
    }
    for i, x in xs {
        set i = 1;
        set x = 2;
    }
    for i, x in xs {
        print("unused");
    }
}
