import std.decimal;

fn with_fee(amount: decimal.Decimal, fee: decimal.Decimal) -> decimal.Decimal
    requires not decimal.is_negative(fee)
    ensures decimal.compare(ret, amount) >= 0 {
    return decimal.add(amount, fee);
}

fn main() uses console {
    print(str(with_fee(decimal.decimal(1000, 2), decimal.decimal(25, 2)).units));
}

prop "a split loses nothing" (units: int, n: int) {
    assume(n >= 1 and n <= 20);
    let amount = decimal.decimal(units, 2);
    match decimal.split_evenly(amount, n) {
        case ok(parts) {
            expect(decimal.equal(decimal.total(parts), amount));
            expect(len(parts) == n);
        }
        case err(m) {
            expect_eq(m, "");
        }
    }
}

prop "rounding to more places changes nothing" (units: int) {
    assume(units > -1000000000 and units < 1000000000);
    expect(decimal.equal(decimal.round_to(decimal.decimal(units, 2), 5, decimal.Rounding.down), decimal.decimal(units, 2)));
}
