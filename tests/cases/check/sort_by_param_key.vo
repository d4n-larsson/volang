# sort_by takes a key of an ordered type parameter, not of an unconstrained one; group_by needs a key
# that can be a map key.
import std.lists.group_by;

fn sorted_by[T, C: ordered](xs: list[T], key: fn(T) -> C) {
    sort_by(xs, key);
}

fn sorted_any[T, C](xs: list[T], key: fn(T) -> C) {
    sort_by(xs, key);
}

fn main() uses console {
    let words = ["pear", "fig"];
    sorted_by(words, fn(w: str) -> int { return len(w); });
    sorted_any(words, fn(w: str) -> int { return len(w); });
    let groups = group_by(words, fn(w: str) -> list[str] { return [w]; });
    print(str(len(groups)));
}
