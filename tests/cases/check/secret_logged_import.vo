# Spec 055 US2: W0506 on a call's only field, with Field not imported: the fix makes the list empty and adds
# the import (one edit, from the imports to the list).
import std.log.field;
import std.log.log_info;

fn reset(token: str) uses log {
    log_info("reset", [field("t", token)]);
}

fn main() uses log {
    reset("t");
}
