# Spec 055 US2: W0506's fix removes the field (with its comma); the only field becomes an empty list.
import std.log.Field;
import std.log.field;
import std.log.log_info;

record Form {
    user: str;
    password: str;
}

fn login(form: Form, token: str) uses log {
    log_info("login", [field("user", form.user), field("pw", form.password)]);
    log_info("token", [field("t", token)]);
}

fn main() uses log {
    login(new Form { user: "u", password: "p" }, "t");
}
