# Spec 055 US2: W0506's fix removes the field (with its comma); the only field becomes an empty list.
import std.log;

record Form {
    user: str;
    password: str;
}

fn login(form: Form, token: str) uses log {
    log.log_info("login", [log.field("user", form.user), log.field("pw", form.password)]);
    log.log_info("token", [log.field("t", token)]);
}

fn main() uses log {
    login(new Form { user: "u", password: "p" }, "t");
}
