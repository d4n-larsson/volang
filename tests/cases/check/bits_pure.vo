import std.bits;

fn is_power_of_two(n: int) -> bool
    requires bits.bit_and(n, 0) == 0 {
    return n > 0 and bits.bit_and(n, n - 1) == 0;
}

fn main() uses console {
    print(str(is_power_of_two(64)));
}

prop "a power of two has one bit" (n: int) {
    assume(n >= 0 and n < 63);
    expect(is_power_of_two(bits.shift_left(1, n)));
}
