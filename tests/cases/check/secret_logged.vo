# Spec 055 US2 (SC-005): a log field whose value is a variable, parameter or field access with a secret-like
# last name is W0506 at the value. Computed values, other names and literals are not.
import std.log;

record Form {
    user: str;
    password: str;
}

record Auth {
    session_id: str;
}

record Req {
    auth: Auth;
}

record User {
    name: str;
    author: str;
    api_key: str;
}

record Cfg {
    db_passwd: str;
}

record Headers {
    authorization: str;
    cookie: str;
}

record Opts {
    private_key: str;
}

fn hash(s: str) -> int {
    return len(s);
}

fn log_all(form: Form, token: str, u: User, req: Req, cfg: Cfg, x: Headers, opts: Opts, keyboard: str) uses log {
    let secret = "s3";
    log.log_info("1", [log.field("pw", form.password)]);
    log.log_info("2", [log.field("t", token)]);
    log.log_debug("3", [log.field("s", secret)]);
    log.log_warn("4", [log.field("k", u.api_key)]);
    log.log_error("5", [log.field("sid", req.auth.session_id)]);
    log.log_info("6", [log.field("db", cfg.db_passwd)]);
    log.log_info("7", [log.field("a", x.authorization)]);
    log.log_info("8", [log.field("c", x.cookie)]);
    log.log_info("9", [log.field("pk", opts.private_key)]);
    log.log_info("10", [log.field("user", form.user), log.field("pw", form.password)]);
    log.log_info("fine", [log.field("name", u.name), log.field("h", hash(form.password)), log.field("by", u.author), log.field("kb", keyboard), log.field("lit", "password")]);
}

fn main() uses log {
    log_all(new Form { user: "u", password: "p" }, "t", new User { name: "n", author: "a", api_key: "k" }, new Req { auth: new Auth { session_id: "s" } }, new Cfg { db_passwd: "d" }, new Headers { authorization: "a", cookie: "c" }, new Opts { private_key: "k" }, "q");
}
