# Spec 055 US2 (SC-005): a log field whose value is a variable, parameter or field access with a secret-like
# last name is W0506 at the value. Computed values, other names and literals are not.
import std.log.Field;
import std.log.field;
import std.log.log_debug;
import std.log.log_error;
import std.log.log_info;
import std.log.log_warn;

record Form {
    user: str;
    password: str;
}

record Auth {
    session_id: str;
}

record Req {
    auth: Auth;
}

record User {
    name: str;
    author: str;
    api_key: str;
}

record Cfg {
    db_passwd: str;
}

record Headers {
    authorization: str;
    cookie: str;
}

record Opts {
    private_key: str;
}

fn hash(s: str) -> int {
    return len(s);
}

fn log_all(form: Form, token: str, u: User, req: Req, cfg: Cfg, x: Headers, opts: Opts, keyboard: str) uses log {
    let secret = "s3";
    log_info("1", [field("pw", form.password)]);
    log_info("2", [field("t", token)]);
    log_debug("3", [field("s", secret)]);
    log_warn("4", [field("k", u.api_key)]);
    log_error("5", [field("sid", req.auth.session_id)]);
    log_info("6", [field("db", cfg.db_passwd)]);
    log_info("7", [field("a", x.authorization)]);
    log_info("8", [field("c", x.cookie)]);
    log_info("9", [field("pk", opts.private_key)]);
    log_info("10", [field("user", form.user), field("pw", form.password)]);
    log_info("fine", [field("name", u.name), field("h", hash(form.password)), field("by", u.author), field("kb", keyboard), field("lit", "password")]);
}

fn main() uses log {
    log_all(new Form { user: "u", password: "p" }, "t", new User { name: "n", author: "a", api_key: "k" }, new Req { auth: new Auth { session_id: "s" } }, new Cfg { db_passwd: "d" }, new Headers { authorization: "a", cookie: "c" }, new Opts { private_key: "k" }, "q");
}
