# Spec 017 (US2): appending adds to a file, and creates it when missing.
import std.fs.Entry;
import std.fs.Info;
import std.fs.append_file;
import std.fs.list_dir;

# Prints every entry below dir, depth first, with its kind.
fn tree(dir: str, indent: str) uses console, file.read("work/") {
    match list_dir(dir) {
        case ok(entries) {
            for e in entries {
                match e.info {
                    case directory {
                        print(indent + e.name + "/");
                        if not e.link {
                            tree(dir + "/" + e.name, indent + "  ");
                        }
                    }
                    case file(n) {
                        print(indent + e.name + " (" + str(n) + ")");
                    }
                    case missing {
                    }
                    case other {
                        print(indent + e.name + " (other)");
                    }
                }
            }
        }
        case err(e) {
            print(indent + dir + ": err " + e);
        }
    }
}

fn said(what: str, r: result[void]) uses console {
    match r {
        case ok() {
            print(what + ": ok");
        }
        case err(e) {
            print(what + ": err " + e);
        }
    }
}

fn main() uses console, file.read("work/"), file.write("work/") {
    said("append log", append_file("work/log.txt", "one\n"));
    said("append log", append_file("work/log.txt", "two\n"));
    said("append new", append_file("work/new.txt", "first\n"));
    said("append to a directory", append_file("work/sub", "x"));
    tree("work", "");
}
