# Spec 017 (US5): a run that looks at, lists, changes files and runs a program replays from its
# recording without touching any file or starting any program.
import std.fs;
import std.process;

fn kind(i: fs.Info) -> str {
    match i {
        case missing {
            return "missing";
        }
        case file(n) {
            return "file " + str(n);
        }
        case directory {
            return "directory";
        }
        case other {
            return "other";
        }
    }
}

fn main() -> result[void] uses console, file.read("work/"), file.write("work/"), file.delete("work/"), process("bin/args") {
    print("a.txt: " + kind(try fs.info("work/a.txt")));
    try fs.append_file("work/log.txt", "run\n");
    try fs.make_dir("work/sub");
    try fs.rename("work/a.txt", "work/sub/a.txt");
    match fs.delete("work/none") {
        case ok() {
            print("deleted");
        }
        case err(e) {
            print("delete: " + e);
        }
    }
    for e in try fs.list_dir("work") {
        print("  " + e.name + ": " + kind(e.info));
    }
    let out = try process.run("bin/args", ["x y", "z"]);
    write(out.stdout);
    print("code " + str(out.code));
    return ok();
}
