# Spec 017 (US4): a function that only wrote and now deletes fails the check: it gains file.delete.
import std.fs;

fn log(line: str) -> result[void] uses file.write("logs/"), file.delete("logs/") {
    match fs.delete("logs/old.txt") {
        case ok() {
        }
        case err(_) {
        }
    }
    try fs.append_file("logs/run.txt", line + "\n");
    return ok();
}

fn main() -> result[void] uses file.write("logs/"), file.delete("logs/") {
    try log("started");
    return ok();
}
