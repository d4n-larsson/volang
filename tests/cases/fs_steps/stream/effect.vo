import std.fs.each_line;

# The function passed prints: its caller must declare console.
fn show(path: str) uses file.read {
    match each_line(path, fn(line: str) -> result[bool] {
        print(line);
        return ok(true);
    }) {
        case ok() {
        }
        case err(_) {
        }
    }
}

fn main() uses console, file.read {
    show("data/lines.txt");
}
