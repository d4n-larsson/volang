# Spec 040: each_line and each_chunk read a file in pieces.
import std.fs;

record Seen {
    lines: list[str];
    sizes: list[int];
}

fn shown(line: str) -> str {
    var out = "";
    for i in 0..len(line) {
        let b = byte_at(line, i);
        if b == 13 {
            set out = out + "<CR>";
        } else if b == 0 {
            set out = out + "<NUL>";
        } else {
            set out = out + slice(line, i, i + 1);
        }
    }
    return "[" + out + "]";
}

fn lines_of(path: str, stop_at: str, fail_at: str) uses console, file.read("data/") {
    let seen = new Seen { lines: new list[str], sizes: new list[int] };
    let done = fs.each_line(path, fn(line) {
        if line == fail_at {
            return err("the function failed at " + line);
        }
        push(seen.lines, shown(line));
        return ok(line != stop_at);
    });
    var end = "ok";
    match done {
        case ok() {
        }
        case err(m) {
            set end = "err " + m;
        }
    }
    print(path + ": " + join(seen.lines, " ") + " -> " + end);
}

fn chunks_of(path: str, size: int) uses console, file.read("data/") {
    let seen = new Seen { lines: new list[str], sizes: new list[int] };
    let done = fs.each_chunk(path, size, fn(piece) {
        push(seen.sizes, len(piece));
        return ok(true);
    });
    var text = "";
    for n in seen.sizes {
        set text = text + " " + str(n);
    }
    match done {
        case ok() {
            print(path + " by " + str(size) + ":" + text + " -> ok");
        }
        case err(m) {
            print(path + " by " + str(size) + ":" + text + " -> err " + m);
        }
    }
}

fn nested() uses console, file.read("data/") {
    let seen = new Seen { lines: new list[str], sizes: new list[int] };
    let done = fs.each_line("data/two.txt", fn(outer) {
        try fs.each_line("data/two.txt", fn(inner) {
            push(seen.lines, outer + inner);
            return ok(true);
        });
        return ok(true);
    });
    match done {
        case ok() {
            print("nested: " + join(seen.lines, " "));
        }
        case err(m) {
            print("nested: err " + m);
        }
    }
}

fn growing() uses console, file.read("data/"), file.write("data/") {
    let seen = new Seen { lines: new list[str], sizes: new list[int] };
    let done = fs.each_line("data/grow.txt", fn(line) {
        push(seen.lines, line);
        if len(seen.lines) < 4 {
            try fs.append_file("data/grow.txt", "more\n");
        }
        return ok(true);
    });
    match done {
        case ok() {
            print("growing: " + str(len(seen.lines)) + " lines, no error");
        }
        case err(m) {
            print("growing: err " + m);
        }
    }
}

fn main() uses console, file.read("data/"), file.write("data/") {
    lines_of("data/lines.txt", "-", "-");
    lines_of("data/lines.txt", "three", "-");
    lines_of("data/lines.txt", "-", "three");
    lines_of("data/empty.txt", "-", "-");
    lines_of("data/bad.txt", "-", "-");
    lines_of("data/missing.txt", "-", "-");
    lines_of("data", "-", "-");
    lines_of("data/pipe", "-", "-");
    chunks_of("data/ten.txt", 5);
    chunks_of("data/ten.txt", 4);
    chunks_of("data/ten.txt", 100);
    chunks_of("data/empty.txt", 4);
    chunks_of("data/ten.txt", 0);
    chunks_of("data/ten.txt", 16777217);
    chunks_of("data/missing.txt", 4);
    chunks_of("data/pipe", 4);
    nested();
    growing();
}
