# CRC-32 (the zlib one) of each hex line of inputs.txt; with an argument, of big.bin, with its time.
import std.bits;
import std.bytes;
import std.fs;

fn make_table() -> list[int] {
    let table = new list[int];
    for i in 0..256 {
        var c = i;
        for _ in 0..8 {
            if bits.bit_and(c, 1) == 1 {
                set c = bits.bit_xor(0xEDB88320, bits.shift_right_logical(c, 1));
            } else {
                set c = bits.shift_right_logical(c, 1);
            }
        }
        push(table, c);
    }
    return table;
}

fn crc32(table: list[int], data: bytes) -> int {
    var c = 0xFFFFFFFF;
    for i in 0..len(data) {
        set c = bits.bit_xor(table[bits.bit_and(bits.bit_xor(c, data[i]), 0xFF)], bits.shift_right_logical(c, 8));
    }
    return bits.bit_xor(c, 0xFFFFFFFF);
}

fn main() -> result[void] uses console, file.read("./"), clock {
    let table = make_table();
    if len(args()) > 0 {
        let data = try fs.read_bytes("big.bin");
        let start = now_ms();
        let sum = crc32(table, data);
        print(str(sum) + " " + str(now_ms() - start));
        return ok();
    }
    try fs.each_line("inputs.txt", fn(line) {
        let data = try bytes.from_hex(line);
        print(str(crc32(table, data)));
        return ok(true);
    });
    return ok();
}
