# 64-bit FNV-1a of each hex line of inputs.txt; with an argument, of big.bin, with its time.
import std.bits;
import std.bytes;
import std.fs;

fn fnv1a(data: bytes) -> int {
    var h = 0xCBF29CE484222325;
    for i in 0..len(data) {
        set h = bits.wrapping_mul(bits.bit_xor(h, data[i]), 0x100000001B3);
    }
    return h;
}

fn main() -> result[void] uses console, file.read("./"), clock {
    if len(args()) > 0 {
        let data = try fs.read_bytes("big.bin");
        let start = now_ms();
        let sum = fnv1a(data);
        print(str(sum) + " " + str(now_ms() - start));
        return ok();
    }
    try fs.each_line("inputs.txt", fn(line) {
        let data = try bytes.from_hex(line);
        print(str(fnv1a(data)));
        return ok(true);
    });
    return ok();
}
