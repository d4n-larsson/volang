# SHA-256 of each hex line of inputs.txt, written with std.bits and compared with std.crypto's.
import std.bits;
import std.bytes;
import std.crypto;
import std.fs;

const word = 0xFFFFFFFF;

fn rotr(x: int, n: int) -> int {
    return bits.bit_or(bits.shift_right_logical(x, n), bits.bit_and(bits.shift_left(x, 32 - n), word));
}

fn xor3(a: int, b: int, c: int) -> int {
    return bits.bit_xor(bits.bit_xor(a, b), c);
}

fn round_constants() -> list[int] {
    return [
        0x428A2F98,
        0x71374491,
        0xB5C0FBCF,
        0xE9B5DBA5,
        0x3956C25B,
        0x59F111F1,
        0x923F82A4,
        0xAB1C5ED5,
        0xD807AA98,
        0x12835B01,
        0x243185BE,
        0x550C7DC3,
        0x72BE5D74,
        0x80DEB1FE,
        0x9BDC06A7,
        0xC19BF174,
        0xE49B69C1,
        0xEFBE4786,
        0x0FC19DC6,
        0x240CA1CC,
        0x2DE92C6F,
        0x4A7484AA,
        0x5CB0A9DC,
        0x76F988DA,
        0x983E5152,
        0xA831C66D,
        0xB00327C8,
        0xBF597FC7,
        0xC6E00BF3,
        0xD5A79147,
        0x06CA6351,
        0x14292967,
        0x27B70A85,
        0x2E1B2138,
        0x4D2C6DFC,
        0x53380D13,
        0x650A7354,
        0x766A0ABB,
        0x81C2C92E,
        0x92722C85,
        0xA2BFE8A1,
        0xA81A664B,
        0xC24B8B70,
        0xC76C51A3,
        0xD192E819,
        0xD6990624,
        0xF40E3585,
        0x106AA070,
        0x19A4C116,
        0x1E376C08,
        0x2748774C,
        0x34B0BCB5,
        0x391C0CB3,
        0x4ED8AA4A,
        0x5B9CCA4F,
        0x682E6FF3,
        0x748F82EE,
        0x78A5636F,
        0x84C87814,
        0x8CC70208,
        0x90BEFFFA,
        0xA4506CEB,
        0xBEF9A3F7,
        0xC67178F2
    ];
}

fn padded(data: bytes) -> list[int] {
    let m = bytes.to_ints(data);
    push(m, 0x80);
    while len(m) % 64 != 56 {
        push(m, 0);
    }
    let bit_count = len(data) * 8;
    for i in 0..8 {
        push(m, bits.bit_and(bits.shift_right_logical(bit_count, 56 - 8 * i), 0xFF));
    }
    return m;
}

fn schedule(m: list[int], at: int) -> list[int] {
    let w = new list[int];
    for i in 0..16 {
        let p = at + 4 * i;
        push(w, bits.bit_or(bits.bit_or(bits.shift_left(m[p], 24), bits.shift_left(m[p + 1], 16)), bits.bit_or(
            bits.shift_left(m[p + 2], 8),
            m[p + 3]
        )));
    }
    for i in 16..64 {
        let s0 = xor3(rotr(w[i - 15], 7), rotr(w[i - 15], 18), bits.shift_right_logical(w[i - 15], 3));
        let s1 = xor3(rotr(w[i - 2], 17), rotr(w[i - 2], 19), bits.shift_right_logical(w[i - 2], 10));
        push(w, bits.bit_and(w[i - 16] + s0 + w[i - 7] + s1, word));
    }
    return w;
}

fn compress(h: list[int], w: list[int], k: list[int]) {
    let v = slice(h, 0, 8);
    for i in 0..64 {
        let s1 = xor3(rotr(v[4], 6), rotr(v[4], 11), rotr(v[4], 25));
        let ch = bits.bit_xor(bits.bit_and(v[4], v[5]), bits.bit_and(bits.bit_and(bits.bit_not(v[4]), word), v[6]));
        let t1 = v[7] + s1 + ch + k[i] + w[i];
        let s0 = xor3(rotr(v[0], 2), rotr(v[0], 13), rotr(v[0], 22));
        let maj = xor3(bits.bit_and(v[0], v[1]), bits.bit_and(v[0], v[2]), bits.bit_and(v[1], v[2]));
        set v[7] = v[6];
        set v[6] = v[5];
        set v[5] = v[4];
        set v[4] = bits.bit_and(v[3] + t1, word);
        set v[3] = v[2];
        set v[2] = v[1];
        set v[1] = v[0];
        set v[0] = bits.bit_and(t1 + s0 + maj, word);
    }
    for i in 0..8 {
        set h[i] = bits.bit_and(h[i] + v[i], word);
    }
}

fn digest(data: bytes) -> bytes {
    let k = round_constants();
    let h = [
        0x6A09E667,
        0xBB67AE85,
        0x3C6EF372,
        0xA54FF53A,
        0x510E527F,
        0x9B05688C,
        0x1F83D9AB,
        0x5BE0CD19
    ];
    let m = padded(data);
    var at = 0;
    while at < len(m) {
        compress(h, schedule(m, at), k);
        set at = at + 64;
    }
    let out = new list[int];
    for x in h {
        for i in 0..4 {
            push(out, bits.bit_and(bits.shift_right_logical(x, 24 - 8 * i), 0xFF));
        }
    }
    return bytes.from_ints(out);
}

fn main() -> result[void] uses console, file.read("./") {
    try fs.each_line("inputs.txt", fn(line) {
        let data = try bytes.from_hex(line);
        let mine = digest(data);
        if mine == crypto.sha256(data) {
            print(bytes.to_hex(mine));
        } else {
            print("differs from std.crypto: " + bytes.to_hex(mine));
        }
        return ok(true);
    });
    return ok();
}
