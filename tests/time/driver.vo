# tests/time_check.py's driver: for each line of stdin (milliseconds since the epoch), prints the
# calendar fields from from_ms, format_time, parse_time of that text and to_ms of the fields.
import std.time;

fn back(r: result[int]) -> str {
    match r {
        case ok(v) {
            return str(v);
        }
        case err(e) {
            return "err " + e;
        }
    }
}

fn main() -> result[void] uses console, input {
    for line in split(read_all(), "\n") {
        if line == "" {
            continue;
        }
        let ms = try parse_int(line);
        let d = time.from_ms(ms);
        let text = time.format_time(ms);
        print(str(d.year) + " " + str(d.month) + " " + str(d.day) + " " + str(d.hour) + " " + str(d.minute) + " " + str(d.second) + " " + str(d.ms) + " " + str(d.weekday) + " " + text + " " + back(time.parse_time(text)) + " " + back(time.to_ms(d)));
    }
    return ok();
}
