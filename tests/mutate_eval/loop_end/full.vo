# Mutation fixture: the same, with the exact count tested.
fn count_below(n: int) -> int {
    var c = 0;
    var i = 1;
    while i < n {
        set c = c + 1;
        set i = i + 1;
    }
    return c;
}

test "counts something" {
    expect(count_below(5) > 0);
}

test "four below five" {
    expect_eq(count_below(5), 4);
}
