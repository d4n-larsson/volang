# SC-001: 260,000 closures, each capturing a record that holds a 500-element list.
record Box {
    items: list[int];
    tag: int;
}

fn make(b: Box) -> fn(int) -> int {
    return fn(x: int) -> int {
        return x + b.tag % 100 + len(b.items) + b.items[1];
    };
}

fn main() uses console {
    let base = new list[int];
    for k in 0..500 {
        push(base, k);
    }
    var total = 0;
    for i in 0..260000 {
        let b = new Box { items: slice(base, i % 5, 495 + i % 5), tag: i };
        let f = make(b);
        set total = total + f(i % 3);
    }
    print(str(total));
}
