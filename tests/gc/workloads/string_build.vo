# SC-001: a 200,000-character string built from 10-character pieces, each step a new string (about
# 2 GB copied). Not `set s = s + ...`, which appends in place and leaves the collector nothing.
fn main() uses console {
    var s = "";
    for i in 0..20000 {
        let next = s + ("piece" + str(10000 + i % 90000));
        set s = next;
    }
    let parts = split(s, "piece");
    print(str(len(s)) + " " + str(len(parts)) + " " + parts[1] + " " + parts[20000]);
}
