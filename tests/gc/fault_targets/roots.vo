# Kept alive only by a builtin's C root (GC_ROOT, spec 008 R4): map's result list while the callback
# allocates.
fn main() uses console {
    let xs = new list[int];
    for i in 0..300 {
        push(xs, i);
    }
    let ys = map(xs, fn(x: int) -> str {
        return "v" + str(x * 2) + "-" + str(x);
    });
    print(ys[0] + " " + ys[299] + " " + str(len(ys)));
}
