import store;
import report;
import util;

fn main() -> result[void] uses console, file.write("out/"), env("HOME") {
    let total = util.clamp(42, 0, 100);
    match env("HOME") {
        case ok(h) {
            print(h);
        }
        case err(e) {
            print(e);
        }
    }
    print(report.render(total));
    try store.save_total(total);
    return ok();
}

test "clamps" {
    expect_eq(util.clamp(500, 0, 100), 100);
}
