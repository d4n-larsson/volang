import store.save_total;
import report.render;
import util.clamp;

fn main() -> result[void] uses console, file.write("out/"), env("HOME") {
    let total = clamp(42, 0, 100);
    match env("HOME") {
        case ok(h) {
            print(h);
        }
        case err(e) {
            print(e);
        }
    }
    print(render(total));
    try save_total(total);
    return ok();
}

test "clamps" {
    expect_eq(clamp(500, 0, 100), 100);
}
