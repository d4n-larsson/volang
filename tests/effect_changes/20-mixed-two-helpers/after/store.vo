import report;

export fn save_total(n: int) -> result[void] uses file.write("out/") {
    return write_file("out/total.txt", report.render(n));
}

fn checksum(s: str) -> int uses file.read("data/") {
    match read_file("data/" + s) {
        case ok(t) {
            return len(t);
        }
        case err(e) {
            return len(e) * 0;
        }
    }
}
