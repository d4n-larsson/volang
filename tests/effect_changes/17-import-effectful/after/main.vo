import store;
import report;
import util;

fn main() -> result[void] uses console, file.write("out/"), clock {
    let total = util.clamp(42, 0, 100);
    print(report.render(total + report.stamp() * 0));
    try store.save_total(total);
    return ok();
}

test "clamps" {
    expect_eq(util.clamp(500, 0, 100), 100);
}
