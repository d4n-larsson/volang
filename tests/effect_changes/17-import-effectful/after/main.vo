import store.save_total;
import report.render;
import util.clamp;
import report.stamp;

fn main() -> result[void] uses console, file.write("out/"), clock {
    let total = clamp(42, 0, 100);
    print(render(total + stamp() * 0));
    try save_total(total);
    return ok();
}

test "clamps" {
    expect_eq(clamp(500, 0, 100), 100);
}
