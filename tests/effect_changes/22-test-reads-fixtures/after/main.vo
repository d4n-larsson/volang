import store;
import report;
import util;

fn main() -> result[void] uses console, file.write("out/") {
    let total = util.clamp(42, 0, 100);
    print(report.render(total));
    try store.save_total(total);
    return ok();
}

test "clamps" uses file.read("fixtures/") {
    match read_file("fixtures/a.txt") {
        case ok(t) {
            expect_eq(len(t) >= 0, true);
        }
        case err(e) {
            expect_eq(len(e) > 0, true);
        }
    }
    expect_eq(util.clamp(500, 0, 100), 100);
}
