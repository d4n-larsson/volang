import report;
import util;

fn main() -> result[void] uses console, file.write("out/") {
    let total = util.clamp(42, 0, 100);
    print(report.render(total));
    try write_file("out/total.txt", report.render(total));
    return ok();
}

test "clamps" {
    expect_eq(util.clamp(500, 0, 100), 100);
}
