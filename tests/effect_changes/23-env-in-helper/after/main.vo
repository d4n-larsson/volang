import report;
import store;
import util;

fn main() -> result[void] uses console, file.write("out/"), env("LIMIT") {
    let total = util.clamp(42, 0, 100);
    print(report.render(total));
    try store.save_total(total);
    return ok();
}

test "clamps" uses env("LIMIT") {
    expect_eq(util.clamp(500, 0, 100), 100);
}
