record Entry {
    total: int;
    name: str;
}

fn better(a: Entry, b: Entry) -> bool {
    return a.total > b.total or (a.total == b.total and a.name < b.name);
}

# A binary heap with the best entry at index 0.
fn heap_push(h: list[Entry], e: Entry) {
    push(h, e);
    var i = len(h) - 1;
    while i > 0 and better(h[i], h[(i - 1) / 2]) {
        let p = (i - 1) / 2;
        let t = h[i];
        set h[i] = h[p];
        set h[p] = t;
        set i = p;
    }
}

fn heap_pop(h: list[Entry]) -> result[Entry] {
    let top = h[0];
    let last = try pop(h);
    if len(h) > 0 {
        set h[0] = last;
        var i = 0;
        while true {
            var b = i;
            let l = 2 * i + 1;
            if l < len(h) and better(h[l], h[b]) {
                set b = l;
            }
            if l + 1 < len(h) and better(h[l + 1], h[b]) {
                set b = l + 1;
            }
            if b == i {
                break;
            }
            let t = h[i];
            set h[i] = h[b];
            set h[b] = t;
            set i = b;
        }
    }
    return ok(top);
}

fn main() -> result[void] uses console, input {
    let totals = new map[str, int];
    # Every total a player had; the ones that are no longer current are dropped when they reach the top.
    let heap = new list[Entry];
    for line in split(read_all(), "\n") {
        let w = split(trim(line), " ");
        if w[0] == "score" {
            set totals[w[1]] = get_or(totals, w[1], 0) + try parse_int(w[2]);
            heap_push(heap, new Entry { total: totals[w[1]], name: w[1] });
        } else if w[0] == "top" {
            let k = try parse_int(w[1]);
            let best = new list[Entry];
            while len(best) < k and len(heap) > 0 {
                let e = try heap_pop(heap);
                if totals[e.name] == e.total {
                    push(best, e);
                }
            }
            let shown = new list[str];
            for e in best {
                heap_push(heap, e);
                push(shown, e.name + ":" + str(e.total));
            }
            if len(shown) == 0 {
                print("empty");
            } else {
                print(join(shown, " "));
            }
        }
    }
    return ok();
}
