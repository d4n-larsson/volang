fn main() -> result[void] uses console, input {
    let lines = split(read_all(), "\n");
    let first = split(trim(lines[0]), " ");
    let steps = new list[int];
    let heads = new list[int];
    for i in 0..try parse_int(first[0]) {
        let w = split(trim(lines[i + 1]), " ");
        push(heads, try parse_int(w[0]));
        push(steps, try parse_int(w[1]));
    }
    var checksum = 0;
    for j in 1..try parse_int(first[1]) + 1 {
        var s = 0;
        for i in 1..len(heads) {
            if heads[i] < heads[s] {
                set s = i;
            }
        }
        set checksum = (checksum + j * (heads[s] + s)) % 1000000007;
        if j <= 50 or j % 1000 == 0 {
            print(str(j) + " " + str(heads[s]) + " " + str(s));
        }
        set heads[s] = heads[s] + steps[s];
    }
    print("END " + str(checksum));
    return ok();
}
