import std.collections;
import std.option;
import std.text;

fn main() -> result[void] uses console, input {
    let xs = text.words(read_all());
    # low: the smaller half, largest first; high: the larger half, smallest first.
    let low: priority_queue[int] = collections.priority_queue_by(fn(a, b) => b - a);
    let high = new priority_queue[int];
    var checksum = 0;
    for i in 1..len(xs) {
        let x = try parse_int(xs[i]);
        if len(low) == 0 or x <= try option.to_result(collections.peek(low), "empty") {
            push(low, x);
        } else {
            push(high, x);
        }
        if len(low) > len(high) + 1 {
            push(high, try pop(low));
        } else if len(high) > len(low) {
            push(low, try pop(high));
        }
        let median = try option.to_result(collections.peek(low), "empty");
        set checksum = (checksum + i * (median + 1000000000)) % 1000000007;
        if i <= 50 or i % 1000 == 0 {
            print(str(i) + " " + str(median));
        }
    }
    print("END " + str(checksum));
    return ok();
}
