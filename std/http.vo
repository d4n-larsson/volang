# std.http: HTTP and HTTPS requests (needs net), and serving plain HTTP requests (needs serve).
# Part of the vo standard library (spec 007, serving spec 011, https spec 019). Import items one by one: `import std.http.NAME;`.
# The host is checked against the caller's net scope at run time, the address against its serve scope.
# ponytail: one request per connection (Connection: close), redirects returned, not followed; a
# server answers one request at a time.

import std.tcp.Conn;
import std.tcp.TcpError;
import std.tcp.close;
import std.tcp.connect;
import std.tcp.connect_tls;
import std.tcp.describe;
import std.tcp.read;
import std.tcp.read_exact;
import std.tcp.read_until;

# One response header, as received.
#     new Header { name: "a", value: "b" }.name is "a"
export record Header {
    # The header name, as received (compare with lower or header()).
    name: str;
    # The header value, without surrounding spaces.
    value: str;
}

# A response: the status code, the headers in their order, and the body.
#     new Response { status: 200, headers: new list[Header], body: "" }.status is 200
export record Response {
    # The HTTP status code, such as 200 or 404.
    status: int;
    # The headers in the order they were sent.
    headers: list[Header];
    # The body as text (UTF-8; get_bytes reads any body).
    body: str;
}

record Url {
    tls: bool;
    host: str;
    port: int;
    target: str;
}

@allow("W0702", "one module per import path: std.http is one file")
fn parse_url(url: str) -> result[Url] {
    for i in 0..len(url) {
        let b = byte_at(url, i);
        if b <= 32 or b >= 127 {
            return err(
                "bad URL: a space, a control character or a character outside ASCII at byte " + str(i)
            );
        }
    }
    var tls = false;
    var skip = 7;
    if len(url) >= 8 and lower(slice(url, 0, 8)) == "https://" {
        set tls = true;
        set skip = 8;
    } else if len(url) < 7 or lower(slice(url, 0, 7)) != "http://" {
        return err("not an http:// or https:// URL: " + url);
    }
    let rest = slice(url, skip, len(url));
    var cut = len(rest);
    for c in [find(rest, "/"), find(rest, "?"), find(rest, "#")] {
        if c >= 0 and c < cut {
            set cut = c;
        }
    }
    let authority = slice(rest, 0, cut);
    var target = slice(rest, cut, len(rest));
    let hash = find(target, "#");
    if hash >= 0 {
        set target = slice(target, 0, hash);
    }
    if target == "" or slice(target, 0, 1) != "/" {
        set target = "/" + target;
    }
    var host = authority;
    var port = 80;
    if tls {
        set port = 443;
    }
    let colon = find(authority, ":");
    if colon >= 0 {
        set host = slice(authority, 0, colon);
        match parse_int(slice(authority, colon + 1, len(authority))) {
            case ok(n) {
                set port = n;
            }
            case err(_) {
                return err("bad port in " + url);
            }
        }
    }
    if host == "" or port < 1 or port > 65535 or find(host, "@") >= 0 {
        return err("bad host in " + url);
    }
    return ok(new Url { tls: tls, host: lower(host), port: port, target: target });
}

# A response whose body is bytes (spec 021): the status code, the headers in their order, and the body.
#     new BytesResponse { status: 200, headers: new list[Header], body: from_text("") }.status is 200
export record BytesResponse {
    # The HTTP status code, such as 200 or 404.
    status: int;
    # The headers in the order they were sent.
    headers: list[Header];
    # The body, whatever its bytes.
    body: bytes;
}

fn exchange(
    method: str,
    url: str,
    headers: list[Header],
    body: str,
    timeout_ms: int,
    hint: str
) -> result[Response] uses net {
    let raw = try exchange_raw(method, url, headers, body, timeout_ms);
    let r = try parse_response(raw);
    return ok(new Response {
        status: r.status,
        headers: r.headers,
        body: try text_body(raw, hint)
    });
}

fn text_body(raw: str, hint: str) -> result[str] {
    # spec 021: the body of a raw message as text, checked (a str is always UTF-8).
    match __text_of_bytes(__bytes_of_text(__http_part(raw, 1))) {
        case ok(t) {
            return ok(t);
        }
        case err(e) {
            return err("the body is " + e + " (" + hint + " reads it)");
        }
    }
}

fn head_text(raw: str) -> result[str] {
    # spec 021: the head of a raw message as text, checked.
    match __text_of_bytes(__bytes_of_text(__http_part(raw, 0))) {
        case ok(t) {
            return ok(t);
        }
        case err(_) {
            return err("a header is not UTF-8");
        }
    }
}

fn exchange_raw(
    method: str,
    url: str,
    headers: list[Header],
    body: str,
    timeout_ms: int
) -> result[str] uses net {
    let u = try parse_url(url);
    let request = try request_text(method, u, headers, body);
    if timeout_ms < 0 {
        return err("bad timeout: " + str(timeout_ms) + " ms");
    }
    __http_timeout(timeout_ms);
    if u.tls {
        return __https_exchange(u.host, u.port, request);
    }
    return __http_exchange(u.host, u.port, request);
}

fn request_text(method: str, u: Url, headers: list[Header], body: str) -> result[str] {
    # The request as sent: the request line, Host, Connection, User-Agent, the caller's headers in
    # their order, Content-Length when there is a body or the method usually has one, then the body.
    try check_method(method);
    let nl = crlf();
    var agent = "vo";
    let lines = new list[str];
    for h in headers {
        try check_header(h);
        if lower(h.name) == "user-agent" {
            set agent = h.value;
        } else {
            push(lines, h.name + ": " + h.value + nl);
        }
    }
    var host = u.host;
    if (u.port != 80 and not u.tls) or (u.port != 443 and u.tls) {
        set host = host + ":" + str(u.port);
    }
    var length = "";
    if len(body) > 0 or method == "POST" or method == "PUT" or method == "PATCH" {
        set length = "Content-Length: " + str(len(body)) + nl;
    }
    return ok(
        method + " " + u.target + " HTTP/1.1" + nl + "Host: " + host + nl + "Connection: close" + nl + "User-Agent: " + agent + nl + join(lines, "") + length + nl + body
    );
}

fn check_method(method: str) -> result[void] {
    if method == "" {
        return err("bad method: empty");
    }
    for i in 0..len(method) {
        let b = byte_at(method, i);
        if b < 65 or b > 90 {
            return err("bad method `" + method + "`: capital letters only, as in `GET`");
        }
    }
    if method == "HEAD" or method == "CONNECT" {
        return err("method `" + method + "` is not supported");
    }
    return ok();
}

fn check_header(h: Header) -> result[void] {
    # A name of letters, digits, `-` and `_`; a value of visible ASCII and spaces: nothing that could
    # end the line and start another header.
    if h.name == "" {
        return err("bad header name: empty");
    }
    for i in 0..len(h.name) {
        let b = byte_at(h.name, i);
        let letter = (b >= 65 and b <= 90) or (b >= 97 and b <= 122);
        if not (letter or (b >= 48 and b <= 57) or b == 45 or b == 95) {
            return err("bad header name `" + h.name + "`: letters, digits, `-` and `_` only");
        }
    }
    for i in 0..len(h.value) {
        let b = byte_at(h.value, i);
        if b < 32 or b >= 127 {
            return err("bad value for header `" + h.name + "`: ASCII text on one line only");
        }
    }
    let name = lower(h.name);
    if name == "host" or name == "connection" or name == "content-length" or name == "transfer-encoding" {
        return err("header `" + h.name + "` is set by std.http");
    }
    return ok();
}

fn crlf() -> str {
    return chr(13) + "\n";
}

fn parse_response(raw: str) -> result[Response] {
    # raw: the response framed by the runtime (spec 013): a head, then the decoded body (any bytes; the
    # caller takes it as text or bytes). The body field is left empty here.
    return parse_head(split(try head_text(raw), crlf()));
}

fn parse_head(head: list[str]) -> result[Response] {
    # The status line and header lines of a response, as a Response with an empty body.
    let parts = split(head[0], " ");
    if len(parts) < 2 or len(parts[0]) < 5 or slice(parts[0], 0, 5) != "HTTP/" {
        return err("malformed response: bad status line");
    }
    var status = 0;
    match parse_int(parts[1]) {
        case ok(n) {
            set status = n;
        }
        case err(_) {
            return err("malformed response: bad status code");
        }
    }
    let headers = try parse_headers(head, "malformed response: bad header line");
    return ok(new Response { status: status, headers: headers, body: "" });
}

fn parse_headers(head: list[str], bad: str) -> result[list[Header]] {
    let headers = new list[Header];
    for i in 1..len(head) {
        let line = head[i];
        let colon = find(line, ":");
        if colon <= 0 {
            return err(bad);
        }
        push(headers, new Header {
            name: slice(line, 0, colon),
            value: trim(slice(line, colon + 1, len(line)))
        });
    }
    return ok(headers);
}

# Sends GET to an http:// or https:// URL (needs net; the host must be in the caller's net scope); an https:// server that cannot be verified gives an err saying why: not trusted, self-signed, for another host, expired, not valid yet, no acceptable TLS version or algorithm, tampered with, or handshake failed.
#     get("ftp://example.com/") == err("not an http:// or https:// URL: ftp://example.com/") is true
export fn get(url: str) -> result[Response] uses net {
    return exchange("GET", url, new list[Header], "", 0, "get_bytes");
}

# Sends POST with a body and its content type to an http:// or https:// URL (needs net).
#     post("ftp://x/", "text/plain", "") == err("not an http:// or https:// URL: ftp://x/") is true
export fn post(url: str, content_type: str, body: str) -> result[Response] uses net {
    return exchange(
        "POST",
        url,
        [new Header { name: "Content-Type", value: content_type }],
        body,
        0,
        "post_bytes"
    );
}

# Sends GET like get, and returns the body as bytes, whatever it is (needs net); get needs a UTF-8 body.
#     get_bytes("ftp://example.com/") == err("not an http:// or https:// URL: ftp://example.com/") is true
export fn get_bytes(url: str) -> result[BytesResponse] uses net {
    return exchange_bytes("GET", url, new list[Header], from_bytes_empty(), 0);
}

# Sends POST like post, with a body of bytes, and returns the body as bytes (needs net).
#     post_bytes("ftp://x/", "application/octet-stream", from_text("")) == err("not an http:// or https:// URL: ftp://x/") is true
export fn post_bytes(url: str, content_type: str, body: bytes) -> result[BytesResponse] uses net {
    return exchange_bytes(
        "POST",
        url,
        [new Header { name: "Content-Type", value: content_type }],
        body,
        0
    );
}

fn from_bytes_empty() -> bytes {
    return __bytes_of_text("");
}

fn exchange_bytes(
    method: str,
    url: str,
    headers: list[Header],
    body: bytes,
    timeout_ms: int
) -> result[BytesResponse] uses net {
    let raw = try exchange_raw(method, url, headers, __raw_text(body), timeout_ms);
    let r = try parse_response(raw);
    return ok(new BytesResponse {
        status: r.status,
        headers: r.headers,
        body: __bytes_of_text(__http_part(raw, 1))
    });
}

# Sends a request with any method (`GET`, `POST`, `PUT`, `PATCH`, `DELETE`, ...), the headers given (in their order, after Host, Connection and User-Agent; a `User-Agent` given replaces `vo`) and a body, to an http:// or https:// URL (needs net). `timeout_ms` bounds the whole request: when it passes, the result is err("the request to HOST:PORT timed out"); 0 leaves only the run's `--timeout`. A header that could break the request (a line break, `Host`, `Content-Length`) is an err before anything is sent.
#     send("PUT", "ftp://x/", new list[Header], "", 0) == err("not an http:// or https:// URL: ftp://x/") is true
export fn send(
    method: str,
    url: str,
    headers: list[Header],
    body: str,
    timeout_ms: int
) -> result[Response] uses net {
    return exchange(method, url, headers, body, timeout_ms, "send_bytes");
}

# Sends a request like send, with a body of bytes, and returns the body as bytes (needs net).
#     send_bytes("PUT", "ftp://x/", new list[Header], from_text(""), 0) == err("not an http:// or https:// URL: ftp://x/") is true
export fn send_bytes(
    method: str,
    url: str,
    headers: list[Header],
    body: bytes,
    timeout_ms: int
) -> result[BytesResponse] uses net {
    return exchange_bytes(method, url, headers, body, timeout_ms);
}

# The value of the first header with this name, compared without case.
#     header(new Response { status: 200, headers: [new Header { name: "Content-Type", value: "text/plain" }], body: "" }, "content-type") == ok("text/plain") is true
export fn header(r: Response, name: str) -> result[str] {
    for h in r.headers {
        if lower(h.name) == lower(name) {
            return ok(h.value);
        }
    }
    return err("no header `" + name + "`");
}

# A request a server received: method, path, query (after `?`), headers in their order, and body.
#     new Request { method: "GET", path: "/", query: "", headers: new list[Header], body: "" }.path is "/"
export record Request {
    # The method, such as GET or POST.
    method: str;
    # The path, without the query.
    path: str;
    # The text after `?`, or "".
    query: str;
    # The headers in the order they were sent.
    headers: list[Header];
    # The body as text (UTF-8; serve answers 400 otherwise).
    body: str;
}

# The value of the first request header with this name, compared without case.
#     request_header(new Request { method: "GET", path: "/", query: "", headers: [new Header { name: "Host", value: "x" }], body: "" }, "host") == ok("x") is true
export fn request_header(r: Request, name: str) -> result[str] {
    for h in r.headers {
        if lower(h.name) == lower(name) {
            return ok(h.value);
        }
    }
    return err("no header `" + name + "`");
}

# Answers HTTP requests on address ("8000": this machine, "0.0.0.0:8000": the network) with handle's responses until stopped; many requests are read at once, and handle is called for one at a time.
#     serve("0", fn(r: Request) -> Response { return new Response { status: 200, headers: new list[Header], body: "" }; }) == err("`0` is not a serve address: write \"PORT\" or \"0.0.0.0:PORT\"") is true
export fn serve[E: effects](address: str, handle: fn(Request) -> Response uses E) -> result[void]
    uses serve, E {
    let answer = fn(raw: str) -> str {
        match parse_request(raw) {
            case ok(req) {
                match text_body(raw, "serve_bytes") {
                    case ok(body) {
                        let r = new Request {
                            method: req.method,
                            path: req.path,
                            query: req.query,
                            headers: req.headers,
                            body: body
                        };
                        return response_text(req.method, handle(r));
                    }
                    case err(_) {
                        return bad_request();
                    }
                }
            }
            case err(_) {
                return bad_request();
            }
        }
    };
    return serve_loop(address, answer);
}

# A request whose body is bytes (spec 021): method, path, query, headers in their order, and body.
#     new BytesRequest { method: "GET", path: "/", query: "", headers: new list[Header], body: from_text("") }.path is "/"
export record BytesRequest {
    # The method, such as GET or POST.
    method: str;
    # The path, without the query.
    path: str;
    # The text after `?`, or "".
    query: str;
    # The headers in the order they were sent.
    headers: list[Header];
    # The body, whatever its bytes.
    body: bytes;
}

# Answers HTTP requests like serve, with request and response bodies as bytes, whatever they are (needs serve); serve needs UTF-8 bodies.
#     serve_bytes("0", fn(r: BytesRequest) -> BytesResponse { return new BytesResponse { status: 200, headers: new list[Header], body: r.body }; }) == err("`0` is not a serve address: write \"PORT\" or \"0.0.0.0:PORT\"") is true
export fn serve_bytes[E: effects](
    address: str,
    handle: fn(BytesRequest) -> BytesResponse uses E
) -> result[void] uses serve, E {
    let answer = fn(raw: str) -> str {
        match parse_request(raw) {
            case ok(req) {
                let r = new BytesRequest {
                    method: req.method,
                    path: req.path,
                    query: req.query,
                    headers: req.headers,
                    body: __bytes_of_text(__http_part(raw, 1))
                };
                let out = handle(r);
                return response_text(req.method, new Response {
                    status: out.status,
                    headers: out.headers,
                    body: __raw_text(out.body)
                });
            }
            case err(_) {
                return bad_request();
            }
        }
    };
    return serve_loop(address, answer);
}

fn bad_request() -> str {
    return response_text("GET", new Response { status: 400, headers: new list[Header], body: "" });
}

fn serve_loop[E: effects](address: str, answer: fn(str) -> str uses E) -> result[void]
    uses serve, E {
    let listener = try __serve_listen(address);
    while true {
        let raw = try __serve_next(listener);
        if raw == "" {
            return ok();
        }
        match __serve_call(answer, raw) {
            case ok(text) {
                __serve_reply(text);
            }
            case err(_) {
                __serve_reply(response_text("GET", new Response {
                    status: 500,
                    headers: new list[Header],
                    body: ""
                }));
            }
        }
    }
}

fn parse_request(raw: str) -> result[Request] {
    # raw: the request framed by the runtime (spec 013): a head, then the decoded body (any bytes; the
    # caller takes it as text or bytes). The body field is left empty here.
    let head = split(try head_text(raw), crlf());
    let parts = split(head[0], " ");
    if len(parts) != 3 or parts[0] == "" or parts[1] == "" or len(parts[2]) < 5 or slice(parts[2], 0, 5) != "HTTP/" {
        return err("bad request line");
    }
    var path = parts[1];
    var query = "";
    let q = find(path, "?");
    if q >= 0 {
        set query = slice(path, q + 1, len(path));
        set path = slice(path, 0, q);
    }
    let headers = try parse_headers(head, "bad header line");
    return ok(new Request {
        method: parts[0],
        path: path,
        query: query,
        headers: headers,
        body: ""
    });
}

fn reason(status: int) -> str {
    let codes = [
        200,
        201,
        202,
        204,
        301,
        302,
        303,
        304,
        307,
        308,
        400,
        401,
        403,
        404,
        405,
        408,
        409,
        410,
        413,
        415,
        422,
        429,
        431,
        500,
        501,
        502,
        503,
        504
    ];
    let names = [
        "OK",
        "Created",
        "Accepted",
        "No Content",
        "Moved Permanently",
        "Found",
        "See Other",
        "Not Modified",
        "Temporary Redirect",
        "Permanent Redirect",
        "Bad Request",
        "Unauthorized",
        "Forbidden",
        "Not Found",
        "Method Not Allowed",
        "Request Timeout",
        "Conflict",
        "Gone",
        "Content Too Large",
        "Unsupported Media Type",
        "Unprocessable Content",
        "Too Many Requests",
        "Request Header Fields Too Large",
        "Internal Server Error",
        "Not Implemented",
        "Bad Gateway",
        "Service Unavailable",
        "Gateway Timeout"
    ];
    for i in 0..len(codes) {
        if codes[i] == status {
            return names[i];
        }
    }
    return "";
}

fn header_ok(h: Header) -> bool {
    # A header name must be a token and no name or value may hold CR, LF or NUL (spec 013, M5).
    if h.name == "" or find(h.value, chr(13)) >= 0 or find(h.value, "\n") >= 0 or find(h.value, chr(0)) >= 0 {
        return false;
    }
    let token = "!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    for c in chars(h.name) {
        if find(token, c) < 0 {
            return false;
        }
    }
    return true;
}

fn response_text(method: str, r: Response) -> str {
    let nl = crlf();
    for h in r.headers {
        if not header_ok(h) {
            return response_text(method, new Response {
                status: 500,
                headers: new list[Header],
                body: ""
            });
        }
    }
    var out = "HTTP/1.1 " + str(r.status) + " " + reason(r.status) + nl;
    for h in r.headers {
        let name = lower(h.name);
        if name != "content-length" and name != "connection" and name != "transfer-encoding" {
            set out = out + h.name + ": " + h.value + nl;
        }
    }
    set out = out + "Content-Length: " + str(len(r.body)) + nl + "Connection: close" + nl + nl;
    if method != "HEAD" {
        set out = out + r.body;
    }
    return out;
}

# Serves requests like serve with `workers` processes (1 to 64; `vo run --workers N` overrides it), each running setup once and then handle (with setup's result) for one request at a time; nothing else is shared between requests. On Ctrl-C or SIGTERM the requests already read are answered, then it returns ok().
#     serve_workers("0", 2, fn() -> result[int] { return ok(0); }, fn(n: int, r: Request) -> Response { return new Response { status: 200, headers: new list[Header], body: "" }; }) == err("`0` is not a serve address: write \"PORT\" or \"0.0.0.0:PORT\"") is true
export fn serve_workers[S, E: effects, F: effects](
    address: str,
    workers: int,
    setup: fn() -> result[S] uses F,
    handle: fn(S, Request) -> Response uses E
) -> result[void] uses serve, E, F {
    # __serve_workers serves on the listener opened here
    let _ = try __serve_listen(address);
    return __serve_workers(workers, setup, fn(state: S, raw: str) -> str {
        return answer_text(raw, fn(r: Request) -> Response {
            return handle(state, r);
        });
    });
}

fn answer_text[E: effects](raw: str, handle: fn(Request) -> Response uses E) -> str uses E {
    # As serve's own closure (kept apart so that serve's error traces stay as they were).
    match parse_request(raw) {
        case ok(req) {
            match text_body(raw, "serve_bytes") {
                case ok(body) {
                    let r = new Request {
                        method: req.method,
                        path: req.path,
                        query: req.query,
                        headers: req.headers,
                        body: body
                    };
                    return response_text(req.method, handle(r));
                }
                case err(_) {
                    return bad_request();
                }
            }
        }
        case err(_) {
            return bad_request();
        }
    }
}

# Serves requests like serve_workers, with request and response bodies as bytes, whatever they are (needs serve).
#     serve_bytes_workers("0", 2, fn() -> result[int] { return ok(0); }, fn(n: int, r: BytesRequest) -> BytesResponse { return new BytesResponse { status: 200, headers: new list[Header], body: r.body }; }) == err("`0` is not a serve address: write \"PORT\" or \"0.0.0.0:PORT\"") is true
export fn serve_bytes_workers[S, E: effects, F: effects](
    address: str,
    workers: int,
    setup: fn() -> result[S] uses F,
    handle: fn(S, BytesRequest) -> BytesResponse uses E
) -> result[void] uses serve, E, F {
    # __serve_workers serves on the listener opened here
    let _ = try __serve_listen(address);
    return __serve_workers(workers, setup, fn(state: S, raw: str) -> str {
        return answer_bytes(raw, fn(r: BytesRequest) -> BytesResponse {
            return handle(state, r);
        });
    });
}

fn answer_bytes[E: effects](raw: str, handle: fn(BytesRequest) -> BytesResponse uses E) -> str
    uses E {
    match parse_request(raw) {
        case ok(req) {
            let r = new BytesRequest {
                method: req.method,
                path: req.path,
                query: req.query,
                headers: req.headers,
                body: __bytes_of_text(__http_part(raw, 1))
            };
            let out = handle(r);
            return response_text(req.method, new Response {
                status: out.status,
                headers: out.headers,
                body: __raw_text(out.body)
            });
        }
        case err(_) {
            return bad_request();
        }
    }
}

fn body_error(e: TcpError) -> str {
    if e == TcpError.closed {
        return "the response ended early";
    }
    return describe(e);
}

fn stream_send(c: Conn[uses net], text: str, wait: int) -> result[void] {
    # std.tcp's send (this module has a send of its own): all of text, within wait ms.
    __http_timeout(wait);
    match __tcp_io(4, c.id, __bytes_of_text(text)) {
        case ok(_) {
            return ok();
        }
        case err(m) {
            return err(slice(m, find(m, ": ") + 2, len(m)));
        }
    }
}

fn stream_line(c: Conn[uses net], wait: int) -> result[str] uses net {
    # One line of the framing (a chunk size, a trailer), without its line end.
    let raw = try map_err(read_until(c, __bytes_of_text(crlf()), wait), body_error);
    if len(raw) > 1024 {
        return err("malformed response: a chunk size line is too long");
    }
    match __text_of_bytes(slice(raw, 0, len(raw) - 2)) {
        case ok(t) {
            return ok(t);
        }
        case err(_) {
            return err("malformed response: bad chunk size");
        }
    }
}

fn chunk_size(line: str) -> result[int] {
    # The hexadecimal size that starts a chunk; an extension after `;` is ignored.
    var digits = trim(line);
    let semi = find(digits, ";");
    if semi >= 0 {
        set digits = trim(slice(digits, 0, semi));
    }
    if digits == "" or len(digits) > 15 {
        return err("malformed response: bad chunk size");
    }
    var n = 0;
    for i in 0..len(digits) {
        let b = byte_at(digits, i);
        var d = -1;
        if b >= 48 and b <= 57 {
            set d = b - 48;
        } else if b >= 97 and b <= 102 {
            set d = b - 87;
        } else if b >= 65 and b <= 70 {
            set d = b - 55;
        }
        if d < 0 {
            return err("malformed response: bad chunk size");
        }
        set n = n * 16 + d;
    }
    return ok(n);
}

fn stream_sized[E: effects](
    c: Conn[uses net],
    head: Response,
    size: int,
    wait: int,
    f: fn(Response, bytes) -> result[bool] uses E
) -> result[bool] uses net, E {
    # size bytes of body in pieces of at most 64 KiB; false when f stopped the stream.
    var left = size;
    while left > 0 {
        let piece = try map_err(read(c, min(left, 65536), wait), body_error);
        set left = left - len(piece);
        if not try f(head, piece) {
            return ok(false);
        }
    }
    return ok(true);
}

fn stream_chunked[E: effects](
    c: Conn[uses net],
    head: Response,
    wait: int,
    f: fn(Response, bytes) -> result[bool] uses E
) -> result[void] uses net, E {
    while true {
        let size = try chunk_size(try stream_line(c, wait));
        if size == 0 {
            while try stream_line(c, wait) != "" {
            }
            return ok();
        }
        if not try stream_sized(c, head, size, wait, f) {
            return ok();
        }
        if try map_err(read_exact(c, 2, wait), body_error) != __bytes_of_text(crlf()) {
            return err("malformed response: a chunk without its line end");
        }
    }
}

fn stream_to_close[E: effects](
    c: Conn[uses net],
    head: Response,
    wait: int,
    f: fn(Response, bytes) -> result[bool] uses E
) -> result[void] uses net, E {
    while true {
        match read(c, 65536, wait) {
            case ok(piece) {
                if not try f(head, piece) {
                    return ok();
                }
            }
            case err(e) {
                if e == TcpError.closed {
                    return ok();
                }
                return err(describe(e));
            }
        }
    }
}

fn stream_head(c: Conn[uses net], wait: int) -> result[Response] uses net {
    # The status and headers of the response (after any 1xx responses), with an empty body.
    while true {
        let raw = try map_err(read_until(c, __bytes_of_text(crlf() + crlf()), wait), body_error);
        if len(raw) > 65536 {
            return err("the response head is larger than 64 KiB");
        }
        match __text_of_bytes(slice(raw, 0, len(raw) - 4)) {
            case ok(text) {
                let head = try parse_head(split(text, crlf()));
                if head.status >= 200 {
                    return ok(head);
                }
            }
            case err(_) {
                return err("a header is not UTF-8");
            }
        }
    }
}

fn stream_body[E: effects](
    c: Conn[uses net],
    request: str,
    wait: int,
    f: fn(Response, bytes) -> result[bool] uses E
) -> result[Response] uses net, E {
    try stream_send(c, request, wait);
    let head = try stream_head(c, wait);
    if head.status == 204 or head.status == 304 {
        return ok(head);
    }
    match header(head, "Transfer-Encoding") {
        case ok(coding) {
            if find(lower(coding), "chunked") >= 0 {
                try stream_chunked(c, head, wait, f);
                return ok(head);
            }
        }
        case err(_) {
        }
    }
    match header(head, "Content-Length") {
        case ok(text) {
            match parse_int(text) {
                case ok(size) {
                    if size < 0 {
                        return err("malformed response: bad Content-Length");
                    }
                    let _ = try stream_sized(c, head, size, wait, f);
                }
                case err(_) {
                    return err("malformed response: bad Content-Length");
                }
            }
        }
        case err(_) {
            try stream_to_close(c, head, wait, f);
        }
    }
    return ok(head);
}

# Sends a request like send and calls f with the response's status and headers (a Response with an
# empty body) and each piece of the body (1 to 65536 bytes) as it arrives, for bodies of any size
# (needs net and f's effects). f answers ok(true) to go on, ok(false) to stop, or an error, which
# send_stream returns. The result is the status and headers. `timeout_ms` (1 to 600000; 0 means
# 600000) bounds each wait for the server, not the whole transfer. Redirects are not followed.
#     send_stream("GET", "ftp://x/", new list[Header], "", 0, fn(head: Response, piece: bytes) -> result[bool] { return ok(true); }) == err("not an http:// or https:// URL: ftp://x/") is true
export fn send_stream[E: effects](
    method: str,
    url: str,
    headers: list[Header],
    body: str,
    timeout_ms: int,
    f: fn(Response, bytes) -> result[bool] uses E
) -> result[Response] uses net, E {
    let u = try parse_url(url);
    let request = try request_text(method, u, headers, body);
    if timeout_ms < 0 or timeout_ms > 600000 {
        return err("bad timeout: " + str(timeout_ms) + " ms");
    }
    var wait = timeout_ms;
    if wait == 0 {
        set wait = 600000;
    }
    var dialed = connect(u.host, u.port, wait);
    if u.tls {
        set dialed = connect_tls(u.host, u.port, wait);
    }
    let c = try map_err(dialed, describe);
    let done = stream_body(c, request, wait, f);
    close(c);
    return done;
}
