# std.http: HTTP and HTTPS: GET and POST (needs net), and serving plain HTTP requests (needs serve).
# Part of the vo standard library (spec 007, serving spec 011, https spec 019). Import items one by one: `import std.http.NAME;`.
# The host is checked against the caller's net scope at run time, the address against its serve scope.
# ponytail: one request per connection (Connection: close), redirects returned, not followed; a
# server answers one request at a time.

# One response header, as received.
#     new Header { name: "a", value: "b" }.name is "a"
export record Header {
    # The header name, as received (compare with lower or header()).
    name: str;
    # The header value, without surrounding spaces.
    value: str;
}

# A response: the status code, the headers in their order, and the body.
#     new Response { status: 200, headers: new list[Header], body: "" }.status is 200
export record Response {
    # The HTTP status code, such as 200 or 404.
    status: int;
    # The headers in the order they were sent.
    headers: list[Header];
    # The body as text (UTF-8; get_bytes reads any body).
    body: str;
}

record Url {
    tls: bool;
    host: str;
    port: int;
    target: str;
}

fn parse_url(url: str) -> result[Url] {
    var tls = false;
    var skip = 7;
    if len(url) >= 8 and lower(slice(url, 0, 8)) == "https://" {
        set tls = true;
        set skip = 8;
    } else if len(url) < 7 or lower(slice(url, 0, 7)) != "http://" {
        return err("not an http:// or https:// URL: " + url);
    }
    let rest = slice(url, skip, len(url));
    var cut = len(rest);
    for c in [find(rest, "/"), find(rest, "?"), find(rest, "#")] {
        if c >= 0 and c < cut {
            set cut = c;
        }
    }
    let authority = slice(rest, 0, cut);
    var target = slice(rest, cut, len(rest));
    let hash = find(target, "#");
    if hash >= 0 {
        set target = slice(target, 0, hash);
    }
    if target == "" or slice(target, 0, 1) != "/" {
        set target = "/" + target;
    }
    var host = authority;
    var port = 80;
    if tls {
        set port = 443;
    }
    let colon = find(authority, ":");
    if colon >= 0 {
        set host = slice(authority, 0, colon);
        match parse_int(slice(authority, colon + 1, len(authority))) {
            case ok(n) {
                set port = n;
            }
            case err(_) {
                return err("bad port in " + url);
            }
        }
    }
    if host == "" or port < 1 or port > 65535 or find(host, "@") >= 0 {
        return err("bad host in " + url);
    }
    return ok(new Url { tls: tls, host: lower(host), port: port, target: target });
}

# A response whose body is bytes (spec 021): the status code, the headers in their order, and the body.
#     new BytesResponse { status: 200, headers: new list[Header], body: from_text("") }.status is 200
export record BytesResponse {
    # The HTTP status code, such as 200 or 404.
    status: int;
    # The headers in the order they were sent.
    headers: list[Header];
    # The body, whatever its bytes.
    body: bytes;
}

fn exchange(method: str, url: str, content_type: str, body: str) -> result[Response] uses net {
    let raw = try exchange_raw(method, url, content_type, body);
    let r = try parse_response(raw);
    var hint = "get_bytes";
    if method == "POST" {
        set hint = "post_bytes";
    }
    return ok(new Response { status: r.status, headers: r.headers, body: try text_body(raw, hint) });
}

fn text_body(raw: str, hint: str) -> result[str] {
    # spec 021: the body of a raw message as text, checked (a str is always UTF-8).
    match __text_of_bytes(__bytes_of_text(__http_part(raw, 1))) {
        case ok(t) {
            return ok(t);
        }
        case err(e) {
            return err("the body is " + e + " (" + hint + " reads it)");
        }
    }
}

fn head_text(raw: str) -> result[str] {
    # spec 021: the head of a raw message as text, checked.
    match __text_of_bytes(__bytes_of_text(__http_part(raw, 0))) {
        case ok(t) {
            return ok(t);
        }
        case err(_) {
            return err("a header is not UTF-8");
        }
    }
}

fn exchange_raw(method: str, url: str, content_type: str, body: str) -> result[str] uses net {
    let u = try parse_url(url);
    let nl = crlf();
    var request = method + " " + u.target + " HTTP/1.1" + nl + "Host: " + u.host;
    if (u.port != 80 and not u.tls) or (u.port != 443 and u.tls) {
        set request = request + ":" + str(u.port);
    }
    set request = request + nl + "Connection: close" + nl + "User-Agent: vo" + nl;
    if method == "POST" {
        set request = request + "Content-Type: " + content_type + nl + "Content-Length: " + str(len(body)) + nl;
    }
    set request = request + nl + body;
    if u.tls {
        return __https_exchange(u.host, u.port, request);
    }
    return __http_exchange(u.host, u.port, request);
}

fn crlf() -> str {
    return chr(13) + "\n";
}

fn parse_response(raw: str) -> result[Response] {
    # raw: the response framed by the runtime (spec 013): a head, then the decoded body (any bytes; the
    # caller takes it as text or bytes). The body field is left empty here.
    let head = split(try head_text(raw), crlf());
    let parts = split(head[0], " ");
    if len(parts) < 2 or len(parts[0]) < 5 or slice(parts[0], 0, 5) != "HTTP/" {
        return err("malformed response: bad status line");
    }
    var status = 0;
    match parse_int(parts[1]) {
        case ok(n) {
            set status = n;
        }
        case err(_) {
            return err("malformed response: bad status code");
        }
    }
    let headers = try parse_headers(head, "malformed response: bad header line");
    return ok(new Response { status: status, headers: headers, body: "" });
}

fn parse_headers(head: list[str], bad: str) -> result[list[Header]] {
    let headers = new list[Header];
    for i in 1..len(head) {
        let line = head[i];
        let colon = find(line, ":");
        if colon <= 0 {
            return err(bad);
        }
        push(headers, new Header { name: slice(line, 0, colon), value: trim(slice(line, colon + 1, len(line))) });
    }
    return ok(headers);
}

# Sends GET to an http:// or https:// URL (needs net; the host must be in the caller's net scope); an https:// server that cannot be verified gives an err saying why: not trusted, self-signed, for another host, expired, not valid yet, no acceptable TLS version or algorithm, tampered with, or handshake failed.
#     get("ftp://example.com/") == err("not an http:// or https:// URL: ftp://example.com/") is true
export fn get(url: str) -> result[Response] uses net {
    return exchange("GET", url, "", "");
}

# Sends POST with a body and its content type to an http:// or https:// URL (needs net).
#     post("ftp://x/", "text/plain", "") == err("not an http:// or https:// URL: ftp://x/") is true
export fn post(url: str, content_type: str, body: str) -> result[Response] uses net {
    return exchange("POST", url, content_type, body);
}

# Sends GET like get, and returns the body as bytes, whatever it is (needs net); get needs a UTF-8 body.
#     get_bytes("ftp://example.com/") == err("not an http:// or https:// URL: ftp://example.com/") is true
export fn get_bytes(url: str) -> result[BytesResponse] uses net {
    return exchange_bytes("GET", url, "", from_bytes_empty());
}

# Sends POST like post, with a body of bytes, and returns the body as bytes (needs net).
#     post_bytes("ftp://x/", "application/octet-stream", from_text("")) == err("not an http:// or https:// URL: ftp://x/") is true
export fn post_bytes(url: str, content_type: str, body: bytes) -> result[BytesResponse] uses net {
    return exchange_bytes("POST", url, content_type, body);
}

fn from_bytes_empty() -> bytes {
    return __bytes_of_text("");
}

fn exchange_bytes(method: str, url: str, content_type: str, body: bytes) -> result[BytesResponse] uses net {
    let raw = try exchange_raw(method, url, content_type, __raw_text(body));
    let r = try parse_response(raw);
    return ok(new BytesResponse { status: r.status, headers: r.headers, body: __bytes_of_text(__http_part(raw, 1)) });
}

# The value of the first header with this name, compared without case.
#     header(new Response { status: 200, headers: [new Header { name: "Content-Type", value: "text/plain" }], body: "" }, "content-type") == ok("text/plain") is true
export fn header(r: Response, name: str) -> result[str] {
    for h in r.headers {
        if lower(h.name) == lower(name) {
            return ok(h.value);
        }
    }
    return err("no header `" + name + "`");
}

# A request a server received: method, path, query (after `?`), headers in their order, and body.
#     new Request { method: "GET", path: "/", query: "", headers: new list[Header], body: "" }.path is "/"
export record Request {
    # The method, such as GET or POST.
    method: str;
    # The path, without the query.
    path: str;
    # The text after `?`, or "".
    query: str;
    # The headers in the order they were sent.
    headers: list[Header];
    # The body as text (UTF-8; serve answers 400 otherwise).
    body: str;
}

# The value of the first request header with this name, compared without case.
#     request_header(new Request { method: "GET", path: "/", query: "", headers: [new Header { name: "Host", value: "x" }], body: "" }, "host") == ok("x") is true
export fn request_header(r: Request, name: str) -> result[str] {
    for h in r.headers {
        if lower(h.name) == lower(name) {
            return ok(h.value);
        }
    }
    return err("no header `" + name + "`");
}

# Answers HTTP requests on address ("8000": this machine, "0.0.0.0:8000": the network) with handle's responses until stopped; many requests are read at once, and handle is called for one at a time.
#     serve("0", fn(r: Request) -> Response { return new Response { status: 200, headers: new list[Header], body: "" }; }) == err("`0` is not a serve address: write \"PORT\" or \"0.0.0.0:PORT\"") is true
export fn serve[E: effects](address: str, handle: fn(Request) -> Response uses E) -> result[void] uses serve, E {
    let answer = fn(raw: str) -> str {
        match parse_request(raw) {
            case ok(req) {
                match text_body(raw, "serve_bytes") {
                    case ok(body) {
                        let r = new Request { method: req.method, path: req.path, query: req.query, headers: req.headers, body: body };
                        return response_text(req.method, handle(r));
                    }
                    case err(_) {
                        return bad_request();
                    }
                }
            }
            case err(_) {
                return bad_request();
            }
        }
    };
    return serve_loop(address, answer);
}

# A request whose body is bytes (spec 021): method, path, query, headers in their order, and body.
#     new BytesRequest { method: "GET", path: "/", query: "", headers: new list[Header], body: from_text("") }.path is "/"
export record BytesRequest {
    # The method, such as GET or POST.
    method: str;
    # The path, without the query.
    path: str;
    # The text after `?`, or "".
    query: str;
    # The headers in the order they were sent.
    headers: list[Header];
    # The body, whatever its bytes.
    body: bytes;
}

# Answers HTTP requests like serve, with request and response bodies as bytes, whatever they are (needs serve); serve needs UTF-8 bodies.
#     serve_bytes("0", fn(r: BytesRequest) -> BytesResponse { return new BytesResponse { status: 200, headers: new list[Header], body: r.body }; }) == err("`0` is not a serve address: write \"PORT\" or \"0.0.0.0:PORT\"") is true
export fn serve_bytes[E: effects](address: str, handle: fn(BytesRequest) -> BytesResponse uses E) -> result[void] uses serve, E {
    let answer = fn(raw: str) -> str {
        match parse_request(raw) {
            case ok(req) {
                let r = new BytesRequest { method: req.method, path: req.path, query: req.query, headers: req.headers, body: __bytes_of_text(__http_part(raw, 1)) };
                let out = handle(r);
                return response_text(req.method, new Response { status: out.status, headers: out.headers, body: __raw_text(out.body) });
            }
            case err(_) {
                return bad_request();
            }
        }
    };
    return serve_loop(address, answer);
}

fn bad_request() -> str {
    return response_text("GET", new Response { status: 400, headers: new list[Header], body: "" });
}

fn serve_loop[E: effects](address: str, answer: fn(str) -> str uses E) -> result[void] uses serve, E {
    let listener = try __serve_listen(address);
    while true {
        let raw = try __serve_next(listener);
        if raw == "" {
            return ok();
        }
        match __serve_call(answer, raw) {
            case ok(text) {
                __serve_reply(text);
            }
            case err(_) {
                __serve_reply(response_text("GET", new Response { status: 500, headers: new list[Header], body: "" }));
            }
        }
    }
}

fn parse_request(raw: str) -> result[Request] {
    # raw: the request framed by the runtime (spec 013): a head, then the decoded body (any bytes; the
    # caller takes it as text or bytes). The body field is left empty here.
    let head = split(try head_text(raw), crlf());
    let parts = split(head[0], " ");
    if len(parts) != 3 or parts[0] == "" or parts[1] == "" or len(parts[2]) < 5 or slice(parts[2], 0, 5) != "HTTP/" {
        return err("bad request line");
    }
    var path = parts[1];
    var query = "";
    let q = find(path, "?");
    if q >= 0 {
        set query = slice(path, q + 1, len(path));
        set path = slice(path, 0, q);
    }
    let headers = try parse_headers(head, "bad header line");
    return ok(new Request { method: parts[0], path: path, query: query, headers: headers, body: "" });
}

fn reason(status: int) -> str {
    let codes = [200, 201, 202, 204, 301, 302, 303, 304, 307, 308, 400, 401, 403, 404, 405, 408, 409, 410, 413, 415, 422, 429, 431, 500, 501, 502, 503, 504];
    let names = ["OK", "Created", "Accepted", "No Content", "Moved Permanently", "Found", "See Other", "Not Modified", "Temporary Redirect", "Permanent Redirect", "Bad Request", "Unauthorized", "Forbidden", "Not Found", "Method Not Allowed", "Request Timeout", "Conflict", "Gone", "Content Too Large", "Unsupported Media Type", "Unprocessable Content", "Too Many Requests", "Request Header Fields Too Large", "Internal Server Error", "Not Implemented", "Bad Gateway", "Service Unavailable", "Gateway Timeout"];
    for i in 0..len(codes) {
        if codes[i] == status {
            return names[i];
        }
    }
    return "";
}

fn header_ok(h: Header) -> bool {
    # A header name must be a token and no name or value may hold CR, LF or NUL (spec 013, M5).
    if h.name == "" or find(h.value, chr(13)) >= 0 or find(h.value, "\n") >= 0 or find(h.value, chr(0)) >= 0 {
        return false;
    }
    let token = "!#$%&'*+-.^_`|~0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    for c in chars(h.name) {
        if find(token, c) < 0 {
            return false;
        }
    }
    return true;
}

fn response_text(method: str, r: Response) -> str {
    let nl = crlf();
    for h in r.headers {
        if not header_ok(h) {
            return response_text(method, new Response { status: 500, headers: new list[Header], body: "" });
        }
    }
    var out = "HTTP/1.1 " + str(r.status) + " " + reason(r.status) + nl;
    for h in r.headers {
        let name = lower(h.name);
        if name != "content-length" and name != "connection" and name != "transfer-encoding" {
            set out = out + h.name + ": " + h.value + nl;
        }
    }
    set out = out + "Content-Length: " + str(len(r.body)) + nl + "Connection: close" + nl + nl;
    if method != "HEAD" {
        set out = out + r.body;
    }
    return out;
}
