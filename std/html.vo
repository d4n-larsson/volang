# std.html: HTML pages from templates, every value escaped for the place it goes.
# Part of the vo standard library (spec 051). Import items one by one: `import std.html.NAME;`.
# html(template, values...) takes an HTML string literal or constant whose `{}` holes take the values
# in order (`{{` and `}}` are braces), checked by vo check: tags must nest and close, and a hole may be
# text, a quoted attribute value or a whole URL attribute value, never inside a script, a style, an
# `on...` or `style` attribute, an unquoted value, a name or a comment. Text and attribute values are
# escaped; a URL whose scheme is not http, https or mailto becomes "#". An Html value is inserted as it
# is, so pages are built from smaller templates; there are no loops or conditions inside a template.

# Markup that came from a checked template: safe to insert where text may go. Made only by html and
# no_html.
#     html_text(no_html()) is ""
export record Html {
    # The markup.
    text: str;
}

# The page for a template and its values (vo check reads the template; see the module comment).
#     html_text(html("<b>{}</b>", "a < b")) is "<b>a &lt; b</b>"
export fn html(template: str) -> Html {
    return new Html { text: "" };
}

# The markup as text: what a response body or a test compares.
#     html_text(html("<p>hi</p>")) is "<p>hi</p>"
export fn html_text(h: Html) -> str {
    return h.text;
}

# The empty markup, for a hole that shows nothing.
#     html_text(no_html()) is ""
export fn no_html() -> Html {
    return new Html { text: "" };
}
