# std.process: Running other programs to their end, with no shell (needs process).
# Part of the vo standard library (spec 017). Import items one by one: `import std.process.NAME;`.
# The program is checked against the caller's process scopes at run time, exactly as written.
# A started program is not confined: it can do anything the user running vo can.

# What a finished program returned: its exit code (128 + n when killed by signal n), its standard output and its standard error.
#     new Output { code: 0, stdout: "", stderr: "" }.code is 0
export record Output {
    # The exit code; 128 + n when the program was killed by signal n.
    code: int;
    # What the program wrote to standard output (UTF-8; run_bytes reads any output).
    stdout: str;
    # What the program wrote to standard error.
    stderr: str;
}

fn decode(text: str) -> result[Output] {
    let first = find(text, "\n");
    let rest = slice(text, first + 1, len(text));
    let second = find(rest, "\n");
    let code = try parse_int(slice(text, 0, first));
    let n = try parse_int(slice(rest, 0, second));
    let body = slice(rest, second + 1, len(rest));
    return ok(new Output {
        code: code,
        stdout: slice(body, 0, n),
        stderr: slice(body, n, len(body))
    });
}

# Runs program with args (no shell: each argument is passed as it is), no input and an empty environment, and waits for it to end (needs process).
#     run("no-such-program.vo-doc", new list[str]) == err("not found") is true
export fn run(program: str, args: list[str]) -> result[Output] uses process {
    return run_with(program, args, "", new list[str]);
}

# Runs program like run, with input as its standard input and env ("NAME=value" entries) as its environment (needs process).
#     run_with("no-such-program.vo-doc", new list[str], "", ["A=1"]) == err("not found") is true
export fn run_with(program: str, args: list[str], input: str, env: list[str]) -> result[Output]
    uses process {
    let argv = [program];
    for a in args {
        push(argv, a);
    }
    return decode(try __run(argv, input, env));
}

# What a finished program returned, its output as bytes (spec 021): the exit code, standard output and standard error.
#     new BytesOutput { code: 0, stdout: from_text(""), stderr: from_text("") }.code is 0
export record BytesOutput {
    # The exit code; 128 + n when the program was killed by signal n.
    code: int;
    # What the program wrote to standard output.
    stdout: bytes;
    # What the program wrote to standard error.
    stderr: bytes;
}

fn header_int(raw: bytes, at: int) -> result[int] {
    var i = at;
    while i < len(raw) and raw[i] != 10 {
        set i = i + 1;
    }
    let digits = try __text_of_bytes(slice(raw, at, i));
    return parse_int(digits);
}

fn header_end(raw: bytes, at: int) -> int {
    var i = at;
    while i < len(raw) and raw[i] != 10 {
        set i = i + 1;
    }
    return i + 1;
}

fn decode_bytes(raw: bytes) -> result[BytesOutput] {
    let code = try header_int(raw, 0);
    let second = header_end(raw, 0);
    let n = try header_int(raw, second);
    let body = header_end(raw, second);
    return ok(new BytesOutput {
        code: code,
        stdout: slice(raw, body, body + n),
        stderr: slice(raw, body + n, len(raw))
    });
}

# Runs program like run, and returns its output as bytes, whatever it is (needs process); run needs UTF-8 output.
#     run_bytes("no-such-program.vo-doc", new list[str]) == err("not found") is true
export fn run_bytes(program: str, args: list[str]) -> result[BytesOutput] uses process {
    return run_with_bytes(program, args, __bytes_of_text(""), new list[str]);
}

# Runs program like run_with, with input as bytes, and returns its output as bytes (needs process).
#     run_with_bytes("no-such-program.vo-doc", new list[str], from_text(""), ["A=1"]) == err("not found") is true
export fn run_with_bytes(
    program: str,
    args: list[str],
    input: bytes,
    env: list[str]
) -> result[BytesOutput] uses process {
    let argv = [program];
    for a in args {
        push(argv, a);
    }
    return decode_bytes(try __run_bytes(argv, input, env));
}
