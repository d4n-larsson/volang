# std.random: Random floats, picks and shuffles (fixed by --seed; not for secrets: std.crypto.random_bytes).
# Part of the vo standard library (spec 007). Import items one by one: `import std.random.NAME;`.

# A float in [0, 1) from 53 random bits.
#     unit() < 1.0 is true
export fn unit() -> float uses random {
    let bits = random_int(0, 9007199254740991);
    return float(bits) / float(9007199254740992);
}

# A random element of xs; an empty list is an error.
#     pick([7]) == ok(7) is true
export fn pick[T](xs: list[T]) -> result[T] uses random {
    if len(xs) == 0 {
        return err("empty list");
    }
    return ok(xs[random_int(0, len(xs) - 1)]);
}

# A shuffled copy of xs (Fisher-Yates); xs is unchanged.
#     len(shuffled([1, 2, 3])) is 3
export fn shuffled[T](xs: list[T]) -> list[T] uses random {
    let out = slice(xs, 0, len(xs));
    var i = len(out) - 1;
    while i > 0 {
        let j = random_int(0, i);
        let t = out[i];
        set out[i] = out[j];
        set out[j] = t;
        set i = i - 1;
    }
    return out;
}
