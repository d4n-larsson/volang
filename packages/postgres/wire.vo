# postgres.wire: the messages of PostgreSQL's protocol (version 3.0) as bytes: building what the
# client sends, and reading what the server sends, with every length checked. Not part of the
# package's API: import postgres.client.
import std.bytes.from_ints;
import std.bytes.from_text;
import std.bytes.to_ints;
import std.bytes.to_text;
import std.text.starts_with;

# A parameter or a column value on the wire: null, or its text form as bytes.
#     new Field { null: true, data: from_ints(new list[int]) }.null is true
export record Field {
    # Whether the value is NULL (data is then empty).
    null: bool;
    # The value's text form.
    data: bytes;
}

# A result column: its name and the number of its type.
#     new Column { name: "id", type_id: 23 }.type_id is 23
export record Column {
    # The column's name (the AS name where given).
    name: str;
    # The type's number in pg_type (23 is integer).
    type_id: int;
}

# What the server said went wrong: the SQLSTATE, the message, and the position in the statement (0
# when it gave none).
#     new Failure { code: "23505", message: "duplicate key", position: 0 }.code is "23505"
export record Failure {
    # The five-character SQLSTATE.
    code: str;
    # The server's message.
    message: str;
    # The 1-based character position in the statement, or 0.
    position: int;
}

# Appends n as two bytes, big-endian.
#     let out = new list[int]; put16(out, 258); out == [1, 2] is true
export fn put16(out: list[int], n: int) {
    push(out, n / 256 % 256);
    push(out, n % 256);
}

# Appends n as four bytes, big-endian (-1 as four 255s).
#     let out = new list[int]; put32(out, -1); out == [255, 255, 255, 255] is true
export fn put32(out: list[int], n: int) {
    var v = n;
    if v < 0 {
        set v = v + 4294967296;
    }
    push(out, v / 16777216 % 256);
    push(out, v / 65536 % 256);
    push(out, v / 256 % 256);
    push(out, v % 256);
}

# Appends the bytes of b.
#     let out = new list[int]; put_bytes(out, from_text("a")); out == [97] is true
export fn put_bytes(out: list[int], b: bytes) {
    for x in to_ints(b) {
        push(out, x);
    }
}

# Appends the text and a zero byte.
#     let out = new list[int]; put_cstr(out, "a"); out == [97, 0] is true
export fn put_cstr(out: list[int], s: str) {
    put_bytes(out, from_text(s));
    push(out, 0);
}

# One message: its type byte (0 for the two that have none), its length, its body.
#     message(83, new list[int]) == from_ints([83, 0, 0, 0, 4]) is true
export fn message(kind: int, body: list[int]) -> bytes {
    var out = new list[int];
    if kind != 0 {
        push(out, kind);
    }
    put32(out, len(body) + 4);
    for x in body {
        push(out, x);
    }
    return from_ints(out);
}

# The request to switch to TLS, sent first.
#     len(tls_request()) is 8
export fn tls_request() -> bytes {
    var body = new list[int];
    put32(body, 80877103);
    return message(0, body);
}

# The startup message: who connects to which database, and the session settings that make results
# the same whatever the server's configuration (UTF-8, UTC, ISO dates, hex bytea).
#     len(startup("u", "d")) > 8 is true
export fn startup(user: str, database: str) -> bytes {
    var body = new list[int];
    put32(body, 196608);
    let settings = [
        "user",
        user,
        "database",
        database,
        "client_encoding",
        "UTF8",
        "DateStyle",
        "ISO, MDY",
        "TimeZone",
        "UTC",
        "IntervalStyle",
        "postgres",
        "bytea_output",
        "hex",
        "standard_conforming_strings",
        "on",
        "extra_float_digits",
        "1",
        "application_name",
        "vo"
    ];
    for s in settings {
        put_cstr(body, s);
    }
    push(body, 0);
    return message(0, body);
}

# The first SCRAM message: the mechanism and the client's first data.
#     sasl_initial("SCRAM-SHA-256", from_text("n,,"))[0] is 112
export fn sasl_initial(mechanism: str, data: bytes) -> bytes {
    var body = new list[int];
    put_cstr(body, mechanism);
    put32(body, len(data));
    put_bytes(body, data);
    return message(112, body);
}

# A later SCRAM message.
#     sasl_response(from_text("c=biws"))[0] is 112
export fn sasl_response(data: bytes) -> bytes {
    var body = new list[int];
    put_bytes(body, data);
    return message(112, body);
}

# One statement, start to finish: Parse, Bind, Describe, Execute and Sync in one piece. Parameters
# and results are in text form; the server gives each parameter the type the statement implies.
#     statement("select 1", new list[Field])[0] is 80
export fn statement(text: str, params: list[Field]) -> bytes {
    var parse = new list[int];
    push(parse, 0);
    put_cstr(parse, text);
    put16(parse, 0);
    var bind = new list[int];
    push(bind, 0);
    push(bind, 0);
    put16(bind, 0);
    put16(bind, len(params));
    for p in params {
        if p.null {
            put32(bind, -1);
        } else {
            put32(bind, len(p.data));
            put_bytes(bind, p.data);
        }
    }
    put16(bind, 0);
    var execute = new list[int];
    push(execute, 0);
    put32(execute, 0);
    return message(80, parse) + message(66, bind) + message(68, [80, 0]) + message(69, execute) + message(83, new list[int]);
}

# The goodbye message.
#     terminate() == from_ints([88, 0, 0, 0, 4]) is true
export fn terminate() -> bytes {
    return message(88, new list[int]);
}

# Two bytes at `at` as a number; err when they are not there.
#     read16(from_ints([1, 2]), 0) == ok(258) is true
export fn read16(b: bytes, at: int) -> result[int] {
    if at < 0 or at + 2 > len(b) {
        return err("protocol: a message is cut short");
    }
    return ok(b[at] * 256 + b[at + 1]);
}

# Four bytes at `at` as a signed number; err when they are not there.
#     read32(from_ints([255, 255, 255, 255]), 0) == ok(-1) is true
export fn read32(b: bytes, at: int) -> result[int] {
    if at < 0 or at + 4 > len(b) {
        return err("protocol: a message is cut short");
    }
    let v = ((b[at] * 256 + b[at + 1]) * 256 + b[at + 2]) * 256 + b[at + 3];
    if v >= 2147483648 {
        return ok(v - 4294967296);
    }
    return ok(v);
}

# The index of the zero byte that ends the text starting at `at`; err when there is none.
#     text_end(from_ints([97, 0]), 0) == ok(1) is true
export fn text_end(b: bytes, at: int) -> result[int] {
    var i = at;
    while i < len(b) {
        if b[i] == 0 {
            return ok(i);
        }
        set i = i + 1;
    }
    return err("protocol: a text in a message does not end");
}

# The bytes from a to b as text; err when they are not UTF-8.
#     text_at(from_text("abc"), 1, 3) == ok("bc") is true
export fn text_at(b: bytes, a: int, c: int) -> result[str] {
    match to_text(slice(b, a, c)) {
        case ok(s) {
            return ok(s);
        }
        case err(_) {
            return err("protocol: a text in a message is not UTF-8");
        }
    }
}

# The kind of an authentication message (0 ok, 10 SASL offered, 11 SASL continue, 12 SASL final, 5
# MD5 password, 3 clear-text password, ...).
#     auth_kind(from_ints([0, 0, 0, 10])) == ok(10) is true
export fn auth_kind(body: bytes) -> result[int] {
    return read32(body, 0);
}

# The mechanisms a SASL offer names.
#     auth_mechanisms(from_ints([0, 0, 0, 10, 65, 0, 0])) == ok(["A"]) is true
export fn auth_mechanisms(body: bytes) -> result[list[str]] {
    var names = new list[str];
    var at = 4;
    while at < len(body) and body[at] != 0 {
        let end = try text_end(body, at);
        push(names, try text_at(body, at, end));
        set at = end + 1;
    }
    return ok(names);
}

# The fields of an error message the client uses.
#     failure(from_ints([67, 52, 50, 0, 0])) == ok(new Failure { code: "42", message: "", position: 0 }) is true
export fn failure(body: bytes) -> result[Failure] {
    var code = "";
    var text = "";
    var position = 0;
    var at = 0;
    while at < len(body) and body[at] != 0 {
        let kind = body[at];
        let end = try text_end(body, at + 1);
        let value = try text_at(body, at + 1, end);
        if kind == 67 {
            set code = value;
        }
        if kind == 77 {
            set text = value;
        }
        if kind == 80 {
            match parse_int(value) {
                case ok(n) {
                    set position = n;
                }
                case err(_) {
                }
            }
        }
        set at = end + 1;
    }
    return ok(new Failure { code: code, message: text, position: position });
}

# The columns a row description names.
#     columns(from_ints([0, 0])) == ok(new list[Column]) is true
export fn columns(body: bytes) -> result[list[Column]] {
    let n = try read16(body, 0);
    var out = new list[Column];
    var at = 2;
    for _ in 0..n {
        let end = try text_end(body, at);
        let name = try text_at(body, at, end);
        let type_id = try read32(body, end + 7);
        let _ = try read16(body, end + 17);
        push(out, new Column { name: name, type_id: type_id });
        set at = end + 19;
    }
    return ok(out);
}

# The values of one data row.
#     data_row(from_ints([0, 1, 255, 255, 255, 255])) == ok([new Field { null: true, data: from_ints(new list[int]) }]) is true
export fn data_row(body: bytes) -> result[list[Field]] {
    let n = try read16(body, 0);
    var out = new list[Field];
    var at = 2;
    let none = from_ints(new list[int]);
    for _ in 0..n {
        let size = try read32(body, at);
        set at = at + 4;
        if size == -1 {
            push(out, new Field { null: true, data: none });
            continue;
        }
        if size < 0 {
            return err("protocol: a value has an impossible length");
        }
        if at + size > len(body) {
            return err("protocol: a message is cut short");
        }
        push(out, new Field { null: false, data: slice(body, at, at + size) });
        set at = at + size;
    }
    return ok(out);
}

# The rows a command changed, from its tag: the last number of INSERT, UPDATE, DELETE and MERGE
# tags, 0 for every other command.
#     changed(from_ints([85, 80, 68, 65, 84, 69, 32, 51, 0])) is 3
export fn changed(body: bytes) -> int {
    var end = len(body);
    if end > 0 and body[end - 1] == 0 {
        set end = end - 1;
    }
    match to_text(slice(body, 0, end)) {
        case ok(tag) {
            let words = split(tag, " ");
            let verb = words[0];
            if verb != "INSERT" and verb != "UPDATE" and verb != "DELETE" and verb != "MERGE" {
                return 0;
            }
            match parse_int(words[len(words) - 1]) {
                case ok(n) {
                    return n;
                }
                case err(_) {
                    return 0;
                }
            }
        }
        case err(_) {
            return 0;
        }
    }
}

# The failure name for a SQLSTATE: constraint, readonly, busy (trying again can succeed), auth, or
# error.
#     failure_name("23505") is "constraint"
export fn failure_name(code: str) -> str {
    if starts_with(code, "23") {
        return "constraint";
    }
    if code == "25006" {
        return "readonly";
    }
    if code == "40001" or code == "40P01" or code == "55P03" {
        return "busy";
    }
    if starts_with(code, "28") {
        return "auth";
    }
    return "error";
}

# A failure the server reported, as err text: name, SQLSTATE, message, and a position (0: none).
#     failure_text(new Failure { code: "42703", message: "no", position: 0 }, 8) is "error: 42703 no (at position 8)"
export fn failure_text(f: Failure, position: int) -> str {
    var text = failure_name(f.code) + ": " + f.code + " " + f.message;
    if position > 0 {
        set text = text + " (at position " + str(position) + ")";
    }
    return text;
}

test "numbers" {
    var out = new list[int];
    put16(out, 65535);
    put32(out, 196608);
    put32(out, -1);
    expect_eq(out, [255, 255, 0, 3, 0, 0, 255, 255, 255, 255]);
    let b = from_ints(out);
    expect_eq(read16(b, 0), ok(65535));
    expect_eq(read32(b, 2), ok(196608));
    expect_eq(read32(b, 6), ok(-1));
    expect_eq(read32(b, 7), err("protocol: a message is cut short"));
    expect_eq(read16(b, -1), err("protocol: a message is cut short"));
}

test "the TLS request and the startup message" {
    expect_eq(tls_request(), from_ints([0, 0, 0, 8, 4, 210, 22, 47]));
    let s = startup("u", "d");
    expect_eq(read32(s, 0), ok(len(s)));
    expect_eq(read32(s, 4), ok(196608));
    expect_eq(text_at(s, 8, 12), ok("user"));
    expect_eq(s[len(s) - 1], 0);
    expect_eq(s[len(s) - 2], 0);
}

test "a statement is five messages" {
    let none = from_ints(new list[int]);
    let m = statement("select $1", [
        new Field { null: false, data: from_text("7") },
        new Field { null: true, data: none }
    ]);
    expect_eq(m[0], 80);
    expect_eq(read32(m, 1), ok(17));
    expect_eq(text_at(m, 6, 15), ok("select $1"));
    let bind = 18;
    expect_eq(m[bind], 66);
    expect_eq(read16(m, bind + 9), ok(2));
    expect_eq(read32(m, bind + 11), ok(1));
    expect_eq(m[bind + 15], 55);
    expect_eq(read32(m, bind + 16), ok(-1));
    expect_eq(slice(m, len(m) - 5, len(m)), from_ints([83, 0, 0, 0, 4]));
}

test "reading an error, columns, a row and a tag" {
    var e = new list[int];
    push(e, 83);
    put_cstr(e, "ERROR");
    push(e, 67);
    put_cstr(e, "23505");
    push(e, 77);
    put_cstr(e, "duplicate key value");
    push(e, 80);
    put_cstr(e, "15");
    push(e, 0);
    expect_eq(failure(from_ints(e)), ok(new Failure {
        code: "23505",
        message: "duplicate key value",
        position: 15
    }));
    var c = new list[int];
    put16(c, 1);
    put_cstr(c, "id");
    put32(c, 0);
    put16(c, 0);
    put32(c, 23);
    put16(c, 4);
    put32(c, -1);
    put16(c, 0);
    expect_eq(columns(from_ints(c)), ok([new Column { name: "id", type_id: 23 }]));
    expect_eq(columns(from_ints([0, 2, 97, 0])), err("protocol: a message is cut short"));
    var r = new list[int];
    put16(r, 2);
    put32(r, 2);
    put_bytes(r, from_text("42"));
    put32(r, -1);
    let none = from_ints(new list[int]);
    expect_eq(data_row(from_ints(r)), ok([
        new Field { null: false, data: from_text("42") },
        new Field { null: true, data: none }
    ]));
    expect_eq(data_row(from_ints([0, 1, 0, 0, 0, 9, 1])), err("protocol: a message is cut short"));
    expect_eq(data_row(from_ints([0, 1, 255, 255, 255, 251])), err(
        "protocol: a value has an impossible length"
    ));
    var t = new list[int];
    put_cstr(t, "INSERT 0 5");
    expect_eq(changed(from_ints(t)), 5);
    expect_eq(changed(from_text("SELECT 3")), 0);
    expect_eq(changed(from_text("CREATE TABLE")), 0);
}

test "failure names" {
    expect_eq(failure_name("23505"), "constraint");
    expect_eq(failure_name("23503"), "constraint");
    expect_eq(failure_name("25006"), "readonly");
    expect_eq(failure_name("40001"), "busy");
    expect_eq(failure_name("40P01"), "busy");
    expect_eq(failure_name("55P03"), "busy");
    expect_eq(failure_name("28P01"), "auth");
    expect_eq(failure_name("42703"), "error");
    expect_eq(
        failure_text(new Failure { code: "23505", message: "dup", position: 0 }, 0),
        "constraint: 23505 dup"
    );
}
