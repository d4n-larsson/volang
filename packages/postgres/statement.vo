# postgres.statement: the text of one SQL statement as PostgreSQL wants it. Programs write `?`
# parameters, as with std.sqlite; the server wants `$1`, `$2`, ... Not part of the package's API:
# import postgres.client.
import std.text;

# A statement ready to send: its text with numbered parameters, how many it has, and the pieces
# both texts are made of (so a position the server reports can be found in what the program wrote).
#     new Rewritten { text: "select $1", count: 1, made: ["select ", "$1"], written: ["select ", "?"] }.count is 1
export record Rewritten {
    # The SQL with `$1`, `$2`, ... in place of each `?`.
    text: str;
    # The number of parameters.
    count: int;
    # The pieces of text, in order.
    made: list[str];
    # The piece of the program's text each of them stands for.
    written: list[str];
}

fn is_name_byte(c: int) -> bool {
    return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c >= 128;
}

fn is_space(c: int) -> bool {
    return c == 32 or c == 9 or c == 10 or c == 13 or c == 12;
}

# The index after the string that opens at `at` (a quote byte), or -1 when it never closes. With
# `escapes` a backslash takes the next byte with it (E'...'); a doubled quote is always a quote.
fn after_quoted(s: str, at: int, quote: int, escapes: bool) -> int {
    var i = at + 1;
    let n = len(s);
    while i < n {
        let c = byte_at(s, i);
        if escapes and c == 92 {
            set i = i + 2;
            continue;
        }
        if c == quote {
            if i + 1 < n and byte_at(s, i + 1) == quote {
                set i = i + 2;
                continue;
            }
            return i + 1;
        }
        set i = i + 1;
    }
    return -1;
}

# The index after the comment that opens at `at` (`/*`, which nest), or -1 when it never closes.
fn after_comment(s: str, at: int) -> int {
    var i = at + 2;
    var depth = 1;
    let n = len(s);
    while i + 1 < n {
        let c = byte_at(s, i);
        let d = byte_at(s, i + 1);
        if c == 47 and d == 42 {
            set depth = depth + 1;
            set i = i + 2;
            continue;
        }
        if c == 42 and d == 47 {
            set depth = depth - 1;
            set i = i + 2;
            if depth == 0 {
                return i;
            }
            continue;
        }
        set i = i + 1;
    }
    return -1;
}

# The index after the dollar-quoted text that opens at `at` (`$tag$`), -1 when it never closes, or 0
# when `at` does not open one.
fn after_dollar(s: str, at: int) -> int {
    let n = len(s);
    var i = at + 1;
    while i < n and is_name_byte(byte_at(s, i)) {
        set i = i + 1;
    }
    if i >= n or byte_at(s, i) != 36 {
        return 0;
    }
    let tag = slice(s, at, i + 1);
    let close = find(slice(s, i + 1, n), tag);
    if close < 0 {
        return -1;
    }
    return i + 1 + close + len(tag);
}

# The index after the spaces or the comment at `i`, or `i` when there is neither.
fn after_blank(s: str, i: int) -> result[int] {
    let n = len(s);
    let c = byte_at(s, i);
    if is_space(c) {
        return ok(i + 1);
    }
    if i + 1 >= n {
        return ok(i);
    }
    let d = byte_at(s, i + 1);
    if c == 45 and d == 45 {
        var end = i;
        while end < n and byte_at(s, end) != 10 {
            set end = end + 1;
        }
        return ok(end);
    }
    if c == 47 and d == 42 {
        let end = after_comment(s, i);
        if end < 0 {
            return err("error: the statement ends inside a comment");
        }
        return ok(end);
    }
    return ok(i);
}

# The index after the string, quoted name or dollar-quoted text at `i`, or `i` when there is none;
# err for a numbered parameter.
fn after_text(s: str, i: int) -> result[int] {
    let c = byte_at(s, i);
    if c == 39 or c == 34 {
        let escapes = c == 39 and i > 0 and (byte_at(s, i - 1) == 69 or byte_at(s, i - 1) == 101) and (i < 2 or not is_name_byte(byte_at(
            s,
            i - 2
        )));
        let end = after_quoted(s, i, c, escapes);
        if end < 0 {
            return err("error: the statement ends inside a string or a quoted name");
        }
        return ok(end);
    }
    if c != 36 or (i > 0 and is_name_byte(byte_at(s, i - 1))) {
        return ok(i);
    }
    if i + 1 < len(s) and byte_at(s, i + 1) >= 48 and byte_at(s, i + 1) <= 57 {
        return err("error: write parameters as ?, not $" + chr(byte_at(s, i + 1)));
    }
    let end = after_dollar(s, i);
    if end < 0 {
        return err("error: the statement ends inside a dollar-quoted text");
    }
    if end > 0 {
        return ok(end);
    }
    return ok(i);
}

# The statement as the server takes it: each `?` outside strings, quoted names, comments and
# dollar-quoted text becomes `$1`, `$2`, ...; `??` is a literal `?`. err for `$1` (write `?`), for more
# than one statement, and for text that ends inside a string or comment.
#     rewrite("select ? + ??") == ok(new Rewritten { text: "select $1 + ?", count: 1, made: ["select ", "$1", " + ", "?", ""], written: ["select ", "?", " + ", "??", ""] }) is true
export fn rewrite(s: str) -> result[Rewritten] {
    let n = len(s);
    var made = new list[str];
    var written = new list[str];
    var from = 0;
    var count = 0;
    var ended = false;
    var i = 0;
    while i < n {
        let blank = try after_blank(s, i);
        if blank != i {
            set i = blank;
            continue;
        }
        if ended {
            return err("error: one statement per sql");
        }
        let text_value = try after_text(s, i);
        if text_value != i {
            set i = text_value;
            continue;
        }
        let c = byte_at(s, i);
        if c == 59 {
            set ended = true;
        }
        if c != 63 {
            set i = i + 1;
            continue;
        }
        push(made, slice(s, from, i));
        push(written, slice(s, from, i));
        if i + 1 < n and byte_at(s, i + 1) == 63 {
            push(made, "?");
            push(written, "??");
            set i = i + 2;
        } else {
            set count = count + 1;
            push(made, "$" + str(count));
            push(written, "?");
            set i = i + 1;
        }
        set from = i;
    }
    push(made, slice(s, from, n));
    push(written, slice(s, from, n));
    return ok(new Rewritten { text: join(made, ""), count: count, made: made, written: written });
}

# The character position in the program's text for a position (1-based, in characters) in the text
# that was sent; a position inside a parameter is the position of its `?`.
#     source_position(new Rewritten { text: "$1 x", count: 1, made: ["", "$1", " x"], written: ["", "?", " x"] }, 4) is 3
export fn source_position(r: Rewritten, position: int) -> int {
    var sent = 0;
    var source = 0;
    for i in 0..len(r.made) {
        let size = text.char_count(r.made[i]);
        if position <= sent + size {
            if r.made[i] == r.written[i] {
                return source + position - sent;
            }
            return source + 1;
        }
        set sent = sent + size;
        set source = source + text.char_count(r.written[i]);
    }
    return source;
}

fn text_of(s: str) -> str {
    match rewrite(s) {
        case ok(r) {
            return r.text + " #" + str(r.count);
        }
        case err(e) {
            return e;
        }
    }
}

test "parameters are numbered in order" {
    expect_eq(text_of("select ?, ? from t where a = ?"), "select $1, $2 from t where a = $3 #3");
    expect_eq(text_of("select 1"), "select 1 #0");
    expect_eq(text_of(""), " #0");
}

test "?? is a literal ?" {
    expect_eq(text_of("select data ?? 'k' and x = ?"), "select data ? 'k' and x = $1 #1");
}

test "no parameters inside strings, names, comments and dollar quotes" {
    expect_eq(text_of("select '?', 'it''s ?', ?"), "select '?', 'it''s ?', $1 #1");
    expect_eq(text_of("select \"a?\" from t where b = ?"), "select \"a?\" from t where b = $1 #1");
    expect_eq(text_of("select 1 -- why?\n, ?"), "select 1 -- why?\n, $1 #1");
    expect_eq(text_of("select /* a /* nested? */ ? */ ?"), "select /* a /* nested? */ ? */ $1 #1");
    expect_eq(
        text_of("select $$ ? $$, $q$ ? $$ ? $q$, ?"),
        "select $$ ? $$, $q$ ? $$ ? $q$, $1 #1"
    );
    expect_eq(text_of("select E'a\\'?', ?"), "select E'a\\'?', $1 #1");
    expect_eq(text_of("select 'a\\', ?"), "select 'a\\', $1 #1");
}

test "numbered parameters are refused" {
    expect_eq(text_of("select $1"), "error: write parameters as ?, not $1");
    expect_eq(text_of("select a$1 from t"), "select a$1 from t #0");
}

test "one statement" {
    expect_eq(text_of("select 1; select 2"), "error: one statement per sql");
    expect_eq(text_of("select 1;  -- done\n"), "select 1;  -- done\n #0");
    expect_eq(text_of("select ';'"), "select ';' #0");
}

test "text that ends early" {
    expect_eq(text_of("select 'abc"), "error: the statement ends inside a string or a quoted name");
    expect_eq(text_of("select /* abc"), "error: the statement ends inside a comment");
    expect_eq(text_of("select $a$ abc"), "error: the statement ends inside a dollar-quoted text");
}

fn position_in(text_value: str, position: int) -> int {
    match rewrite(text_value) {
        case ok(r) {
            return source_position(r, position);
        }
        case err(_) {
            return -1;
        }
    }
}

test "a position in the sent text is found in the written text" {
    expect_eq(position_in("select x from t", 8), 8);
    expect_eq(position_in("select ?, ?, y from t", 16), 14);
    expect_eq(position_in("select ?, ?, y from t", 12), 11);
    expect_eq(position_in("select ? ?? b, é, zz", 16), 16);
    expect_eq(position_in("select ? ?? b, é, zz", 19), 19);
}
