# postgres.values: how PostgreSQL's types and text forms map to the five kinds of value a program
# sees. Not part of the package's API: import postgres.client.
import std.bytes.from_hex;
import std.bytes.from_ints;
import std.bytes.to_hex;
import std.text.starts_with;
import std.time.date;

# The kind of value a column of a given type is read as.
#     kind_of(23) == Kind.integer is true
export variant Kind {
    # smallint, integer, bigint, oid.
    integer;
    # boolean: read as integer 0 or 1.
    boolean;
    # real, double precision.
    real;
    # bytea.
    blob;
    # Everything else: the server's text form.
    text;
}

# The kind for a type's number in pg_type.
#     kind_of(1700) == Kind.text is true
export fn kind_of(type_id: int) -> Kind {
    if type_id == 20 or type_id == 21 or type_id == 23 or type_id == 26 {
        return Kind.integer;
    }
    if type_id == 16 {
        return Kind.boolean;
    }
    if type_id == 700 or type_id == 701 {
        return Kind.real;
    }
    if type_id == 17 {
        return Kind.blob;
    }
    return Kind.text;
}

# The bytes of a bytea value in the server's hex form.
#     blob_of(`\x00ff`) == from_hex("00ff") is true
export fn blob_of(text: str) -> result[bytes] {
    if not starts_with(text, `\x`) {
        return err("protocol: a bytea value is not in hex form");
    }
    match from_hex(slice(text, 2, len(text))) {
        case ok(b) {
            return ok(b);
        }
        case err(_) {
            return err("protocol: a bytea value is not in hex form");
        }
    }
}

# Bytes as the text the server reads a bytea from.
#     blob_text(from_ints([0, 255])) is `\x00ff`
export fn blob_text(b: bytes) -> str {
    return `\x` + to_hex(b);
}

fn number(s: str, a: int, b: int) -> result[int] {
    if a < 0 or b > len(s) or a >= b {
        return err("not a date or time");
    }
    for i in a..b {
        let c = byte_at(s, i);
        if c < 48 or c > 57 {
            return err("not a date or time");
        }
    }
    return parse_int(slice(s, a, b));
}

fn is_at(s: str, i: int, c: str) -> bool {
    return i < len(s) and slice(s, i, i + 1) == c;
}

# The clock time, fraction and offset after the date, as milliseconds to add.
fn time_part(s: str) -> result[int] {
    let n = len(s);
    if n < 19 or not is_at(s, 13, ":") or not is_at(s, 16, ":") {
        return err("not a date or time");
    }
    let hour = try number(s, 11, 13);
    let minute = try number(s, 14, 16);
    let second = try number(s, 17, 19);
    var ms = hour * 3600000 + minute * 60000 + second * 1000;
    var at = 19;
    if is_at(s, at, ".") {
        var end = at + 1;
        while end < n and byte_at(s, end) >= 48 and byte_at(s, end) <= 57 {
            set end = end + 1;
        }
        var digits = slice(s, at + 1, end);
        while len(digits) < 3 {
            set digits = digits + "0";
        }
        set ms = ms + try number(digits, 0, 3);
        set at = end;
    }
    if at == n {
        return ok(ms);
    }
    if not is_at(s, at, "+") and not is_at(s, at, "-") {
        return err("not a date or time");
    }
    var offset = try number(s, at + 1, at + 3) * 3600000;
    if is_at(s, at + 3, ":") {
        set offset = offset + try number(s, at + 4, at + 6) * 60000;
        if is_at(s, at + 6, ":") {
            set offset = offset + try number(s, at + 7, at + 9) * 1000;
            if at + 9 != n {
                return err("not a date or time");
            }
        } else if at + 6 != n {
            return err("not a date or time");
        }
    } else if at + 3 != n {
        return err("not a date or time");
    }
    if is_at(s, at, "+") {
        return ok(ms - offset);
    }
    return ok(ms + offset);
}

# Milliseconds since 1970 UTC for the text of a date (`2026-11-23`, its midnight UTC), a timestamp
# (`2026-11-23 10:00:00.123456`, taken as UTC) or a timestamp with time zone (`... 10:00:00+00`).
# Microseconds beyond the millisecond are dropped. err for anything else (`infinity`, dates BC).
#     time_of("1970-01-02 00:00:01.5+00") == ok(86401500) is true
export fn time_of(s: str) -> result[int] {
    if len(s) < 10 or not is_at(s, 4, "-") or not is_at(s, 7, "-") {
        return err("not a date or time");
    }
    let year = try number(s, 0, 4);
    let month = try number(s, 5, 7);
    let day = try number(s, 8, 10);
    var ms = 0;
    match date(year, month, day) {
        case ok(d) {
            set ms = d;
        }
        case err(_) {
            return err("not a date or time");
        }
    }
    if len(s) == 10 {
        return ok(ms);
    }
    if not is_at(s, 10, " ") {
        return err("not a date or time");
    }
    return ok(ms + try time_part(s));
}

test "types to kinds" {
    expect_eq(kind_of(20), Kind.integer);
    expect_eq(kind_of(21), Kind.integer);
    expect_eq(kind_of(23), Kind.integer);
    expect_eq(kind_of(26), Kind.integer);
    expect_eq(kind_of(16), Kind.boolean);
    expect_eq(kind_of(700), Kind.real);
    expect_eq(kind_of(701), Kind.real);
    expect_eq(kind_of(17), Kind.blob);
    expect_eq(kind_of(25), Kind.text);
    expect_eq(kind_of(1700), Kind.text);
    expect_eq(kind_of(1184), Kind.text);
}

test "bytea" {
    expect_eq(blob_of(`\x`), from_hex(""));
    expect_eq(blob_of(`\x00ff10`), from_hex("00ff10"));
    expect_eq(blob_of("00ff"), err("protocol: a bytea value is not in hex form"));
    expect_eq(blob_of(`\xzz`), err("protocol: a bytea value is not in hex form"));
    expect_eq(blob_text(from_ints([0, 255, 16])), `\x00ff10`);
}

test "dates and times" {
    expect_eq(time_of("1970-01-01"), ok(0));
    expect_eq(time_of("2026-11-23"), ok(1795392000000));
    expect_eq(time_of("2026-11-23 10:00:00"), ok(1795428000000));
    expect_eq(time_of("2026-11-23 10:00:00+00"), ok(1795428000000));
    expect_eq(time_of("2026-11-23 10:00:00.123456+00"), ok(1795428000123));
    expect_eq(time_of("2026-11-23 10:00:00.5"), ok(1795428000500));
    expect_eq(time_of("2026-11-23 12:00:00+02"), ok(1795428000000));
    expect_eq(time_of("2026-11-23 04:30:00-05:30"), ok(1795428000000));
    expect_eq(time_of("1969-12-31 23:59:59.999+00"), ok(-1));
    expect_eq(time_of("infinity"), err("not a date or time"));
    expect_eq(time_of("2026-11-23 10:00:00 BC"), err("not a date or time"));
    expect_eq(time_of("2026-13-01"), err("not a date or time"));
    expect_eq(time_of("2026-11-23T10:00:00"), err("not a date or time"));
    expect_eq(time_of("2026-11-23 10:00"), err("not a date or time"));
    expect_eq(time_of(""), err("not a date or time"));
}
