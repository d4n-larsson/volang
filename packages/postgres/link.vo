# postgres.link: the connection under the protocol: opening it (with TLS unless told otherwise),
# sending bytes and receiving one message at a time, each wait under a time limit, and std.tcp's
# failures as this package's failure names. Not part of the package's API: import postgres.client.
import postgres.wire;
import std.bytes;
import std.tcp;
import std.text;

# One message from the server: its type byte and its body.
#     new Message { kind: 90, body: from_ints([73]) }.kind is 90
export record Message {
    # The type byte ('Z' is 90).
    kind: int;
    # The body, without the type and the length.
    body: bytes;
}

# A std.tcp failure as this package words it: `timeout:`, `tls:`, `connection:` or `protocol:`.
#     failed(TcpError.refused) is "connection: the connection was refused"
export fn failed(e: tcp.TcpError) -> str {
    match e {
        case timed_out {
            return "timeout: the server did not answer within the time limit";
        }
        case tls(reason) {
            return "tls: " + reason;
        }
        case too_large {
            return "protocol: " + tcp.tcp_error_text(e);
        }
        case invalid(_) {
            return "protocol: " + tcp.tcp_error_text(e);
        }
        case refused {
            return "connection: " + tcp.tcp_error_text(e);
        }
        case closed {
            return "connection: " + tcp.tcp_error_text(e);
        }
        case not_found {
            return "connection: " + tcp.tcp_error_text(e);
        }
        case unreachable {
            return "connection: " + tcp.tcp_error_text(e);
        }
        case in_use {
            return "connection: " + tcp.tcp_error_text(e);
        }
        case too_many {
            return "connection: " + tcp.tcp_error_text(e);
        }
        case other(_) {
            return "connection: " + tcp.tcp_error_text(e);
        }
    }
}

# Opens the connection. Unless plain_text, asks the server for TLS before anything else and verifies
# it for host; a server without TLS is an err and nothing more is sent.
#     dial("", 5432, true, 1000) == err("protocol: an argument is out of range: the host is empty or longer than 253 bytes") is true
export fn dial(host: str, port: int, plain_text: bool, ms: int) -> result[tcp.Conn[uses net]]
    uses net {
    let c = try map_err(tcp.connect(host, port, ms), failed);
    if plain_text {
        return ok(c);
    }
    match secure(c, host, ms) {
        case ok() {
            return ok(c);
        }
        case err(e) {
            tcp.close_conn(c);
            return err(e);
        }
    }
}

fn secure(c: tcp.Conn[uses net], host: str, ms: int) -> result[void] uses net {
    try map_err(tcp.write_all(c, wire.tls_request(), ms), failed);
    let answer = try map_err(tcp.read_exact(c, 1, ms), failed);
    if answer[0] == 78 {
        return err("tls: the server does not offer TLS");
    }
    if answer[0] != 83 {
        return err("protocol: the server's answer to the TLS request is not S or N");
    }
    return map_err(tcp.start_tls(c, host, ms), failed);
}

# Sends data within ms.
#     deliver(new Conn { id: 0, peer: "" }, from_ints([1]), 1000) == err("connection: the connection is closed") is true
export fn deliver[E: effects](c: tcp.Conn[uses E], data: bytes, ms: int) -> result[void] uses E {
    return map_err(tcp.write_all(c, data, ms), failed);
}

# The next message, each wait within ms. A length under 4 or over 1 GiB is `protocol:`.
#     receive(new Conn { id: 0, peer: "" }, 1000) == err("connection: the connection is closed") is true
export fn receive[E: effects](c: tcp.Conn[uses E], ms: int) -> result[Message] uses E {
    let head = try map_err(tcp.read_exact(c, 5, ms), failed);
    let size = try wire.read32(head, 1) - 4;
    if size < 0 or size > 1073741824 {
        return err("protocol: a message has an impossible length");
    }
    var body = bytes.from_ints(new list[int]);
    var left = size;
    while left > 0 {
        let part = try map_err(tcp.read_exact(c, min(left, 16777216), ms), failed);
        set body = body + part;
        set left = left - len(part);
    }
    return ok(new Message { kind: head[0], body: body });
}

# Closes the connection.
#     let c = new Conn { id: 0, peer: "" }; hang_up(c); 1 is 1
export fn hang_up[E: effects](c: tcp.Conn[uses E]) uses E {
    tcp.close_conn(c);
}

# Whether an err text is of a kind after which the connection cannot be used.
#     ends_connection("timeout: the server did not answer within the time limit") is true
export fn ends_connection(e: str) -> bool {
    return text.starts_with(e, "timeout:") or text.starts_with(e, "connection:") or text.starts_with(e, "protocol:") or text.starts_with(e, "tls:") or text.starts_with(e, "auth:");
}

test "std.tcp failures by name" {
    expect_eq(
        failed(tcp.TcpError.timed_out),
        "timeout: the server did not answer within the time limit"
    );
    expect_eq(
        failed(tcp.TcpError.tls("the certificate has expired")),
        "tls: the certificate has expired"
    );
    expect_eq(
        failed(tcp.TcpError.closed),
        "connection: " + tcp.tcp_error_text(tcp.TcpError.closed)
    );
    expect_eq(
        failed(tcp.TcpError.not_found),
        "connection: " + tcp.tcp_error_text(tcp.TcpError.not_found)
    );
    expect_eq(
        failed(tcp.TcpError.too_large),
        "protocol: " + tcp.tcp_error_text(tcp.TcpError.too_large)
    );
}
