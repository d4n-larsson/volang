# postgres.signin: the startup message and signing in, up to the server's first "ready". The
# decisions are pure (answer); sign_in only sends and receives. Not part of the package's API: import
# postgres.client.
import postgres.link.deliver;
import postgres.link.receive;
import postgres.scram.client_final;
import postgres.scram.first_bare;
import postgres.scram.verify;
import postgres.wire.auth_kind;
import postgres.wire.auth_mechanisms;
import postgres.wire.failure;
import postgres.wire.failure_text;
import postgres.wire.sasl_initial;
import postgres.wire.sasl_response;
import postgres.wire.startup;
import std.bytes.from_ints;
import std.bytes.from_text;
import std.bytes.to_text;
import std.tcp.Conn;

# Where signing in stands, and what it needs next.
#     new SignIn { stage: 0, password: "", bare: "n=,r=x", expected: from_ints(new list[int]) }.stage is 0
export record SignIn {
    # 0 nothing asked yet, 1 first message sent, 2 proof sent, 3 the server proved itself, 4 signed in.
    stage: int;
    # The password, used only to make the proof.
    password: str;
    # The signed part of the client's first message.
    bare: str;
    # The signature the server must answer with.
    expected: bytes;
}

fn asked_for(kind: int) -> str {
    if kind == 3 {
        return "a clear-text password";
    }
    if kind == 5 {
        return "an MD5 password";
    }
    if kind == 2 {
        return "Kerberos";
    }
    if kind == 7 or kind == 8 {
        return "GSSAPI";
    }
    if kind == 9 {
        return "SSPI";
    }
    return "method " + str(kind);
}

fn body_text(body: bytes, from: int) -> result[str] {
    match to_text(slice(body, from, len(body))) {
        case ok(s) {
            return ok(s);
        }
        case err(_) {
            return err("protocol: a text in a message is not UTF-8");
        }
    }
}

fn nothing() -> bytes {
    return from_ints(new list[int]);
}

fn offers_scram(body: bytes) -> result[bool] {
    for m in try auth_mechanisms(body) {
        if m == "SCRAM-SHA-256" {
            return ok(true);
        }
    }
    return ok(false);
}

# What to send in answer to one authentication message (empty: nothing), moving s on; err when the
# server asks for something else or does not prove that it knows the password.
#     answer(new SignIn { stage: 0, password: "", bare: "n=,r=x", expected: from_ints(new list[int]) }, from_ints([0, 0, 0, 5, 1, 2, 3, 4])) == err("auth: the server asked for an MD5 password; only SCRAM-SHA-256 is supported") is true
export fn answer(s: SignIn, body: bytes) -> result[bytes] {
    let kind = try auth_kind(body);
    if kind == 0 {
        if s.stage != 0 and s.stage != 3 {
            return err("auth: the server did not prove that it knows the password");
        }
        set s.stage = 4;
        return ok(nothing());
    }
    if kind == 10 and s.stage == 0 {
        if not try offers_scram(body) {
            return err("auth: the server does not offer SCRAM-SHA-256");
        }
        set s.stage = 1;
        return ok(sasl_initial("SCRAM-SHA-256", from_text("n,," + s.bare)));
    }
    if kind == 11 and s.stage == 1 {
        let final = try client_final(s.password, s.bare, try body_text(body, 4));
        set s.expected = final.server_signature;
        set s.stage = 2;
        return ok(sasl_response(from_text(final.message)));
    }
    if kind == 12 and s.stage == 2 {
        if not verify(try body_text(body, 4), s.expected) {
            return err("auth: the server did not prove that it knows the password");
        }
        set s.stage = 3;
        return ok(nothing());
    }
    if kind == 10 or kind == 11 or kind == 12 {
        return err("protocol: a sign-in message came out of order");
    }
    return err(
        "auth: the server asked for " + asked_for(kind) + "; only SCRAM-SHA-256 is supported"
    );
}

# What one message while signing in means: true when the server is ready. Authentication messages
# go to answer; this handles the others.
fn other(kind: int, body: bytes, s: SignIn) -> result[bool] {
    if kind == 69 {
        return err(failure_text(try failure(body), 0));
    }
    if kind == 90 {
        if s.stage != 4 {
            return err("protocol: the server is ready before signing in ended");
        }
        return ok(true);
    }
    if kind != 83 and kind != 75 and kind != 78 {
        return err("protocol: an unexpected message while signing in");
    }
    return ok(false);
}

# Sends the startup message and signs in, each wait within ms; the nonce is the client's random part
# of SCRAM.
#     sign_in(new Conn { id: 0, peer: "" }, "u", "d", "", 1000, "x") == err("connection: the connection is closed") is true
export fn sign_in[E: effects](
    c: Conn[E],
    user: str,
    database: str,
    password: str,
    ms: int,
    nonce: str
) -> result[void] uses E {
    try deliver(c, startup(user, database), ms);
    let s = new SignIn {
        stage: 0,
        password: password,
        bare: first_bare(nonce),
        expected: nothing()
    };
    var ready = false;
    while not ready {
        let m = try receive(c, ms);
        if m.kind == 82 {
            let reply = try answer(s, m.body);
            if len(reply) > 0 {
                try deliver(c, reply, ms);
            }
        } else {
            set ready = try other(m.kind, m.body, s);
        }
    }
    return ok();
}

test "sign-in methods other than SCRAM are refused" {
    let s = new SignIn { stage: 0, password: "p", bare: "n=,r=x", expected: nothing() };
    expect_eq(answer(s, from_ints([0, 0, 0, 3])), err(
        "auth: the server asked for a clear-text password; only SCRAM-SHA-256 is supported"
    ));
    expect_eq(answer(s, from_ints([0, 0, 0, 10, 80, 76, 65, 73, 78, 0, 0])), err(
        "auth: the server does not offer SCRAM-SHA-256"
    ));
}

test "ok before the server's proof is refused" {
    let s = new SignIn { stage: 2, password: "p", bare: "n=,r=x", expected: nothing() };
    expect_eq(answer(s, from_ints([0, 0, 0, 0])), err(
        "auth: the server did not prove that it knows the password"
    ));
    let none = new SignIn { stage: 0, password: "", bare: "n=,r=x", expected: nothing() };
    expect_eq(answer(none, from_ints([0, 0, 0, 0])), ok(nothing()));
    expect_eq(none.stage, 4);
    expect_eq(answer(none, from_ints([0, 0, 0, 12, 118, 61])), err(
        "protocol: a sign-in message came out of order"
    ));
}

test "ready only after signing in" {
    let s = new SignIn { stage: 1, password: "p", bare: "n=,r=x", expected: nothing() };
    expect_eq(other(90, from_ints([73]), s), err(
        "protocol: the server is ready before signing in ended"
    ));
    expect_eq(other(83, nothing(), s), ok(false));
    expect_eq(other(65, nothing(), s), err("protocol: an unexpected message while signing in"));
}
