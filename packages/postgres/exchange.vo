# postgres.exchange: one statement on the wire and its whole answer: the column names and kinds, the
# rows as text fields, the rows changed, the server's failure if any, and whether the transaction
# is now failed. Not part of the package's API: import postgres.client.
import postgres.link.Message;
import postgres.link.deliver;
import postgres.link.receive;
import postgres.statement.Rewritten;
import postgres.statement.source_position;
import postgres.values.Kind;
import postgres.values.kind_of;
import postgres.wire.Field;
import postgres.wire.changed;
import postgres.wire.columns;
import postgres.wire.data_row;
import postgres.wire.failure;
import postgres.wire.failure_text;
import postgres.wire.statement;
import std.tcp.Conn;

# What one statement gave.
#     new Answer { names: new list[str], kinds: new list[Kind], rows: new list[list[Field]], changed: 0, problem: "", failed: false }.changed is 0
export record Answer {
    # The column names.
    names: list[str];
    # The kind each column is read as.
    kinds: list[Kind];
    # The rows, one field per column.
    rows: list[list[Field]];
    # The rows a changing statement changed.
    changed: int;
    # The server's failure as err text ("" when it reported none).
    problem: str;
    # Whether the open transaction failed (the server's status after the statement).
    failed: bool;
}

# One message of the answer into a; true when it was the last one.
#     let a = new Answer { names: new list[str], kinds: new list[Kind], rows: new list[list[Field]], changed: 0, problem: "", failed: false }; take(new Message { kind: 90, body: std.bytes.from_ints([69]) }, new Rewritten { text: "", count: 0, made: [""], written: [""] }, a) == ok(true) and a.failed is true
export fn take(m: Message, r: Rewritten, a: Answer) -> result[bool] {
    if m.kind == 90 {
        set a.failed = len(m.body) == 1 and m.body[0] == 69;
        return ok(true);
    }
    if m.kind == 84 {
        for c in try columns(m.body) {
            push(a.names, c.name);
            push(a.kinds, kind_of(c.type_id));
        }
    } else if m.kind == 68 {
        let fields = try data_row(m.body);
        if len(fields) != len(a.kinds) {
            return err("protocol: a row does not have the columns that were described");
        }
        push(a.rows, fields);
    } else if m.kind == 67 {
        set a.changed = changed(m.body);
    } else if m.kind == 69 {
        let f = try failure(m.body);
        var position = 0;
        if f.position > 0 {
            set position = source_position(r, f.position);
        }
        set a.problem = failure_text(f, position);
    } else if m.kind != 49 and m.kind != 50 and m.kind != 110 and m.kind != 78 and m.kind != 83 and m.kind != 65 and m.kind != 73 {
        return err("protocol: an unexpected message in the answer to a statement");
    }
    return ok(false);
}

# Sends one statement with its parameters and reads its whole answer, each wait within ms.
#     round_trip(new Conn { id: 0, peer: "" }, new Rewritten { text: "", count: 0, made: [""], written: [""] }, new list[Field], 1000) == err("connection: the connection is closed") is true
export fn round_trip[E: effects](
    c: Conn[E],
    r: Rewritten,
    fields: list[Field],
    ms: int
) -> result[Answer] uses E {
    try deliver(c, statement(r.text, fields), ms);
    let a = new Answer {
        names: new list[str],
        kinds: new list[Kind],
        rows: new list[list[Field]],
        changed: 0,
        problem: "",
        failed: false
    };
    var done = false;
    while not done {
        set done = try take(try receive(c, ms), r, a);
    }
    return ok(a);
}
