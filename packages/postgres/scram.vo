# postgres.scram: signing in with SCRAM-SHA-256 (RFC 5802, RFC 7677), the client's side. The password
# never leaves this module: only a proof made from it does. Not part of the package's API: import
# postgres.client.
import std.bits.bit_xor;
import std.bytes.from_base64;
import std.bytes.from_ints;
import std.bytes.from_text;
import std.bytes.to_base64;
import std.bytes.to_ints;
import std.crypto.hmac_sha256;
import std.crypto.same_bytes;
import std.crypto.sha256;
import std.text.starts_with;

# The client's last message and the signature the server must answer with.
#     new Final { message: "c=biws", server_signature: from_text("x") }.message is "c=biws"
export record Final {
    # The text to send: the channel binding, the nonce and the proof.
    message: str;
    # What a server that knows the password answers.
    server_signature: bytes;
}

# The key PBKDF2-HMAC-SHA256 derives from a password, a salt and a number of rounds (32 bytes).
#     len(pbkdf2(from_text("p"), from_text("s"), 1)) is 32
export fn pbkdf2(password: bytes, salt: bytes, rounds: int) -> bytes {
    var u = hmac_sha256(password, salt + from_ints([0, 0, 0, 1]));
    let acc = to_ints(u);
    for _ in 1..rounds {
        set u = hmac_sha256(password, u);
        for i in 0..32 {
            set acc[i] = bit_xor(acc[i], u[i]);
        }
    }
    return from_ints(acc);
}

# The part of the client's first message that is signed later: no user name (the server takes it
# from the startup message) and the client's nonce.
#     first_bare("abc") is "n=,r=abc"
export fn first_bare(nonce: str) -> str {
    return "n=,r=" + nonce;
}

fn field(parts: list[str], prefix: str) -> result[str] {
    for p in parts {
        if starts_with(p, prefix) {
            return ok(slice(p, len(prefix), len(p)));
        }
    }
    return err("auth: the server's SCRAM message has no " + prefix + " field");
}

# The client's last message for a password, the signed part of its first message (first_bare) and
# the server's first message. err when the server's message is not what the exchange allows: a nonce
# that does not start with the client's, a salt that is not base64, rounds outside 1 to 600000.
#     client_final("p", "n=,r=abc", "r=xyz,s=c2FsdA==,i=4096") == err("auth: the server's nonce does not continue the client's") is true
export fn client_final(password: str, bare: str, server_first: str) -> result[Final] {
    let parts = split(server_first, ",");
    let nonce = try field(parts, "r=");
    let salt_text = try field(parts, "s=");
    let rounds_text = try field(parts, "i=");
    let own = slice(bare, find(bare, "r=") + 2, len(bare));
    if not starts_with(nonce, own) or len(nonce) == len(own) {
        return err("auth: the server's nonce does not continue the client's");
    }
    var salt = from_text("");
    match from_base64(salt_text) {
        case ok(b) {
            set salt = b;
        }
        case err(_) {
            return err("auth: the server's salt is not base64");
        }
    }
    var rounds = 0;
    match parse_int(rounds_text) {
        case ok(n) {
            set rounds = n;
        }
        case err(_) {
        }
    }
    if rounds < 1 or rounds > 600000 {
        return err(
            "auth: the server asked for " + rounds_text + " rounds; 1 to 600000 are accepted"
        );
    }
    # ponytail: the password goes in as its UTF-8 bytes, without SASLprep (RFC 4013). ASCII passwords
    # are unaffected; one with characters SASLprep would change does not sign in. Upgrade: SASLprep.
    let salted = pbkdf2(from_text(password), salt, rounds);
    let client_key = hmac_sha256(salted, from_text("Client Key"));
    let stored_key = sha256(client_key);
    let without_proof = "c=biws,r=" + nonce;
    let auth_message = from_text(bare + "," + server_first + "," + without_proof);
    let signature = hmac_sha256(stored_key, auth_message);
    let proof = to_ints(client_key);
    for i in 0..32 {
        set proof[i] = bit_xor(proof[i], signature[i]);
    }
    let server_key = hmac_sha256(salted, from_text("Server Key"));
    return ok(new Final {
        message: without_proof + ",p=" + to_base64(from_ints(proof)),
        server_signature: hmac_sha256(server_key, auth_message)
    });
}

# Whether the server's last message carries the signature a server that knows the password gives.
#     verify("e=invalid-proof", from_text("x")) is false
export fn verify(server_final: str, expected: bytes) -> bool {
    if not starts_with(server_final, "v=") {
        return false;
    }
    match from_base64(slice(server_final, 2, len(server_final))) {
        case ok(got) {
            return same_bytes(got, expected);
        }
        case err(_) {
            return false;
        }
    }
}

fn example() -> result[Final] {
    return client_final(
        "pencil",
        "n=user,r=rOprNGfwEbeRWgbNEkqO",
        "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    );
}

test "the exchange of RFC 7677" {
    match example() {
        case ok(f) {
            expect_eq(
                f.message,
                "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ="
            );
            expect(verify("v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=", f.server_signature));
            expect(
                not verify("v=7rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=", f.server_signature)
            );
            expect(not verify("e=other-error", f.server_signature));
            expect(not verify("v=", f.server_signature));
        }
        case err(e) {
            expect_eq(e, "");
        }
    }
}

test "what the server may not send" {
    expect_eq(client_final("p", "n=,r=abc", "r=abc,s=c2FsdA==,i=4096"), err(
        "auth: the server's nonce does not continue the client's"
    ));
    expect_eq(client_final("p", "n=,r=abc", "r=abcd,s=!!,i=4096"), err(
        "auth: the server's salt is not base64"
    ));
    expect_eq(client_final("p", "n=,r=abc", "r=abcd,s=c2FsdA==,i=100000000"), err(
        "auth: the server asked for 100000000 rounds; 1 to 600000 are accepted"
    ));
    expect_eq(client_final("p", "n=,r=abc", "r=abcd,s=c2FsdA==,i=0"), err(
        "auth: the server asked for 0 rounds; 1 to 600000 are accepted"
    ));
    expect_eq(client_final("p", "n=,r=abc", "r=abcd,i=4096"), err(
        "auth: the server's SCRAM message has no s= field"
    ));
}
