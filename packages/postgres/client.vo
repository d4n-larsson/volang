# postgres.client: PostgreSQL databases on a server, with the names and shapes of std.sqlite.
# Import items one by one: `import postgres.client.NAME;`. Add the package with `vo package`.
# connect needs `net` with the server in its scopes (`net("db.internal:5432")`) and `entropy`; a
# database's type names `net`, and using it needs it: code for any database is generic over its
# effects, `fn save[D: effects](db: Database[D], ...) uses D`, as with std.sqlite.
# Statements are sql("...") with `?` parameters in order; values are never part of the text. `??` is a
# literal `?`. The connection is encrypted and the server verified unless Options.plain_text is set.
# Every failure is an err whose first word says what kind it is: constraint, readonly, busy, error
# (the connection stays usable), auth, tls, timeout, connection, protocol (it is closed).
import postgres.exchange;
import postgres.link;
import postgres.signin;
import postgres.statement;
import postgres.values;
import postgres.wire;
import std.bytes;
import std.crypto;
import std.tcp;

# Where and how to connect. Every field is given; the usual values are port 5432, plain_text false,
# connect_ms 10000 and statement_ms 30000.
#     new Options { host: "db", port: 5432, database: "app", user: "app", password: "", plain_text: false, connect_ms: 10000, statement_ms: 30000 }.port is 5432
export record Options {
    # The server's name or IPv4 address.
    host: str;
    # Its port, 1 to 65535.
    port: int;
    # The database to use.
    database: str;
    # The user to sign in as.
    user: str;
    # The user's password ("" when the server asks for none). It is never sent: only a proof is.
    password: str;
    # true for a connection without TLS (a server on the same machine, a test). false: the connection
    # is encrypted and the server's certificate verified for host, or connect fails.
    plain_text: bool;
    # The time limit for connecting and signing in, in milliseconds (1 to 600000), for each wait.
    connect_ms: int;
    # The time limit for each wait of a statement, in milliseconds (1 to 600000).
    statement_ms: int;
}

# An open, signed-in connection: from connect; close it with close. One made with `new` is refused.
#     new Database { conn: new Conn { id: 0, peer: "" }, statement_ms: 1, in_transaction: false, failed: false, closed: true }.closed is true
export record Database[E: effects] {
    # The connection.
    conn: tcp.Conn[uses E];
    # The time limit for each wait of a statement.
    statement_ms: int;
    # Whether transaction is running its function.
    in_transaction: bool;
    # Whether a statement failed in the open transaction.
    failed: bool;
    # Whether the connection was closed, by close or by a failure.
    closed: bool;
}

# One SQL statement with ? parameters: sql("...") or parse_sql(s).
#     sql("select 1").text is "select 1"
export record Statement {
    # The SQL text.
    text: str;
}

# A parameter or column value.
#     Value.integer(1) == Value.integer(1) is true
export variant Value {
    # smallint, integer, bigint; boolean as 0 or 1.
    integer(int);
    # real, double precision.
    real(float);
    # Text, and every other type in the server's text form (numeric, timestamps, uuid, json, ...).
    text(str);
    # bytea.
    blob(bytes);
    # NULL.
    null;
}

# One result row: its column names and values, in the statement's column order.
#     new Row { columns: ["x"], values: [Value.null] }.columns[0] is "x"
export record Row {
    # The column names (AS names where given).
    columns: list[str];
    # The values, one per column.
    values: list[Value];
}

# What a changing statement did: the rows it changed. last_id is always 0 (PostgreSQL has no row id
# of the last insert: write `insert ... returning id` and run it with query).
#     new Changes { changed: 1, last_id: 0 }.changed is 1
export record Changes {
    # The rows inserted, updated or deleted.
    changed: int;
    # Always 0.
    last_id: int;
}

# The statement for text: `?` parameters in order, one statement. It is checked when it runs (exec
# and query return the err parse_sql would).
#     sql("select ?").text is "select ?"
export fn sql(text: str) -> Statement {
    return new Statement { text: text };
}

# The statement for SQL built at run time: err for more than one statement, numbered parameters
# (`$1`), or text that ends inside a string or comment. Syntax is the server's to report.
#     parse_sql("select $1") == err("error: write parameters as ?, not $1") is true
export fn parse_sql(text: str) -> result[Statement] {
    let _ = try statement.rewrite(text);
    return ok(new Statement { text: text });
}

fn shut[E: effects](db: Database[uses E]) uses E {
    if not db.closed {
        set db.closed = true;
        link.hang_up(db.conn);
    }
}

# Connects and signs in (needs net with the host in its scopes, and entropy). Unless o.plain_text,
# the connection is upgraded to TLS before anything else is sent and the server's certificate must
# verify for o.host. Signs in with SCRAM-SHA-256, or with nothing when the server asks for nothing.
#     connect(new Options { host: "db", port: 0, database: "", user: "", password: "", plain_text: false, connect_ms: 1, statement_ms: 1 }) == err("error: the port must be 1 to 65535") is true
export fn connect(o: Options) -> result[Database[uses net]] uses net, entropy {
    if o.port < 1 or o.port > 65535 {
        return err("error: the port must be 1 to 65535");
    }
    if o.connect_ms < 1 or o.connect_ms > 600000 or o.statement_ms < 1 or o.statement_ms > 600000 {
        return err("error: the time limits must be 1 to 600000 milliseconds");
    }
    let nonce = bytes.to_base64(crypto.random_bytes(18));
    let c = try link.dial(o.host, o.port, o.plain_text, o.connect_ms);
    let db = new Database[uses net] {
        conn: c,
        statement_ms: o.statement_ms,
        in_transaction: false,
        failed: false,
        closed: false
    };
    match signin.sign_in(c, o.user, o.database, o.password, o.connect_ms, nonce) {
        case ok() {
            return ok(db);
        }
        case err(e) {
            shut(db);
            return err(e);
        }
    }
}

# Tells the server goodbye and ends the connection; using the database afterwards returns
# err("connection: closed"). Harmless to repeat.
#     let db = new Database { conn: new Conn { id: 0, peer: "" }, statement_ms: 1, in_transaction: false, failed: false, closed: true }; close(db); db.closed is true
export fn close[E: effects](db: Database[uses E]) uses E {
    if db.closed {
        return;
    }
    match link.deliver(db.conn, wire.terminate(), db.statement_ms) {
        case ok() {
        }
        case err(_) {
        }
    }
    shut(db);
}

# The parameters as the server takes them: each value's text form, or null.
fn fields_of(params: list[Value]) -> result[list[wire.Field]] {
    var out = new list[wire.Field];
    let none = bytes.from_ints(new list[int]);
    for p in params {
        match p {
            case integer(i) {
                push(out, new wire.Field { null: false, data: bytes.from_text(str(i)) });
            }
            case real(f) {
                push(out, new wire.Field { null: false, data: bytes.from_text(str(f)) });
            }
            case text(s) {
                if find(s, chr(0)) >= 0 {
                    return err("error: text with a zero byte cannot be stored: pass it as a blob");
                }
                push(out, new wire.Field { null: false, data: bytes.from_text(s) });
            }
            case blob(b) {
                push(out, new wire.Field {
                    null: false,
                    data: bytes.from_text(values.blob_text(b))
                });
            }
            case null {
                push(out, new wire.Field { null: true, data: none });
            }
        }
    }
    return ok(out);
}

# A column value of a kind, from its text form.
fn value_of(kind: values.Kind, f: wire.Field) -> result[Value] {
    if f.null {
        return ok(Value.null);
    }
    var s = "";
    match bytes.to_text(f.data) {
        case ok(t) {
            set s = t;
        }
        case err(_) {
            return ok(Value.blob(f.data));
        }
    }
    match kind {
        case integer {
            match parse_int(s) {
                case ok(i) {
                    return ok(Value.integer(i));
                }
                case err(_) {
                    return err("protocol: an integer value is not a number");
                }
            }
        }
        case boolean {
            if s == "t" {
                return ok(Value.integer(1));
            }
            return ok(Value.integer(0));
        }
        case real {
            match parse_float(s) {
                case ok(x) {
                    return ok(Value.real(x));
                }
                case err(_) {
                    return ok(Value.text(s));
                }
            }
        }
        case blob {
            return ok(Value.blob(try values.blob_of(s)));
        }
        case text {
            return ok(Value.text(s));
        }
    }
}

fn run[E: effects](
    db: Database[uses E],
    st: Statement,
    params: list[Value]
) -> result[exchange.Answer] uses E {
    if db.closed {
        return err("connection: closed");
    }
    let r = try statement.rewrite(st.text);
    if r.count != len(params) {
        return err(
            "error: the statement has " + str(r.count) + " parameters, and " + str(len(params)) + " values were given"
        );
    }
    if len(params) > 65535 {
        return err("error: a statement takes at most 65535 parameters");
    }
    let fields = try fields_of(params);
    match exchange.round_trip(db.conn, r, fields, db.statement_ms) {
        case ok(o) {
            set db.failed = o.failed;
            if o.problem != "" {
                return err(o.problem);
            }
            return ok(o);
        }
        case err(e) {
            if link.ends_connection(e) {
                shut(db);
            }
            return err(e);
        }
    }
}

# Runs a statement that changes data or the schema, with its ? parameters in order (needs the
# database's effects).
#     exec(new Database { conn: new Conn { id: 0, peer: "" }, statement_ms: 1, in_transaction: false, failed: false, closed: true }, sql("create table t(x int)"), new list[Value]) == err("connection: closed") is true
export fn exec[E: effects](
    db: Database[uses E],
    st: Statement,
    params: list[Value]
) -> result[Changes] uses E {
    let o = try run(db, st, params);
    return ok(new Changes { changed: o.changed, last_id: 0 });
}

# Runs a statement that returns rows, with its ? parameters in order: every row (needs the
# database's effects).
#     query(new Database { conn: new Conn { id: 0, peer: "" }, statement_ms: 1, in_transaction: false, failed: false, closed: true }, sql("select ?"), new list[Value]) == err("connection: closed") is true
export fn query[E: effects](
    db: Database[uses E],
    st: Statement,
    params: list[Value]
) -> result[list[Row]] uses E {
    let o = try run(db, st, params);
    var rows = new list[Row];
    for fields in o.rows {
        var values_value = new list[Value];
        for i in 0..len(fields) {
            push(values_value, try value_of(o.kinds[i], fields[i]));
        }
        push(rows, new Row { columns: o.names, values: values_value });
    }
    return ok(rows);
}

fn roll_back[E: effects](db: Database[uses E]) uses E {
    match run(db, sql("rollback"), new list[Value]) {
        case ok(_) {
        }
        case err(_) {
        }
    }
}

# Runs f inside a transaction: committed when f returns ok, rolled back when it returns err (which is
# returned). A transaction inside another is an err, and so is one in which a statement failed.
#     let f: fn() -> result[int] = fn() => ok(5); transaction(new Database { conn: new Conn { id: 0, peer: "" }, statement_ms: 1, in_transaction: false, failed: false, closed: true }, f) == err("connection: closed") is true
export fn transaction[T, E: effects, F: effects](
    db: Database[uses E],
    f: fn() -> result[T] uses F
) -> result[T] uses E, F {
    if db.in_transaction {
        return err("error: a transaction is already open");
    }
    let none = new list[Value];
    let _ = try run(db, sql("begin"), none);
    set db.in_transaction = true;
    let r = f();
    set db.in_transaction = false;
    match r {
        case ok(v) {
            if db.failed {
                roll_back(db);
                return err("error: a statement in the transaction failed");
            }
            match run(db, sql("commit"), none) {
                case ok(_) {
                    return ok(v);
                }
                case err(e) {
                    if link.ends_connection(e) {
                        return err(e + "; whether the transaction was committed is not known");
                    }
                    return err(e);
                }
            }
        }
        case err(e) {
            roll_back(db);
            return err(e);
        }
    }
}

fn kind_name(v: Value) -> str {
    match v {
        case integer(_) {
            return "integer";
        }
        case real(_) {
            return "real";
        }
        case text(_) {
            return "text";
        }
        case blob(_) {
            return "blob";
        }
        case null {
            return "null";
        }
    }
}

# The value of a column by name; err for an unknown name or one that two columns have.
#     value_column(new Row { columns: ["x"], values: [Value.null] }, "y") == err("no column `y`") is true
export fn value_column(row: Row, column: str) -> result[Value] {
    return ok(row.values[try values.column_index(row.columns, column)]);
}

# A column's value as an int; err unless it is an integer (a boolean is 0 or 1).
#     int_column(new Row { columns: ["x"], values: [Value.integer(7)] }, "x") == ok(7) is true
export fn int_column(row: Row, column: str) -> result[int] {
    let v = try value_column(row, column);
    match v {
        case integer(i) {
            return ok(i);
        }
        case real(_) {
        }
        case text(_) {
        }
        case blob(_) {
        }
        case null {
        }
    }
    return err(column + " is " + kind_name(v) + ", not integer");
}

# A column's value as a float: a real, or an integer converted (NaN and the infinities are text).
#     float_column(new Row { columns: ["x"], values: [Value.integer(7)] }, "x") == ok(7.0) is true
export fn float_column(row: Row, column: str) -> result[float] {
    let v = try value_column(row, column);
    match v {
        case real(f) {
            return ok(f);
        }
        case integer(i) {
            return ok(float(i));
        }
        case text(_) {
        }
        case blob(_) {
        }
        case null {
        }
    }
    return err(column + " is " + kind_name(v) + ", not real");
}

# A column's value as text; err unless it is text.
#     text_column(new Row { columns: ["x"], values: [Value.text("hi")] }, "x") == ok("hi") is true
export fn text_column(row: Row, column: str) -> result[str] {
    let v = try value_column(row, column);
    match v {
        case text(s) {
            return ok(s);
        }
        case integer(_) {
        }
        case real(_) {
        }
        case blob(_) {
        }
        case null {
        }
    }
    return err(column + " is " + kind_name(v) + ", not text");
}

# A column's value as bytes: a blob, or text as its UTF-8 bytes.
#     bytes_column(new Row { columns: ["x"], values: [Value.null] }, "x") == err("x is null, not blob") is true
export fn bytes_column(row: Row, column: str) -> result[bytes] {
    let v = try value_column(row, column);
    match v {
        case blob(b) {
            return ok(b);
        }
        case text(s) {
            return ok(bytes.from_text(s));
        }
        case integer(_) {
        }
        case real(_) {
        }
        case null {
        }
    }
    return err(column + " is " + kind_name(v) + ", not blob");
}

# Whether a column's value is NULL.
#     is_null(new Row { columns: ["x"], values: [Value.null] }, "x") == ok(true) is true
export fn is_null(row: Row, column: str) -> result[bool] {
    return ok(try value_column(row, column) == Value.null);
}

# A date or timestamp column as milliseconds since 1970 UTC: a timestamp with time zone, a timestamp
# (taken as UTC) or a date (its midnight UTC). Microseconds beyond the millisecond are dropped.
#     time_column(new Row { columns: ["at"], values: [Value.text("1970-01-01 00:00:01+00")] }, "at") == ok(1000) is true
export fn time_column(row: Row, column: str) -> result[int] {
    let v = try value_column(row, column);
    match text_column(row, column) {
        case ok(s) {
            return map_err(values.time_of(s), fn(reason) => column + " is " + reason + ": " + s);
        }
        case err(_) {
            return err(column + " is " + kind_name(v) + ", not a date or time");
        }
    }
}
