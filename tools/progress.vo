# Progress and estimated time for the long make targets (test, gate, gc-check, ...).
#
#   bin/vo run --timeout 0 tools/progress.vo -- run TARGET [MAKE_ARG...]   runs `make TARGET`, its output
#                                                                          to build/progress/TARGET.log
#   bin/vo run --timeout 0 tools/progress.vo -- watch LOG [TARGET]         follows a log another run is
#                                                                          writing (TARGET: its timings)
#
# Run it from the repository root. A step is a line that starts with `== ` (`== gate: test`,
# `== fmt_corpus.py`, ...). The status line shows the step, how long it and the whole run have taken, and an
# estimate of what is left: the durations the same steps took in the last complete run of TARGET
# (build/progress/TARGET.times.json, written when a `run` ends). The first run of a target has no
# estimate. Status lines go to stderr when a step starts and at most once a minute; FAIL lines and the
# last lines before a failure are printed as they come; the full output is in the log.

import std.fs.append_file;
import std.fs.make_dir;
import std.json.Json;
import std.json.as_object;
import std.json.parse_json;
import std.json.write_json_pretty;
import std.lists.sort_by_desc;
import std.process.Output;
import std.process.run;
import std.process.run_lines;
import std.text.contains;
import std.text.lines;
import std.text.pad_left;
import std.text.starts_with;
import std.time.sleep;

const progress_dir = "build/progress/";

# What make and the suites under it read from the environment (std.process starts programs with none).
# ponytail: a fixed list, in Passed and passed_vars; add a name to both when a suite reads a new one.

effects Passed = env("CI", "HOME", "LANG", "PATH", "TMPDIR", "VO_ARCHIVES", "VO_BIN", "VO_GC_STRESS", "VO_GRAMMARS", "VO_PG_TEST", "VO_REPLAY_BIN", "VO_STREAM", "VO_TEST_JITTER_MS");

# One step: started and ended in milliseconds, -1 when unknown.
record Step {
    key: str;
    name: str;
    started: int;
    ended: int;
}

record Progress {
    target: str;
    start: int;
    steps: list[Step];
    seen: map[str, int];
    # The last complete run's milliseconds per step key.
    history: map[str, int];
    last_draw: int;
    # Catching up on a log that is already there: no status lines, step times unknown.
    quiet: bool;
    # watch: the lines of the log taken so far.
    taken: int;
}

fn new_progress(target: str, start: int, history: map[str, int]) -> Progress {
    return new Progress {
        target: target,
        start: start,
        steps: new list[Step],
        seen: new map[str, int],
        history: history,
        last_draw: 0,
        quiet: false,
        taken: 0
    };
}

# Seconds as 4m07s, or 1h02m from an hour on.
fn fmt(ms: int) -> str {
    let s = ms / 1000;
    if s >= 3600 {
        return str(s / 3600) + "h" + pad_left(str(s % 3600 / 60), 2, "0") + "m";
    }
    return str(s / 60) + "m" + pad_left(str(s % 60), 2, "0") + "s";
}

# Milliseconds left by the last run's timings, or -1 without them.
fn remaining(p: Progress, now: int) -> int {
    if len(p.history) == 0 {
        return -1;
    }
    var left = 0;
    let done = new map[str, bool];
    for s in p.steps {
        set done[s.key] = true;
    }
    if len(p.steps) > 0 {
        let cur = p.steps[len(p.steps) - 1];
        var spent = 0;
        if cur.started >= 0 {
            set spent = now - cur.started;
        }
        set left = left + max(0, get_or(p.history, cur.key, 0) - spent);
    }
    for key, ms in p.history {
        if not has(done, key) {
            set left = left + ms;
        }
    }
    return left;
}

# The status line, or "" when it is not due (at most once a minute unless forced) or catching up.
fn status(p: Progress, now: int, force: bool) -> str {
    if p.quiet or (not force and now - p.last_draw < 60000) {
        return "";
    }
    set p.last_draw = now;
    var total = "?";
    if len(p.history) > 0 {
        set total = str(len(p.history));
    }
    let parts = ["[" + str(len(p.steps)) + "/" + total + "]"];
    if len(p.steps) > 0 {
        let cur = p.steps[len(p.steps) - 1];
        let cs = chars(cur.name);
        push(parts, join(slice(cs, 0, min(50, len(cs))), ""));
        if cur.started >= 0 {
            push(parts, "step " + fmt(now - cur.started));
        }
    } else {
        push(parts, "starting");
    }
    push(parts, "total " + fmt(now - p.start));
    let left = remaining(p, now);
    if left >= 0 {
        push(parts, "about " + fmt(left) + " left");
    } else {
        push(parts, "no estimate yet (first run)");
    }
    return join(parts, "  ");
}

# Takes one line of make's output; returns what to print (FAIL lines and status lines).
fn on_line(p: Progress, text: str, now: int) -> list[str] {
    let out = new list[str];
    if starts_with(text, "== ") and len(trim(slice(text, 3, len(text)))) > 0 {
        var at = now;
        if p.quiet {
            set at = -1;
        }
        if len(p.steps) > 0 {
            set p.steps[len(p.steps) - 1].ended = at;
        }
        let name = trim(slice(text, 3, len(text)));
        let k = get_or(p.seen, name, 0) + 1;
        set p.seen[name] = k;
        push(p.steps, new Step { key: name + "#" + str(k), name: name, started: at, ended: -1 });
    } else if starts_with(text, "FAIL") or contains(text, "*** ") {
        push(out, text);
    } else {
        return out;
    }
    let s = status(p, now, true);
    if s != "" {
        push(out, s);
    }
    return out;
}

# Takes the complete lines of the log not taken yet (the last piece has no line end yet: it waits).
fn take_lines(p: Progress, text: str, now: int) -> list[str] {
    let out = new list[str];
    let ls = split(text, "\n");
    for i in p.taken..len(ls) - 1 {
        for l in on_line(p, ls[i], now) {
            push(out, l);
        }
    }
    set p.taken = max(p.taken, len(ls) - 1);
    return out;
}

# The timings file: seconds per step key, to one decimal.
fn times_json(p: Progress, now: int) -> result[str] {
    let times = new map[str, Json];
    for s in p.steps {
        var ended = s.ended;
        if ended < 0 {
            set ended = now;
        }
        set times[s.key] = Json.number(float((ended - s.started) / 100) / 10.0);
    }
    return write_json_pretty(Json.object(times));
}

fn parse_times(text: str) -> result[map[str, int]] {
    let history = new map[str, int];
    for key, v in try as_object(try parse_json(text)) {
        match v {
            case number(secs) {
                set history[key] = int(secs * 1000.0);
            }
            case integer(secs) {
                set history[key] = secs * 1000;
            }
            case null {
            }
            case boolean(_) {
            }
            case text(_) {
            }
            case array(_) {
            }
            case object(_) {
            }
        }
    }
    return ok(history);
}

fn summary(p: Progress, code: int, now: int) -> str {
    let timed = new list[Step];
    for s in p.steps {
        if s.started >= 0 {
            push(timed, s);
        }
    }
    let took = fn(s: Step) -> int {
        if s.ended < 0 {
            return now - s.started;
        }
        return s.ended - s.started;
    };
    sort_by_desc(timed, took);
    var state = "FAILED (exit " + str(code) + ")";
    if code < 0 {
        set state = "ended";
    } else if code == 0 {
        set state = "passed";
    }
    var name = p.target;
    if name == "" {
        set name = "run";
    }
    var out = name + ": " + state + " in " + fmt(now - p.start) + ", " + str(len(p.steps)) + " steps; slowest:";
    for s in slice(timed, 0, min(8, len(timed))) {
        set out = out + "\n  " + pad_left(fmt(took(s)), 8, " ") + "  " + s.name;
    }
    return out;
}

test "steps, estimate, timings and summary" {
    let history = new map[str, int];
    set history["a#1"] = 10000;
    set history["b#1"] = 5000;
    let p = new_progress("test", 0, history);
    expect_eq(on_line(p, "== a", 1000), ["[1/2]  a  step 0m00s  total 0m01s  about 0m15s left"]);
    expect_eq(on_line(p, "ok 1", 2000), new list[str]);
    expect_eq(on_line(p, "FAIL x", 4000), [
        "FAIL x",
        "[1/2]  a  step 0m03s  total 0m04s  about 0m12s left"
    ]);
    expect_eq(len(on_line(p, "== b", 13000)), 1);
    expect_eq(remaining(p, 14000), 4000);
    expect_eq(times_json(p, 20000), ok("{\n  \"a#1\": 12.0,\n  \"b#1\": 7.0\n}"));
    expect_eq(parse_times("{\"a#1\": 12.0, \"b#1\": 7}"), ok(history_of(12000, 7000)));
    expect_eq(
        summary(p, 2, 20000),
        "test: FAILED (exit 2) in 0m20s, 2 steps; slowest:\n     0m12s  a\n     0m07s  b"
    );
    expect_eq(fmt(3725000), "1h02m");
    let w = new_progress("", 0, new map[str, int]);
    expect_eq(take_lines(w, "== a\nFAIL x\n== b", 1000), [
        "[1/?]  a  step 0m00s  total 0m01s  no estimate yet (first run)",
        "FAIL x",
        "[1/?]  a  step 0m00s  total 0m01s  no estimate yet (first run)"
    ]);
    expect_eq(take_lines(w, "== a\nFAIL x\n== b\n", 2000), [
        "[2/?]  b  step 0m00s  total 0m02s  no estimate yet (first run)"
    ]);
}

fn history_of(a: int, b: int) -> map[str, int] {
    let h = new map[str, int];
    set h["a#1"] = a;
    set h["b#1"] = b;
    return h;
}

fn load_history(target: str) -> result[map[str, int]] uses file.read("build/") {
    match read_file(progress_dir + target + ".times.json") {
        case ok(text) {
            return parse_times(text);
        }
        case err(_) {
            return ok(new map[str, int]);
        }
    }
}

fn passed_vars() -> list[str] uses Passed {
    let vars = new list[str];
    let names = [
        "CI",
        "HOME",
        "LANG",
        "PATH",
        "TMPDIR",
        "VO_ARCHIVES",
        "VO_BIN",
        "VO_GC_STRESS",
        "VO_GRAMMARS",
        "VO_PG_TEST",
        "VO_REPLAY_BIN",
        "VO_STREAM",
        "VO_TEST_JITTER_MS"
    ];
    for name in names {
        match env(name) {
            case ok(v) {
                push(vars, name + "=" + v);
            }
            case err(_) {
            }
        }
    }
    return vars;
}

fn run_make(target: str, make_args: list[str]) -> result[int]
    uses console, file.read("build/"), file.write("build/"), clock, process("sh"), Passed {
    try make_dir(progress_dir);
    let log = progress_dir + target + ".log";
    try write_file(log, "");
    let p = new_progress(target, now_ms(), try load_history(target));
    eprint("make " + target + ": output in " + log);
    # stdout and stderr in one stream, in the order make wrote them. make holds the log open on fd 3 while
    # it runs (append_file opens it per line), so watch's fuser sees the run until it ends.
    let argv = ["-c", "log=$1; shift; exec make \"$@\" 2>&1 3>>\"$log\"", "sh", log, target];
    for a in make_args {
        push(argv, a);
    }
    let out = try run_lines("sh", argv, "", passed_vars(), "./", fn(text: str) -> result[bool] {
        try append_file(log, text + "\n");
        for l in on_line(p, text, now_ms()) {
            eprint(l);
        }
        let s = status(p, now_ms(), false);
        if s != "" {
            eprint(s);
        }
        return ok(true);
    });
    if out.code == 0 {
        try write_file(progress_dir + target + ".times.json", try times_json(p, now_ms()) + "\n");
    } else {
        let ls = lines(try read_file(log));
        eprint(join(slice(ls, max(0, len(ls) - 15), len(ls)), "\n"));
    }
    eprint(summary(p, out.code, now_ms()));
    return ok(out.code);
}

# The log's creation time where the file system keeps it, else now.
fn birth(log: str) -> result[int] uses clock, process("stat") {
    match parse_int(trim((try run("stat", ["-c", "%W", log])).stdout)) {
        case ok(t) {
            if t > 0 {
                return ok(t * 1000);
            }
        }
        case err(_) {
        }
    }
    return ok(now_ms());
}

# ponytail: rereads the whole log each second (logs are a few hundred KiB); read from an offset if they grow.
fn watch(log: str, target: str) -> result[void]
    uses console, file.read, clock, process("fuser", "stat") {
    var history = new map[str, int];
    if target != "" {
        set history = try load_history(target);
    }
    let p = new_progress(target, try birth(log), history);
    set p.quiet = true;
    while true {
        let taken = p.taken;
        for l in take_lines(p, try read_file(log), now_ms()) {
            eprint(l);
        }
        if p.quiet {
            set p.quiet = false;
            eprint(status(p, now_ms(), true));
            continue;
        }
        if p.taken > taken {
            continue;
        }
        # fuser fails when no process has the log open any more: the run ended.
        if (try run("fuser", [log])).code != 0 {
            break;
        }
        let s = status(p, now_ms(), false);
        if s != "" {
            eprint(s);
        }
        sleep(1000);
    }
    eprint(summary(p, -1, now_ms()));
    return ok();
}

fn main() -> result[void]
    uses console, file.read, file.write("build/"), clock, process("fuser", "sh", "stat"), Passed {
    let a = args();
    if len(a) >= 2 and a[0] == "run" {
        let code = try run_make(a[1], slice(a, 2, len(a)));
        if code != 0 {
            exit(min(code, 63));
        }
        return ok();
    }
    if (len(a) == 2 or len(a) == 3) and a[0] == "watch" {
        var target = "";
        if len(a) == 3 {
            set target = a[2];
        }
        return watch(a[1], target);
    }
    eprint(
        "usage: bin/vo run --timeout 0 tools/progress.vo -- run TARGET [MAKE_ARG...] | watch LOG [TARGET]"
    );
    exit(2);
}
